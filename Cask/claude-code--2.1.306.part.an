`}var cp="WebSearch",j2s="allow_web_search";var cl=900000;class lr{ms=void 0}var pl=new W(()=>new lr);function rDo(){let e=pl.of(j().host);return e.ms??=a.CLAUDE_CODE_WEBFETCH_CACHE_TTL_MS??cl,e.ms}function PLr(){let e=Math.max(1,Math.round(rDo()/60000));return`${e} ${I(e,"minute")}`}function ml(e){switch(e){case"artifact-tool":return' claude.ai artifact links (claude.ai/artifact/{id} or claude.ai/code/artifact/{uuid}) are published artifacts: read them with the Artifact tool (action "read"), not WebFetch or curl.';case"webfetch":return" Exception: claude.ai artifact links (claude.ai/artifact/{id} or claude.ai/code/artifact/{uuid}) ARE fetchable via your claude.ai login \u2014 use WebFetch, not curl (curl gets the SPA shell or a Cloudflare 403).";case"none":return""}}function fl(e){switch(e){case"artifact-tool":return`- claude.ai artifact links (claude.ai/artifact/{id} or claude.ai/code/artifact/{uuid}, including preview.claude.ai) are published artifacts: read them with the Artifact tool (action "read"), not WebFetch, curl or a headless browser.
`;case"webfetch":return`- Exception: claude.ai artifact links (claude.ai/artifact/{id} or claude.ai/code/artifact/{uuid}, including preview.claude.ai) ARE fetchable \u2014 WebFetch uses your claude.ai login. Use WebFetch for these, not curl or a headless browser (those return the SPA shell or a Cloudflare 403, not the content).
`;case"none":return""}}var gl=`${ar} is for URLs that already appear in this conversation: URLs the person provided, or URLs returned by a prior ${cp} or ${ar}. A URL recalled from training or built by editing a seen URL's path may need the person's approval or be rejected; call ${cp} or fetch a linking page instead.

`;function W2s(e,n="none",s,r=!1){let h=r?gl:"";if(qI({model:e,leanPrompt:s}))return`${h}Fetches a URL, converts the page to markdown, and answers \`prompt\` against it using a small fast model.

- Fails on authenticated/private URLs \u2014 use an authenticated MCP tool or \`gh\` for those instead.${ml(n)}
- Fails on localhost and other hostnames without a dot; for a local server, use curl via Bash.
- HTTP is upgraded to HTTPS. Cross-host redirects are returned to you rather than followed; call again with the redirect URL.
- Responses are cached for ${PLr()} per URL.`;return`${h}IMPORTANT: WebFetch WILL FAIL for authenticated or private URLs. Before using this tool, check if the URL points to an authenticated service (e.g. Google Docs, Confluence, Jira, GitHub). If so, look for a specialized MCP tool that provides authenticated access.

t"/$bunfs/root/chunk-sqjfa46e.js";import"/$bunfs/root/chunk-0m0d8rmc.js";import"/$bunfs/root/chunk-9f58jhyf.js";import"/$bunfs/root/chunk-z56mw3jm.js";import"/$bunfs/root/chunk-bfqb6kr7.js";import"/$bunfs/root/chunk-xs5gxdh4.js";import"/$bunfs/root/chunk-vgw491ng.js";import"/$bunfs/root/chunk-x1jve85r.js";import"/$bunfs/root/chunk-3qakkaq9.js";import"/$bunfs/root/chunk-z4ge6560.js";import"/$bunfs/root/chunk-m97gemge.js";import"/$bunfs/root/chunk-wbe6y5eh.js";import"/$bunfs/root/chunk-jynr8s3f.js";import"/$bunfs/root/chunk-1km7hqtn.js";import"/$bunfs/root/chunk-qvwgdr4y.js";import"/$bunfs/root/chunk-d4xt7ej2.js";import"/$bunfs/root/chunk-py6za7eb.js";import"/$bunfs/root/chunk-xq3n3466.js";import{Hs}from"/$bunfs/root/chunk-8e9fn683.js";import"/$bunfs/root/chunk-nazthp4h.js";import"/$bunfs/root/chunk-r4ra030x.js";import"/$bunfs/root/chunk-rgfmprrn.js";import"/$bunfs/root/chunk-r60g4ktj.js";import"/$bunfs/root/chunk-75mw5s1r.js";import"/$bunfs/root/chunk-zxkjwp6x.js";import"/$bunfs/root/chunk-1e8yvrwp.js";import"/$bunfs/root/chunk-sr12pz9k.js";import"/$bunfs/root/chunk-x9nx7epe.js";import"/$bunfs/root/chunk-00v37vwv.js";import"/$bunfs/root/chunk-5yg4avpf.js";import"/$bunfs/root/chunk-bq7qbt1w.js";import"/$bunfs/root/chunk-dyxe93g1.js";import"/$bunfs/root/chunk-tn1j6vmr.js";import"/$bunfs/root/chunk-99m0p1v3.js";import"/$bunfs/root/chunk-44118748.js";import{QT,kXe}from"/$bunfs/root/chunk-kacqaca4.js";import"/$bunfs/root/chunk-b8ghx04f.js";import"/$bunfs/root/chunk-r1n6vzwg.js";import"/$bunfs/root/chunk-y7fvkjrx.js";import"/$bunfs/root/chunk-y0937590.js";import"/$bunfs/root/chunk-t2v3fz5w.js";import{b}from"/$bunfs/root/chunk-pj3wn6z3.js";M();M();function Uo(z){return{label:z.label,value:z.value}}var _t=[{value:"claude",label:"@Claude Code - Tag @claude in issues and PR comments"},{value:"claude-review",label:"Claude Code Review - Automated code review on new PRs"}],bt=r(Se,{children:[e(F,{chord:["up","down"],action:"navigate"}),e(F,{chord:"space",action:"toggle"}),e(F,{chord:"enter",action:"confirm"}),e(Qe,{action:"confirm:no",context:"Confirmation",fallback:"Esc",description:"cancel"})]});function Je(P){let o=w(15),{onSubmit:p,defaultSelections:k}=P,[m,x]=g(!1),a;if(o[0]!==p)a=(O)=>{if(O.length===0){x(!0);return}x(!1),p(O)},o[0]=p,o[1]=a;else a=o[1];let A=a,f;if(o[2]===b)f=()=>{x(!1)},o[2]=f;else f=o[2];let y=f,E;if(o[3]===b)E=()=>{x(!0)},o[3]=E;else E=o[3];let R=E,S;if(o[4]===b)S=e(n,{dimColor:!0,children:"We'll create a workflow file in your repository for each one you select."}),o[4]=S;else S=o[4];let N;if(o[5]===b)N=r(s,{flexDirection:"column",children:[S,r(n,{dimColor:!0,children:["More workflow examples (issue triage, CI fixes, etc.) at:"," ",e(vt,{url:"https://github.com/anthropics/claude-code-action/blob/main/examples/",children:"https://github.com/anthropics/claude-code-action/blob/main/examples/"})]})]}),o[5]=N;else N=o[5];let W;if(o[6]===b)W=_t.map(Uo),o[6]=W;else W=o[6];let v;if(o[7]!==k||o[8]!==A)v=e(TP,{options:W,defaultValue:k,onSubmit:A,onChange:y,onCancel:R,hideIndexes:!0}),o[7]=k,o[8]=A,o[9]=v;else v=o[9];let G;if(o[10]!==m)G=m&&e(s,{children:e(n,{color:"error",children:"You must select at least one workflow to continue"})}),o[10]=m,o[11]=G;else G=o[11];let D;if(o[12]!==v||o[13]!==G)D=r(he,{title:"Install GitHub App",subtitle:"Select GitHub workflows to install",onCancel:R,exitOnCtrlCD:!0,inputGuide:bt,children:[N,v,G]}),o[12]=v,o[13]=G,o[14]=D;else D=o[14];return D}var St="Add Claude Code GitHub Workflow",ae="https://github.com/anthropics/claude-code-action/blob/main/docs/setup.md",xt="https://code.claude.com/docs/en/gitlab-ci-cd",At=`name: Claude Code

on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]
  issues:
    types: [opened, assigned]
  pull_request_review:
    types: [submitted]

jobs:
  claude:
    if: |
      (github.event_name == 'issue_comment' && contains(github.event.comment.body, '@claude')) ||
      (github.event_name == 'pull_request_review_comment' && contains(github.event.comment.body, '@claude')) ||
      (github.event_name == 'pull_request_review' && contains(github.event.review.body, '@claude')) ||
      (github.event_name == 'issues' && (contains(github.event.issue.body, '@claude') || contains(github.event.issue.title, '@claude')))
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: read
      issues: read
      id-token: write
      actions: read # Required for Claude to read CI results on PRs
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - name: Run Claude Code
        id: claude
        uses: anthropics/claude-code-action@v1
        with:
          anthropic_api_key: \${{ secrets.ANTHROPIC_API_KEY }}

          # This is an optional setting that allows Claude to read CI results on PRs
          additional_permissions: |
            actions: read

          # Optional: Give a custom prompt to Claude. If this is not specified, Claude will perform the instructions specified in the comment that tagged it.
          # prompt: 'Update the pull request description to include a summary of changes.'

          # Optional: Add claude_args to customize behavior and configuration
          # See https://github.com/anthropics/claude-code-action/blob/main/docs/usage.md
          # or https://code.claude.com/docs/en/cli-reference for available options
          # claude_args: '--allowed-tools Bash(gh pr *)'

`,Rt=`## \uD83E\uDD16 Installing Claude Code GitHub App

This PR adds a GitHub Actions workflow that enables Claude Code integration in our repository.

### What is Claude Code?

[Claude Code](https://claude.com/claude-code) is an AI coding agent that can help with:
- Bug fixes and improvements  
- Documentation updates
- Implementing new features
- Code reviews and suggestions
- Writing tests
- And more!

### How it works

Once this PR is merged, we'll be able to interact with Claude by mentioning @claude in a pull request or issue comment.
Once the workflow is triggered, Claude will analyze the comment and surrounding context, and execute on the request in a GitHub action.

### Important Notes

- **This workflow won't take effect until this PR is merged**
- **@claude mentions won't work until after the merge is complete**
- The workflow runs automatically whenever Claude is mentioned in PR or issue comments
- Claude gets access to the entire PR or issue context including files, diffs, and previous comments

### Security

- Our Anthropic API key is securely stored as a GitHub Actions secret
- Only users with write access to the repository can trigger the workflow
- All Claude runs are stored in the GitHub Actions run history
- Claude's default tools are limited to reading/writing files and interacting with our repo by creating comments, branches, and commits.
- We can add more allowed tools by adding them to the workflow file like:

\`\`\`
allowed_tools: Bash(npm install),Bash(npm run build),Bash(npm run lint),Bash(npm run test)
\`\`\`

There's more information in the [Claude Code action repo](https://github.com/anthropics/claude-code-action).

After merging this PR, let's try mentioning @claude in a comment on any PR to get started!`,Ot=`name: Claude Code Review

on:
  pull_request:
    types: [opened, synchronize, ready_for_review, reopened]
    # Optional: Only run on specific file changes
    # paths:
    #   - "src/**/*.ts"
    #   - "src/**/*.tsx"
    #   - "src/**/*.js"
    #   - "src/**/*.jsx"

jobs:
  claude-review:
    # Optional: Filter by PR author
    # if: |
    #   github.event.pull_request.user.login == 'external-contributor' ||
    #   github.event.pull_request.user.login == 'new-developer' ||
    #   github.event.pull_request.author_association == 'FIRST_TIME_CONTRIBUTOR'

    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: read
      issues: read
      id-token: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - name: Run Claude Code Review
        id: claude-review
        uses: anthropics/claude-code-action@v1
        with:
          anthropic_api_key: \${{ secrets.ANTHROPIC_API_KEY }}
          plugin_marketplaces: 'https://github.com/anthropics/claude-code.git'
          plugins: 'code-review@claude-code-plugins'
          prompt: '/code-review:code-review --comment \${{ github.repository }}/pull/\${{ github.event.pull_request.number }}'
          claude_args: '--allowedTools "mcp__github_inline_comment__create_inline_comment"'
          # See https://github.com/anthropics/claude-code-action/blob/main/docs/usage.md
          # or https://code.claude.com/docs/en/cli-reference for available options


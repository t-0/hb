ernal use only",id:"xg5Va4c/VJ"}),description:{short:Ee.shortDescription(Se.msg({defaultMessage:"Single line, truncated on overflow. Maximum 200 characters.",id:"47aHGyWFid"}),{docsOnly:!1})},predicates:{show:md,required:md}}),backgroundColor:Ee.subfield(Yt.z.string().optional(),{label:Se.msg({defaultMessage:"Background color",id:"CMansqNBPw"}),control:"color",default:gm.BANNER_DEFAULT_BACKGROUND_COLOR,placeholder:Se.msg({defaultMessage:"#F5F5F5",description:"Default hex color value \u2014 DO NOT TRANSLATE",id:"oqBUnTcd78"}),description:{short:Ee.shortDescription(Se.msg({defaultMessage:"Six-digit hex (#RRGGBB). Applied exactly as configured; not theme-adapted.",id:"WbM+LbvT9p"}),{docsOnly:!1})},predicates:{show:md}}),textColor:Ee.subfield(Yt.z.string().optional(),{label:Se.msg({defaultMessage:"Text color",id:"jGi3Y4Pu/z"}),control:"color",default:gm.BANNER_DEFAULT_TEXT_COLOR,placeholder:Se.msg({defaultMessage:"#000000",description:"Default hex color value \u2014 DO NOT TRANSLATE",id:"mMxRbpUjV1"}),description:{short:Ee.shortDescription(Se.msg({defaultMessage:"Six-digit hex (#RRGGBB). Applied exactly as configured; not theme-adapted.",id:"WbM+LbvT9p"}),{docsOnly:!1})},predicates:{show:md}}),linkUrl:Ee.subfield(Yt.z.string().optional(),{label:Se.msg({defaultMessage:"Link URL",id:"1e9zwhbnvk"}),placeholder:Se.msg({defaultMessage:"https://intranet.example.com/usage-policy",id:"7U5OZwbVj5"}),description:{short:Ee.shortDescription(Se.msg({defaultMessage:"Optional HTTPS URL. The banner text becomes a link when set.",id:"HuIg1+BeMP"}),{docsOnly:!1})},mono:!0,predicates:{show:md}})});var Vue=(e)=>Boolean(e.url||e.oauthIssuer||e.oauthClientId),mm={show:()=>!1},Kv={requiresUserConsent:!0},que=Oj.ORG_UUID_VALUE.catch(void 0);function Gue(e){return(e===null||e===void 0?void 0:e.enabled)===!0&&e.allowedOrganizationUuids===void 0}function Wue(e,t){let n=e===null||e===void 0?void 0:e.allowedOrganizationUuids;return n===void 0||t!==void 0&&n.includes(t.toLowerCase())}function Sj(e){
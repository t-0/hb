der:-9.9,placeholder:A.msg({defaultMessage:"C:\\Program Files\\Corp\\cred-helper.exe",id:"xUm3tL647e"}),description:{short:P.shortDescription(A.msg({defaultMessage:"Absolute path of the helper executable on Windows devices, used there instead of Helper script. Leave unset to use Helper script on every operating system.",id:"/E7aYcf6cf"})),long:P.longDescription("When one configuration serves both Windows and macOS or Linux devices, set **Helper script** to the macOS/Linux path and this to the Windows path (`C:\\...` or `C:/...`). Windows devices run this executable with the same arguments, timeout, TTL and environment as **Helper script**; macOS and Linux devices ignore it. An invalid value here stops the connection on Windows devices only. Desktop releases that predate this setting ignore it and run **Helper script** on every operating system.")},predicates:{show:(e)=>Boolean(pe.credentialHelperCommandOf(e))}}),args:P.field(P.annotate(B.z.array(zn.safeHelperArg),{maxItems:32}).optional(),{flatKey:"inferenceCredentialHelperArgs",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"2.110.0"}},remotePolicy:{requiresUserConsent:!0},selectsConnection:!0,title:A.msg({defaultMessage:"Helper script arguments",id:"3FLCLSsNxv"}),category:"connection",group:pe.HELPER_SCRIPT_GROUP,order:-9.5,mono:!0,control:"json",placeholder:A.msg({defaultMessage:'["--environment", "production"]',id:"ymzVVGWwhS"}),description:{short:P.shortDescription(A.msg({defaultMessage:"Arguments passed to the helper script, one per entry, in order. Leave unset to run it with none.",id:"1gCf5ARH90"})),long:P.longDescription('Each entry reaches the executable as one argument, exactly as written: `["--environment", "production"]` runs `helper --environment production`. Use it to keep one installed script and let the configuration each user receives decide what it does (which environment, tenant or vault to read), instead of packaging a script per case.\n\nEntries may not be empty and may not contain a double quote (`"`), a percent sign (`%`) or control characters, on any platform: a Windows `.cmd`/`.bat` helper receives its arguments through `cmd.exe`, where those characters would change the command. A `.cmd`/`.bat` script sees each argument quoted (`%1` is `"production"`, `%~1` strips the quotes); `.ps1`, `.exe` and POSIX helpers receive them bare. Arguments are visible in the diagnostic report and to other processes on the machine, so do not put secrets in them; the helper exists to fetch the secret.\n\nA changed list takes effect the way a changed path does.')},predicates:{show:(e)=>Boolean(pe.credentialHelperCommandOf(e))}}),ttlSec:Vae,timeoutSec:qae,silentRefreshEnabled:Gae};var rD={kind:B.z.literal("helper-script"),...uD.helperScriptLeaves,awsEnv:Qae.optional()};uD.HelperScriptCreds=B.z.object(rD);var Zh=(e)=>P.annotate(e,{remotePolicy:{hybrid:{scope:"excluded"}}});uD.GATEWAY_AUTH_SCHEME_SSO={path:'inferenceGatewayAuthScheme: "sso"',use:'inferenceCredentialKind: "interactive"',effect:"the original spelling will keep working; no end date has been set",match:(e)=>e==="sso",rewrite:()=>{return}};uD.GATEWAY_AUTH_SCHEME_AUTO={path:'inferenceGatewayAuthScheme: "auto"',use:'"bearer" (or remove the key \u2014 bearer is the default)',effect:'the value will be reported as invalid and ignored like any unrecognised scheme; the key will then take its default, "bearer", so the credential will still be sent as an Authorization: Bearer header',..._i.BATCH_2026_09,match:(e)=>e==="auto",rewrite:()=>"bearer"};var iD=(e,t)=>(e===null||e===void 0?void 0:e.bearerTokenType)==="access_token"&&!(e.resource&&!t)&&!zn.scopesIncludeResourceScope(e.scopes),ele=(e)=>typeof e.inferenceProvider==="string"?e.inferenceProvider:void 0,ia=(e)=>e!==void 0&&e!==null&&(typeof e!=="string"||e.trim()!=="");uD.VERTEX_OAUTH_CREDENTIAL_KIND={path:'inferenceCredentialKind: "oauth" (Vertex AI)',use:'"interactive" \u2014 the same Google sign-in under its new name (in hosted or nested documents, switch once every desktop is on a release that knows the Vertex "interactive" kind)',effect:'"oauth" will no longer be a Vertex AI credential kind: the value will be reported as invalid and ignored \u2014 the device will then derive the kind from the credential fields present (Google sign-in when an OAuth client id is set), and the hosted editor will refuse to save the configuration until the kind is changed',..._i.BATCH_2026_09,match:(e,t)=>typeof e==="string"&&oa.legacyCredentialKindAlias(ele(t),e)!==void 0};uD.VERTEX_INTERACTIVE_WITH_AUDIENCE={path:'inferenceCredentialKind: "interactive" together with inferenceVertexWorkforceAudience (Vertex AI)',use:'"workforce" \u2014 or remove inferenceVertexWorkforceAudience if Google sign-in ("interactive") is what is meant',effect:'the audience will no longer imply Workforce Identity: the kind will stay "interactive" (Google sign-in), which needs inferenceVertexOAuthClientId \u2014 without it the configuration will be reported as incomplete and inference will not start',..._i.BATCH_2026_09,match:(e,t)=>t.inferenceProvider==="vertex"&&typeof e==="string"&&(e==="interactive"||oa.legacyCredentialKindAlias("vertex",e)==="interactive")&&ia(t.inferenceVertexWorkforceAudience)&&!ia(t.inferenceVertexOAuthClientId)};var oD=P.field(B.z.preprocess((e)=>_i.applyLegacy(uD.GATEWAY_AUTH_SCHEME_SSO,_i.applyLegacy(uD.GATEWAY_AUTH_SCHEME_AUTO,e)),B.z.enum(["bearer","x-api-key"])).optional(),{flatKey:"inferenceGatewayAuthScheme",readers:["desktop","m365","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.3036.0"},executionTarget:"desktop"},title:A.msg({defaultMessage:"Gateway auth scheme",id:"tmwK1KjFte"}),deprecations:[uD.GATEWAY_AUTH_SCHEME_SSO,uD.GATEWAY_AUTH_SCHEME_AUTO],default:"bearer",category:"connection",predicates:{show:(e)=>{var t,n;let i=(n=(t=e.inference)===null||t===void 0?void 0:t.credential)===null||n===void 0?void 0:n.kind;return i==="static"||i==="helper-script"}},description:{short:P.shortDescription(A.msg({defaultMessage:"How the gateway credential is sent on the wire (Authorization: Bearer vs x-api-key header).",id:"WsT/E/qNoC"}))}}),tle=Zh(B.z.object({kind:B.z.literal("static"),apiKey:P.field(P.annotate(B.z.string().optional(),{redact:"drop"}),{flatKey:"inferenceGatewayApiKey",readers:["desktop","m365"],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"},executionTarget:"desktop"},title:A.msg({defaultMessage:"Gateway API key",id:"NA4SBfPMeA"}),category:"connection",predicates:{required:(e)=>!pe.hasActiveBootstrap(e)},description:{short:P.shortDescription(A.msg({defaultMessage:"API key for the configured inference gateway.",id:"InfGatewayApiKeyHint"}),{docsOnly:!0})}}),authScheme:oD})),nle=B.z.object({...rD,authScheme:oD});function av(e){let t=e.setupNotesKey!==e.oidcKey;return P.longDescription(`- **\`browser\`** (default) \u2014 opens the system browser for an authorization-code (PKCE) sign-in on a loopback redirect URI. See the **IdP setup** notes on \`${e.setupNotesKey}\` for redirect-URI registration${t?"; the same rules apply here":""}.
`+`- **\`broker\`** \u2014 signs in through the OS identity broker (Web Account Manager on Windows, Company Portal on macOS). Requires the ${e.idp} to be **Microsoft Entra ID** \u2014 the \`issuer\` on \`${e.oidcKey}\` must be \`https://login.microsoftonline.com/{tenant-id}/v2.0\`. The broker satisfies Conditional Access policies that require a compliant/managed device or token protection, and needs no loopback redirect. The Entra app registration must include the broker redirect URIs \`ms-appx-web://Microsoft.AAD.BrokerPlugin/{client-id}\` (Windows) and \`msauth.com.anthropic.claudefordesktop://auth\` (macOS) under the **Mobile and desktop applications** platform. Not supported on Linux.`+(e.trailing===void 0?"":`

${e.trailing}`))}uD.idpSignInShape={authFlow:P.field(B.z.enum(["browser","broker"]).optional(),{flatKey:"inferenceIdpAuthFlow",support:{enabled:{scopes:["3p"],availableInVersion:"2.7032.0"}},title:A.msg({defaultMessage:"Identity provider sign-in flow",id:"InfIdpAuthFlow"}),category:"connection",notAPresenceSignal:!0,description:{short:P.shortDescription(A.msg({defaultMessage:"How the identity-provider sign-in runs: system browser (default) or the OS Microsoft Entra broker.",id:"InfIdpAuthFlowShort"})),long:av({oidcKey:"inferenceIdpOidc",setupNotesKey:"inferenceIdpOidc",idp:"IdP",trailing:"Broker mode mints a token in the customer's own Entra tenant with the customer-configured `scopes` and forwards it to the customer's own gateway or proxy; both endpoints of that trust relationship are inside the customer's control."})}}),oidc:P.field(zn.GatewayOidc.optional(),{flatKey:"inferenceIdpOidc",support:{enabled:{scopes:["3p"],availableInVersion:"2.7032.0"}},remotePolicy:{requiresUserConsent:!0},selectsConnection:!0,title:A.msg({defaultMessage:"Identity provider (OIDC)",id:"InfIdpOidc"}),predicates:{required:(e)=>!pe.hasActiveBootstrap(e),warn:(e,t)=>{var n;return iD(e,t!==void 0&&pe.credentialKindOf(t)==="external-idp"&&((n=pe.activeCredentialOf(t))===null||n===void 0?void 0:n.authFlow)==="broker")?A.msg({defaultMessage:"No API resource scope set. On IdPs where the requested scopes decide the access-token audience (e.g. Entra ID), this yields a token for the IdP\u2019s own APIs, not your gateway or proxy. Add its API scope (Entra: api://APP_ID/.default). Ignore this if your IdP sets the token audience out-of-band (Keycloak audience mapper, Auth0 default audience, Okta custom-AS audience).",id:"IdpScopeNoResourceWarn"}):null}},egressRequirements:(e,t)=>pe.credentialKindOf(t)==="external-idp"?pe.oidcEgressHosts(e):[],egressRequirementsLabel:A.msg({defaultMessage:"Identity provider (OIDC) sign-in hosts",id:"InfIdpOidcEgress"}),category:"connection",description:{short:P.shortDescription(A.msg({defaultMessage:"Your organization\u2019s OpenID Connect identity provider. The user\u2019s token is sent as the Bearer credential to the gateway or the Bedrock proxy.",id:"InfIdpOidcShort"})),long:P.longDescription('Used with `inferenceCredentialKind: "external-idp"`. The app discovers `<issuer>/.well-known/openid-configuration`, runs an OIDC authorization-code (PKCE) sign-in in the browser with `clientId` (or through the OS broker, see `inferenceIdpAuthFlow`) and sends the token as `Authorization: Bearer` on every inference request: to `inferenceGatewayBaseUrl` on the gateway provider, or on Bedrock to `inferenceBedrockBaseUrl`, which is then required: only a proxy that validates the token accepts it, never Amazon Bedrock itself (to sign in straight to Bedrock use `interactive`, AWS IAM Identity Center). On Bedrock this kind has no model discovery: list the models in `inferenceModels`.\n\n**Bearer token type.** `id_token` (the default) sends the OIDC ID token; the receiver validates signature, `iss` and `aud` (the `clientId` here). `access_token` sends the OAuth access token, for gateways and proxies that validate as an OAuth resource server; `scopes` must then name the registered API scope. Either way the receiver must check `aud`, or it accepts any token from your tenant.\n\n**IdP setup.** The callback is `http://127.0.0.1:<port>/callback` (`localhost` with `redirectHost: "localhost"`); register exactly that. **Entra:** a public-client app with a *Mobile and desktop applications* redirect URI `http://127.0.0.1/callback` (omitting the path fails with `AADSTS50011`); in `access_token` mode also grant the API\'s delegated permission, or sign-in fails with `AADSTS65001`. **Okta:** a *Native* app with `http://127.0.0.1:<port>/callback` and that port in `redirectPort`.\n\n**Refresh.** With `offline_access` the app renews the token silently and asks for a browser sign-in only when refresh fails (Google returns no `id_token` on refresh, so `id_token` mode there re-prompts about hourly).\n\n**Older names.** Gateway configurations written before this key use `inferenceGatewayOidc` / `inferenceGatewayOidcAuthFlow` with the `interactive` kind; they stay readable and mean the same sign-in.',{docsUrl:`${pe.COWORK_3P_DOCS_BASE}/configuration#inferenceidpoidc`})}})};var sD=B.z.object({kind:B.z.literal("external-idp"),...uD.idpSignInShape}),lv=uD.idpSignInShape;uD.IDP_OIDC_FLAT_KEY=(nv=P.fieldMetaForNode(lv.oidc))===null||nv===void 0?void 0:nv.flatKey;uD.IDP_AUTH_FLOW_FLAT_KEY=(rv=P.fieldMetaForNode(lv.authFlow))===null||rv===void 0?void 0:rv.flatKey;var aD=(e,t)=>uD.IDP_OIDC_FLAT_KEY!==void 0&&t.inferenceProvider==="gateway"&&ia(e)&&(!ia(t.inferenceCredentialKind)||t.inferenceCredentialKind==="interactive"||t.inferenceCredentialKind==="external-idp");uD.GATEWAY_IDP_OIDC_KEY={path:"inferenceGatewayOidc",use:`${uD.IDP_OIDC_FLAT_KEY} with inferenceCredentialKind: "external-idp" once every desktop in the fleet is on a release that reads them`,effect:"the original spelling will keep working; no end date has been set",editorPreserves:!0,match:aD};uD.GATEWAY_IDP_AUTH_FLOW_KEY={path:"inferenceGatewayOidcAuthFlow",use:`${uD.IDP_AUTH_FLOW_FLAT_KEY} together with ${uD.IDP_OIDC_FLAT_KEY} once every desktop in the fleet is on a release that reads them`,effect:"the original spelling will keep working; no end date has been set",editorPreserves:!0,match:(e,t)=>aD(e,t)&&(ia(t.inferenceGatewayOidc)||uD.IDP_OIDC_FLAT_KEY!==void 0&&ia(t[uD.IDP_OIDC_FLAT_KEY]))};uD.GATEWAY_INTERACTIVE_WITH_IDP={path:'inferenceCredentialKind: "interactive" together with inferenceGatewayOidc (gateway)',use:'"external-idp" once every desktop in the fleet is on a release that reads it',effect:'the original spelling will keep working ("interactive" with inferenceGatewayOidc is read as "external-idp"); no end date has been set',editorPreserves:!0,match:(e,t)=>uD.IDP_OIDC_FLAT_KEY!==void 0&&t.inferenceProvider==="gateway"&&e==="interactive"&&(ia(t.inferenceGatewayOidc)||ia(t[uD.IDP_OIDC_FLAT_KEY]))};function rle(){let e=P.fieldMetaForNode(lv.oidc);return e!==void 0&&P.isReleasedFor3p(e)}function ile(){return uD.IDP_OIDC_FLAT_KEY===void 0||uD.IDP_AUTH_FLOW_FLAT_KEY===void 0?[]:[[uD.GATEWAY_IDP_OIDC_KEY.path,uD.IDP_OIDC_FLAT_KEY],[uD.GATEWAY_IDP_AUTH_FLOW_KEY.path,uD.IDP_AUTH_FLOW_FLAT_KEY]]}function ole(e){if(uD.IDP_OIDC_FLAT_KEY!==void 0&&e===uD.IDP_OIDC_FLAT_KEY)return uD.GATEWAY_IDP_OIDC_KEY.path;if(uD.IDP_AUTH_FLOW_FLAT_KEY!==void 0&&e===uD.IDP_AUTH_FLOW_FLAT_KEY)return uD.GATEWAY_IDP_AUTH_FLOW_KEY.path;return}var sle=(e)=>uD.IDP_OIDC_FLAT_KEY===void 0?[]:[e];uD.whereIdpKeysExist=sle;var ale=B.z.discriminatedUnion("kind",[tle,B.z.object({kind:B.z.literal("interactive"),authFlow:P.field(B.z.enum(["browser","broker"]).optional(),{flatKey:"inferenceGatewayOidcAuthFlow",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.25927.0"},executionTarget:"desktop"},title:A.msg({defaultMessage:"Gateway sign-in flow",id:"InfGatewayOidcAuthFlow"}),deprecations:uD.whereIdpKeysExist(uD.GATEWAY_IDP_AUTH_FLOW_KEY),category:"connection",notAPresenceSignal:!0,description:{short:P.shortDescription(A.msg({defaultMessage:"How the IdP sign-in runs: system browser (default) or the OS Microsoft Entra broker.",id:"InfGatewayOidcAuthFlowShort"})),long:av({oidcKey:"inferenceGatewayOidc",setupNotesKey:"inferenceGatewayOidc",idp:"IdP",trailing:"Broker mode mints a token in the customer's own Entra tenant with the customer-configured `scopes`, and forwards it to the customer's own gateway; both endpoints of that trust relationship are inside the customer's control. A desktop that has the `external-idp` kind reads this key, together with `inferenceGatewayOidc`, as that kind's sign-in flow; it stays readable."})}}),oidc:P.field(zn.GatewayOidc.optional(),{flatKey:"inferenceGatewayOidc",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.6889.0"},executionTarget:"desktop"},remotePolicy:{requiresUserConsent:!0},selectsConnection:!0,title:A.msg({defaultMessage:"Gateway SSO IdP (OIDC)",id:"FcISn6aVjf"}),deprecations:uD.whereIdpKeysExist(uD.GATEWAY_IDP_OIDC_KEY),predicates:{warn:(e,t)=>{var n,i;return iD(e,((n=t===null||t===void 0?void 0:t.inference)===null||n===void 0?void 0:n.provider)==="gateway"&&((i=t.inference.credential)===null||i===void 0?void 0:i.kind)==="interactive"&&t.inference.credential.authFlow==="broker")?A.msg({defaultMessage:"No API resource scope set. On IdPs where the requested scopes decide the access-token audience (e.g. Entra ID), this yields a token for the IdP\u2019s own APIs \u2014 not your gateway. Add the gateway\u2019s API scope (Entra: api://GATEWAY_APP_ID/.default). Ignore this if your IdP sets the token audience out-of-band (Keycloak audience mapper, Auth0 default audience, Okta custom-AS audience).",id:"GwScopeNoResourceWarn"}):null}},egressRequirements:(e,t)=>{var n,i;return((n=t.inference)===null||n===void 0?void 0:n.provider)==="gateway"&&((i=t.inference.credential)===null||i===void 0?void 0:i.kind)==="interactive"?pe.oidcEgressHosts(e):[]},egressRequirementsLabel:A.msg({defaultMessage:"Gateway sign-in (OIDC)",id:"L+geN0DrtO"}),category:"connection",description:{short:P.shortDescription(A.msg({defaultMessage:"External IdP for gateway sign-in. The user\u2019s token from this issuer is sent to the gateway as the Bearer credential.",id:"pRQIKI2d3D"})),long:P.longDescription("**External IdP mode.** The app discovers `<issuer>/.well-known/openid-configuration`, runs an OIDC authorization-code-with-PKCE sign-in in the system browser with `clientId`, and sends the resulting token as `Authorization: Bearer` on every inference request. Leave this unset for a gateway that hosts its own RFC 8414 metadata at `<baseUrl>/.well-known/oauth-authorization-server`. A desktop that has the `external-idp` kind reads this block as that kind's identity-provider key; it stays readable, so a fleet keeps this spelling until every desktop is on such a release.\n\n**Bearer token type.** `id_token` (the default) sends the OIDC ID token; the gateway validates signature, `iss`, and `aud` (the `clientId` configured here). `access_token` sends the OAuth access token, for gateways that validate as a resource server (Portkey, Kong, Envoy JWT filter, AWS API Gateway authorizers); `scopes` must then name the gateway's registered API scope. Either way the gateway must check `aud`, not just signature and issuer, or it accepts any token from your tenant.\n\n**IdP setup.** The callback is `http://127.0.0.1:<port>/callback` by default (`http://localhost:<port>/callback` with `redirectHost: \"localhost\"`); register exactly the one you use and include `/callback`. **Entra:** a public-client app with a *Mobile and desktop applications* redirect URI of `http://127.0.0.1/callback` (any port; omitting the path fails with `AADSTS50011`); in `access_token` mode also grant the gateway API's delegated permission, or sign-in fails with `AADSTS65001`. **Okta:** a *Native* app with the exact URI `http://127.0.0.1:<port>/callback` and that port in `redirectPort`.\n\n**Refresh.** With `offline_access` the app renews the token silently and prompts a browser sign-in only when refresh fails. Google never returns an `id_token` on refresh, so a Google Workspace-backed gateway in `id_token` mode re-prompts about hourly; `access_token` mode is unaffected.",{docsUrl:`${pe.COWORK_3P_DOCS_BASE}/gateway#single-sign-on-with-your-identity-provider`})}})}),sD,nle]),lle=B.z.object({provider:B.z.literal("gateway"),baseUrl:P.field(P.annotate(zn.httpsUrl.optional(),{redact:"hostname"}),{flatKey:"inferenceGatewayBaseUrl",readers:["desktop","m365","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"},executionTarget:"desktop"},remotePolicy:{...Kh,originPinned:{carries:"server-issued-credential"}},title:A.msg({defaultMessage:"Gateway base URL",id:"JQs8c3pGcl"}),egressRequirements:(e,t)=>{var n;return((n=t.inference)===null||n===void 0?void 0:n.provider)==="gateway"?pe.singleHostEgress(e):[]},category:"connection",predicates:{required:(e)=>!pe.hasActiveBootstrap(e)},placeholder:A.msg({defaultMessage:"https://llm-gateway.example.com",id:"we1m4ZIlaP"}),description:{short:P.shortDescription(A.msg({defaultMessage:"Full URL of the inference gateway endpoint.",id:"6cmRKZgiFv"}))}}),streamIdleTimeoutSec:P.field(B.z.coerce.number().int().min(300).max(1800).optional(),{flatKey:"inferenceStreamIdleTimeoutSec",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.44121.1"},executionTarget:"desktop"},title:A.msg({defaultMessage:"Stream idle timeout",id:"1zaCZqzDhD"}),category:"connection",order:85,suffix:A.msg({defaultMessage:"seconds",id:"8TQoLRh7Ea"}),placeholder:A.msg({defaultMessage:"300",id:"ady/daA2aj"}),description:{short:P.shortDescription(A.msg({defaultMessage:"Extra seconds to wait for model output on a streaming response that is sending only keep-alive pings. Gateway provider only. Default 300.",id:"vVjD8kgAio"})),long:P.longDescription("Raises how long Cowork, Chat and Code sessions wait for the next model event on an open streaming response (Claude Code's `CLAUDE_STREAM_IDLE_TIMEOUT_MS`). It only helps when the gateway writes SSE keep-alive `ping` events (or `:` comment lines) into the response while the upstream model is silent \u2014 for example a LiteLLM proxy with keep-alive pings enabled in front of Amazon Bedrock. With pings arriving, Claude Code accepts at least about five minutes of keep-alives and then waits this many seconds more for real model output before abandoning the request. Gateway provider only; the other providers keep Claude Code's defaults.\n\nA response on which nothing at all arrives \u2014 no pings \u2014 still fails after about 5 minutes regardless of this key, because at the device a silent connection cannot be told apart from a dead one. If long generations fail behind a gateway that does not send pings, configure the gateway to send them rather than raising this value. A common case is automatic compaction, in which a session sends its whole conversation in one streaming request and waits for a long summary; when that request fails, the error reads `Prompt is too long \xB7 automatic compaction failed:` followed by the cause. While this key is set, the app's value takes precedence over `CLAUDE_STREAM_IDLE_TIMEOUT_MS` in Claude Code's own managed settings for sessions the app starts; when it is unset, that setting still applies. Values outside 300\u20131800 are rejected at parse time (the error is listed in the diagnostics report) and the default applies.",{docsUrl:`${pe.COWORK_3P_DOCS_BASE}/configuration#inferencestreamidletimeoutsec`})}}),gatewayManagedClaudeCode:P.field(B.z.boolean().optional(),{flatKey:"inferenceGatewayManagedClaudeCode",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"2.9939.2"},executionTarget:"desktop",visibility:"public-undocumented"},title:A.msg({defaultMessage:"Gateway-managed Claude Code",id:"+Mc2p855y7"}),default:!1,failClosedValue:!1,category:"connection",order:86,description:{short:P.shortDescription(A.msg({defaultMessage:"When true, sessions for users signed in through the gateway\u2019s own sign-in run Claude Code in its gateway mode. Gateway provider only. Default false.",id:"YT+I9m2Ho0"})),long:P.longDescription("Set this to `true` to run Claude Code in its gateway mode (`CLAUDE_CODE_USE_GATEWAY`) in Cowork, Chat and Code sessions for users who signed in through the gateway's own sign-in (`inferenceCredentialKind: interactive` with no organization identity provider configured). In gateway mode Claude Code turns off its usage analytics and authenticated calls to Anthropic (the WebFetch tool's hostname-only domain lookup is governed separately by `skipWebFetchPreflight`), and may hide its WebSearch tool. `false` keeps base-URL routing, where those sessions treat the gateway as the Anthropic API at a custom base URL. A change takes effect for sessions started after the next app launch. Other sign-in methods and other providers ignore this key, and in a third-party deployment a `CLAUDE_CODE_USE_GATEWAY` in a user's own environment is ignored for app sessions either way.")}}),...wc,credential:ale.optional()}),cle=B.z.discriminatedUnion("kind",[Zh(B.z.object({kind:B.z.literal("static"),apiKey:P.field(P.annotate(B.z.string().optional(),{redact:"drop"}),{flatKey:"inferenceAnthropicApiKey",support:{enabled:{scopes:["3p"],availableInVersion:"1.8089.0"},executionTarget:"desktop"},title:A.msg({defaultMessage:"Claude API key",id:"5ykkZh9itH"}),category:"connection",placeholder:A.msg({defaultMessage:"sk-ant-\u2026",id:"yWgQU4eQPw"}),predicates:{required:(e)=>!pe.hasActiveBootstrap(e)},description:{short:P.shortDescription(A.msg({defaultMessage:"Leave blank to fetch a key via browser sign-in, or to supply the key via a credential helper.",id:"LqkJ93Y17Y"}))}})})),B.z.object({kind:B.z.literal("interactive")}),uD.HelperScriptCreds]),ule=P.annotate(B.z.object({provider:B.z.literal("anthropic"),...wc,credential:cle.optional()}),{remotePolicy:{hybrid:{scope:"excluded"}}});uD.AwsSigV4Credential=B.z.discriminatedUnion("kind",[B.z.object({kind:B.z.literal("interactive"),ssoStartUrl:P.field(pe.urlWithSchemeCoercion.optional(),{flatKey:"inferenceBedrockSsoStartUrl",support:{enabled:{scopes:["3p"],availableInVersion:"1.6259.0"},executionTarget:"desktop"},remotePolicy:{rejectLoopback:!0,requiresUserConsent:!0},title:A.msg({defaultMessage:"AWS SSO start URL",id:"M1ekod7Ohm"}),category:"connection",predicates:{required:(e)=>!pe.hasActiveBootstrap(e)},placeholder:A.msg({defaultMessage:"https://d-1234567890.awsapps.com/start",id:"RFFH1lyEc7"}),description:{short:P.shortDescription(A.msg({defaultMessage:"Enables in-app AWS sign-in (no AWS CLI needed). Set with the three SSO fields below.",id:"Ahe51s8B/N"}))}}),ssoRegion:P.field(sv.optional(),{flatKey:"inferenceBedrockSsoRegion",support:{enabled:{scopes:["3p"],availableInVersion:"1.6259.0"},execution
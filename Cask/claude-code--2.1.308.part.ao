            <span class="area-name">${li(b.name)}</span>
            <span class="area-count">~${b.session_count} sessions</span>
          </div>
          <div class="area-desc">${li(b.description)}</div>
        </div>
      `).join("")}
    </div>
    `:"",r=s.interaction_style,g=r?.narrative?`
    <h2 id="section-usage">How You Use Claude Code</h2>
    <div class="narrative">
      ${a(r.narrative)}
      ${r.key_pattern?`<div class="key-insight"><strong>Key pattern:</strong> ${li(r.key_pattern)}</div>`:""}
    </div>
    `:"",h=s.what_works,S=h?.impressive_workflows&&h.impressive_workflows.length>0?`
    <h2 id="section-wins">Impressive Things You Did</h2>
    ${h.intro?`<p class="section-intro">${li(h.intro)}</p>`:""}
    <div class="big-wins">
      ${h.impressive_workflows.map((b)=>`
        <div class="big-win">
          <div class="big-win-title">${li(b.title||"")}</div>
          <div class="big-win-desc">${li(b.description||"")}</div>
        </div>
      `).join("")}
    </div>
    `:"",I=s.friction_analysis,T=I?.categories&&I.categories.length>0?`
    <h2 id="section-friction">Where Things Go Wrong</h2>
    ${I.intro?`<p class="section-intro">${li(I.intro)}</p>`:""}
    <div class="friction-categories">
      ${I.categories.map((b)=>`
        <div class="friction-category">
          <div class="friction-title">${li(b.category||"")}</div>
          <div class="friction-desc">${li(b.description||"")}</div>
          ${b.examples?`<ul class="friction-examples">${b.examples.map((k)=>`<li>${li(k)}</li>`).join("")}</ul>`:""}
        </div>
      `).join("")}
    </div>
    `:"",P=s.suggestions,q=P?`
    ${P.claude_md_additions&&P.claude_md_additions.length>0?`
    <h2 id="section-features">Existing CC Features to Try</h2>
    <div class="claude-md-section">
      <h3>Suggested CLAUDE.md Additions</h3>
      <p style="font-size: 12px; color: #64748b; margin-bottom: 12px;">Just copy this into Claude Code to add it to your CLAUDE.md.</p>
      <div class="claude-md-actions">
        <button class="copy-all-btn" onclick="copyAllCheckedClaudeMd()">Copy All Checked</button>
      </div>
      ${P.claude_md_additions.map((b,k)=>`
        <div class="claude-md-item">
          <input type="checkbox" id="cmd-${k}" class="cmd-checkbox" checked data-text="${li(b.prompt_scaffold||b.where||"Add to CLAUDE.md")}\\n\\n${li(b.addition)}">
          <label for="cmd-${k}">
            <code class="cmd-code">${li(b.addition)}</code>
            <button class="copy-btn" onclick="copyCmdItem(${k})">Copy</button>
          </label>
          <div class="cmd-why">${li(b.why)}</div>
        </div>
      `).join("")}
    </div>
    `:""}
    ${P.features_to_try&&P.features_to_try.length>0?`
    <p style="font-size: 13px; color: #64748b; margin-bottom: 12px;">Just copy this into Claude Code and it'll set it up for you.</p>
    <div class="features-section">
      ${P.features_to_try.map((b)=>`
        <div class="feature-card">
          <div class="feature-title">${li(b.feature||"")}</div>
          <div class="feature-oneliner">${li(b.one_liner||"")}</div>
          <div class="feature-why"><strong>Why for you:</strong> ${li(b.why_for_you||"")}</div>
          ${b.example_code?`
          <div class="feature-examples">
            <div class="feature-example">
              <div class="example-code-row">
                <code class="example-code">${li(b.example_code)}</code>
                <button class="copy-btn" onclick="copyText(this)">Copy</button>
              </div>
            </div>
          </div>
          `:""}
        </div>
      `).join("")}
    </div>
    `:""}
    ${P.usage_patterns&&P.usage_patterns.length>0?`
    <h2 id="section-patterns">New Ways to Use Claude Code</h2>
    <p style="font-size: 13px; color: #64748b; margin-bottom: 12px;">Just copy this into Claude Code and it'll walk you through it.</p>
    <div class="patterns-section">
      ${P.usage_patterns.map((b)=>`
        <div class="pattern-card">
          <div class="pattern-title">${li(b.title||"")}</div>
          <div class="pattern-summary">${li(b.suggestion||"")}</div>
          ${b.detail?`<div class="pattern-detail">${li(b.detail)}</div>`:""}
          ${b.copyable_prompt?`
          <div class="copyable-prompt-section">
            <div class="prompt-label">Paste into Claude Code:</div>
            <div class="copyable-prompt-row">
              <code class="copyable-prompt">${li(b.copyable_prompt)}</code>
              <button class="copy-btn" onclick="copyText(this)">Copy</button>
            </div>
          </div>
          `:""}
        </div>
      `).join("")}
    </div>
    `:""}
    `:"",j=s.on_the_horizon,B=j?.opportunities&&j.opportunities.length>0?`
    <h2 id="section-horizon">On the Horizon</h2>
    ${j.intro?`<p class="section-intro">${li(j.intro)}</p>`:""}
    <div class="horizon-section">
      ${j.opportunities.map((b)=>`
        <div class="horizon-card">
          <div class="horizon-title">${li(b.title||"")}</div>
          <div class="horizon-possible">${li(b.whats_possible||"")}</div>

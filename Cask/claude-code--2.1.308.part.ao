uration does not restate it. Deletion stops at the first configuration fetch that carries this value, before it takes effect as configuration at the next relaunch; a device that cannot reach its configuration server deletes nothing.")}})})});var sl=x(function(Wj){Object.defineProperty(Wj,"__esModule",{value:!0});Wj.ManagedConfig=Wj.DISCRIMINATORS=void 0;var vm=fn(),bm=pr(),ds=mt(),xc=pn(),wm=Or(),xj=Fv(),Lj=hd(),Nj=Iv(),Uj=Rj(),zj=Cv(),Fj=xv(),Bj=Dv(),Hj=Zv(),Kj=Qh(),Zj=Yh(),Vj=jj(),nr=Ec(),qj=Mv(),Gj=pd(),ede=ds.field(vm.z.enum(ds.PROVIDERS).optional(),{flatKey:"inferenceProvider",readers:["desktop","m365","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"},values:{mantle:{availableInVersion:"1.13576.0"}},executionTarget:"desktop"},activatesThirdPartyMode:(e,t)=>t||e.inference!==void 0,title:xc.msg({defaultMessage:"Inference provider",id:"QQpUrtO7kr"}),egressRequirements:(e)=>e==="anthropic"?[bm.ANTHROPIC_API_HOST,bm.PLATFORM_CLAUDE_HOST]:[],egressRequirementsLabel:xc.msg({defaultMessage:"Claude API",id:"Fo2tzWOJzu"}),category:"connection",customRenderer:"providerSelect",description:{short:ds.shortDescription(xc.msg({defaultMessage:"Selects the inference backend. Setting this key activates third-party mode.",id:"aRuqK/KXrl"})),long:ds.longDescription("Setting this key asks for 3P mode. The app opens in 3P mode unless the user chose to sign in to Claude.ai at the login screen, a choice `disableDeploymentModeChooser` removes. In 3P mode, if the selected provider's required credential keys are missing or invalid, the app shows a configuration error. A value the app cannot read (a misspelt, wrongly cased or unknown provider, or a value of the wrong type) still counts as set when machine-wide device management sent it: a macOS configuration profile, Windows policy under `HKLM`, or the root-owned policy file on Linux. The app then asks for 3P mode and, in 3P mode, shows a configuration error whose details name this key. An unreadable `bootstrapUrl` from the same sources counts the same way unless `bootstrapEnabled` is `false`. An unreadable value does not count where the user can write it: the local configuration file, or Windows policy under `HKCU`. Neither does an empty value (a value of only spaces is unreadable, not empty), or a Windows value of type `REG_BINARY`, `REG_MULTI_SZ` or `REG_QWORD`. Each of those reads as not set. When this key is not set, the app launches in standard mode unless another setting asks for 3P mode, such as a `bootstrapUrl` that `bootstrapEnabled` has not turned off. Keys for providers other than the selected one are ignored. Each provider's required keys are documented on its dedicated page under Inference providers.")}});Wj.DISCRIMINATORS={inferenceProvider:{node:ede,nestedPath:["inference","provider"],discriminates:"provider"},inferenceCredentialKind:{node:wm.inferenceCredentialKindField,nestedPath:["inference","credential","kind"],discriminates:"credentialKind"}};Wj.ManagedConfig=vm.z.object({inference:ds.annotate(wm.InferenceConfig.optional(),{gatewayServable:!1}),selfHosted:Zj.SelfHostedConfig.optional(),otlp:nr.OtlpConfig.optional(),dictation:nr.DictationConfig.optional(),tokenLimits:nr.TokenLimitsConfig.optional(),coworkSurface:nr.CoworkSurfaceConfig.optional(),codeSurface:nr.CodeSurfaceConfig.optional(),chatSurface:nr.ChatSurfaceConfig.optional(),sessionRetention:Vj.SessionRetentionConfig.optional(),extensions:nr.ExtensionsConfig.optional(),autoUpdate:nr.AutoUpdateConfig.optional(),featureDiscovery:nr.FeatureDiscoveryConfig.optional(),bootstrap:Nj.BootstrapConfig.optional(),lifecycle:zj.LifecycleConfig.optional(),models:Bj.ModelsConfig.optional(),plugins:Kj.PluginsConfig.optional(),telemetry:qj.TelemetryConfig.optional(),mcp:Fj.McpConfig.optional(),workspace:Gj.WorkspaceConfig.optional(),builtinBrowser:Uj.BuiltinBrowserConfig.optional(),authentication:Lj.AuthenticationConfig.optional(),appearance:xj.AppearanceConfig.optional(),...Hj.PASSTHROUGH_FIELDS})});var Om=x(function(X
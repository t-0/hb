sOnly:!1})}}),allowedOrganizationUuids:Ee.subfield(Yt.z.preprocess((e)=>e===null||typeof e==="string"&&e.trim()===""?void 0:e,Ee.annotate(Yt.z.array(que),{maxItems:100}).transform((e)=>e.filter((t)=>t!==void 0)).optional().catch([])),{label:Se.msg({defaultMessage:"Organizations users may import from",id:"JWDj9FZ3tB"}),support:{availableInVersion:"2.26454.0"},placeholder:Se.msg({defaultMessage:'["00000000-0000-0000-0000-000000000000"]',id:"v2GKYTjwD3"}),description:{short:Ee.shortDescription(Se.msg({defaultMessage:"When set, users import by sign-in only, and only from the Claude.ai organizations with these IDs.",id:"YIm8r9KgW7"}),{docsOnly:!1}),long:Ee.longDescription("A list of Claude.ai organization IDs (UUIDs). When set, users can import only by signing in to Claude.ai, and only from an organization on the list: a sign-in to any other organization, or to a personal account, is refused before anything is downloaded. Importing from a file and from earlier sessions on this computer is turned off. The list narrows `enabled` and turns nothing on by itself; `automatic3pImport` is not affected. An entry that is not a UUID allows nothing and is reported. An empty list, or one that cannot be read, allows no organization, so no import is offered; a null or blank value is read as not set. A provisioned sign-in import names no organization, so it is not offered while the list is set. Each import is reported to your OpenTelemetry collector as the event `desktop_claude_ai_import`, with the ID of the organization it came from. It is an info-level event: set `otlpDesktopLogLevel` to `info` to receive it.",{docsOnly:!1})}}),automatic3pImport:Ee.subfield(Yt.z.boolean().optional(),{label:Se.msg({defaultMessage:"Automatically import earlier third-party sessions",id:"c4gImpAuto"}),support:{availableInVersion:"1.40609.0"},description:{short:Ee.shortDescription(Se.msg({defaultMessage:"Copy this computer\u2019s earlier third-party sessions into the app once, in the background. Independent of `enabled`.",id:"dVIH5Gg6O5"}),{docsOnly:!1}),long:Ee.longDescription("Under device-delivered configuration (device management, a configuration file or a bootstrap URL) this runs only when set to `true`; for organizations managed from the Claude admin console (the hosted configuration) it is on unless an admin turns it off there. When the app launches under this organization, it copies this computer's earlier third-party sessions into its session store in the background, with Settings \u2192 Import's importer (originals stay in place). It lists the earlier configuration's Cowork artifacts in this organization. Optional plugins the user had on come back if still offered: those from the organization plugins directory are switched on, and those from an optional `allowedPluginMarketplaces` entry on the gateway's or bootstrap server's own origin are installed again without asking. Plugins the user uploaded (unless `userPluginUploadsEnabled` is off; they can run programs on this computer) and skills they saved (unless `skillCreationEnabled` is off) are installed again without asking, on or off as they were; a skill that declares tools, hooks, metadata or unknown settings arrives off. Other marketplaces' plugins stay behind. Earlier Cowork projects are added, their instructions held until the user accepts them. The user's Cowork memory and global instructions are copied and used at once, unreviewed (no memory if it was paused). Earlier scheduled tasks are added, each on or off as it was: one that was on runs at its next scheduled time. Runs at most once per device under device-delivered configuration and once more after it joins the hosted configuration. Under the hosted configuration it takes sessions from any earlier device configuration (including ones a console sign-in created) but never those stored under another organization's hosted configuration; under device-delivered configuration, only those stored while no organization ID was configured, and only once one is. Turn on `enabled` too so users can import sessions it leaves out by hand.",{docsOnly:!1})}}),exportEnabled:Ee.subfield(Yt.z.boolean().default(!1),{label:Se.msg({defaultMessage:"Enable session export",id:"c4gImpExEn"}),support:{availableInVersion:"1.32352.0"},description:{short:Ee.shortDescription(Se.msg({defaultMessage:"Lets users export this computer\u2019s chats, Cowork tasks, and Code sessions as a zip another install can import. No effect unless `enabled` is true.",id:"c4gImpExSh"}),{docsOnly:!1}),long:Ee.longDescription("Allows users to write this computer's chats, Cowork tasks, and Code sessions to a portable zip that another install can import from Settings > Import. Transcripts contain conversation content including tool outputs; only session-record metadata is projected to a fixed field allowlist. Treat exported zips as sensitive data.",{docsOnly:!1})}}),bannerBehavior:Ee.subfield(Yt.z.enum(["off","detect","show"]).optional().catch(void 0),{label:Se.msg({defaultMessage:"Import prompt banner",id:"c4gImpBnr0"}),support:{availableInVersion:"1.28929.0"},description:{short:Ee.shortDescription(Se.msg({defaultMessage:"Prompt to import on a new chat or task. Off if unset. `show`: always; needs `enabled` or a sign-in import. `detect`: if `enabled` finds earlier Claude sessions.",id:"H9VdpjJA2h"}),{docsOnly:!1})}}),bannerMaxDismissals:Ee.subfield(Yt.z.number().int().min(1).max(10).optional().catch(void 0),{label:Se.msg({defaultMessage:"Import prompt skip limit",id:"qYSrEYqrpG"}),support:{visibility:"public-undocumented",availableInVersion:"2.16120.0"},description:{short:Ee.shortDescription(Se.msg({defaultMessage:"Skips allowed before the import prompt stays hidden: 1 to 10, 1 if unset. It returns 3 days after each skip except the last. An import hides it for good.",id:"IUTVtr/gtN"}))},predicates:mm})};kj.PASSTHROUGH_FIELDS={claudeAiImport:Ee.field(Yt.z.object(Yue).refine((e)=>!Vue(e)||Boolean(e.url&&e.oauthIssuer&&e.oauthClientId),{message:"url, oauthIssuer and oauthClientId are required together (an import endpoint is unusable without all three)"}).optional(),{flatKey:"claudeAiImport",support:{enabled:{scopes:["3p"],availableInVersion:"1.10628.0"}},title:Se.msg({defaultMessage:"Claude.ai data import",id:"c4gImpTitl"}),egressRequirements:(e)=>{let t=Sj(e);if(!t)return[];if(t.arm==="configured")return[t.url,t.oauthIssuer].map(Oi.egressAddress).filter((n)=>!!n);return[Oi.CLAUDE_AI_HOST,Oi.ANTHROPIC_API_HOST,Oi.GCS_SIGNED_URL_HOST]},egressRequirementsLabel:Se.msg({defaultMessage:"Claude.ai data import",id:"c4gImpEgrs"}),category:"connectors",group:Se.msg({defaultMessage:"Claude.ai data import",id:"c4gImpTitl"}),description:{short:Ee.shortDescription(Se.msg({defaultMessage:"Lets users import Claude.ai chats and projects, plus earlier Claude sessions on this computer, when `enabled` is true. `automatic3pImport` is a separate switch.",id:"nsQDRMwvNu"}))}}),banner:Ee.field(Ee.annotate(kj.BannerConfig.optional(),{redact:"keep"}),{flatKey:"banner",remotePolicy:{hotApplied:!0},support:{enabled:{scopes:["1p","3p"],availableInVersion:"1.7196.0"}},title:Se.msg({defaultMessage:"Organization banner",id:"bU34Yscprn"}),category:"appearance",group:Se.msg({defaultMessage:"Organization banner",id:"bU34Yscprn"}),description:{short:Ee.shortDescription(Se.msg({defaultMessage:"A persistent banner across the top of the app window after sign-in.",id:"UQLzOZq7h3"})),long:Ee.longDescription("Use this for compliance notices, an internal-support link, or to identify the deployment. The banner is shown on every page after sign-in and cannot be dismissed by the user. Colors are six-digit hex (`#RRGGBB`); when `linkUrl` is set the banner text becomes an HTTPS link.")}})}});var Rj=x(function(Tj){Object.defineProperty(Tj,"__esModule",{value:!0});Tj.BuiltinBrowserConfig=void 0;var Si=fn(),us=pr(),cn=mt(),Gr=Cn(),Dn=pn(),fa=Li(),Vv=(e)=>{var t;return((t=e.builtinBrowser)===null||t===void 0?void 0:t.enabled)===!0};function Cj(e,t){if(typeof t!=="string"||t==="")return{kind:"drop",why:"dropped: entries must be non-empty strings"};if(e==="allowed"&&t==="*")return{kind:"drop",why:'dropped: set builtinBrowserDefaultDomainPolicy to "allow" to let Claude open every site'};let n=us.parseEgressHostEntry(t);if(n===null)return{kind:"unknown",why:`matches nothing as written: must be ${us.EGRESS_ENTRY_GRAMMAR}`};if(n.host==="localhost")return{kind:"unknown",why:"matches nothing: localhost dev servers are never blocked in the built-in browser"};return}function Aj(e){return(t,n)=>{if(!Array.isArray(t))return;for(let i of t){let r=Cj(e,i);if(r)n(`built-in browser ${e}-sites entry ${JSON.stringify(i)} ${r.why}`,r.kind)}}}var Ij=(e)=>Si.z.preprocess((t)=>Array.isArray(t)?t.filter((n)=>{var i;return((i=Cj(e,n))===null||i===void 0?void 0:i.kind)!=="drop"}):t,cn.annotate(Si.z.array(Si.z.string().min(1)),{maxItems:500})).optional();Tj.BuiltinBrowserConfig=Si.z.object({enabled:cn.field(Si.z.boolean().optional(),{flatKey:"builtinBrowserEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"2.2553.0"},executionTarget:"desktop"},title:Dn.msg({defaultMessage:"Allow the built-in browser",id:"WpkucDWuLT"}),default:!1,remotePolicy:{hybrid:{derived:!0}},egressRequirements:(e)=>e===!0?[us.UPDATE_FEED_HOST]:[],egressRequirementsLabel:Dn.msg({defaultMessage:"Built-in browser (site safety check)",id:"cDGoOjcr2/"}),category:"sandbox",group:fa.BUILTIN_BROWSER_GROUP,order:12,description:{short:cn.shortDescription(Dn.msg({defaultMessage:"Offer the built-in browser in Cowork and Code sessions so users and Claude can open and work with web pages. Site sign-ins stay on the device until cleared.",id:"GP16g9tMfY"})),long:cn.longDescription(`When enabled, Cowork and Code sessions get a built-in browser pane. Users can open any site in it; Claude can open, read, and act on pages with its browser tools once the user approves each site (private-network hosts ask again per action unless the user always allows the host). Pages load directly from the user's machine, so your network controls apply; the pane's sign-ins and cookies stay in the app's browser profile on the device until cleared.

Off (default): no browser pane; Code sessions keep the localhost-only dev-server preview. With \`bootstrapUrl\` set, put this key in the served configuration: a device-profile value alone leaves the browser off. On an install managed from the Claude admin console this follows the console's Built-in browser switch.

When a public site opens or is framed in the pane, and before Claude works with it, the app checks its address (query removed) against Anthropic's site safety list on \`${us.UPDATE_FEED_HOST}\`, signed out, with no account, organization, or device identifier (Claude admin console installs: as the signed-in member on \`api.anthropic.com\`). A site it blocks stays blocked to Claude under every key below. Private addresses, names resolving to them, and internal-suffix or single-label names are never sent (a name under a public domain is checked even if only your VPN resolves it). Allow \`${us.UPDATE_FEED_HOST}\` through your firewall: if a check fails, users can browse but Claude's page tools stay off for that site.

\`builtinBrowserDefaultDomainPolicy\` and its two site lists restrict where Claude may browse. A separately deployed Claude Code [managed-settings](${Gr.COWORK_3P_DOCS_BASE}/code#interaction-with-claude-code%E2%80%99s-own-managed-settings) file still applies: \`disableBrowserExternalNavigation: true\` keeps the browser off even with this key on, and \`browserExternalPageTools: "disabled"\` keeps the pane but turns Claude's page tools off for external sites. Takes effect after the app restarts.`,{docsUrl:`${Gr.COWORK_3P_DOCS_BASE}/configuration#builtinbrowserenabled`})}}),defaultDomainPolicy:cn.field(Si.z.enum(["allow","block"]).optional(),{flatKey:"builtinBrowserDefaultDomainPolicy",support:{enabled:{scopes:["3p"],availableInVersion:"2.2553.0"},executionTarget:"desktop"},title:Dn.msg({defaultMessage:"Default site policy in the built-in browser",id:"UoPPb2U8EW"}),default:"allow",failClosedValue:"block",remotePolicy:{hybrid:{derived:!0},hotApplied:!0},predicates:{show:Vv},optionLabels:{allow:Dn.msg({defaultMessage:"Allow all sites except blocked sites",id:"QKY/9Ra51f"}),block:Dn.msg({defaultMessage:"Block all sites except allowed sites",id:"SyVfZ0jYvT"})},category:"sandbox",group:fa.BUILTIN_BROWSER_GROUP,order:12.2,description:{short:cn.shortDescription(Dn.msg({defaultMessage:"Whether Claude may open sites in the built-in browser by default; the allowed or blocked list is the exception. Mirrors the Claude in Chrome site policy.",id:"+Xd6SuBz42"})),long:cn.longDescription("Applies when `builtinBrowserEnabled` is on, in both Cowork and Code sessions, and decides which sites Claude may open, read, or act on with its browser tools; users can still view any site themselves. `allow` (default): every site except entries in `builtinBrowserBlockedDomains`. `block`: no site except entries in `builtinBrowserAllowedDomains`. Under either policy `coworkEgressAllowedHosts`, when set to anything but `*`, is an outer bound: sites outside it are refused to Claude in the browser too. A site Anthropic's site safety list blocks stays blocked to Claude under either policy (see `builtinBrowserEnabled`); for a site the list only flags for confirmation, Claude asks the user before each of its actions under `allow`, and skips that confirmation only when the site matches a `builtinBrowserAllowedDomains` entry under `block`. A value that cannot be read is treated as `block` until it is fixed.\n\nThe policy also limits what pages load: a page in the pane, including one a user opened, cannot load frames, scripts, images, or other content from a site the policy does not admit (a blocked page a user opens still loads content from its own site). Under `block`, or with a `coworkEgressAllowedHosts` list, include the CDN and API hosts your allowed sites depend on.\n\nThis key and the two site lists work the same way as the Claude in Chrome site policy in the admin console. They are set separately here, except on an install managed from the Claude admin console, where they follow your organization's browser site permissions there.",{docsUrl:`${Gr.COWORK_3P_DOCS_BASE}/configuration#builtinbrowserdefaultdomainpolicy`})}}),allowedDomains:cn.field(Ij("allowed"),{flatKey:"builtinBrowserAllowedDomains",support:{enabled:{scopes:["3p"],availableInVersion:"2.2553.0"},executionTarget:"desktop"},title:Dn.msg({defaultMessage:"Allowed sites in the built-in browser",id:"N0mmi7Llpp"}),failClosedValue:[],checkDropped:Aj("allowed"),remotePolicy:{hybrid:{derived:!0},hotApplied:!0},predicates:{show:Vv},category:"sandbox",group:fa.BUILTIN_BROWSER_GROUP,order:12.4,placeholder:Gr.HOST_LIST_PLACEHOLDER,description:{short:cn.shortDescription(Dn.msg({defaultMessage:"Sites Claude may open, read, and act on in the built-in browser when the default site policy is block. Users can still view other sites.",id:"Jno9aeMAe8"})),long:cn.longDescription("Used when `builtinBrowserDefaultDomainPolicy` is `block`; ignored under `allow`. A site matching an entry is one Claude may open and work with using its browser tools; every other external site is treated as blocked by your organization: Claude cannot open it, cannot read or act on it, and frames, popups, and redirects into it from a page Claude is working on are refused. A user can still type its address and view it themselves. Listing a site here never unblocks a site Anthropic's site safety list blocks (see `builtinBrowserEnabled`); for a site that list only flags for confirmation, an entry here is your organization vouching for it, so Claude works with it without asking before each action.\n\nEntries use the same grammar as `coworkEgressAllowedHosts`, except that bare `*` is dropped: as in Claude in Chrome, no allowed-sites entry opens every site. Set the policy to `allow` for that. A wildcard whose base is a public suffix (`*.co.uk`, `*.github.io`) is likewise ignored so an entry can never open a whole shared registry. Any other entry outside that grammar is kept but matches nothing (the app log and the editor name it); a value that cannot be read at all allows nothing until it is fixed. A plain hostname entry (`example.com`) also covers its `www.` form, and a `www.` entry covers the bare name, but no other subdomain. `localhost` dev servers are always reachable, so listing them changes nothing.\n\nEmpty or unset (default): under `block`, Claude may open no external site. On an install managed from the Claude admin console this follows your organization's browser site permissions there.",{docsUrl:`${Gr.COWORK_3P_DOCS_BASE}/configuration#builtinbrowseralloweddomains`})}}),blockedDomains:cn.field(Ij("blocked"),{flatKey:"builtinBrowserBlockedDomains",support:{enabled:{scopes:["3p"],availableInVersion:"2.2553.0"},executionTarget:"desktop"},title:Dn.msg({defaultMessage:"Blocked sites in the built-in browser",id:"BcwtcpU/GS"}),failClosedValue:["*"],checkDropped:Aj("blocked"),remotePolicy:{hybrid:{derived:!0},hotApplied:!0},predicates:{show:Vv},category:"sandbox",group:fa.BUILTIN_BROWSER_GROUP,order:12.6,placeholder:Gr.HOST_LIST_PLACEHOLDER,description:{short:cn.shortDescription(Dn.msg({defaultMessage:"Sites Claude may not open, read, or act on in the built-in browser when the default site policy is allow. Users can still view them.",id:"FQzOgmWpx1"})),long:cn.longDescription("Used when `builtinBrowserDefaultDomainPolicy` is `allow` (the default); ignored under `block`. A site matching an entry is treated as blocked by your organization: Claude cannot open it, cannot read or act on it with its browser tools, and frames, popups, and redirects into it from a page Claude is working on are refused. A user can still type its address and view it themselves: the pane shows a \"blocked by your organization's policy\" banner and Claude's tools stay off there. To take the external browser away from users as well, deploy Claude Code's `disableBrowserExternalNavigation` managed setting instead. A blocked site is refused before the site safety check, so its address is never sent to Anthropic.\n\nEntries use the same grammar as `coworkEgressAllowedHosts`; `*` blocks every external site. An entry outside that grammar is kept but matches nothing (the app log and the editor name it); a value that cannot be read at all blocks every external site until it is fixed. As in Claude in Chrome, a plain hostname entry (`example.com`) also covers its `www.` form, and a `www.` entry covers the bare name, but no other subdomain. `localhost` dev servers are never affected.\n\nUse this key for exceptions inside an allowed egress wildcard or when egress is open. Empty or unset (default): no sites beyond the egress list are blocked. On an install managed from the Claude admin console this follows your organization's browser site permissions there.",{docsUrl:`${Gr.COWORK_3P_DOCS_BASE}/configuration#builtinbrowserblockeddomains`})}})})});var jj=x(function(Dj){Object.defineProperty(Dj,"__esModule",{value:!0});Dj.SessionRetentionConfig=void 0;var pa=fn(),Hn=mt(),un=pn(),_m=un.msg({defaultMessage:"Session retention",id:"3Pm9sCaKFE"}),qv=un.msg({defaultMessage:"days",id:"Bc20laBenW"}),Gv=()=>pa.z.preprocess((e)=>typeof e==="string"&&e.trim()!==""?Number(e):e,pa.z.number().int().gte(1).lte(3650).optional()),Yv=Hn.longDescription("The app deletes whole sessions in the background shortly after it fetches this configuration (at launch and on each re-poll), or some minutes after launch and then daily when the configuration comes from device management alone. Idle time runs from the session's last activity; viewing an old Code session counts as activity, viewing an old chat or Cowork task without continuing it does not durably. A session that is running or open on screen is skipped and checked again on the next pass, as is a chat or Cowork task whose folder changed on disk within the period. Pinned sessions are not exempt. Minimum 1 day; a value that cannot be read as a whole number of days deletes nothing. Set through the served configuration or in the device-management profile that carries the rest of the configuration. What it does not reach: another account's sessions on the device (evaluated when that account signs in), Code sessions on a remote machine (SSH/WSL), Cowork background (dispatch) tasks the sidebar does not list, a chat or Cowork task whose folder cannot be located, and Claude Code files not named by a session id (prompt history, plans, shell snapshots), which keep Claude Code's own retention. Honored only by Claude Desktop configured for a third-party model provider.");Dj.SessionRetentionConfig=pa.z.object({chatDays:Hn.field(Gv(),{flatKey:"chatSessionRetentionDays",support:{enabled:{scopes:["3p"],availableInVersion:"1.52386.0"}},title:un.msg({defaultMessage:"Chat retention period",id:"Qmc45WB3Fw"}),category:"limits",group:_m,order:0,suffix:qv,placeholder:un.msg({defaultMessage:"90",id:"YrCav22fKE"}),description:{short:Hn.shortDescription(un.msg({defaultMessage:"Delete chats, with their files, after this many days without activity. Unset: kept until the user d
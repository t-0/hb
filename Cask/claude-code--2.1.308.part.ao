        <div class="chart-title">Primary Friction Types</div>
        ${ee(e.friction,"#dc2626")}
      </div>
      <div class="chart-card">
        <div class="chart-title">Inferred Satisfaction (model-estimated)</div>
        ${ee(e.satisfaction,"#eab308",6,Pt)}
      </div>
    </div>

    ${q}

    ${B}

    ${ne}

    ${oe}
  </div>
  <script>${L}</script>

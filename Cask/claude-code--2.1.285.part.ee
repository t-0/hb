sts, see the debug log.","serving_off.bridge_trusted_devices":"This computer's tools are not offered to your cloud session over the device bridge. The bridge cannot check a device's proof, and trusted devices may be required for your organization or could not be checked. Remove the off switch for the session channel from your environment to serve over it instead.","served_settings.changed_while_attached":"This project's Claude Code settings changed while a cloud session was using this computer. The cloud session may have made the change. It is not applied to that session. Review the files before you rely on them.","served_settings.changed_between_attaches":"This project's Claude Code settings changed since a cloud session last used this computer. The cloud session may have made the change. It applies to the session now using this computer. Review the files before you rely on them.","refused.sandbox_custody":"This computer can't run this command inside its sandbox while protecting its credential files (a protected directory could not be prepared). Nothing was run. Ask the user to run it themselves on this computer, or continue without it.","repository_trust.state.trusted":"Repositories trusted","repository_trust.state.no_repository":"No repository attached","repository_trust.state.declined":"Repository trust declined","repository_trust.state.not_marked":"Repositories not marked trusted","repository_trust.prompt.meaning":"Answering yes marks everything attached to this cloud session as trusted, which lets the session act on your computer with your authority. Say yes only if you trust all of it.","repository_trust.prompt.unbound":"This terminal is not the computer this cloud session is bound to, so an answer given here cannot prove which device it came from. Answer on a device that can: claude.ai on the web, the desktop app or the mobile app.","repository_trust.prompt.not_shown_here":"This cloud session is asking whether you trust what is attached to it, but the question cannot be shown in full on this terminal. Answer it in claude.ai on the web, the desktop app or the mobile app; the session waits until you do (esc stops its turn).","repository_trust.folder_waits.required":"Before this session can use a folder on your computer, it needs you to confirm you trust what is attached to it. It asks next.","repository_trust.folder_waits.declined":"This session cannot use a folder on your computer: you declined to trust what is attached to it. Send it a new message if you want it to ask again.","repository_trust.folder_waits.unavailable":"This session cannot use a folder on your computer right now: the service could not read what is attached to it. It can try again.","repository_trust.folder_waits.marker":"(The service's own message to Claude is not shown here; the transcript view shows it.)","repository_trust.served_calls.unattested":"This computer refused a call from the cloud session: the service could not vouch for the call's sender under your organization's trusted-device policy.","repository_trust.served_calls.unattested_untrusted_repo.not_marked":"This computer refused a call from the cloud session: what is attached to it is not marked trusted. If connecting showed you no trust question, use a session with nothing attached or start a new one. If it showed one, answering yes lets the session's calls through. Reconnecting this computer changes nothing.","repository_trust.served_calls.unattested_untrusted_repo":"This computer refused a call from the cloud session: the session's attached repositories were not marked trusted. Answer the session's trust question to let its calls through.","forwarding_off.reason.disabled_switch_off":"running tools there is not turned on for this session's cloud environment","forwarding_off.reason.disabled_flag_off":"running tools there is not enabled for this account","forwarding_off.retracted":"Correction: this session now offers device tools that act on the user's computer, so the earlier note that it cannot run tools there no longer holds for them. When the user asks for something on their computer, use those tools.",forwarding_off(e){return`The user's computer has connected to this cloud session, but this session cannot run tools on it, because ${e}. Do the work in this session's own cloud environment. When the user asks for something on their computer, tell them plainly that this session cannot reach it and why, and that you are working in the cloud environment instead. Do not describe this environment as their computer. Do not retry or look for another route: a tool that only reports information about that computer cannot run anything on it, and if it says the computer is not connected or may be back in a few seconds, this is the cause and waiting will not change it.`},announce_unverified(e){return`The cloud session did not accept the device proof on this machine's requests, so commands meant for this machine are not routed here and the session uses its own environment instead \u2014 ${e}.`}};function UJ(e,{requireStarted:n}){let r=E0(e);if(r!==void 0)return{confined:!1,reason:r};if(!n)return{confined:!0};if(e.started!==!0||e.config===void 0)return{confined:!1,reason:"sandbox_failed_to_start"};let s=jJ(e.config);return s===void 0?{confined:!0}:{confined:!1,reason:s}}function E0(e){if(!e.sandboxingEnabled){if(!e.enabledInSettings)return"sandbox_unavailable";return e.supportedHere?"sandbox_failed_to_start":"sandbox_unsupported"}if(e.filesystemPolicy!=="strict"||e.scrubMode)return"sandbox_unconfined";return}function jJ(e){if(e.weakensIsolation)return"sandbox_weakened";if(e.allowsUnixSockets)return"sandbox_allows_unix_sockets";if(e.injectsCredentials)return"sandbox_injects_credentials";return}function x0(){let e=je.isSandboxingEnabled(),n=je.getConfig();return{sandboxingEnabled:e,enabledInSettings:je.isSandboxEnabledInSettings(),supportedHere:je.passesCheapSandboxGates(),filesystemPolicy:Qk(),scrubMode:td(),...n!==void 0&&{config:{allowsUnixSockets:n.network?.al
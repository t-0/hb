rceAttributes","no custom resource attributes will be attached");fA.OtlpConfig=Me.z.object({endpoint:z.field(z.annotate(zn.urlWithSchemeCoercion.optional(),{redact:"hostname",gatewayServable:!1}),{flatKey:"otlpEndpoint",readers:["desktop","m365"],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},remotePolicy:{rejectLoopback:!0},title:L.msg({defaultMessage:"OpenTelemetry collector endpoint",id:"xovdJlXIM6"}),egressRequirements:(e)=>{let t=Wf.safeHostname(e);return t?[t]:[]},category:"telemetry",group:Fo,order:10,placeholder:L.msg({defaultMessage:"https://otel.example.com",id:"b7vgLij1HS"}),description:{short:z.shortDescription(L.msg({defaultMessage:"Where OpenTelemetry logs and metrics are sent. Leave blank to disable.",id:"Zhe9UuhccO"}))}}),protocol:z.field(z.annotate(Me.z.enum(["http/protobuf","http/json","grpc"]).optional(),{gatewayServable:!1}),{flatKey:"otlpProtocol",readers:["desktop","m365"],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},title:L.msg({defaultMessage:"OpenTelemetry exporter protocol",id:"jETNRIFigw"}),default:"http/protobuf",category:"telemetry",group:Fo,order:11,description:{short:z.shortDescription(L.msg({defaultMessage:"Transport protocol for the OpenTelemetry exporters.",id:"OtlpProtocolHint"})),long:z.longDescription("Code sessions export over the protocol set here. Chats and Cowork tasks export over `http/protobuf` instead of `grpc` on Windows, and on other platforms whenever the Claude Code engine is given an HTTP proxy (the operating system's proxy, `egressProxyUrl` or `egressProxyPacUrl`, or `HTTPS_PROXY` / `HTTP_PROXY` in a Claude Code settings file); the application log notes the substitution. The desktop application's own events always go over `http/json` to `<endpoint>/v1/logs`. None of this changes the endpoint, so choose `grpc` only for a collector that also serves OTLP/HTTP at the same address; otherwise keep `http/protobuf` and point `otlpEndpoint` at the collector's OTLP/HTTP receiver (conventionally port 4318).")},predicates:{show:(e)=>{var t;return((t=e.otlp)===null||t===void 0?void 0:t.endpoint)!==void 0},warn:(e)=>e==="grpc"?L.msg({defaultMessage:"Chats and Cowork tasks on Windows or behind an HTTP proxy, and the app\u2019s own events, export over OTLP/HTTP to this same endpoint. Choose grpc only if the collector also accepts OTLP/HTTP there.",id:"OtlpProtocolGrpcWarn"}):null}}),headers:z.field(z.annotate(zn.kvRecord(oA).optional(),{redact:"presence",gatewayServable:!1}),{flatKey:"otlpHeaders",readers:["desktop","m365"],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},deprecations:[oA],title:L.msg({defaultMessage:"OpenTelemetry exporter headers",id:"fO2poeLmt6"}),category:"telemetry",group:Fo,order:12,placeholder:{key:L.msg({defaultMessage:"X-Scope-OrgID",id:"OtlpHeadersKeyPh"}),value:L.msg({defaultMessage:"tenant-a",id:"OtlpHeadersValuePh"})},addLabel:L.msg({defaultMessage:"Add header",id:"IxbsWX4wj4"}),description:{short:z.shortDescription(L.msg({defaultMessage:"Static collector headers \u2014 routing and tenant headers only. No credentials here; use Collector authentication or the headers helper script for tokens.",id:"OtlpHeadersHint2"}))},predicates:{show:(e)=>{var t;return((t=e.otlp)===null||t===void 0?void 0:t.endpoint)!==void 0},warn:(e,t,r)=>lA.credentialHeadersWarn(e,r,"headersHelper")}}),authMode:z.field(z.annotate(Me.z.enum(["none","inference-credential"]).optional(),{gatewayServable:!1}),{flatKey:"otlpAuthMode",support:{enabled:{scopes:["3p"],availableInVersion:"1.30096.1"}},title:L.msg({defaultMessage:"Collector authentication",id:"OtlpCollectorAuthTitle"}),default:{displayOnly:"none"},optionLabels:{none:L.msg({defaultMessage:"None (static headers only)",id:"OtlpCollectorAuthNone"}),"inference-credential":L.msg({defaultMessage:"Reuse the inference credential",id:"OtlpCollectorAuthReuse"})},category:"telemetry",group:Fo,order:12.3,description:{short:z.shortDescription(L.msg({defaultMessage:"inference-credential sends the user\u2019s inference bearer token to the collector as Authorization: Bearer.",id:"OtlpCollectorAuthHint"})),long:z.longDescription("`inference-credential` adds `Authorization: Bearer <token>` to every export, using the token the app currently holds for the inference provider, with no helper script to deploy. The collector must accept that token as issued: a gateway OIDC token carries the gateway\u2019s audience, Microsoft Entra on Foundry issues the Foundry resource\u2019s token, and Vertex workforce identity forwards a Google Cloud access token; static gateway and Bedrock keys are forwarded as-is. Because the token can also call inference as the user, use this only for a collector you operate; for anything else, use the headers helper script with an ingest-scoped credential. Kinds that never produce a bearer (AWS SigV4 kinds on Bedrock, Google ADC / OAuth files on Vertex, API-key kinds) export without it \u2014 use the helper script instead. Cowork tasks pick up the current token each time they start; a Code session keeps the token it started with for as long as it stays open; the desktop\u2019s own event exporter uses the current token on every flush. Before sign-in, exports go out unauthenticated. An `Authorization` header printed by the headers helper script wins over this.")},predicates:{show:(e)=>{var t;return((t=e.otlp)===null||t===void 0?void 0:t.endpoint)!==void 0},warn:(e,t)=>{var r,i;if(e!=="inference-credential")return null;if(Wee((r=t.otlp)===null||r===void 0?void 0:r.endpoint))return L.msg({defaultMessage:"This sends the user\u2019s inference token over plain http to another host. Use an https collector endpoint.",id:"OtlpCollectorAuthCleartext"});if(!((i=t.inference)===null||i===void 0?void 0:i.provider)||uA.credentialYieldsBearer(t.inference))return null;return L.msg({defaultMessage:"The configured inference credential is not sent as a bearer token, so telemetry will export without it. Use the headers helper script instead.",id:"OtlpCollectorAuthNoBearer"})}}}),headersHelper:z.field(z.annotate(fa.safeHelperPath.optional(),{pathKind:"file",gatewayServable:!1}),{flatKey:"otlpHeadersHelper",support:{enabled:{scopes:["3p"],availableInVersion:"1.30096.1"}},remotePolicy:{requiresUserConsent:!0},title:L.msg({defaultMessage:"OpenTelemetry headers helper script",id:"OtlpHeadersHelperTitle"}),category:"telemetry",group:Fo,order:12.6,placeholder:L.msg({defaultMessage:"/usr/local/bin/otel-headers-helper",id:"OtlpHeadersHelperPlaceholder"}),description:{short:z.shortDescription(L.msg({defaultMessage:"Absolute path to an executable that prints a JSON object of collector headers. Merged over the static headers and Collector authentication; the helper wins.",id:"OtlpHeadersHelperHint"})),long:z.longDescription('Absolute path to an executable that prints a single JSON object of HTTP headers on stdout, e.g. `{"Authorization": "Bearer \u2026"}`. The desktop runs it (no arguments; output cached for a few minutes, and a failure is not retried for 30 seconds) whenever it needs collector headers and merges the result over **OpenTelemetry exporter headers** and the **Collector authentication** header (the helper wins on conflict). Cowork tasks get the current output when they start; Code sessions and host-run Cowork sessions are also given the script as Claude Code\u2019s own `otelHeadersHelper`, so an open session re-runs it as tokens rotate (on Windows this applies to `.exe`, `.cmd` and `.bat` helpers; a `.ps1` helper applies at session start only); the desktop\u2019s own event exporter re-runs it per flush. Session start waits at most two seconds for a slow helper and otherwise proceeds without its headers until it finishes. Use this when the collector needs a credential the inference sign-in cannot provide, when the collector token rotates, or when the config comes from a hosted admin console, which cannot store header values. If the helper fails, telemetry is sent without its headers \u2014 check the app log.')},predicates:{show:(e)=>{var t;return((t=e.otlp)===null||t===void 0?void 0:t.endpoint)!==void 0}}}),resourceAttributes:z.field(z.annotate(zn.kvRecord(aA).optional(),{redact:"presence",gatewayServable:!1}),{flatKey:"otlpResourceAttributes",readers:["desktop","m365"],support:{enabled:{scopes:["3p"],availableInVersion:"1.5354.0"}},deprecations:[aA],title:L.msg({defaultMessage:"OpenTelemetry resource attributes",id:"JgRwRuBWFK"}),category:"telemetry",group:Fo,order:13,placeholder:{key:L.msg({defaultMessage:"enduser.id",id:"QkbhtcTa4t"}),value:L.msg({defaultMessage:"alice@example.com",id:"KER1zNW5fX"})},addLabel:L.msg({defaultMessage:"Add attribute",id:"fkzH83T+V/"}),description:{short:z.shortDescription(L.msg({defaultMessage:"Extra resource attributes to attach to every span/metric. A static enduser.id set here always wins over the runtime identity.",id:"avoHZ0YdKZ"})),long:z.longDescription("Extra resource attributes to attach to every span, metric, and log sent to your collector. When End-user attribution is on and no `enduser.id` is set here, the desktop fills it with the signed-in user's runtime identity; a value you set here always wins. `process.owner` (the OS login name) is always emitted; set it here to override.")},predicates:{show:(e)=>{var t;return((t=e.otlp)===null||t===void 0?void 0:t.endpoint)!==void 0}}}),desktopLogLevel:z.field(Me.z.enum(["off","error","warn","info","debug"]).optional(),{flatKey:"otlpDesktopLogLevel",support:{enabled:{scopes:["3p"],availableInVersion:"1.9255.0"}},title:L.msg({defaultMessage:"Desktop telemetry export level",id:"TcONUV0eiZ"}),default:"error",category:"telemetry",group:Fo,order:14,description:{short:z.shortDescription(L.msg({defaultMessage:"Controls the Claude Desktop application\u2019s events, separate from Cowork and Code sessions. Defaults to error.",id:"wkZUOJzo5S"}))},predicates:{show:(e)=>{var t;return((t=e.otlp)===null||t===void 0?void 0:t.endpoint)!==void 0}}}),contentCapture:z.field(z.annotate(zn.lenientEnumArray(fA.OTLP_CONTENT_CATEGORIES).optional(),{redact:"keep"}),{flatKey:"otlpContentCapture",failClosedValue:[],support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.15962.0"}},title:L.msg({defaultMessage:"Content capture categories",id:"OtlpContentCaptureTitle"}),category:"telemetry",group:Fo,order:15,description:{short:z.shortDescription(L.msg({defaultMessage:"Content categories the desktop exporter sends unredacted to your collector. Leave empty to redact all content (default).",id:"OtlpContentCaptureHint"})),long:z.longDescription(`Each category enables a class of raw content in OpenTelemetry events sent to your collector (this data never reaches Anthropic):
`+"- `userPrompts` \u2014 user-typed prompt text\n"+"- `assistantResponses` \u2014 assistant message text\n"+"- `toolDetails` \u2014 tool input arguments, e.g. the web-search query string\n"+"- `toolContent` \u2014 tool output content, e.g. fetched page text or command stdout\n"+"- `rawApiBodies` \u2014 full inference API request and response bodies\n\n"+"These mirror Claude Code's `OTEL_LOG_*` env vars; see the [Claude Code monitoring docs](https://code.claude.com/docs/en/monitoring-usage).")},predicates:{show:(e)=>{var t;return((t=e.otlp)===null||t===void 0?void 0:t.endpoint)!==void 0}}}),tracesEnabled:z.field(Me.z.boolean().optional(),{flatKey:"otlpTracesEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.22209.0"}},title:L.msg({defaultMessage:"Export traces",id:"bKPAH/MBRZ"}),category:"telemetry",group:Fo,order:16,description:{short:z.shortDescription(L.msg({defaultMessage:"Also export OpenTelemetry traces from Cowork tasks and Code sessions. Uses Claude Code\u2019s session tracing.",id:"eW1UlMFTJB"})),long:z.longDescription("Enables Claude Code's session tracing (`CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1` + `OTEL_TRACES_EXPORTER=otlp`) in spawned Cowork tasks and Code sessions. Each user interaction exports a trace whose spans and events carry `trace_id`/`span_id`, enabling end-to-end correlation in your observability backend (metrics do not carry trace context; correlate those via `session.id`). Traces go to the collector endpoint and protocol configured above. The span structure may evolve between Claude Code releases; see the [Claude Code monitoring docs](https://code.claude.com/docs/en/monitoring-usage).")},predicates:{show:(e)=>{var t;return((t=e.otlp)===null||t===void 0?void 0:t.endpoint)!==void 0}}})});fA.DictationConfig=Me.z.object({enabled:z.field(Me.z.boolean().optional(),{flatKey:"dictationEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.44121.1"},visibility:"public-undocumented"},remotePolicy:{hybrid:{scope:"excluded"}},title:L
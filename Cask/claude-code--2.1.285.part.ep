ge:"Per-user soft cap, counted client-side over the token cap window. Not a server-enforced quota.",id:"DJ6DrJYlMf"})),long:z.longDescription("Requires `inferenceTokenWindowHours` to also be set \u2014 without a window length the cap is inert and no limit is enforced.")}}),windowHours:z.field(Me.z.coerce.number().int().positive().lte(720).optional(),{flatKey:"inferenceTokenWindowHours",support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},title:L.msg({defaultMessage:"Token cap window",id:"FSyyISlTnS"}),category:"limits",suffix:L.msg({defaultMessage:"hours",id:"4MengK4xQ/"}),placeholder:L.msg({defaultMessage:"24",id:"wAM7X1pIFa"}),description:{short:z.shortDescription(L.msg({defaultMessage:"Tumbling window length for the token cap. Max 720 hours (30 days).",id:"3iLLaW8pc5"})),long:z.longDescription("Required when `inferenceMaxTokensPerWindow` is set \u2014 the cap only takes effect once both are configured.")},predicates:{show:sA,required:sA}})});var C_=L.msg({defaultMessage:"Allowed surfaces",id:"XhBz9JhRHE"}),Qee=L.msg({defaultMessage:"Chat restrictions",id:"Ztk/Zc3utE"}),$_={coworkSurface:(e)=>{var t;return((t=e.coworkSurface)===null||t===void 0?void 0:t.enabled)!==!1},codeSurface:(e)=>{var t;return((t=e.codeSurface)===null||t===void 0?void 0:t.enabled)!==!1},chatSurface:(e)=>{var t;return((t=e.chatSurface)===null||t===void 0?void 0:t.enabled)===!0}},ete=L.msg({defaultMessage:"At least one surface must remain enabled.",id:"LastSurfaceReason"});function R_(e,t){if(!$_[t](e))return!1;for(let r of Object.keys($_))if(r!==t&&$_[r](e))return!1;return ete}fA.CoworkSurfaceConfig=Me.z.object({enabled:z.field(Me.z.boolean().optional(),{flatKey:"coworkTabEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.9659.0"}},title:L.msg({defaultMessage:"Allow Cowork",description:"\u201CCowork\u201D is a product name \u2014 keep it untranslated in Latin script; translate the rest of the sentence naturally.",id:"pq8krELyA1"}),default:!0,failClosedValue:!1,remotePolicy:{applyUnverified:!1},category:"sandbox",group:C_,label:L.msg({defaultMessage:"Cowork",description:"[no-translate] Product name; must remain exactly \u201CCowork\u201D in every locale.",id:"+MH0VdRCHz"}),order:0,predicates:{disabled:(e)=>R_(e,"coworkSurface")},description:{short:z.shortDescription(L.msg({defaultMessage:"Enable Cowork. Claude works on longer tasks like research, analysis, and documents.",description:"\u201CCowork\u201D is a product name \u2014 keep it untranslated in Latin script; translate the rest of the sentence naturally.",id:"N8nKVnjFDF"}))}})});fA.SSH_CLIENT_UNREADABLE_STAND_IN="/dev/null/unreadable-ssh-client";fA.CodeSurfaceConfig=Me.z.object({enabled:z.field(Me.z.boolean().optional(),{flatKey:"isClaudeCodeForDesktopEnabled",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.2581.0"}},title:L.msg({defaultMessage:"Allow Code",id:"5fWJP5tZx6"}),default:!0,failClosedValue:!1,remotePolicy:{applyUnverified:!1},category:"sandbox",group:C_,label:L.msg({defaultMessage:"Code",id:"h2vipunVVd"}),order:1,predicates:{disabled:(e)=>R_(e,"codeSurface")},description:{short:z.shortDescription(L.msg({defaultMessage:"Enable Code. Claude writes and runs code.",id:"/vs1W12TA0"}))}}),sshHostAllowlist:z.field(z.annotate(Me.z.array(Me.z.string().trim().min(1)).optional(),{glob:!0}),{flatKey:"sshHostAllowlist",support:{enabled:{scopes:["3p"],availableInVersion:"1.40609.0"}},betaFeatureKey:"sshRemoteSessions",title:L.msg({defaultMessage:"SSH host allowlist",id:"t3bJrMvGzZ"}),failClosedValue:[],category:"sandbox",group:so.CODE_SURFACE_GROUP,order:16,placeholder:L.msg({defaultMessage:"*.dev.example.com",id:"KWUwe1EqgP"}),predicates:{show:(e)=>{var t;return((t=e.codeSurface)===null||t===void 0?void 0:t.enabled)!==!1}},description:{short:z.shortDescription(L.msg({defaultMessage:"SSH hosts users may connect to for Code sessions. Empty or unset: off unless the device\u2019s Claude Code managed-settings allowlist applies. * allows any host.",id:"KXzmrLfnUT"})),long:z.longDescription("When off, the SSH option is hidden and any connection attempt is refused.\n\nEntries are exact hostnames (`build01.corp.example.com`) or `*.` wildcards (`*.corp.example.com` matches the apex and subdomains at any depth); matching is case-insensitive and ignores a `user@` prefix. Both the host the user entered and the `HostName` their `~/.ssh/config` resolves it to must match, so an alias cannot reach a host outside the list. `ProxyCommand` is permitted when the resolved host matches (this key governs which hosts the app offers, not network egress); `ProxyJump` is refused with a message suggesting `ProxyCommand`.\n\nThis is opt-in because a remote session runs Claude Code on the SSH host and the app forwards the session's inference credential to it, plus your OTLP collector endpoint and auth headers when `otlpEndpoint` is set. List only hosts you trust with those. Token-based credentials are forwarded; file-based kinds (Bedrock IAM Identity Center sign-in or AWS profile, Vertex Google sign-in or a credentials file) are refused at session start.\n\nIf this key is unset, an `sshHostAllowlist` in Claude Code's own managed-settings file on the device still applies; when both are set, this key wins where the app's configuration is admin-managed (MDM, the admin console, or a device-managed bootstrap URL) and otherwise applies only while that file sets none. `allowedWorkspaceFolders` still applies on the remote host.",{docsUrl:`${zn.COWORK_3P_DOCS_BASE}/ssh-remote-sessions`})}}),sshClientPath:z.field(z.annotate(fa.safeHelperPath.optional(),{pathKind:"file"}),{flatKey:"sshClientPath",support:{enabled:{scopes:["3p"],availableInVersion:"1.46388.1"}},betaFeatureKey:"sshRemoteSessions",remotePolicy:{requiresUserConsent:!0},failClosedValue:fA.SSH_CLIENT_UNREADABLE_STAND_IN,title:L.msg({defaultMessage:"SSH client program",id:"TnZHycC4Xk"}),category:"sandbox",group:so.CODE_SURFACE_GROUP,order:16.5,placeholder:L.msg({defaultMessage:"/opt/openssh/bin/ssh",id:"matzhaiItp"}),predicates:{show:(e)=>{var t;return((t=e.codeSurface)===null||t===void 0?void 0:t.enabled)!==!1}},description:{short:z.shortDescription(L.msg({defaultMessage:"Absolute path to the OpenSSH ssh program the app runs for SSH sessions. Unset: the first ssh on the user\u2019s PATH.",id:"CkU2BFhxiC"})),long:z.longDescription("Pins which OpenSSH client the app runs wherever it starts `ssh`: evaluating the user's SSH configuration (`ssh -G`), making the SSH connection and its channels, and the Code tab's terminal. `ssh-keygen` and `ssh-add` are taken from the same directory when they exist there, otherwise from PATH. The program must be OpenSSH 7.6 or newer; on macOS and Linux a wrapper script that ends in one is accepted, on Windows it must be a native `.exe` (not a .cmd, .bat or .ps1 script). When this key is set and the program is missing, cannot be run, or is too old, SSH sessions fail with an error telling the user to ask their IT administrator (the configured path is in its details) \u2014 the app never falls back to another ssh. On Windows, where SSH connections do not yet run through an ssh program, the key currently affects configuration evaluation and the terminal only.",{docsUrl:`${zn.COWORK_3P_DOCS_BASE}/ssh-remote-sessions`})}})});fA.ChatSurfaceConfig=Me.z.object({enabled:z.field(Me.z.boolean().optional(),{flatKey:"chatTabEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.13576.0"}},title:L.msg({defaultMessage:"Allow Chat",id:"0Cc9oG2J04"}),category:"sandbox",group:C_,label:L.msg({defaultMessage:"Chat",id:"WTrOy36sdu"}),order:2,predicates:{disabled:(e)=>R_(e,"chatSurface")},description:{short:z.shortDescription(L.msg({defaultMessage:"Enable Chat. Quick questions and drafting.",id:"z2x73mCBZ9"}))}}),advancedFileAnalysis:z.field(Me.z.boolean().optional(),{flatKey:"chatAdvancedFileAnalysisEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.14271.0"}},title:L.msg({defaultMessage:"Advanced file analysis",id:"ChatAdvancedFileAnalysisEnabled"}),category:"sandbox",group:Qee,order:20,predicates:{show:(e)=>{var t;return((t=e.chatSurface)===null||t===void 0?void 0:t.enabled)!==!1}},description:{short:z.shortDescription(L.msg({defaultMessage:"Allow Claude to run code in a local sandbox to analyze attached files it can\u2019t read natively \u2014 like Excel and PowerPoint. Off by default.",id:"EC49vAdH1s"})),long:z.longDescription("Also enables inline data analysis. The sandbox can only read files attached to the conversation and has no network access.")}})});var A_=L.msg({defaultMessage:"Extensions",id:"nb2FlN/G2m"});fA.ExtensionsConfig=Me.z.object({enabled:z.field(Me.z.boolean().optional(),{flatKey:"isDesktopExtensionEnabled",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.2581.0"}},title:L.msg({defaultMessage:"Allow desktop extensions",id:"knHnvzpkOf"}),default:!1,legacyFlatKey:{name:"isDxtEnabled",effect:"the old name will be reported as unreadable and the key will read as false: desktop extensions will be disabled until the name is updated",...el.BATCH_2026_09},failClosedValue:!1,egressRequirements:(e)=>e===!1?[]:Wf.PYTHON_EXTENSION_RUNTIME_HOSTS,egressRequirementsLabel:L.msg({defaultMessage:"Desktop extensions (Python runtime)",id:"8Jc9WEC0S8"}),category:"connectors",group:A_,order:11,description:{short:z.shortDescription(L.msg({defaultMessage:".dxt and .mcpb installs.",id:"2IB0Hxh1vO"})),long:z.longDescription("1P builds default to enabled at runtime unless this is explicitly set. In 3P, enabling this allows loading extensions; local install additionally requires an org policy backend.")}}),directoryEnabled:z.field(Me.z.boolean().optional(),{flatKey:"isDesktopExtensionDirectoryEnabled",support:{enabled:{scopes:["1p"],availableInVersion:"1.2581.0"}},title:L.msg({defaultMessage:"Show extension directory",id:"bqOLf0vLQm"}),default:{displayOnly:!0},legacyFlatKey:{name:"isDxtDirectoryEnabled",effect:"the old name will be reported as unreadable and not read, leaving the key unset: the extension directory will show and no directory-only install restriction will apply until the name is updated",...el.BATCH_2026_09},category:"connectors",group:A_,order:12,description:{short:z.shortDescription(L.msg({defaultMessage:"The in-app catalogue of installable extensions. Hide to allow sideload only.",id:"g8s4jWgsLf"}))},predicates:{show:(e)=>{var t;return((t=e.extensions)===null||t===void 0?void 0:t.enabled)!==!1}}}),signatureRequired:z.field(Me.z.boolean().optional(),{flatKey:"isDesktopExtensionSignatureRequired",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.2581.0"}},title:L.msg({defaultMessage:"Require signed extensions",id:"bmP92ZCban"}),default:!1,legacyFlatKey:{name:"isDxtSignatureRequired",effect:"the old name will be reported as unreadable and the key will read as true: only signed extensions will load until the name is updated",...el.BATCH_2026_09},failClosedValue:!0,category:"connectors",group:A_,order:13,description:{short:z.shortDescription(L.msg({defaultMessage:"Reject desktop extensions that are not signed by a trusted publisher.",id:"DY0aw7svrD"}))},predicates:{show:(e)=>{var t;return((t=e.extensions)===null||t===void 0?void 0:t.enabled)!==!1}}})});fA.AutoUpdateConfig=Me.z.object({disabled:z.field(Me.z.boolean().optional(),{flatKey:"disableAutoUpdates",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.2581.0"}},appBehaviorOnly:!0,title:L.msg({defaultMessage:"Block auto-updates",id:"OX1+jdVwLL"}),default:!1,category:"telemetry",group:so.UPDATES_GROUP,order:20,description:{short:z.shortDescription(L.msg({defaultMessage:"Stop Claude Desktop from fetching updates entirely (no time limit). You\u2019ll need to push new versions yourself.",id:"t/LNoeQ72j"}))},predicates:{warn:(e)=>e===!0?L.msg({defaultMessage:"Security and compatibility fixes will not install automatically. Make sure IT has another distribution path.",id:"1oztgcYddf"}):null}}),enforcementHours:z.field(Me.z.coerce.number().int().gt(0).lte(72).optional(),{flatKey:"autoUpdaterEnforcementHours",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.2581.0"}},appBehaviorOnly:!0,title:L.msg({defaultMessage:"Auto-update enforcement window",id:"jJz20QocAd"}),category:"telemetry",group:so.UPDATES_GROUP,order:21,suffix:L.msg({defaultMessage:"hours",id:"4MengK4xQ/"}),description:{short:z.shortDescription(L.msg({defaultMessage:"Hours before a downloaded update force-installs. Only applies when auto-updates are enabled. Blank = 72-hour default.",id:"VyqfjIW6Iv"})),long:z.longDescription("Has no effect when `disableAutoUpdates` is in place at launch: the updater never starts, so nothing is downloaded and this timer never arms. If the policy reaches an already-running app after an update has downloaded, that one staged update still installs on this timer; no further updates are fetched.\n\nLeaving it blank uses the 72-hour default *and* then waits for the machine to be idle (10+ minutes without input) before restarting; setting any explicit value (including 72) restarts once the window elapses regardless of user activity. In both cases the restart holds off while Claude is mid-task.")},predicates:{show:(e)=>{var t;return((t=e.autoUpdate)===null||t===void 0?void 0:t.disabled)!==!0}}}),viaUpdatesHost:z.field(Me.z.boolean().optional(),{flatKey:"updateViaUpdatesHost",support:{enabled:{scopes:["3p"],availableInVersion:"1.26832.0"}},appBehaviorOnly:!0,title:L.msg({defaultMessage:"Check for updates on releases.claude.com",id:"UpdateViaUpdatesHost"}),default:!1,category:"telemetry",group:so.UPDATES_GROUP,order:22,description:{short:z.shortDescription(L.msg({defaultMessage:"Read the update feed from releases.claude.com so api.anthropic.com can stay blocked.",id:"UpdateViaUpdatesHostShort"})),long:z.longDescription("By default the app asks `api.anthropic.com` which version to install. That host also serves the model APIs, so organizations that block un-approved LLM endpoints at the network edge end up blocking updates too.\n\nTurn this on to read the same feed from `releases.claude.com`, a hostname that serves only the desktop update-check route and carries no model API. `api.anthropic.com` can then stay blocked without breaking auto-update. Rollout behavior is unchanged; the installer download still comes from `downloads.claude.ai` as before.")},predicates:{show:(e)=>{var t;return((t=e.autoUpdate)===null||t===void 0?void 0:t.disabled)!==!0}}})});var tte=L.msg({defaultMessage:"Feature announcements",id:"FeatureAnnouncementsGroup"});fA.FeatureDiscoveryConfig=Me.z.object({disabled:z.field(Me.z.boolean().optional(),{flatKey:"disableFeatureDiscovery",support:{enabled:{scopes:["3p"],availableInVersion:"1.21459.0"}},title:L.msg({defaultMessage:"Hide feature announcements",id:"DisableFeatureDiscoveryTitle"}),default:!1,failClosedValue:!0,category:"appearance",group:tte,order:10,description:{short:z.shortDescription(L.msg({defaultMessage:"Suppress unprompted feature-announcement UI: the post-update \u201CWhat\u2019s new\u201D nudge and new-feature tips. Users can still open release notes themselves.",id:"DisableFeatureDiscoveryHint"})),long:z.longDescription(`Covers the version-shipped announcement UI baked into each release: the **What's new** button that appears on its own after an update, and the one-time **New feature** tips (coach-marks) that point out newly shipped capabilities. Useful when your organization gates feature availability and doesn't want the app advertising capabilities you haven't rolled out.

`+"User-initiated surfaces stay: the What's-new menu item and header button still open the release notes on demand. Auto-update behavior is unaffected \u2014 that is governed by `disableAutoUpdates` and `autoUpdaterEnforcementHours`.")}})})});var D_=E(function(bA){Object.defineProperty(bA,"__esModule",{value:!0});bA.BootstrapConfig=void 0;var tl=sn(),_A=rr(),yA=Dn(),pt=st(),Tr=En(),nt=ln(),nl=fr(),Ar=ao(),Au=(e)=>{var t;return Boolean((t=e.bootstrap)===null||t===void 0?void 0:t.url)},gA=Tr.legacyKvEncodingNotice("bootstrapHeaders","no bootstrap request headers will be sent (the fetch may then fail to authenticate)");bA.BootstrapConfig=tl.z.object({enabled:pt.field(tl.z.boolean().optional(),{flatKey:"bootstrapEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.10628.0"}},remotePolicy:{type:"remote-disabled"},title:nt.msg({defaultMessage:"Use bootstrap config",id:"Q6zr1vGzlF"}),default:!0,category:"source",group:Ar.BOOTSTRAP_GROUP,description:{short:pt.shortDescription(nt.msg({defaultMessage:"Fetch and apply the URL above at launch. Turn off to keep the URL saved but skip the fetch.",id:"0Nsvk4xG6E"}))},predicates:{show:Au}}),url:pt.field(pt.annotate(nl.httpsUrl.optional(),{redact:"hostname"}),{flatKey:"bootstrapUrl",support:{enabled:{scopes:["3p"],availableInVersion:"1.10628.0"}},remotePolicy:{type:"remote-disabled"},title:nt.msg({defaultMessage:"Bootstrap config URL",id:"MPdK0gXvRA"}),egressRequirements:(e,t)=>{var r;if(((r=t.bootstrap)===null||r===void 0?void 0:r.enabled)===!1)return[];let i=yA.safeHostname(e);return i?[i]:[]},egressRequirementsLabel:nt.msg({defaultMessage:"Bootstrap config server",id:"qjMZL1XFnR"}),category:"source",group:Ar.BOOTSTRAP_GROUP,placeholder:nt.msg({defaultMessage:"https://config.example.com/claude-desktop",id:"IHENczwSR2"}),description:{short:pt.shortDescription(nt.msg({defaultMessage:"HTTPS endpoint that returns a per-user JSON config overlay. Values from the response override local settings and become read-only.",id:"5SJ4ZG3Kp2"}))}}),oidc:pt.field(nl.BootstrapFetchOidc.optional(),{flatKey:"bootstrapOidc",support:{enabled:{scopes:["3p"],availableInVersion:"1.10628.0"}},remotePolicy:{type:"remote-disabled"},title:nt.msg({defaultMessage:"Bootstrap OIDC parameters",id:"zS5yI0rzXy"}),egressRequirements:(e,t)=>{var r;return((r=t.bootstrap)===null||r===void 0?void 0:r.enabled)===!1?[]:Tr.oidcEgressHosts(e)},egressRequirementsLabel:nt.msg({defaultMessage:"Bootstrap sign-in (OIDC)",id:"q2PtfeOums"}),category:"source",group:Ar.BOOTSTRAP_GROUP,description:{short:pt.shortDescription(nt.msg({defaultMessage:"When set, the bootstrap request sends a Bearer token from a browser sign-in (authorization-code-with-PKCE).",id:"USlfHdFqDQ"})),long:pt.longDescription("Set this to use a separate identity provider (Microsoft Entra ID, Okta, Ping, or any compliant OIDC provider) for the bootstrap sign-in. The app runs an authorization-code-with-PKCE flow in the system browser. Omit to use device-code mode against the bootstrap server's own origin.\n\nThis is an **object-typed key** \u2014 in an MDM profile it is a single JSON-string value, not separate keys with dotted names like `bootstrapOidc.clientId`. Writing the sub-fields as separate registry values causes the app to silently fall through to device-code mode.",{docsUrl:`${Tr.COWORK_3P_DOCS_BASE}/bootstrap`})},predicates:{show:Au}}),headers:pt.field(pt.annotate(Tr.kvRecord(gA).optional(),{redact:"presence"}),{flatKey:"bootstrapHeaders",support:{enabled:{scopes:["3p"],availableInVersion:"1.32885.1"}},deprecations:[gA],remotePolicy:{type:"remote-disabled"},title:nt.msg({defaultMessage:"Bootstrap request headers",id:"BootstrapHeadersTitle"}),category:"source",group:Ar.BOOTSTRAP_GROUP,placeholder:{key:nt.msg({defaultMessage:"Authorization",id:"BootstrapHdrKeyPh"}),value:nt.msg({defaultMessage:"Basic \u2026",id:"BootstrapHdrValPh"})},addLabel:nt.msg({defaultMessage:"Add header",id:"IxbsWX4wj4"}),description:{short:pt.shortDescription(nt.msg({defaultMessage:"HTTP headers sent on every bootstrap config fetch. Use this instead of embedding user:pass@ in the URL.",id:"BootstrapHeadersHint"})),long:pt.longDescription('Static headers sent on every request to the bootstrap config URL \u2014 for a service-account credential (`Authorization: Basic \u2026`, an API key header) or a routing/tenant header. When either this or the headers helper script is set and no separate `bootstrapOidc` provider is configured, the app treats the headers as sufficient auth and does not require a per-user sign-in for the bootstrap fetch. These headers (and the helper script\'s below) also accompany requests to a plugin marketplace this server hosts on its own origin (`allowedPluginMarketplaces` with `credentialKind: "inferenceCredential"`). Header values are masked in diagnostics and telemetry. For a rotating token, use the headers helper script instead.',{docsUrl:`${Tr.COWORK_3P_DOCS_BASE}/bootstrap`})},predicates:{show:Au}}),headersHelper:pt.field(pt.annotate(nl.safeHelperPath.optional(),{pathKind:"file"}),{flatKey:"bootstrapHeadersHelper",support:{enabled:{scopes:["3p"],availableInVersion:"1.32885.1"}},remotePolicy:{type:"remote-disabled"},title:nt.msg({defaultMessage:"Bootstrap headers helper script",id:"BootstrapHeadersHelperTitle"}),category:"source",group:Ar.BOOTSTRAP_GROUP,placeholder:nt.msg({defaultMessage:"/usr/local/bin/bootstrap-headers-helper",id:"BootstrapHeadersHelperPh"}),mono:!0,description:{short:pt.shortDescription(nt.msg({defaultMessage:"Absolute path to an executable that prints a JSON object of bootstrap request headers. Merged over the static headers; the helper wins.",id:"BootstrapHeadersHelperHint"})),long:pt.longDescription('Absolute path to an executable that prints a single JSON object of HTTP headers on stdout, e.g. `{"Authorization": "Bearer \u2026"}`. The app runs it (no arguments; output cached for a few minutes) before each bootstrap config fetch and merges the result over **Bootstrap request headers** (the helper wins on conflict). Use this instead of embedding `user:pass@` in the bootstrap URL, or when the bootstrap server needs a rotating token from a secrets manager. When either this or the static headers are set and no separate `bootstrapOidc` provider is configured, the app treats them as sufficient auth and does not require a per-user sign-in for the bootstrap fetch. If a per-user sign-in also runs (`bootstrapOidc` or the server\u2019s own device-code flow), that Bearer token wins on `Authorization`.',{docsUrl:`${Tr.COWORK_3P_DOCS_BASE}/bootstrap`})},predicates:{show:Au}}),trustBootstrapDelivery:pt.field(tl.z.boolean().optional(),{flatKey:"trustBootstrapDelivery",legacyFlatKey:{name:"trustBootstrapLocalExec",effect:"the key will read as false (its fail-closed value): each user will be asked to consent to bootstrap-delivered sign-in targets, endpoints, helper scripts and connectors, even when the bootstrap URL came from a device-managed profile",..._A.BATCH_2026_09},support:{enabled:{scopes:["3p"],availableInVersion:"1.26832.0"}},failClosedValue:!1,title:nt.msg({defaultMessage:"Trust bootstrap-delivered settings",id:"vRHCNG9xkY"}),default:!1,category:"source",group:Ar.BOOTSTRAP_GROUP,remotePolicy:{type:"remote-disabled"},description:{short:pt.shortDescription(nt.msg({defaultMessage:"Skip the per-user consent prompt for sign-in targets, inference endpoints, helper scripts, and connectors the bootstrap server delivers.",id:"f6Kz1NkBdU"}))},predicates:{show:Au}})})});var j_=E(function(kA){Object.defineProperty(kA,"__esModule",{value:!0});kA.LifecycleConfig=kA.RELAUNCH_ENFORCEMENT_DEFAULT_HOURS=kA.CONFIG_RELAUNCH_IDLE_MINUTES=void 0;var pa=sn(),Cr=st(),Rr=ln(),Xf=ao();kA.CONFIG_RELAUNCH_IDLE_MINUTES=2;kA.RELAUNCH_ENFORCEMENT_DEFAULT_HOURS=24;var wA=10,SA=2,OA=30;kA.LifecycleConfig=pa.z.object({relaunchEnforcementHours:Cr.field(pa.z.preprocess((e)=>typeof e==="string"&&e.trim()!==""?Number(e):e,pa.z.number().int().min(0).lte(336).optional()),{flatKey:"relaunchEnforcementHours",support:{enabled:{scopes:["3p"],availableInVersion:"1.40609.0"}},appBehaviorOnly:!0,remotePolicy:{hotApplied:!0},title:Rr.msg({defaultMessage:"Configuration relaunch window",id:"RelaunchEnforcementHoursTitle"}),default:kA.RELAUNCH_ENFORCEMENT_DEFAULT_HOURS,category:"telemetry",group:Xf.UPDATES_GROUP,order:23,suffix:Rr.msg({defaultMessage:"hours",id:"4MengK4xQ/"}),description:{short:Cr.shortDescription(Rr.msg({defaultMessage:"Hours a user may keep working on the old configuration after a managed-configuration change is detected. 0 = restart required at once. Blank = 24 hours.",id:"RelaunchEnforcementHoursShort"})),long:Cr.longDescription("Set it via MDM (plist, registry, or file) or serve it from your configuration endpoint (remote bootstrap configuration). When the running app observes a managed-configuration change it cannot apply without restarting, it shows the sidebar relaunch card and starts this window. The window starts at the running app\u2019s next configuration re-check (the re-check interval beside it), so allow up to one re-check interval on top of this value between saving a change and the restart dialog. When the window ends the app blocks with a restart dialog and restarts on its own after "+`${kA.CONFIG_RELAUNCH_IDLE_MINUTES} minutes with no activity (no running Claude task and no keyboard or pointer input); the user can also restart right away. Defaults to ${kA.RELAUNCH_ENFORCEMENT_DEFAULT_HOURS} hours. Set a larger value (up to 336 = 14 days) to give users longer; \`0\` shows the dialog at the first observation.

A served value is read from the newest served configuration, so tightening or loosening the window takes effect at the next poll without a restart, and a change to this key alone never asks for one. Like the update keys beside it, a value from a device-management profile that sets only app-behavior keys applies without making the rest of the configuration device-managed, and takes precedence over a served one. Because the key is grouped with the other app-behavior keys, a profile that sets any of them claims the whole group: set this key in the same profile as the update keys you deploy, or a served value is ignored on those devices and the ${kA.RELAUNCH_ENFORCEMENT_DEFAULT_HOURS}-hour default applies.`)}}),configRecheckIntervalMinutes:Cr.field(pa.z.coerce.number().int().gte(SA).lte(OA).optional(),{flatKey:"configRecheckIntervalMinutes",support:{enabled:{scopes:["3p"],availableInVersion:"1.46388.1"}},appBehaviorOnly:!0,remotePolicy:{hotApplied:!0},title:Rr.msg({defaultMessage:"Configuration re-check interval",id:"ConfigRecheckIntervalMinutesTitle"}),default:wA,category:"telemetry",group:Xf.UPDATES_GROUP,order:24,suffix:Rr.msg({defaultMessage:"minutes",id:"ConfigRecheckIntervalMinutesSuffix"}),description:{short:Cr.shortDescription(Rr.msg({defaultMessage:"Minutes between the running app\u2019s checks for a changed managed configuration. Blank = 10 minutes.",id:"ConfigRecheckIntervalMinutesShort"})),long:Cr.longDescription(`How often the running app re-checks its managed configuration for changes: it re-polls your configuration endpoint with a conditional request, so an unchanged configuration costs one \`304\` round-trip. A detected change shows the sidebar relaunch card and starts the \`relaunchEnforcementHours\` window, so a saved change reaches a running app within roughly one interval. Defaults to ${wA} minutes; each wait is jittered by \xB110% so a fleet does not poll in lockstep. Values outside ${SA}\u2013${OA} are rejected with a parse error and the default applies.

`+"Applied without a restart: a new served value re-arms the timer at the check that delivers it, and a change to this key alone never asks for a relaunch. Set it via MDM or serve it from your configuration endpoint; like the update keys beside it, a value from a device-management profile that sets only app-behavior keys applies without making the rest of the configuration device-managed, and takes precedence over a served one. Because the key is grouped with the other app-behavior keys, a profile that sets any of them claims the whole group, and every key in it is then read from that profile alone: deploy this key in the same profile as the update keys (`disableAutoUpdates`, `autoUpdaterEnforcementHours`, \u2026). A profile that sets the update keys without it ignores a served interval and the default applies; a profile that sets only this key ignores served update settings, so a served `disableAutoUpdates` no longer holds on those devices. A profile that also manages the connection itself (sets `bootstrapUrl` or the provider keys) follows the normal tier order instead: once a served configuration is in hand it, not the profile, supplies this key.")}})})});var x_=E(function(AA){Object.defineProperty(AA,"__esModule",{value:!0});AA.ModelsConfig=AA.InferenceModel=void 0;AA.modelDiscoveryUrlHint=M_;AA.usageCostEstimateEnabled=rp;AA.effectiveModelPricing=gte;AA.dropNonAnthropicModels=_te;AA.droppedModelMessage=yte;AA.nonAnthropicModelText=$A;var Ye=sn(),ip=Lh(),np=Dn(),oe=st(),Ht=En(),ye=ln(),ma=mr(),IA=su();function ep(e){let t=e.match(/^(.+?)\[1m\]$/i);return t?t[1].trim():e}AA.InferenceModel=Ye.z.object({name:oe.subfield(Ye.z.string().trim().min(1),{label:ye.msg({defaultMessage:"Model ID",id:"/m0q/Dre6A"}),isPrimaryKey:!0,mono:!0,placeholder:ye.msg({defaultMessage:"claude-opus-4",id:"s+j6yEtVLW"}),description:{short:oe.shortDescription(ye.msg({defaultMessage:"Model ID exactly as the provider expects it. The first entry is the default model.",id:"1tZVf88rjp"}))}}),lab
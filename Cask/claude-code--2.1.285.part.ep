show:(e)=>{var t;return((t=e.plugins)===null||t===void 0?void 0:t.remoteUrl)!==void 0}},description:{short:ae.shortDescription(pe.msg({defaultMessage:"Typically supplied by your bootstrap server. Ignored when bootstrap is disabled.",id:"0PDitvSoS4"}))}}),settings:ae.field(ae.annotate(Fn.OrgPluginSettings.optional(),{redact:"keep"}),{flatKey:"orgPluginSettings",support:{enabled:{scopes:["3p"],availableInVersion:"1.8089.0"}},title:pe.msg({defaultMessage:"Organization plugin settings",id:"hD0T/0cTEY"}),failClosedValue:Fn.ORG_PLUGIN_SETTINGS_PARSE_FAILED,checkDropped:Fn.checkOrgPluginSettingsForDrops,deprecations:[Fn.ORG_PLUGIN_SETTINGS_RECORD_FORM,Fn.ORG_PLUGIN_PERMISSION_ASK_SESSION],category:"plugins",customRenderer:"orgPluginSettings",description:{short:ae.shortDescription(pe.msg({defaultMessage:"Admin policy applied to plugin-delivered MCP servers.",id:"MW4a5sB6yS"})),long:ae.longDescription('Locks per-tool permissions on MCP servers that arrive via the org-plugins directory \u2014 one entry per server name:\n```json\n[{"serverName": "internal-search", "tools": [{"toolName": "delete_document", "permission": "blocked"}]}]\n```\nThe older record form (`{"mcpServers": {"internal-search": {"toolPolicy": {"delete_document": "blocked"}}}}`) is deprecated and accepted only until '+op.formatDeprecationDate((N_=Fn.ORG_PLUGIN_SETTINGS_RECORD_FORM.supportEnds)!==null&&N_!==void 0?N_:"")+". Desktop versions before 1.15200.0 parse only the record form: on those builds an array value is ignored and plugin tool locks are **not enforced**, so update the fleet past 1.15200.0 before deploying the array form.\n\nIf a Managed MCP servers entry and an org-plugin server share a name, the Managed MCP servers entry wins and its `toolPolicy` (if any) applies; the entry here for that name is ignored.",{docsUrl:`${lo.COWORK_3P_DOCS_BASE}/configuration#orgpluginsettings`})}}),marketplaces:ae.field(ae.annotate(Cte.optional(),{redact:"presence"}),{flatKey:"allowedPluginMarketplaces",support:{enabled:{scopes:["3p"],availableInVersion:"1.17377.1"}},checkDropped:BA,remotePolicy:{marketplaceUrlHygiene:!0},title:pe.msg({defaultMessage:"Plugin marketplaces",id:"SbDWhfly4c"}),description:{short:ae.shortDescription(pe.msg({defaultMessage:"Git repositories or hosted marketplace.json URLs to surface as plugin marketplaces in the Directory\u2019s Organization tab. The app re-fetches each periodically.",id:"57U/34BfkA"}))},failClosedValue:[],egressRequirements:(e)=>Array.isArray(e)?e.map((t)=>t.source==="github"?"github.com":ap.safeHostname(t.url)).filter((t)=>!!t):[],egressRequirementsLabel:pe.msg({defaultMessage:"Plugin marketplaces",id:"SbDWhfly4c"}),category:"plugins",group:pe.msg({defaultMessage:"Plugin marketplaces",id:"SbDWhfly4c"}),addLabel:pe.msg({defaultMessage:"Add marketplace",id:"u1Y1OE1uGp"}),predicates:{warn:(e,t,r)=>zA(e)?r.formatMessage(pe.msg({defaultMessage:"Automatic installation needs {source, select, url {a Manifest SHA-256} other {a full 40-character commit SHA in Ref}}. Without one this marketplace is treated as available: it is listed, but this setting installs nothing.",id:"BwpYj08tvc"}),{source:e.source}):null},presets:[{label:"GitHub repo",item:{source:"github",repo:""}},{label:"Git URL",item:{source:"git",url:""}},{label:"Marketplace URL",item:{source:"url",url:""}},...Ite,{label:"Salesforce",section:"From partners",description:"salesforce/salesforce-skills on GitHub",support:{visibility:"internal-only"},item:{source:"github",repo:"salesforce/salesforce-skills"}}]}),userPluginMarketplacesEnabled:ae.field(et.z.boolean().optional(),{flatKey:"userPluginMarketplacesEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.37937.0"}},title:pe.msg({defaultMessage:"Allow user-added plugin marketplaces",id:"v/P6I/BbB8"}),default:{displayOnly:!0},failClosedValue:!1,category:"sandbox",group:sp.GENERAL_RESTRICTIONS_GROUP,order:6.6,description:{short:ae.shortDescription(pe.msg({defaultMessage:"Allow users to add plugin marketplaces themselves. When off, the add-marketplace surfaces are hidden and in-app adds are refused.",id:"99a8pjspXC"})),long:ae.longDescription("When on (default), users can add plugin marketplaces from the plugin browser. Set to `false` to block user marketplace adds: the add-marketplace surfaces are hidden, and the app refuses adds that still reach it (deep links, stale UI).\n\nThis is a feature-availability control enforced in the app, not a data boundary: marketplaces already registered on the user's machine (or registered outside the app, for example by the Claude Code CLI or by editing Claude Code's plugin files) are not removed or blocked by this key. Marketplaces provisioned by your organization (`allowedPluginMarketplaces`) are unaffected.\n\nThis key applies only while the app runs in third-party mode. If users could otherwise sign in to Claude.ai on the device, also set `disableDeploymentModeChooser` so the app stays in third-party mode.",{docsUrl:`${lo.COWORK_3P_DOCS_BASE}/configuration#userpluginmarketplacesenabled`})}}),userPluginUploadsEnabled:ae.field(et.z.boolean().optional(),{flatKey:"userPluginUploadsEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.37937.0"}},title:pe.msg({defaultMessage:"Allow user-added plugins",id:"FC6Rd6B6Wv"}),default:{displayOnly:!0},failClosedValue:!1,category:"sandbox",group:sp.GENERAL_RESTRICTIONS_GROUP,order:6.7,description:{short:ae.shortDescription(pe.msg({defaultMessage:"Allow users to add their own plugins. When off, every in-app option for adding one is hidden and uploads that still reach the app are refused.",id:"7AFPPgSJBu"})),long:ae.longDescription("When on (default), users can upload plugin files and create plugins with Claude. Set to `false` to stop users adding plugins of their own: every in-app option for doing so is hidden, and the app refuses uploads that still reach it.\n\nThis is a feature-availability control enforced in the app, not a data boundary: plugins already installed (or placed on disk outside the app) are not removed or blocked by this key. Plugins from organization-provisioned marketplaces and the organization plugins directory are unaffected.\n\nThis key applies only while the app runs in third-party mode. If users could otherwise sign in to Claude.ai on the device, also set `disableDeploymentModeChooser` so the app stays in third-party mode.",{docsUrl:`${lo.COWORK_3P_DOCS_BASE}/configuration#userpluginuploadsenabled`})}})})});var F_=E(function(GA){Object.defineProperty(GA,"__esModule",{value:!0});GA.TelemetryConfig=void 0;var Dr=sn(),vt=st(),lp=En(),Ut=ln(),uo=ao();GA.TelemetryConfig=Dr.z.object({orgUuid:vt.field(vt.annotate(Dr.z.string().optional(),{redact:"keep"}),{flatKey:"deploymentOrganizationUuid",support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},remotePolicy:{hybrid:{derived:!0},applyUnverified:!0},title:Ut.msg({defaultMessage:"Organization UUID",id:"EATQrlttOw"}),category:"telemetry",group:uo.ANTHROPIC_TELEMETRY_GROUP,order:-1,placeholder:Ut.msg({defaultMessage:"00000000-0000-0000-0000-000000000000",id:"oT3AdLMVZK"}),description:{short:vt.shortDescription(Ut.msg({defaultMessage:"A UUID you generate. Tags telemetry so Anthropic support can locate your fleet\u2019s events, and namespaces each user\u2019s local data. Not used for auth.",id:"gvBRfDvKmN"})),long:vt.longDescription("If unset, a shared placeholder UUID is used: telemetry can\u2019t be distinguished from other unconfigured deployments, and local data is stored under the placeholder. **Changing this value orphans data** stored under the previous value (sessions, skills, plugins).")}}),disableEssential:vt.field(Dr.z.boolean().optional(),{flatKey:"disableEssentialTelemetry",support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},remotePolicy:{default:!0,applyUnverified:!0},failClosedValue:!0,title:Ut.msg({defaultMessage:"Block essential telemetry",id:"rdKIIOydC8"}),default:!1,category:"telemetry",group:uo.ANTHROPIC_TELEMETRY_GROUP,order:0,description:{short:vt.shortDescription(Ut.msg({defaultMessage:"Crash and performance reports to Anthropic.",id:"EGOuVJosgc"})),long:vt.longDescription(`"Essential" means the signals Anthropic needs to keep your deployment working: **crash stacks**, **startup failure reasons**, and **version/OS metadata**. No prompts, completions, file contents, or identifiers beyond a random install ID.

**What you lose when this is on:** when a Claude Desktop build hits a bug that only reproduces on your OS version or locale, Anthropic can't see it unless a user manually reports. Fixes ship slower.

**Why this is discouraged, not blocked:** some air-gapped environments require zero outbound telemetry as a matter of policy. The switch exists for them. If you don't have that constraint, leave it off.`,{docsUrl:`${lp.COWORK_3P_DOCS_BASE}/telemetry#essential-telemetry`})},predicates:{warn:(e)=>e===!0?Ut.msg({defaultMessage:"Crash and error reports are how we diagnose failures specific to your inference setup. Support turnaround will be slower without them.",id:"ek/rdG0G9V"}):null}}),disableNonessential:vt.field(Dr.z.boolean().optional(),{flatKey:"disableNonessentialTelemetry",support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},remotePolicy:{default:!0,applyUnverified:!0},failClosedValue:!0,title:Ut.msg({defaultMessage:"Block nonessential telemetry",id:"oo4Av05fBn"}),default:!1,category:"telemetry",group:uo.ANTHROPIC_TELEMETRY_GROUP,order:1,description:{short:vt.shortDescription(Ut.msg({defaultMessage:"Product-usage analytics and diagnostic-report uploads. No message content.",id:"0X/lTj2Hvv"})),long:vt.longDescription(`"Nonessential" covers two things: **product-usage analytics** (which features get used, navigation patterns; no prompts or completions) and the **Send** action in Help \u2192 Generate Diagnostic Report. Turning this on stops both.

Destinations are listed under Egress Requirements \u2192 Nonessential telemetry.`,{docsUrl:`${lp.COWORK_3P_DOCS_BASE}/telemetry#non-essential-telemetry`})},predicates:{warn:(e)=>e===!0?Ut.msg({defaultMessage:"Usage analytics help us prioritize improvements for third-party inference. Diagnostic-report uploads will also be blocked. No message content is included in either.",id:"XtXm3euW3d"}):null}}),disableNonessentialServices:vt.field(Dr.z.boolean().optional(),{flatKey:"disableNonessentialServices",support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},failClosedValue:!0,title:Ut.msg({defaultMessage:"Block nonessential services",id:"HA2UIzGsaT"}),default:!1,category:"telemetry",group:uo.ANTHROPIC_TELEMETRY_GROUP,order:2,description:{short:vt.shortDescription(Ut.msg({defaultMessage:"Connector favicons and the artifact-preview and MCP Apps widget iframe origins. Artifacts will not render.",id:"3Hw5zW3SBt"})),long:vt.longDescription(`"Nonessential services" covers three outbound fetches the app runs without: **connector favicons** (the icon proxy), the **artifact-preview** iframe origin, and the **MCP Apps widget** iframe origin (\`*.claudemcpcontent.com\`). Turning this on blocks all three.

**What you lose when this is on:** connectors show without icons, artifacts do not render in conversations, and connectors that return MCP Apps show the text tool result instead of the widget.

Destinations are listed under Egress Requirements \u2192 Nonessential services.`)},predicates:{warn:(e)=>e===!0?Ut.msg({defaultMessage:"This disables connector icons, artifact previews, and MCP Apps widgets. Artifacts will not render in conversations, and connectors that return MCP Apps show the text tool result instead of the widget.",id:"aqHCy/bK6k"}):null}}),usageMetrics:vt.field(Dr.z.boolean().optional(),{flatKey:"usageMetricsEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.46388.1"},visibility:"public-undocumented"},remotePolicy:{hybrid:{scope:"only",derived:!0},hotApplied:!0},predicates:{show:()=>!1},title:Ut.msg({defaultMessage:"Report usage metrics to your Claude.ai organization",id:"hFaw5XYgDV"}),category:"telemetry",group:uo.ANTHROPIC_TELEMETRY_GROUP,order:3,description:{short:vt.shortDescription(Ut.msg({defaultMessage:"Set by the control plane from the organization\u2019s Claude Code analytics setting; not editable here. Reports per-user token, cost and session counts (no content).",id:"6k4DCNJe7b"})),long:vt.longDescription(`Server-derived: the Claude.ai control plane sets this key, each time it serves the configuration, from the organization's Claude Code analytics setting in Admin settings; it is off until an admin turns that setting on, and off for organizations under HIPAA or customer-managed encryption keys. It is not authored in any form, MDM profile, or bootstrap server, and a value stored anywhere else is ignored.

When on, each signed-in desktop periodically reports usage counters to your Claude.ai organization: per-member **token counts** (input, output, cache read, cache write) by model, the desktop's **cost estimate** for those tokens, and **session counts**, tagged with the member's account, the model name, the app surface (Chat, Cowork or Code), an opaque per-session and per-install identifier, and the app version, operating system and architecture. No prompts, responses, file contents, tool inputs or outputs are included. Sessions and the cost estimate appear in your organization's Claude.ai analytics (Analytics \u2192 Claude Code); the Admin API Claude Code usage report carries those plus per-member, per-model token counts.

This is independent of **Block essential telemetry** and **Block nonessential telemetry**: those govern diagnostics sent to Anthropic, this one populates your own organization's dashboard, and either can be on without the other. Reports go to the same Claude.ai endpoint the desktop fetches its configuration from, so no additional firewall entry is needed. A change takes effect at the next configuration sync without a relaunch.`)}})})});var Z_=E(function(YA){Object.defineProperty(YA,"__esModule",{value:!0});YA.MANAGED_MCP_PRESETS=void 0;YA.isAnthropicM365ConnectorUrl=JA;YA.isAnthropicM365Connector=Mte;var Dte="07c030f6-5743-41b7-ba00-0a6e85f37c17",jte=[".claude.com",".fedstart.com"];function JA(e){if(!e)return!1;if(!jte.some((t)=>e.hostname.endsWith(t)))return!1;return e.hostname.startsWith("microsoft365.mcp.")||e.pathname.includes("/m365/")}function Mte(e){if(!(e===null||e===void 0?void 0:e.url)||e.custom_oauth_client_id)return!1;try{return JA(new URL(e.url))}catch(t){return!1}}YA.MANAGED_MCP_PRESETS=[{label:"Microsoft 365",item:{name:"m365",url:"https://microsoft365.mcp.claude.com/mcp",transport:"http",oauth:{scope:`api://${Dte}/access_as_user offline_access`}}},{label:"Box",item:{name:"box",url:"https://mcp.box.com",transport:"http",oauth:{authorizationServer:["https://api.box.com"]}}},{label:"Microsoft 365",kind:"builtin",item:{name:"Microsoft 365",server:"microsoft365"}},{label:"Web search",kind:"builtin",item:{name:"Web search",server:"websearch",provider:"brave"}},{label:"GitHub",kind:"builtin",item:{name:"GitHub",server:"github"}}]});var B_=E(function(tT){Object.defineProperty(tT,"__esModule",{value:!0});tT.McpConfig=void 0;tT.isMcpPersistentAlwaysAllowEnabled=Ute;var fo=sn(),QA=Js(),rl=Dn(),It=st(),il=En(),zt=ln(),eT=Z_(),ar=fr(),mo=ao();function Lte(e,t){var r;let i=typeof t.url==="string"?t.url.trim():"",n=t.headers&&typeof t.headers==="object"?t.headers:void 0,o=[],s;try{s=i?new URL(i):void 0}catch(d){}if((s===null||s===void 0?void 0:s.protocol)==="http:"){let d=s.hostname;if(d!=="localhost"&&d!=="127.0.0.1")o.push(e.formatMessage({defaultMessage:"Endpoint is plain HTTP; auth credentials travel in cleartext.",id:"sqfi+II5M9"}))}let u=QA.credentialHeadersWarn(n,e,"headersHelper");if(u!==null)o.push(u);let c=n?(r=Object.entries(n).find(([d])=>d.toLowerCase()==="authorization"))===null||r===void 0?void 0:r[1]:void 0;if(typeof c==="string"&&/^Bearer\s+\S{12,}$/i.test(c))o.push(e.formatMessage({defaultMessage:"Shared bearer token: every org member authenticates as the same identity.",id:"y4dl3eyfcO"}));return o.length>0?o.join(" "):null}tT.McpConfig=fo.z.object({managedServers:It.field(It.annotate(ar.ManagedMcpServers.optional(),{redact:"presence"}),{flatKey:"managedMcpServers",readers:["desktop","m365"],groupOverride:"nameSubset",support:{enabled:[{scopes:["3p"],availableInVersion:"1.2581.0"},{scopes:["1p"],availableInVersion:"1.24012.11"}]},remotePolicy:{mcpUrlHygiene:!0},title:zt.msg({defaultMessage:"Managed MCP servers",id:"DC+lIM7C8k"}),checkDropped:ar.checkManagedMcpServersForDrops,deprecations:ar.MANAGED_MCP_SERVERS_DEPRECATIONS,failClosedValue:[],egressRequirements:(e)=>Array.isArray(e)?e.flatMap((t)=>{if(ar.isBuiltinMcpEntry(t))return[...ar.hostsForBuiltinMcpEntry(t)];if(t.transport==="stdio")return[];let r=[rl.safeHostname(t.url)];if(t.oauth&&t.oauth.mode!=="dcr"){let i=ar.resolveByoAsSelection(t.oauth);if(i.via==="tenant")r.push("login.microsoftonline.com");r.push(...ar.byoAsSelectionUrls(i).map(rl.safeHostname))}return r}).filter((t)=>!!t):[],category:"connectors",group:mo.MCP_SERVERS_GROUP,order:0,addLabel:zt.msg({defaultMessage:"Add server",id:"pOeEMxHCXp"}),customRenderer:"mcpProbe",description:{short:It.shortDescription(zt.msg({defaultMessage:"Org-pushed MCP servers: remote (HTTP/SSE) or local (stdio command). May embed bearer tokens.",id:"wG2dpZSzTk"})),long:It.longDescription('For OAuth-authenticated entries, the app builds the redirect URI as `http://<callbackHost>:<callbackPort>/callback`; register that exact value with the OAuth provider. Tokens refresh automatically during a session.\n\n`toolPolicy` locks the per-tool approval state, keyed by tool name: `"blocked"` removes the tool from the session and labels it admin-blocked, `"ask"` requires approval on every call (Allow once / Deny only; no persistent always-allow), `"allow"` pre-approves. Tools **not listed** follow the user\'s choice: the prompt offers a persistent Always allow, except for tools that can modify data, which show a session-scoped **Allow for this task** alongside **Allow for all tasks** with a malicious-instruction warning. In Code sessions, `blocked` and `ask` are forwarded as Claude Code permission rules; `allow` is not.\n\nKeys may contain `*` wildcards (`"read_*"` matches every tool whose name starts with `read_`; anchored, and `*` is the only wildcard). When several wildcard keys match, the strictest applies (blocked > ask > allow). An exact-name key wins over matching wildcards, with two exceptions in the stricter direction: in Code sessions a wildcard `ask`, or a wildcard `blocked` other than the bare `"*"`, beats a less strict exact key (so `"*": "blocked"` plus exact `"allow"` entries still works as deny-by-default there); and in chat approval prompts and always-allow persistence a wildcard `ask` keeps every matching tool behind a per-call prompt even when a more permissive exact key matches, while direct tool invocations such as artifact or widget calls follow the exact key.\n\nFor the bundled Microsoft 365 connector, the send tools (`outlook_send_mail`, `outlook_send_draft`, `outlook_forward_mail`, `outlook_create_event`, `outlook_update_event`, `teams_send_chat_message`, `teams_send_channel_message`, `teams_reply_channel_message`) cannot be loosened below `ask`; an `allow` setting resolves to `ask`.',{docsUrl:`${il.COWORK_3P_DOCS_BASE}/configuration#managedmcpservers`})},presets:eT.MANAGED_MCP_PRESETS,blankItem:{transport:"http"},predicates:{warn:(e,t,r)=>Lte(r,e)}}),persistentAlwaysAllowEnabled:It.field(fo.z.boolean().optional(),{flatKey:"mcpPersistentAlwaysAllowEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.24012.9"}},title:zt.msg({defaultMessage:"Allow persistent tool approvals",id:"OmQqCV/O12"}),default:!0,failClosedValue:!1,category:"connectors",group:mo.MCP_SERVERS_GROUP,order:1,description:{short:It.shortDescription(zt.msg({defaultMessage:"Offer the persistent \u201CAlways allow\u201D approval options for MCP tools. Disable to keep tool approvals per-call or session-scoped only.",id:"GXMHY2UvCF"})),long:It.longDescription("When enabled (the default), approval prompts for tools without a `toolPolicy` entry offer a persistent grant \u2014 **Always allow**, or **Allow for all tasks** for tools that can modify data \u2014 the Tool permissions picker in Connector settings lets users pre-approve tools, and those grants persist across sessions with no expiry.\n\nWhen disabled, the persistent options are hidden from approval prompts and from the Connector settings picker, previously stored persistent grants stop being honored, and scheduled-task runs no longer record or replay cross-run tool approvals. Session-scoped approvals are unchanged: users can still approve each call, and tools that can modify data keep the session-scoped **Allow for this task** option.\n\nA per-tool `toolPolicy` entry on `managedMcpServers` always takes precedence over this key: `blocked`, `ask`, and `allow` behave exactly as documented there whether this key is enabled or not.\n\nThis key governs the chat and Cowork surfaces. Code sessions use a separate permission path this key does not cover \u2014 govern Code tool approvals with per-tool `toolPolicy` entries, whose `blocked` and `ask` values are forwarded there.",{docsUrl:`${il.COWORK_3P_DOCS_BASE}/configuration#mcppersistentalwaysallowenabled`})}}),claudeInChromeEnabled:It.field(fo.z.boolean().optional(),{flatKey:"claudeInChromeEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.34493.0"},visibility:"public-undocumented"},remotePolicy:{hybrid:{scope:"only",derived:!0}},predicates:{show:()=>!1},title:zt.msg({defaultMessage:"Enable Claude in Chrome",id:"q3VdR8mZpL"}),category:"connectors",group:mo.MCP_SERVERS_GROUP,order:3,description:{short:It.shortDescription(zt.msg({defaultMessage:"Set by the control plane from the organization\u2019s Claude in Chrome admin setting; not editable here. Lets sessions drive the user\u2019s browser via the extension.",id:"Hn7tK2cWqs"})),long:It.longDescription(`Server-derived: the Claude.ai control plane sets this key, each time it serves the configuration, from the organization's Claude in Chrome setting (Admin settings \u2192 Claude in Chrome \u2014 the same switch, site allowlist/blocklist, and per-role access that govern the extension itself) and the signed-in member's role. It is not authored in any form, MDM profile, or bootstrap server, and a value stored anywhere else is ignored.

When on, Cowork and Code sessions can use the Claude in Chrome browser tools (navigate, read page, click, type, screenshot) in the user's Google Chrome or Microsoft Edge. Tool calls travel over the browser's local native-messaging connection between the app and the extension and are encrypted end to end between the two; page content is never relayed through Anthropic servers, and inference stays on the configured provider; the extension's hosted URL-safety check stays on, so the address of each page the agent acts on is checked against the Anthropic API. macOS and Windows only.

Before any tool call, Claude Desktop and the extension each obtain a short-lived signed identity statement from the Anthropic API and pair only when both belong to the same account in your organization, so those two small requests do go to Anthropic. Installed from the Chrome Web Store, the extension runs in third-party mode on its own for members of a hybrid organization \u2014 nothing runs that does not arrive over the verified pairing, and per-site permission prompts are delegated to Claude Desktop \u2014 so no separate Chrome policy is needed. Chrome managed policy stays optional for locked-down fleets: \`forceLoginOrgUUID\` may name the organization(s) allowed to take control of the extension wherever the policy reaches (a Claude Desktop from any other organization is refused), and \`blockedUrlPatterns\` may be added and applies on top of the hosted URL-safety check. Requires \`isLocalDevMcpEnabled\` to remain enabled. Off unless the organization's Claude in Chrome setting is on.`)}}),localStdioEnabled:It.field(fo.z.boolean().optional(),{flatKey:"isLocalDevMcpEnabled",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.2581.0"}},title:zt.msg({defaultMessage:"Allow user-added MCP servers",id:"1QKV7FS8FM"}),default:!0,failClosedValue:!1,egressRequirements:(e)=>e===!1?[]:rl.PYTHON_EXTENSION_RUNTIME_HOSTS,egressRequirementsLabel:zt.msg({defaultMessage:"User-added MCP (Python runtime)",id:"O0zxaLsWs9"}),category:"connectors",group:mo.MCP_SERVERS_GROUP,order:2,description:{short:It.shortDescription(zt.msg({defaultMessage:"Local stdio servers added via the Developer settings. Remote servers come from the managed list above or organization plugins.",id:"1NMgra1xGv"}))}}),toolTimeoutSec:It.field(fo.z.coerce.number().int().min(60).max(3600).optional(),{flatKey:"mcpToolTimeoutSec",support:{enabled:{scopes:["3p"],availableInVersion:"1.37937.0"}},title:zt.msg({defaultMessage:"MCP tool call timeout",id:"yfZOCQ8bcU"}),category:"connectors",group:mo.MCP_SERVERS_GROUP,order:4,suffix:zt.msg({defaultMessage:"seconds",id:"8TQoLRh7Ea"}),placeholder:zt.msg({defaultMessage:"180",id:"H3SKnBW98K"}),description:{short:It.shortDescription(zt.msg({defaultMessage:"Per-call timeout for MCP tool calls, in seconds. Default 180 (3 minutes).",id:"TKg4Ha2DBx"})),long:It.longDescription("Sets the per-call timeout the agent applies to every MCP tool call; a call that runs longer fails with a timeout error the model can see. Cowork and chat sessions default to 180 seconds. Code sessions have no desktop-imposed MCP tool timeout today, so setting this key introduces one there as well. The desktop's own request deadlines toward MCP servers \u2014 the managed servers above and, where `isLocalDevMcpEnabled` permits them, user-added local servers \u2014 follow this value so they never cut a call short first; while the key is unset, calls to user-added local servers are additionally limited to 60 seconds by the desktop. Values outside 60\u20133600 are rejected at parse time (the error is listed in the diagnostics report) and the defaults apply.\n\nThe timeout is global (there is no per-server or per-tool form), so size it for the slowest tool you need to complete: long-running tools on one server extend the window during which a stuck call on any server holds its turn. Cowork's built-in shell tool runs under the same cap: a single command's `timeout_ms` (itself limited to 600 seconds) cannot exceed this value.",{docsUrl:`${il.COWORK_3P_DOCS_BASE}/configuration#mcptooltimeoutsec`})}})});function Ute(e){var t;return((t=e.mcp)===null||t===void 0?void 0:t.persistentAlwaysAllowEnabled)!==!1}});var Cu=E(function(ST){Object.defineProperty(ST,"__esModule",{value:!0});ST.WorkspaceConfig=ST.BUILTIN_TOOL_POLICY_ASK_SESSION=ST.BUILTIN_ASK_POLICY_VALUES=ST.BUILTIN_TOOL_NAMES=void 0;ST.builtinToolScope=Hte;ST.scanRuleList=cT;ST.parseBuiltinRule=ul;ST.builtinRuleToolName=H_;ST.canonicalBuiltinRule=os;ST.isScopedBuiltinRule=qte;ST.checkBuiltinToolPolicyForDrops=mT;ST.checkDisabledBuiltinToolsForDrops=hT;ST.builtinRuleWarnings=Wte;ST.checkEgressHostsForDrops=gT;ST.resolveDisabledBuiltinTools=q_;ST.isChatTabEnabled=bT;ST.isSkillCreationEnabled=Jte;ST.isChatAdvancedFileAnalysisEnabled=Yte;ST.resolveBuiltinAskTools=vT;ST.toolsCoveredByScopedRule=wT;ST.resolveBuiltinAskToolNames=Xte;var Ae=sn(),ha=rr(),jr=Dn(),F=st(),wt=En(),Y=ln(),dp=mr(),ol=fr(),Vt=ao(),rT=Y.msg({defaultMessage:"Network proxy",id:"wER6775GSj"}),iT=Y.msg({defaultMessage:"End-user attribution",id:"enduserAttrTtl"}),K_=(e)=>[jr.safeHostname(e)].filter((t)=>!!t),Fte=Ae.z.object({path:F.subfield(F.annotate(Ae.z.string().min(1),{pathKind:"folder"}),{label:Y.msg({defaultMessage:"Path",id:"P6LP7JosNq"}),support:{availableInVersion:"1.14271.0"},isPrimaryKey:!0,mono:!0,placeholder:Y.msg({defaultMessage:"~/Documents/work",id:"/dk65J5QxC"}),description:{short:F.shortDescription(Y.msg({defaultMessage:"Absolute folder path. May start with ~ or one of the listed %VAR% tokens, expanded per user. Subfolders are included.",id:"tFB6xfvwBv"}))}}),isDefaultSelected:F.subfield(Ae.z.boolean().optional(),{label:Y.msg({defaultMessage:"Pre-select on new task",id:"Dk3pnI8vXq"}),support:{availableInVersion:"1.14271.0"},description:{short:F.shortDescription(Y.msg({defaultMessage:"Shows as a folder chip on the new-task page and skips the trust prompt. Users can remove it.",id:"P3a+4xY9Hb"}),{docsOnly:!1})}}),mode:F.subfield(Ae.z.enum(["rw","ro"]).optional(),{label:Y.msg({defaultMessage:"Access mode",id:"Dt4A+S9duA"}),support:{availableInVersion:"1.26832.0"},description:{short:F.shortDescription(Y.msg({defaultMessage:"Read-only folders can be viewed and searched but not modified in Cowork. In Code, applies to file tools only; Bash and SSH do not yet enforce read-only.",id:"XMxsnX6Se9"}),{docsOnly:!1}),long:F.longDescription(`Read-only folders can be viewed and searched but not modified in Cowork (by Claude or via the UI). Bash runs in Cowork's isolated workspace where the folder is mounted read-only at the OS level; file-tool writes (Edit, Write) are blocked in-process by Claude Desktop.

In Code, read-only applies to Claude file tools only; Bash in Code sessions and SSH sessions do **not** yet enforce read-only mode. `+"A read-only folder that contains Claude's own data directory (for example the home folder) is enforced in Cowork only \u2014 configure narrower folders for Code coverage.",{docsOnly:!1})}})});ST.BUILTIN_TOOL_NAMES=["Bash","Read","Write","Edit","Glob","Grep","NotebookEdit","WebFetch","WebSearch","Task","TodoWrite","TaskCreate","TaskUpdate","TaskGet","TaskList","TaskStop","Skill","REPL","JavaScript","AskUserQuestion","ToolSearch","SendUserMessage"];var up=["WebSearch","WebFetch"],oT=["WebFetch"],Zte="a scoped entry reaches Code sessions only, never Cowork; allow specific hosts with the egress host settings (coworkEgressAllowedHosts), one list for Cowork and Code",sl={Read:["Read","Grep","Glob"],Edit:["Edit","Write","NotebookEdit"]},aT=new Map(Object.entries(sl).flatMap(([e,t])=>t.filter((r)=>r!==e).map((r)=>[r,e]))),sT="\\((\\S[^\\r\\n]*)\\)",Bte={Bash:["curl *"],Read:["//etc/**","**/secrets/**"],Edit:["**/*.env","//etc/**"]},Kte=["Bash","Task","Skill"];function Hte(e){let t=Bte[e];if(t!==void 0)return{examples:t};let r=aT.get(e);if(r!==void 0)return{via:r};return oT.includes(e)?{hostsViaEgress:!0}:void 0}var lT=new RegExp(`^(?:(${ST.BUILTIN_TOOL_NAMES.filter((e)=>!up.includes(e)).join("|")})(?:${sT})?|(${up.join("|")}))$`),uT=new RegExp(`^([^\\s()]+)(?:${sT})?$`);function cT(e){let t=(o,s)=>{let u=e.indexOf(e[o],o+1);for(let c=o+1,d=s;c<u;c++){let f=e[c];if(f==="(")d++;else if(f===")"&&d>0)d--;else if(f===","&&d===0)return-1}return u},r=[],i=0,n="";for(let o=0;o<e.length;o++){let s=e[o];if(s==='"'||s==="'"){let u=t(o,i);if(u!==-1){n+=e.slice(o,u+1),o=u;continue}}else if(s==="(")i++;else if(s===")"&&i>0)i--;else if(s===","&&i===0){r.push(n),n="";continue}n+=s}return r.push(n),{segments:r,open:i>0}}function dT(e){return cT(e).segments.length>1}var Vte=/^[a-z_][a-z0-9_]+:/,fT=new Map(ST.BUILTIN_TOOL_NAMES.map((e)=>[e.toLowerCase(),e]));function ul(e){let t=lT.exec(e);if(t===null||dT(e))return;return t[3]!==void 0?{tool:t[3]}:{tool:t[1],...t[2]!==void 0&&{content:t[2]}}}function H_(e){var t;return(t=ul(e))===null||t===void 0?void 0:t.tool}function os(e){let t=uT.exec(e);return t!==null&&t[2]==="*"&&fT.get(t[1].toLowerCase())===t[1]?t[1]:e}function qte(e){var t;return((t=ul(e))===null||t===void 0?void 0:t.content)!==void 0}function pT(e){var t;let r=ul(e);if(r!==void 0){let{tool:o,content:s}=r;if(s===void 0)return;if(s==="*")return`"(*)" means every call; it is applied as the bare name "${o}"`;if(Vte.test(s))return;let u=aT.get(o);if(u!==void 0)return`Claude Code matches file-path patterns only on ${u}(\u2026) rules, which cover ${sl[u].join("/")}; use "${u}(${s})"`;if(!(o in sl)&&!Kte.includes(o))return`${o} matches rule content only in Claude Code's ${o}(<field>:<pattern>) form; use the bare name "${o}" to cover every call`;return}if(dT(e))return"looks like several rules joined by commas; use one entry per rule";let i=(t=uT.exec(e))===null||t===void 0?void 0:t[1];if(i===void 0)return"malformed rule; expected Tool or Tool(pattern) on one line";let n=fT.get(i.toLowerCase());if(n===void 0)return;if(n!==i)return`tool names are case-sensitive; use "${n}"`;return oT.includes(n)?`${n} takes the bare name only \u2014 ${Zte}`:`${n} takes the bare name only`}var Gte=`Each entry is a Claude Code tool name (\`${ST.BUILTIN_TOOL_NAMES.join("`, `")}\`) or an argument-scoped [permission rule](https://code.claude.com/docs/en/permissions#permission-rule-syntax) such as \`Bash(curl *)\` or \`Edit(**/*.env)\`. A bare name covers every call; a scoped rule covers matching calls in every permission mode, including Auto and bypass. Scopes are matched for \`Bash(\u2026)\` (a command pattern) and for file paths written as \`Read(\u2026)\` (covers \`${sl.Read.join("`, `")}\`) or \`Edit(\u2026)\` (covers \`${sl.Edit.join("`, `")}\`); other tools take \`Tool(<field>:<pattern>)\`. \`${up.join("` and `")}\` are bare-name only: per-host web access is \`coworkEgressAllowedHosts\`.

Scoped \`Bash(\u2026)\` rules apply in Code sessions and in VM-sandboxed Cowork sessions (\`requireCoworkFullVmSandbox\`); Cowork's own sandboxed shell honors bare names only. Anchor file patterns with \`**/\` (\`Read(**/secrets/**)\`), because in the VM sandbox a host absolute path does not match. Scoped rules need a build that supports them across the whole fleet (\`disableAutoUpdates\` pins builds): an older build passes a scoped entry to Claude Code unchecked. An entry whose pattern contains \`)\` followed by a space or comma is enforced only through Claude Code's managed-settings channel, so another Claude Code [managed-settings source](${wt.COWORK_3P_DOCS_BASE}/code#interaction-with-claude-code%E2%80%99s-own-managed-settings) replaces it unless that source sets \`parentSettingsBehavior\` to \`"merge"\`; every other entry is enforced either way.

An unusable entry (a lowercase tool name, an unbalanced parenthesis, a scoped \`${up.join("(\u2026)` or `")}(\u2026)\`) is kept, because the deny list is served exactly as written, and raises a configuration warning.`;ST.BUILTIN_ASK_POLICY_VALUES=["allow","ask"];ST.BUILTIN_TOOL_POLICY_ASK_SESSION={path:'builtinToolPolicy: "ask-session"',use:'"ask"',effect:'the entry will be read as "ask" (approval on every call), like any unrecognized value',...ha.BATCH_2026_09,match:(e)=>typeof e==="object"&&e!==null&&!Array.isArray(e)&&Object.values(e).some((t)=>t==="ask-session"),rewrite:(e)=>Object.fromEntries(Object.entries(e).map(([t,r])=>[t,r==="ask-session"?"ask":r]))};function mT(e,t){var r;let i=ha.applyLegacy(ST.BUILTIN_TOOL_POLICY_ASK_SESSION,e);if(!i||typeof i!=="object")return;for(let[n,o]of Object.entries(i)){let s=os(n);if(s!==n)t(`builtinToolPolicy["${n}"]: "(*)" means every call; applied as the bare name "${s}"`,"clamp");if(H_(s)===void 0)t(`builtinToolPolicy["${n}"] dropped: ${(r=pT(n))!==null&&r!==void 0?r:"unknown built-in tool"}`,"drop");else if(o==="blocked")t(`builtinToolPolicy["${n}"]: "blocked" is not a built-in tool policy; treated as "ask" (use disabledBuiltinTools to remove the tool)`,"drop");else if(o!=="allow"&&o!=="ask")t(`builtinToolPolicy["${n}"]: unrecognized policy ${JSON.stringify(o)}; treated as "ask"`,"drop")}}function hT(e,t){if(!Array.isArray(e))return;e.forEach((r,i)=>{if(typeof r!=="string")t(`disabledBuiltinTools[${i}] dropped: entries must be strings (got ${r===null?"null":Array.isArray(r)?"array":typeof r})`,"drop");else if(os(r)!==r)t(`disabledBuiltinTools entry ${JSON.stringify(r)}: "(*)" means every call; applied as the bare name "${os(r)}"`,"clamp")})}function Wte(e,t){return t.flatMap((r)=>{let i=pT(r);return i===void 0?[]:[`${e} entry ${JSON.stringify(r)} is not enforced as written: ${i}`]})}function gT(e,t){if(!Array.isArray(e))return;for(let r of e)if(typeof r!=="string"||jr.parseEgressHostEntry(r)===null)t(`coworkEgressAllowedHosts entry ${JSON.stringify(r)} dropped: must be ${jr.EGRESS_ENTRY_GRAMMAR}`)}ST.WorkspaceConfig=Ae.z.object({disabledBuiltinTools:F.field(Ae.z.preprocess((e)=>Array.isArray(e)?[...new Set(e.filter((t)=>typeof t==="string").map(os))]:e,F.annotate(Ae.z.array(Ae.z.string()),{maxItems:100})).optional(),{flatKey:"disabledBuiltinTools",failClosedValue:[...ST.BUILTIN_TOOL_NAMES],checkDropped:hT,support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.2581.0"}},title:Y.msg({defaultMessage:"Disabled built-in tools",id:"iGPHC9Tm20"}),category:"sandbox",group:Vt.TOOLS_GROUP,order:4,customRenderer:"builtinToolRules",placeholder:Y.msg({defaultMessage:"WebSearch or Bash(curl *)",id:"KHWonN3qfv"}),description:{short:F.shortDescription(Y.msg({defaultMessage:"Built-in tools, or argument-scoped permission rules such as Read(**/.env), denied in Cowork and Code.",id:"9xjjQpa1S8"})),long:F.longDescription(Gte)},predicates:{locked:[{when:(e)=>{var t;return dp.isBedrockFamily((t=e.inference)===null||t===void 0?void 0:t.provider)},append:["WebSearch"]}]}}),disableBundledSkills:F.field(Ae.z.boolean().optional(),{flatKey:"disableBundledSkills",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.15962.0"}},failClosedValue:!0,title:Y.msg({defaultMessage:"Disable bundled skills and workflows",id:"kpCOjtwfPF"}),category:"sandbox",group:Vt.GENERAL_RESTRICTIONS_GROUP,order:6,description:{short:F.shortDescription(Y.msg({defaultMessage:"Disables Claude Code\u2019s bundled skills and workflows (deep-research and similar). Use where WebFetch/WebSearch aren\u2019t available.",id:"Q90IY9SGu1"}))}}),skillCreationEnabled:F.field(Ae.z.boolean().optional(),{flatKey:"skillCreationEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.25927.0"}},title:Y.msg({defaultMessage:"Allow user-created skills",id:"y486fMBVj/"}),default:{displayOnly:!0},failClosedValue:!1,category:"sandbox",group:Vt.GENERAL_RESTRICTIONS_GROUP,order:6.5,description:{short:F.shortDescription(Y.msg({defaultMessage:"Allow users to create and upload their own skills. When off, the creation and upload surfaces are hidden and the agent\u2019s skill-creation tools are disabled.",id:"Cpqtiix6lD"})),long:F.longDescription("When on (default), users can create new skills and upload skill files in the app. Set to `false` to block user skill creation: the skill-creation and upload surfaces are hidden (the `skill_creation` feature is served as blocked by the organization), and the agent's skill-creation tools (saving skills from a conversation, skill proposals) are not offered in sessions \u2014 the same effect as turning off the **User-created skills** organization setting available to claude.ai enterprise admins.\n\nThis is a feature-availability control enforced in the app's UI, not a data boundary: skills are files on the user's machine, and files already present there (or placed there outside the app) are not removed or blocked by this key. Skills themselves remain usable; organization-distributed plugins and bundled skills are unaffected (to disable bundled skills, use `disableBundledSkills`).",{docsUrl:`${wt.COWORK_3P_DOCS_BASE}/configuration#skillcreationenabled`})}}),builtinToolPolicy:F.field(F.annotate(Ae.z.preprocess((e)=>{let t=ha.applyLegacy(ST.BUILTIN_TOOL_POLICY_ASK_SESSION,e);return t&&typeof t==="object"&&!Array.isArray(t)?Object.entries(t).filter(([r])=>H_(os(r))!==void 0).reduce((r,[i,n])=>{let o=os(i),s=n==="allow"?"allow":"ask";return r[o]=r[o]==="ask"?"ask":s,r},{}):t},Ae.z.record(Ae.z.string().regex(lT),Ae.z.enum(ST.BUILTIN_ASK_POLICY_VALUES))).optional(),{redact:"toolRules"}),{flatKey:"builtinToolPolicy",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.8089.0"},values:{"ask-session":{availableInVersion:"1.40609.0"}}},title:Y.msg({defaultMessage:"Built-in tool policy",id:"hhKxQ3MtxT"}),failClosedValue:Object.fromEntries(ST.BUILTIN_TOOL_NAMES.map((e)=>[e,"ask"])),deprecations:[ST.BUILTIN_TOOL_POLICY_ASK_SESSION],checkDropped:mT,category:"sandbox",group:Vt.TOOLS_GROUP,order:3,customRenderer:"builtinToolRules",placeholder:Y.msg({defaultMessage:"WebFetch or Bash(curl *)",id:"tQLBe0W6Km"}),addLabel:Y.msg({defaultMessage:"Add policy",id:"6TgDeF8iRs"}),description:{short:F.shortDescription(Y.msg({defaultMessage:"Approval policy per built-in tool or argument-scoped rule such as Bash(curl *). \u201Cask\u201D requires user approval before each matching call; \u201Callow\u201D is the default.",id:"H4Ea6XAuEf"})),long:F.longDescription("Keys use the same tool names and argument-scoped rule syntax as **Disabled built-in tools** (`disabledBuiltinTools`), and scopes apply in the same sessions. Scoped **ask** rules reach sessions only through Claude Code's managed-settings channel, so another Claude Code managed-settings source replaces them unless it sets `parentSettingsBehavior` to `\"merge\"` (bare names hold either way). They need the same fleet-wide build support, and an older build drops a scoped **ask** entry as a configuration error (which also blocks WSL sessions on Windows until that client updates), so the tool runs unprompted.\n\nAn **ask** entry, bare or scoped, also turns off the app's remembered \u201Calways allow\u201D choices for that tool, so each prompted call is confirmed individually. In Code side chats, and in Cowork sessions that run tools on the host, **ask** on a file tool (`Read`, `Write`, `Edit`, `Glob`, `Grep`) blocks matching calls instead of prompting; Code sessions and VM-sandboxed Cowork sessions show the prompt. An unusable entry is dropped and recorded as a configuration error; a value other than `allow` or `ask` is treated as `ask` and reported. To remove a tool or deny a rule outright, use **Disabled built-in tools** instead.")}}),autoModeEnabled:F.field(Ae.z.boolean().optional(),{flatKey:"autoModeEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.10628.0"}},title:Y.msg({defaultMessage:"Allow Auto mode",id:"0QsHlMb8HD"}),default:!1,category:"sandbox",group:Vt.GENERAL_RESTRICTIONS_GROUP,order:5,description:{short:F.shortDescription(Y.msg({defaultMessage:"Offer Auto mode in the Cowork and Code permission selectors. Claude decides which actions need approval.",id:"Aba2uTiXAG"})),long:F.longDescription(`When enabled, users can select **Auto mode** (Code) / **Automatically approve** (Cowork). Claude runs a safety classifier on each action and only prompts for approval on actions it judges risky, instead of following the static per-tool policy.

Requires a model that supports the safety classifier \u2014 which models qualify depends on the deployment's provider and the app version. Models without support show the option greyed out. \`builtinToolPolicy\` and this key may both be set; Auto mode is a user-selectable option alongside the default policy, not a replacement for it.

In Code sessions, a separately deployed Claude Code [managed-settings](${wt.COWORK_3P_DOCS_BASE}/code#interaction-with-claude-code%E2%80%99s-own-managed-settings) file that sets \`disableAutoMode\` to \`"disable"\` overrides this key and keeps Auto mode hidden.`,{docsUrl:`${wt.COWORK_3P_DOCS_BASE}/configuration#automodeenabled`})}}),disableBypassPermissionsMode:F.field(Ae.z.boolean().optional(),{flatKey:"disableBypassPermissionsMode",support:{enabled:{scopes:["3p"],availableInVersion:"1.46388.1"}},title:Y.msg({defaultMessage:"Disable bypass permissions mode",id:"CIeOvXouGu"}),default:{displayOnly:!1},failClosedValue:!0,category:"sandbox",group:Vt.GENERAL_RESTRICTIONS_GROUP,order:5.5,description:{short:F.shortDescription(Y.msg({defaultMessage:"Remove the bypass permissions mode from Code sessions and Cowork tasks, so Claude always follows the permission policy. Off by default.",id:"eXwx/L4TgM"})),long:F.longDescription(`When set to \`true\`, sessions cannot run in bypass permissions mode: the app stops offering the mode in Code and Cowork, and a session that requests it anyway is downgraded. This is the \`disableBypassPermissionsMode\` setting from the \`permissions\` section of Claude Code's [managed settings](${wt.COWORK_3P_DOCS_BASE}/code#interaction-with-claude-code%E2%80%99s-own-managed-settings); a separately deployed Claude Code managed-settings file that sets it to \`"disable"\` also removes the mode, whichever source sets it.

Unset (default): users the deployment otherwise allows can choose bypass permissions mode.`,{docsUrl:`${wt.COWORK_3P_DOCS_BASE}/configuration#disablebypasspermissionsmode`})}}),toolSearchEnabled:F.field(Ae.z.boolean().optional(),{flatKey:"toolSearchEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.21459.0"}},title:Y.msg({defaultMessage:"Enable tool search",id:"3b6nGnLx6b"}),default:!1,category:"sandbox",group:Vt.TOOLS_GROUP,order:5,description:{short:F.shortDescription(Y.msg({defaultMessage:"Load MCP tool schemas on demand (tool search) instead of inlining every schema into context.",id:"jPPLehrZ3d"})),long:F.longDescription("When enabled, Cowork, Code, and Chat sessions place only tool names in context up front, and Claude fetches a tool's full schema the first time it needs it. Use this when many MCP tools are configured and their inlined schemas crowd out the context window. If your endpoint does not accept the request shape it then receives, requests fail with HTTP 400.\n\n- **Claude API, Vertex AI, Bedrock, or Bedrock Mantle with no custom base URL**: not needed. The app leaves Claude Code's experimental betas on there, as terminal Claude Code does, so tool search is on by default (on Vertex AI, for Claude 4.5 and newer models). To turn it off in Code, Cowork, and Chat, set `ENABLE_TOOL_SEARCH` to `false` in the `env` block of OS-level Claude Code managed settings (with `parentSettingsBehavior: \"merge\"`). Earlier app versions treat these like the last case.\n- **Gateway provider, app versions bundling Claude Code 2.1.247 or later**: requests add only the tool-search shape (the `tool-search-tool-2025-10-19` `anthropic-beta` value, deferred tool loading, `tool_reference` content blocks); every other experimental Claude Code beta stays suppressed. OS-level Claude Code managed settings that keep that suppression or turn `ENABLE_TOOL_SEARCH` off still win; set `ENABLE_TOOL_SEARCH` to `force` there instead (with `parentSettingsBehavior: \"merge\"`). Sessions in Claude Code's own gateway mode (`CLAUDE_CODE_USE_GATEWAY`) get its gateway-safe tool-search shape regardless.\n- **Foundry, a custom base URL, and earlier app versions**: the app suppresses Claude Code's experimental betas for the session and the key lifts that, so requests carry the tool-search shape together with Claude Code's other experimental betas for that provider. On Vertex with app versions bundling Claude Code older than 2.1.221, leave this unset while any model older than Claude 4.5 is in use; those engines send the header regardless of model and Vertex's pre-4.5 stacks reject it.",{docsUrl:`${wt.COWORK_3P_DOCS_BASE}/gateway#mcp-tool-search`})}}),skipWebFetchPreflight:F.field(Ae.z.boolean().optional(),{flatKey:"skipWebFetchPreflight",support:{enabled:{scopes:["3p"],availableInVersion:"1.37937.0"}},title:Y.msg({defaultMessage:"Skip WebFetch domain check",id:"N2lNsOXNuF"}),default:{displayOnly:!1},category:"sandbox",group:Vt.GENERAL_RESTRICTIONS_GROUP,order:11,egressRequirements:(e,t)=>{var r;return e===!0||((r=t.codeSurface)===null||r===void 0?void 0:r.enabled)===!1?[]:[jr.ANTHROPIC_API_HOST]},egressRequirementsLabel:Y.msg({defaultMessage:"WebFetch domain check",id:"nZmPQiUhiY"}),description:{short:F.shortDescription(Y.msg({defaultMessage:"Skip Claude Code\u2019s WebFetch domain lookup against api.anthropic.com in Code sessions. Off by default; turn on when that host is blocked.",id:"3dSlpHs3f5"})),long:F.longDescription(`Before fetching a page, Claude Code's WebFetch tool asks \`api.anthropic.com\` whether the domain is on Anthropic's content blocklist, and refuses the fetch if that lookup cannot complete. Third-party deployments route inference elsewhere and often block \`api.anthropic.com\` at the firewall; with the lookup on, every WebFetch in Code sessions then fails with "Unable to verify if domain \u2026 is safe to fetch", and where the host is reachable, every fetched hostname is sent to Anthropic. (Cowork sessions fetch through the app's own allowlisted fetch and never run this lookup.)

Off (default): the lookup runs as it does today, so \`api.anthropic.com\` must be reachable from users' machines for Code-session WebFetch to work (listed under Egress Requirements). Set to \`true\` when users' machines cannot reach \`api.anthropic.com\` (corporate firewall, government network) or you do not want fetched hostnames sent there: Code sessions then fetch without the lookup and never contact that host for it. This is the same \`skipWebFetchPreflight\` setting Claude Code reads from its own [managed-settings](${wt.COWORK_3P_DOCS_BASE}/code#interaction-with-claude-code%E2%80%99s-own-managed-settings) file; the app passes it to every session it starts. To restrict which domains Claude may fetch, use \`coworkEgressAllowedHosts\` or \`builtinToolPolicy\` instead.`)}}),allowedFolders:F.field(F.annotate(F.annotate(Ae.z.array(Ae.z.union([Ae.z.string().min(1),Fte])),{maxItems:200}).transform((e)=>e.map((t)=>typeof t==="string"?{path:t}:t)).optional(),{pathKind:"folder"}),{flatKey:"allowedWorkspaceFolders",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.2581.0"}},title:Y.msg({defaultMessage:"Allowed workspace folders",id:"y3gym+4SMI"}),failClosedValue:[],category:"sandbox",group:Vt.GENERAL_RESTRICTIONS_GROUP,order:2,addLabel:Y.msg({defaultMessage:"Add folder",id:"kjqTjJbwtK"}),description:{short:F.shortDescription(Y.msg({defaultMessage:"Folders where Claude may work. Applies to both Cowork and Code sessions. Leave unset for unrestricted access.",id:"vDcS6jXepg"})),long:F.longDescription('Paths can reference `~` and these environment variables, expanded per user: `%OneDrive%`, `%OneDriveCommercial%`, `%OneDriveConsumer%`, `%APPDATA%`, `%LOCALAPPDATA%`, `%USERNAME%`, `%XDG_DOCUMENTS_DIR%`. The set is fixed; an entry that references any other `%VAR%`, or one that is unset on the device, is ignored.\n\nEach folder is interpreted on the machine the session runs on. For a Code session on an SSH host, `~` means the remote user\'s home, an entry that references a `%VAR%` is ignored there (environment variables belong to the machine that defines them), and the session\'s working directory must fall inside one of the folders as they exist on that host. One list serves every machine: `["/Users", "~"]` governs `/Users` on a managed Mac and the signed-in user\'s home on a Linux host. A folder that names nothing real on a given machine simply allows nothing there.',{docsUrl:`${wt.COWORK_3P_DOCS_BASE}/configuration#allowedworkspacefolders`})}}),blockReadsOutsideWorkingDirectories:F.field(Ae.z.boolean().optional(),{flatKey:"blockReadsOutsideWorkingDirectories",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.46388.1"}},failClosedValue:!0,title:Y.msg({defaultMessage:"Block reads outside working directories",id:"GQrrmfzD4R"}),default:{displayOnly:!1},category:"sandbox",group:Vt.GENERAL_RESTRICTIONS_GROUP,order:2.5,description:{short:F.shortDescription(Y.msg({defaultMessage:"Keep Claude from reading files outside a Code session\u2019s working directories. File tools refuse such reads; sandboxed shell commands lose the home directory.",id:"vSpvldmS33"})),long:F.longDescription(`When set to \`true\`, Code sessions refuse reads outside their working directories (the session folder plus any \`allowedWorkspaceFolders\`). The file tools (Read, Grep, Glob) refuse them in every permission mode; where Claude Code's sandbox runs (macOS, or Linux and SSH hosts with bubblewrap, once \`allowedWorkspaceFolders\` or an egress allowlist is also configured) shell commands cannot see the home directory and other user folders (\`/Users\`, \`/home\`, mounted volumes) and a read there is refused with no prompt; elsewhere (Windows, Linux without bubblewrap, or neither folders nor an egress allowlist configured) such shell reads prompt for approval. The app keeps the user's git configuration files (which may themselves embed credentials such as URL tokens; a symlinked one stays hidden), its own Claude Code installation, and the session's plugin and attachment folders readable (not on a Windows SSH host, where plugin files and attachments stay out of the file tools' reach under the block). An allowed folder that is or contains the home directory leaves it readable.

Users can re-open folders (even their whole home) in their own Claude Code settings with \`sandbox.filesystem.allowRead\` or \`permissions.additionalDirectories\`; settings files tracked in a git repository cannot. The key travels on Claude Code's managed-settings channel: another Claude Code managed-settings source replaces it unless that source sets \`parentSettingsBehavior\` to \`"merge"\`, and one that sets \`sandbox.filesystem.allowManagedReadPathsOnly\` reduces it to approval prompts. This is \`permissions.blockReadsOutsideWorkingDirectories\` in Claude Code's [managed settings](${wt.COWORK_3P_DOCS_BASE}/code#interaction-with-claude-code%E2%80%99s-own-managed-settings).

Unset (default): nothing changes.`,{docsUrl:`${wt.COWORK_3P_DOCS_BASE}/configuration#blockreadsoutsideworkingdirectories`})}}),disableWslSessions:F.field(Ae.z.boolean().optional(),{flatKey:"disableWslSessions",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.19367.0"},visibility:"public-undocumented"},appBehaviorOnly:!0,title:Y.msg({defaultMessage:"Block WSL sessions",id:"DpHm4YbvWC"}),category:"sandbox",group:Vt.CODE_SURFACE_GROUP,order:15,predicates:{show:(e)=>{var t;return((t=e.codeSurface)===null||t===void 0?void 0:t.enabled)!==!1}},description:{short:F.shortDescription(Y.msg({defaultMessage:"Block Code sessions that run inside a WSL distro. Windows endpoint policy does not reach inside WSL.",id:"722/v6Am9J"})),long:F.longDescription("Sessions started inside a WSL distro run Claude Code where Windows host endpoint policy (this managed configuration, and Claude Code's own managed-settings.json) does not apply. On a device with any managed configuration present, WSL sessions are blocked unless this key is explicitly set to `false`. Set to `true` to block WSL sessions unconditionally; set to `false` to allow them on managed devices; leave unset to block whenever the device is managed.\n\nThis key is honored only when deployed through machine-scoped management \u2014 MDM on macOS, the HKLM policy hive on Windows, the root-owned `/etc` file on Linux \u2014 never via the in-app Setup panel or user-writable stores; in particular, an explicit `false` written to the user-writable HKCU hive is ignored (and its presence still marks the device as managed). Because the key is grouped with the other app-behavior keys, deploying it claims that whole group: the auto-update keys (`disableAutoUpdates`, `autoUpdaterEnforcementHours`, \u2026) are then resolved from the managed tier alone, and any local- or remote-tier values for them stop applying.")}}),relocateUncUserData:F.field(Ae.z.boolean().optional(),{flatKey:"relocateUncUserData",support:{enabled:{scopes:["1p"],availableInVersion:"1.32352.0"}},appBehaviorOnly:!0,title:Y.msg({defaultMessage:"Move app data off network shares",id:"hnH9BhZfMz"}),category:"sandbox",group:Vt.GENERAL_RESTRICTIONS_GROUP,order:7.5,description:{short:F.shortDescription(Y.msg({defaultMessage:"Store app data in local AppData on Windows devices where Roaming AppData is redirected to a network share, which Cowork tasks cannot run from.",id:"3SHQ+DxHRI"})),long:F.longDescription("AD Folder Redirection can point %APPDATA% at a network (UNC) share, where Cowork tasks fail to start. The sandbox cannot mount a network path. With this key set to `true`, the app stores its data in a product-specific `<ProductName>-Data` folder under %LOCALAPPDATA% on such devices instead. The key only takes effect when %APPDATA% actually resolves to a UNC path, so it is a no-op on devices with a local profile and does not move a healthy install.\n\nBecause the key is grouped with the other app-behavior keys, deploying it claims that whole group: the auto-update keys (`disableAutoUpdates`, `autoUpdaterEnforcementHours`, \u2026) are then resolved from the managed tier alone, and any local- or remote-tier values for them stop applying. Deploy it together with any auto-update keys you rely on in the same managed (MDM / HKLM `Policies\\Claude`) tier.\n\nThe relocation is a fresh start, not a move: nothing is carried over from the share. The new local folder begins empty, so users sign in again and re-enter their settings, preferences, and MCP server configuration after the move. Nothing is deleted from the share either; removing the key returns the app to the share with its previous contents (including the previous sign-in state) intact, so the rollback path keeps working.")}}),allowedEgressHosts:F.field(F.annotate(Ae.z.preprocess((e)=>Array.isArray(e)?e.filter((t)=>typeof t==="string"&&jr.parseEgressHostEntry(t)!==null):e,F.annotate(Ae.z.array(Ae.z.string().min(1)),{maxItems:500}).optional()),{glob:!0}),{checkDropped:gT,flatKey:"coworkEgressAllowedHosts",failClosedValue:[],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},title:Y.msg({defaultMessage:"Allowed egress hosts",id:"5oTa1gWQsk"}),egressRequirements:(e)=>!Array.isArray(e)?[]:e.includes("*")?jr.DEPENDENCY_INSTALL_DOMAINS:e,egressRequirementsLabel:Y.msg({defaultMessage:"Tool egress (Cowork tasks and Code sessions)",id:"hzwBI5sR1r"}),category:"sandbox",group:Vt.GENERAL_RESTRICTIONS_GROUP,order:1,placeholder:wt.HOST_LIST_PLACEHOLDER,description:{short:F.shortDescription(Y.msg({defaultMessage:"Hostnames the agent\u2019s tools may reach from Cowork and Code sessions. Also surfaced under Egress Requirements.",id:"hOkbU+XfaP"})),long:F.longDescription(`Applies to **both** Cowork and Code, and only to **tool calls**. In Cowork it governs the sandbox's web fetch, shell commands, and package installs; in Code sessions it is [translated into Claude Code's network sandbox allowlist](${wt.COWORK_3P_DOCS_BASE}/code#applied-as-managed-policy), where a separately deployed Claude Code managed-settings file takes precedence by default. It does **not** cover Web Search (which runs at your inference provider), inference, or MCP traffic. When unset, only the inference endpoint is reachable from the sandbox, so the agent's package installs and web fetches fail with a 403.

Entries are exact hostnames (\`api.github.com\`), wildcards (\`*.corp.com\` matches subdomains at any depth, not \`corp.com\` itself), or \`*\` to allow all. IP addresses match only when listed exactly. \`localhost\` and private-network addresses are always blocked for web fetch; shell commands and package installs run in a network sandbox that reaches only the listed hosts plus your inference provider. With \`*\`, that sandbox is disabled and web fetch still blocks private addresses.

Any entry except bare \`*\` may carry a \`:port\` suffix (\`internal.corp.com:8443\`, \`*.corp.com:8443\`) restricting it to that port. IPv6 literals are not supported. An invalid entry is dropped (with a warning in the app log) and the rest keep working; an unreadable value counts as an empty list. Ports are enforced for the Cowork sandbox's web fetch, shell, and package-install egress; plugin CLIs ignore port-scoped entries for now, and the Code translation treats them as the bare host. Deploy port-scoped entries only once your whole fleet is on a build that supports them (\`disableAutoUpdates\` pins builds): on an older build one such entry invalidates the sandbox's whole shell and package-install allowlist for the session.

Listed hosts also need to be open on your network firewall.`,{docsUrl:`${wt.COWORK_3P_DOCS_BASE}/web-tools#web-fetch`})}}),egressProxyUrl:F.field(F.annotate(ol.urlSchema({allowHttp:!0}).optional(),{redact:"hostname"}),{flatKey:"egressProxyUrl",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.44121.1"}},appBehaviorOnly:!0,remotePolicy:{type:"remote-disabled"},title:Y.msg({defaultMessage:"Proxy server URL",id:"A/z9Ko1sje"}),egressRequirements:K_,egressRequirementsLabel:Y.msg({defaultMessage:"Proxy server",id:"B/iAs+tICD"}),category:"connection",group:rT,order:1,placeholder:Y.msg({defaultMessage:"http://proxy.example.com:8080",id:"F8dd6JjEQu"}),description:{short:F.shortDescription(Y.msg({defaultMessage:"Send the app\u2019s and the agent\u2019s traffic through this HTTP proxy instead of the operating system\u2019s proxy settings.",id:"XX6zi7GmwV"})),long:F.longDescription("Pins the app (sign-in, the connection test, model discovery, MCP servers, plugins), the Claude Code engine behind Chat, Cowork, and Code, and on macOS and Windows the Cowork workspace VM (the agent's shell, package-install, `git`, and plugin commands, and the whole engine under `requireCoworkFullVmSandbox`) to one HTTP proxy. Use it when your gateway or the internet is reachable only through a corporate proxy and you cannot rely on the system proxy. It is a reachability setting, not an egress control.\n\nThe value is an `http://` or `https://` URL, usually with a port. SOCKS proxies and embedded credentials (`user:pass@`) are rejected. Give a local forwarding proxy on the device as `http://127.0.0.1:port`; an `https://` loopback address cannot be verified from inside the Cowork workspace VM. Requests to `localhost`, `127.0.0.1`, `[::1]`, and `*.local` names bypass the proxy so local MCP servers keep working; everything else goes through it, and if the proxy is unreachable requests fail rather than connect directly. The engine receives it as `HTTPS_PROXY` and `HTTP_PROXY` with a matching `NO_PROXY`; if Claude Code managed settings on the device set those variables, they win for the engine on the host. Traffic that never uses this proxy: the Cowork workspace VM on Linux, credential and header helper scripts, the update download, the Windows sign-in broker, and pages opened in the system browser.\n\nRead once at launch from device management (MDM) or the local configuration file only; a configuration server cannot deliver it, because the app may need the proxy to reach that server. A profile that sets only this key (or only the other app-behavior keys, such as `disableAutoUpdates`) does not take over a connection users set up in the app, but those keys are read from one source as a group, so put the proxy in the same profile as your update settings. Changes apply at the next app start. When `egressProxyPacUrl` is also set, the PAC file wins and this key is ignored.",{docsUrl:`${wt.COWORK_3P_DOCS_BASE}/network-proxy`})}}),egressProxyPacUrl:F.field(F.annotate(ol.urlSchema({allowHttp:!0}).optional(),{redact:"hostname"}),{flatKey:"egressProxyPacUrl",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.44121.1"}},appBehaviorOnly:!0,remotePolicy:{type:"remote-disabled"},title:Y.msg({defaultMessage:"Proxy auto-config (PAC) URL",id:"0DhMVtlmyQ"}),egressRequirements:K_,egressRequirementsLabel:Y.msg({defaultMessage:"Proxy auto-config file",id:"Gqm6SFn9I2"}),category:"connection",group:rT,order:2,placeholder:Y.msg({defaultMessage:"http://wpad.example.com/proxy.pac",id:"E7zJ/trntg"}),description:{short:F.shortDescription(Y.msg({defaultMessage:"URL of a PAC file that decides the proxy per request. Wins over the proxy server URL when both are set.",id:"dRsQ1NgKdo"})),long:F.longDescription("At launch the app downloads the PAC script and asks it which proxy to use for each request, as a browser would, instead of following the operating system's proxy settings. Same value rules, coverage, exclusions, and delivery as `egressProxyUrl`, except that bypassing is the script's decision: `localhost`, `127.0.0.1`, and `[::1]` still never use a proxy, but `*.local` names and everything else follow whatever it returns. If the PAC file cannot be downloaded, the app connects directly rather than failing.\n\nOn macOS and Windows the Cowork workspace VM is handed a copy of the script when it starts and evaluates it for each request itself; there `myIpAddress()` returns the VM's internal address rather than the device's, so a script that chooses by client subnet gives the VM its off-network answer (if that download fails, the VM connects directly). The Claude Code engine behind Chat, Cowork, and Code cannot evaluate a PAC file, so the app hands it one proxy (whichever the script returns for your inference endpoint) plus a bypass for loopback and `*.local` names. If the script answers `DIRECT` or only `SOCKS` for that endpoint, the engine uses no proxy at all, so have it return an HTTP `PROXY host:port` entry there; if the engine needs different rules, set `HTTPS_PROXY` and `NO_PROXY` in Claude Code managed settings, which win for the engine on the host.",{docsUrl:`${wt.COWORK_3P_DOCS_BASE}/network-proxy`})}}),secureVmEnabled:F.field(Ae.z.boolean().optional(),{flatKey:"secureVmFeaturesEnabled",support:{enabled:{scopes:["1p"],availableInVersion:"1.2581.0"}},failClosedValue:!1,title:Y.msg({defaultMessage:"Secure VM features",id:"+AQagzW8cG"}),category:"sandbox",description:{short:F.shortDescription(Y.msg({defaultMessage:"Enable additional VM-level isolation for the Cowork sandbox.",id:"SecureVmFeaturesHint"}),{docsOnly:!0})}}),hardwareBuddyEnabled:F.field(Ae.z.boolean().optional(),{flatKey:"hardwareBuddyEnabled",support:{enabled:{scopes:["1p"],availableInVersion:"1.18286.0"}},title:Y.msg({defaultMessage:"Allow Hardware Buddy devices",id:"HardwareBuddyEnabled"}),default:!0,failClosedValue:!1,category:"connectors",description:{short:F.shortDescription(Y.msg({defaultMessage:"Allow pairing Hardware Buddy Bluetooth devices in Cowork.",id:"HardwareBuddyHint"}),{docsOnly:!0})}}),requireFullVmSandbox:F.field(Ae.z.boolean().optional(),{flatKey:"requireCoworkFullVmSandbox",support:{enabled:{scopes:["1p"],availableInVersion:"1.2581.0"},deprecated:{scopes:["3p"],availableInVersion:"1.2581.0"}},title:Y.msg({defaultMessage:"Require full VM sandbox",id:"wQRUBw9rk7"}),default:!1,failClosedValue:!0,category:"sandbox",description:{short:F.shortDescription(Y.msg({defaultMessage:"Runs tools inside an isolated VM instead of the host. Stronger isolation; slower file access and no host-process tools.",id:"LVgbWJo83E"}))},predicates:{warn:(e)=>e===!0?Y.msg({defaultMessage:"The default host-native mode starts faster and works behind restricted networks. Shell commands run inside the VM; file tools run on the host with path-based access control. Enable this only if your security review requires the agent loop itself to run in the VM.",id:"05sWumUU1+"}):null}}),endUserAttribution:F.field(Ae.z.boolean().optional(),{flatKey:"endUserAttribution",legacyFlatKey:{name:"enduserAttribution",effect:"the key will read as false (its fail-closed value): end-user attribution will stay off \u2014 no identity shown, no enduser.id emitted \u2014 whatever the old name said",...ha.BATCH_2026_09},support:{enabled:{scopes:["3p"],availableInVersion:"1.25927.0"}},failClosedValue:!1,remotePolicy:{applyUnverified:!1},default:{displayOnly:!0},title:iT,category:"appearance",group:iT,description:{short:F.shortDescription(Y.msg({defaultMessage:"Show the signed-in user\u2019s identity-provider identity in the sidebar and account menu, and emit it as the OpenTelemetry enduser.id resource attribute.",id:"enduserAttrHnt"})),long:F.longDescription("When on (default), the app resolves the signed-in user's identity from the configured credential source (the identity provider claim, or the OS login name when no claim is available) and shows it in the sidebar footer, the account menu, and the Code session greeting. If an OpenTelemetry collector is configured, the same identity is also emitted as the `enduser.id` resource attribute on every span, metric, and log sent to your collector \u2014 unless you have set a static `enduser.id` under OpenTelemetry resource attributes, in which case your static value is kept and the runtime identity is not emitted. When off, no identity is shown in the app and no runtime `enduser.id` is emitted; a static `enduser.id` under OpenTelemetry resource attributes still passes through unchanged. This setting does not gate the `process.owner` resource attribute (the OS login name), which is standard OpenTelemetry process metadata and is always emitted \u2014 set a static `process.owner` under OpenTelemetry resource attributes to override it. Applies to both Cowork tasks and Code sessions.")}}),userContentRendererUrl:F.field(ol.urlSchema({rejectLoopback:!0}).optional(),{flatKey:"userContentRendererUrl",support:{enabled:{scopes:["3p"],availableInVersion:"1.24012.0"}},remotePolicy:{rejectLoopback:!0},title:Y.msg({defaultMessage:"Artifact preview iframe origin",id:"ucrUrlTitle"}),category:"connection",egressRequirements:K_,egressRequirementsLabel:Y.msg({defaultMessage:"Artifact preview iframe",id:"ucrUrlEgrs"}),description:{short:F.shortDescription(Y.msg({defaultMessage:"HTTPS origin of the user-content-renderer deployment used for artifact and file previews. Defaults to the commercial host when unset.",id:"ucrUrlHint"}))}}),organizationInstructions:F.field(Ae.z.string().trim().min(1).max(3000).optional(),{flatKey:"organizationInstructions",support:{enabled:{scopes:["3p"],availableInVersion:"1.37937.0"}},title:Y.msg({defaultMessage:"Organization instructions",id:"t2ElSZR3Hy"}),category:"sandbox",group:Y.msg({defaultMessage:"Organization instructions",id:"t2ElSZR3Hy"}),multiline:!0,placeholder:Y.msg({defaultMessage:"Always answer in British English. Never include customer account numbers in a response.",id:"tevwj/1wDb"}),description:{short:F.shortDescription(Y.msg({defaultMessage:"Appended to Claude\u2019s system prompt in Chat, Cowork, and Code. Guidance the model follows, not an enforced control. Up to 3,000 characters.",id:"1h3TR2uKST"})),long:F.longDescription(`Free-text instructions from your organization that Claude Desktop appends, in a clearly delimited block, after its own system prompt in **Chat**, **Cowork**, and **Code** (every chat, task, and Code session, including the sub-agents they spawn): for example house style, data-handling rules, or topics to decline. The model is told these instructions come from the organization's administrator and take priority over a user's personal preferences.

This is guidance the model follows, not an enforced control: like any system-prompt text it steers the model's behavior and is usually honored, but it does not guarantee an outcome and is not a substitute for the restriction keys (tool policy, egress allowlist, folder allowlist). The app's own system prompt is never replaced or shortened by this key; in Code sessions it is added after Claude Code's own prompt and any \`CLAUDE.md\` instructions still apply.

Read from the app's loaded configuration when a session starts; a changed value generally takes effect for sessions started after the next app launch. Leading and trailing whitespace is trimmed; an empty string is treated as unset. Maximum 3,000 characters; a longer value is rejected (the key is ignored with a configuration error) rather than truncated. Line breaks are preserved when the value is delivered as JSON, a bootstrap response, a \`.mobileconfig\` profile, or a \`.reg\` file; the Group Policy (ADMX) and Intune text box for this setting is single-line.`)}})});var _T={Bash:"mcp__workspace__bash",WebFetch:"mcp__workspace__web_fetch"};function yT(e){for(let[t,r]of Object.entries(_T))if(e.has(t))e.add(r);return[...e]}function q_(e){var t,r,i;let n=new Set((r=(t=e.workspace)===null||t===void 0?void 0:t.disabledBuiltinTools)!==null&&r!==void 0?r:[]);if(dp.isBedrockFamily((i=e.inference)===null||i===void 0?void 0:i.provider))n.add("WebSearch");return yT(n)}function bT(e){var t;return((t=e.chatSurface)===null||t===void 0?void 0:t.enabled)===!0}function Jte(e){var t;return((t=e.workspace)===null||t===void 0?void 0:t.skillCreationEnabled)!==!1}function Yte(e){var t;return bT(e)&&((t=e.chatSurface)===null||t===void 0?void 0:t.advancedFileAnalysis)===!0&&!q_(e).includes(_T.Bash)}function vT(e){var t,r;let i=new Set(q_(e)),n=new Set;for(let[o,s]of Object.entries((r=(t=e.workspace)===null||t===void 0?void 0:t.builtinToolPolicy)!==null&&r!==void 0?r:{})){let u=ul(o);if(s!=="allow"&&u!==void 0&&!(u.content===void 0&&i.has(u.tool))&&!i.has(o))n.add(o)}return yT(n)}function wT(e){var t;return(t=sl[e])!==null&&t!==void 0?t:[e]}function Xte(e){let t=new Set;for(let r of vT(e)){let i=ul(r);if((i===null||i===void 0?void 0:i.content)===void 0)t.add(r);else for(let n of wT(i.tool))t.add(n)}return[...t]}});var fp=E(function(TT){Object.defineProperty(TT,"__esModule",{value:!0});TT.AuthenticationConfig=void 0;TT.forceLoginOrgUUIDList=AT;var Pn=sn(),ET=rr(),$t=st(),St=ln(),PT=fr(),cl=a
he alias resolves to. Otherwise the first listed wins.",id:"trBeCWLw48"}))},predicates:{show:(e)=>Boolean(e.anthropicFamilyTier)}})});function mte(e){var t;let r=e.map((u)=>typeof u==="string"?{name:u}:u),i=new Map;for(let u of r)if(ep(u.name)===u.name&&!i.has(u.name))i.set(u.name,u);let n=(u)=>u.anthropicFamilyTier!==void 0||u.isFamilyDefault===!0,o=new Map;for(let u of r){let c=ep(u.name),d=c===u.name?void 0:i.get(c);if(d&&!n(d)&&!n(u)){let f=(t=o.get(d))!==null&&t!==void 0?t:{plain:d,spellings:[]};f.spellings.push(u),o.set(d,f).set(u,f)}}let s=new Set;return r.flatMap((u)=>{let c=o.get(u);if(!c){let f=ep(u.name);return[f===u.name?u:{...u,name:f,supports1m:!0}]}if(s.has(c))return[];s.add(c);let d=c.plain.prefer1m===void 0&&c.spellings.some((f)=>f.prefer1m===!0);return[{...c.plain,supports1m:!0,...d&&{prefer1m:d}}]})}var hte=(e)=>{var t;return((t=e.inference)===null||t===void 0?void 0:t.provider)!==void 0&&!ma.PROVIDER_CLI_FLAG[e.inference.provider]};function M_(e,t){let r=t.inference;switch(r===null||r===void 0?void 0:r.provider){case"anthropic":return`https://${np.ANTHROPIC_API_HOST}/v1/models`;case"gateway":return r.baseUrl?`${r.baseUrl.replace(/\/+$/,"")}/v1/models`:"/v1/models";case"bedrock":return r.region?np.bedrockControlPlaneHost(r.region):e.formatMessage({defaultMessage:"the Bedrock control-plane",id:"+aUKGm2IHp"});default:return e.formatMessage({defaultMessage:"the provider",id:"QL5gWJ5JBl"})}}var Qf=()=>Ye.z.number().min(0).max(1e4);AA.ModelsConfig=Ye.z.object({discoveryEnabled:oe.field(Ye.z.boolean().optional(),{flatKey:"modelDiscoveryEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.8089.0"}},default:{displayOnly:!0},title:ye.msg({defaultMessage:"Model discovery",id:"jU4z+3Uk7+"}),category:"connection",group:Ht.MODELS_GROUP,order:-1,predicates:{show:(e)=>ma.providerHasDiscovery(e)},description:{short:oe.shortDescription((e,t)=>hte(t)?e.formatMessage({defaultMessage:"Auto-populate the model picker from {url} at launch; when this key isn\u2019t set in the config, discovery is skipped if the model list below makes it unnecessary.",id:"b/YbjgdGIX"},{url:M_(e,t)}):e.formatMessage({defaultMessage:"Auto-populate the model picker from {url} at launch.",id:"xWiIy0pAlB"},{url:M_(e,t)})),long:oe.longDescription("Auto-populate the model picker from the provider's model-list endpoint at launch. For gateway and Anthropic providers, a config that doesn't set this key skips discovery automatically when the model list below already makes it unnecessary; the toggle here only sets it explicitly on or off. Turn off if the endpoint isn't reachable from your network, or to use a fixed list. When off, the model list below is required and must use full model IDs (aliases like sonnet/opus are resolved via discovery).",{docsUrl:`${Ht.COWORK_3P_DOCS_BASE}/configuration#models`})}}),prefer1mContext:oe.field(Ye.z.boolean().optional(),{flatKey:"modelPrefer1mContext",support:{enabled:{scopes:["3p"],availableInVersion:"1.28929.0"}},default:{displayOnly:!1},title:ye.msg({defaultMessage:"Default to 1M context",id:"Y4hvizKRhU"}),category:"connection",group:Ht.MODELS_GROUP,order:-0.5,description:{short:oe.shortDescription(ye.msg({defaultMessage:"When a user has no saved selection, start the picker on the 1M-context variant of the default model if it offers one.",id:"HWE7QizUxw"})),long:oe.longDescription("When a user has no saved selection, start the picker on the 1M-context variant of the default model (the first listed model, or the first model your endpoint returns under discovery) if it offers one. A saved selection is always kept; users who picked a model before this version need to pick the 1M row once, after which it persists. Equivalent to setting `prefer1m` on the default entry of `inferenceModels`, but also applies under dynamic discovery.",{docsUrl:`${Ht.COWORK_3P_DOCS_BASE}/configuration#models`})}}),list:oe.field(oe.annotate(oe.annotate(Ye.z.array(Ye.z.union([Ye.z.string().trim().min(1),AA.InferenceModel])).min(1),{maxItems:200}).transform(mte).optional(),{redact:"hash",gatewayServable:!1}),{flatKey:"inferenceModels",readers:["desktop","m365"],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},title:ye.msg({defaultMessage:"Model list",id:"hv0F38ESRM"}),groupOverride:"nameSubset",category:"connection",group:Ht.MODELS_GROUP,order:0,addLabel:ye.msg({defaultMessage:"Add model",id:"zUO6Ii5EAT"}),description:{short:oe.shortDescription((e,t)=>{var r;return((r=t.models)===null||r===void 0?void 0:r.discoveryEnabled)===!1||!ma.providerHasDiscovery(t)?e.formatMessage({defaultMessage:"Models to show in the picker. First entry is the default.",id:"i8fSuvZDK/"}):e.formatMessage({defaultMessage:"Override the auto-discovered model list. First entry is the default.",id:"G/QQvx0Tsd"})}),long:oe.longDescription('Use the **provider\'s exact model ID**: Vertex publisher IDs (`claude-sonnet-5`), Bedrock inference-profile IDs (`us.anthropic.claude-sonnet-5`), or Foundry deployment names. Entries may be plain ID strings or objects.\n\n**Gateway:** the `name` must be the exact ID your gateway\'s `/v1/models` endpoint returns. If you set `supports1m` on an alias (`sonnet`) but discovery returns the full ID, the variant won\'t appear.\n\n**Extended context** (`supports1m`) is a capability assertion you make about your deployment; only set it for models you\'ve confirmed support the 1M-token window:\n```json\n[{"name": "claude-sonnet-5", "supports1m": true}, "claude-opus-4-8"]\n```\n`"claude-sonnet-5[1m]"` is shorthand for the same entry. When an ID is listed both bare and with `[1m]` (as a gateway lists it), the picker shows one model with a 1M variant; put `labelOverride` on the bare entry (a label on the `[1m]` spelling is ignored there); tier-tagged entries are not folded. `prefer1m: true` (no effect without `supports1m`) makes the 1M variant the default picker selection when this entry is the default model; users can still switch, and an explicit pick is kept. Under dynamic discovery (no explicit list), set `modelPrefer1mContext` instead.\n\n**Display label** (`labelOverride`) is for IDs the picker can\'t derive a friendly name from (Bedrock ARNs, gateway routing aliases). Display-only; `name` is still what the app sends:\n```json\n[{"name": "arn:aws:bedrock:us-east-1:123:application-inference-profile/abc", "labelOverride": "Claude Opus (Prod)"}]\n```\n\n**Tier mapping** (`anthropicFamilyTier`) tells the app which Claude tier (`haiku`/`sonnet`/`opus`/`fable`/`mythos`) an entry stands in for, so bare tier aliases (e.g. in Code sessions) resolve to your model. `isFamilyDefault: true` picks the winner when several entries share a tier:\n```json\n[{"name": "us.anthropic.claude-opus-4-8", "anthropicFamilyTier": "opus"}]\n```',{docsUrl:`${Ht.COWORK_3P_DOCS_BASE}/configuration#models`})},predicates:{required:(e)=>{var t;return!Ht.hasActiveBootstrap(e)&&(((t=e.models)===null||t===void 0?void 0:t.discoveryEnabled)===!1||!ma.providerHasDiscovery(e))},warn:(e,t,r)=>bte(e.name,t,r)}}),pricing:Ye.z.object({enabled:oe.field(Ye.z.boolean().optional(),{flatKey:"inferenceModelPricingEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.37937.0"}},default:{displayOnly:!1},title:ye.msg({defaultMessage:"Show estimated cost",id:"dqCubkxbYK"}),category:"connection",group:Ht.MODELS_GROUP,order:1,description:{short:oe.shortDescription(ye.msg({defaultMessage:"Show an estimated cost on the Usage page at Anthropic list price; turn on to set a multiplier or per-model rates.",id:"O20EMso86S"})),long:oe.longDescription("Off unless set: the Usage page shows token counts only, since the app cannot know your negotiated provider rates. `true` turns on a USD estimate priced at Anthropic's published list price and is the only switch that does: `inferenceModelPricingMultiplier` and `inferenceModelPricing` refine the estimate while this is on and are ignored otherwise; turning this off hides them in the config editors without clearing them. Claude Code performs the calculation, so the same figures appear in its own cost reporting for Code sessions. Model IDs Claude Code cannot map to a Claude model (an opaque gateway alias, an inference-profile ARN it cannot resolve) are left out of the estimate until `inferenceModelPricing` gives them a rate. A machine-level Claude Code managed `modelPricing` (MDM / managed-settings.json / server-managed) takes precedence over all three keys.",{docsUrl:`${Ht.COWORK_3P_DOCS_BASE}/configuration#models`})}}),multiplier:oe.field(oe.annotate(Ye.z.coerce.number().gt(0).lte(1).optional(),{redact:"presence"}),{flatKey:"inferenceModelPricingMultiplier",support:{enabled:{scopes:["3p"],availableInVersion:"1.37937.0"}},title:ye.msg({defaultMessage:"Price multiplier",id:"BvuzkKM8Bk"}),category:"connection",group:Ht.MODELS_GROUP,order:1.1,predicates:{show:rp},placeholder:ye.msg({defaultMessage:"0.85",id:"SyOzaH65Yu"}),description:{short:oe.shortDescription(ye.msg({defaultMessage:"Scales every estimated cost (0.85 = 85% of the price); between 0 and 1.",id:"g06VJdp+L7"})),long:oe.longDescription("Mirrors Claude Code's managed `modelPricing.multiplier`: a number in (0, 1] applied to every computed cost, whether the model was priced at Anthropic list price or by an `inferenceModelPricing` row; use it for a flat contracted discount. Applies only while `inferenceModelPricingEnabled` is `true`; on its own it does not turn the estimate on. Ignored when a machine-level Claude Code managed `modelPricing` is present.",{docsUrl:`${Ht.COWORK_3P_DOCS_BASE}/configuration#models`})}}),models:oe.field(oe.annotate(Ye.z.array(Ye.z.object({name:oe.subfield(Ye.z.string().trim().min(1),{label:ye.msg({defaultMessage:"Model ID",id:"/m0q/Dre6A"}),isPrimaryKey:!0,mono:!0,placeholder:ye.msg({defaultMessage:"claude-opus-4",id:"s+j6yEtVLW"}),description:{short:oe.shortDescription(ye.msg({defaultMessage:"A model ID from the list above, or any other ID or alias your provider serves. A built-in Claude ID also covers its dated and provider forms.",id:"usJ91EFnHr"}),{docsOnly:!1})}}),inputPerMtok:oe.subfield(Qf(),{label:ye.msg({defaultMessage:"Input",id:"it6Ligcq3B"}),description:{short:oe.shortDescription(ye.msg({defaultMessage:"USD per million input tokens.",id:"nQMe9gkLHr"}))}}),outputPerMtok:oe.subfield(Qf(),{label:ye.msg({defaultMessage:"Output",id:"fio5opLcOZ"}),description:{short:oe.shortDescription(ye.msg({defaultMessage:"USD per million output tokens.",id:"NPC4I65XQU"}))}}),cacheReadPerMtok:oe.subfield(Qf(),{label:ye.msg({defaultMessage:"Cache read",id:"M4uIq3kw9y"}),description:{short:oe.shortDescription(ye.msg({defaultMessage:"USD per million prompt-cache read tokens.",id:"T5SCPPfeMB"}))}}),cacheWritePerMtok:oe.subfield(Qf(),{label:ye.msg({defaultMessage:"Cache write",id:"tV/UHxu+ec"}),description:{short:oe.shortDescription(ye.msg({defaultMessage:"USD per million prompt-cache write tokens (5-minute and 1-hour writes alike).",id:"295mSyLyL7"}))}})})).optional(),{redact:"presence"}),{flatKey:"inferenceModelPricing",support:{enabled:{scopes:["3p"],availableInVersion:"1.37937.0"}},title:ye.msg({defaultMessage:"Model pricing",id:"Em5X7PlTGI"}),category:"connection",group:Ht.MODELS_GROUP,order:1.2,predicates:{show:rp},addLabel:ye.msg({defaultMessage:"Add price",id:"Gk+NyPXeVe"}),description:{short:oe.shortDescription(ye.msg({defaultMessage:"Per-model rates replacing Anthropic list price in the Usage page\u2019s estimate.",id:"5Ho1RhYUiz"})),long:oe.longDescription('Each row replaces Anthropic list price for one model in the Usage page\'s estimate, in USD per million tokens (`inputPerMtok`, `outputPerMtok`, `cacheReadPerMtok`, `cacheWritePerMtok`, all four required; `cacheWritePerMtok` prices both 5-minute and 1-hour cache writes); rows apply only while `inferenceModelPricingEnabled` is `true` and do not turn the estimate on by themselves. Mirrors Claude Code\'s managed `modelPricing.overrides`, and `name` is matched the same way: a built-in Claude model ID (e.g. `claude-sonnet-4-6`, or its Bedrock, Vertex, or Foundry ID) covers every dated and provider spelling of that model; any other value (a gateway alias, an inference-profile ARN) matches that exact ID only (case-insensitive) and wins over a built-in row. An ID Claude Code cannot map to a Claude model at all gets no estimate until a row here prices it. `inferenceModelPricingMultiplier` still applies on top of a row.\n```json\n{"inferenceModelPricingEnabled": true, "inferenceModelPricingMultiplier": 0.9, "inferenceModelPricing": [{"name": "claude-sonnet-4-6", "inputPerMtok": 2.4, "outputPerMtok": 12, "cacheReadPerMtok": 0.24, "cacheWritePerMtok": 3}]}\n```\nThese are estimates for visibility, not an invoice; your provider bills at its own rates. A machine-level Claude Code managed `modelPricing` (MDM / managed-settings.json / server-managed) takes precedence over this table.',{docsUrl:`${Ht.COWORK_3P_DOCS_BASE}/configuration#models`})}})}).optional()});function rp(e){var t,r;return((r=(t=e.models)===null||t===void 0?void 0:t.pricing)===null||r===void 0?void 0:r.enabled)===!0}function gte(e){var t;let r=(t=e.models)===null||t===void 0?void 0:t.pricing;if(!r||!rp(e))return;let{enabled:i,...n}=r;return n}function _te(e,t,r){let{inferenceProvider:i,inferenceModels:n}=e;if(!i||!Array.isArray(n))return e;let o=n.filter((s)=>{let u=ip.checkModel(i,s.name);if(!u.ok)t(s.name,u.reason);else if("warn"in u&&u.warn)r===null||r===void 0||r(u.warn);return u.ok});if(o.length!==n.length&&o.length>0)e.inferenceModels=o;return e}function yte(e,t){return`inferenceModels: "${e}" is not an Anthropic model and was removed from the list \u2014 ${t}`}function bte(e,t,r){var i;let n=typeof e==="string"?ep(e.trim()):"";if(!n||!((i=t.inference)===null||i===void 0?void 0:i.provider))return null;let o=ip.checkModel(t.inference.provider,n);return o.ok?null:$A(r,o.reason)}function $A(e,t){return e.formatMessage({defaultMessage:"Doesn\u2019t look like an Anthropic model: {reason}",id:"3RoY+bkhPc"},{reason:t})}});var z_=E(function(KA){var N_;Object.def
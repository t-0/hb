}
function mkdirNoFollow(dir, root) {
  if (isSymlink(dir)) throw new Error('refusing to use symlinked directory: ' + dir);
  mkdirSync(dir, { recursive: true });
  // Check after creating: mkdirSync(recursive) follows symlinked ancestors.

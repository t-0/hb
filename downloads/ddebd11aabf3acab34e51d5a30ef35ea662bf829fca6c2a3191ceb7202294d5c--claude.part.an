environment for Claude Code cloud sessions. Creates an environment, spawns a
local runner, verifies it appears in the Admin UI, and writes a CHEAT-SHEET.md.

Any extra args are passed to the underlying Claude Code session.`);return}await h$t(s);let i=await PNe(s);if(i!==null)NTe(i.reason);_V();let n=bU(s);if(pGe(n),z()&&n!==void 0){MB({storageV5:n}),Q1(n);let[{composePolicyLimitsClient:o,primePolicyLimitsCache:c},{credentialsStoreFor:p},{primeFastPathCredentials:m}]=await Promise.all([import("/$bunfs/root/chunk-ehhxwqea.js"),import("/$bunfs/root/chunk-rb23hp3w.js"),import("/$bunfs/root/chunk-km8cken7.js")]);o({storageV5:n}),await m(p(n)),await c(n),await $q(n)}let r=h(nss()),u=Yp()?[]:[process.argv[1]],d=t.length>0&&!t[0].startsWith("-")?[]:[v],l=[...u,...d,"--append-system-prompt",r,"--tools",g,"--permission-mode","default",...t];if(a.DEBUG)console.error("[self-hosted-runner:setup] spawning:",_({argv:[process.execPath,...l.map((o)=>o===r?`<${r.length} chars>`:o)]}));let e=f(process.execPath,l,{stdio:"inherit"});if(e.error)return await Bt("cli_self_hosted_setup","spawn_failed"),console.error(`[self-hosted-runner:setup] failed to spawn child: ${e.error.message}`),Ao(1);if(e.status!==null&&e.status!==0||e.signal)await Bt("cli_self_hosted_setup",e.signal?"child_signal":"child_nonzero"),console.error(`[self-hosted-runner:setup] child exited with status ${e.status??"(null)"}${e.signal?`, signal ${e.signal}`:""}`);else await Wr("cli_self_hosted_setup");return console.error("[self-hosted-runner:setup] To continue setup, re-run `claude self-hosted-runner setup` \u2014 resuming the session with `claude --resume`/`-c` will not re-enable the setup tools."),Ao(e.status!==null?e.status:1)}export{q as selfHostedRunnerSetupMain};

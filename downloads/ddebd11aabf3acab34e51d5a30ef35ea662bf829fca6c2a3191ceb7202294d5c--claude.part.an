or GIT_CONFIG_COUNT and its keys), which do not reach this upload\u2019s git: the grant has to stand in a file that git reads.",git_refused_not_a_repository:"Git does not recognise the .git here as a repository (\u201Cnot a git repository\u201D), so nothing was uploaded. Its HEAD, objects or refs may be missing, empty or unreadable, as after an interrupted copy. Start from a fresh clone, or from the folder that holds the real repository.",git_refused_bad_config:"Git cannot parse one of its configuration files (\u201Cbad config\u201D), so nothing was uploaded. Run `git rev-parse --git-dir` here (it changes nothing): its error names the file and the line, or the setting at fault. Fix that, then retry.",git_refused_config_unreadable:"Git cannot open one of its configuration files (\u201Cunable to access\u201D), so nothing was uploaded. Run `git rev-parse --git-dir` here (it changes nothing): its error names the file. Make that file readable for your user, or remove the include that points to it, then retry.",git_refused_unknown_extension:"This repository uses a git feature that the git on your PATH does not know (\u201Cunknown repository extension\u201D), so nothing was uploaded. Update git, or put a newer git first on the PATH that Claude Code is started with, then retry.",git_did_not_run:"The program that runs as git on your PATH started and ran no git, so nothing was uploaded. A version manager\u2019s shim (asdf\u2019s, for one) does that where no git version is set for the folder. Run `git --version` here to see what it says. Set a version, or put a real git first on the PATH that Claude Code is started with, then retry.",git_did_not_run_from_outside:"",git_dir_objects_folder_missing:"This checkout\u2019s git directory lacks objects/info or objects/pack, so nothing was uploaded. Git makes both in every repository and works without them; a copy that skips empty folders loses them. To make them again, in an ordinary checkout, at its top level, where .git is: first look with ls -ld .git .git/objects (a link shows an arrow, ->). If either is a link, stop, since the folders would be made wherever it points, and start from a fresh clone instead. Otherwise run mkdir .git/objects/info .git/objects/pack (an error that one of them exists does no harm), then retry.",launch_folder_unresolved:"This folder\u2019s own path could not be resolved just now: a link on the way to it changed, or a folder above it cannot be entered. So nothing was uploaded. Retry from the folder itself, by its real path.",keyed_folder_unresolved:"The folder under which Claude Code keeps this worktree\u2019s trust and settings could not be resolved just now: too many files may be open, or a folder on the way to it changed. So nothing was uploaded. Retry."};var vnn=5000,Tnn="seed bundle delete timed out";async function Enn(e){let n;try{let r=await Dt(hWn(e.fileId,e.config,{timeoutMs:vnn}),vnn,Tnn);n=r.success?void 0:r.reason}catch(r){n=r instanceof Error&&r.message===Tnn?"timeout":"unexpected",t(`[teleportToRemote] Deleting the uploaded bundle failed: ${d(r)}`,{level:"warn"})}if(n===void 0){g("teleport_seed_bundle_discard");return}t(`[teleportToRemote] Could not delete the uploaded bundle (${n}); its expiry removes it`,{level:"warn"}),p("teleport_seed_bundle_discard",n)}function uH(e){return!1}function xdt(e){return uH(e)?{enabled:Cjn,enabledNow:TEe}:{enabled:m$,enabledNow:M1}}function Gmo(e){return e==="forward"?"host":void 0}function dQt(){return!0}function SUe({hostConsent:e}){return Gmo(e)}function Zpe(){let e=ue().remoteHomeSettingsMode;return cJ(e)??(e===void 0?void 0:"keep_local")}function SPe(e){if(e===void 0||e==="stored")return(e==="stored"||dQt())&&_tr()==="forward";return!0}function bUe({launchConsent:e,isProjectSynced:n,launchMayForward:r,surface:s,trigger:h}){}var ytr=3;function cJ(e){return sQn.includes(e)?e:void 0}function _tr(){if(!TW(M1()))return"unspecified";return Pdt()??"unspecified"}function Pdt(){return cJ(ue().remoteHomeSettingsMode)}async fu
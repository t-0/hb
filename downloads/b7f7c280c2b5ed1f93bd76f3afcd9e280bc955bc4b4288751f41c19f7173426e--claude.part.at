`);return Lo(`Here is a note offered by a side agent:

${r}`)}var is='"You should know" made this page from the conversation at the time; it is a one-off explainer, not maintained.';var On="Your prompt box has text in it. Send or clear it, then press again to turn suggestions off.";var Sn="A dialog is open. Answer or close it, then try again.";var En="Your prompt box has text in it. Send or clear it, then try again.";var _n="Couldn\u2019t add the note. If the box has text, send or clear it, then try "+"again.";function as(e){let t=e.search(/<title[\s>]/i);if(t===-1)return null;let o=e.slice(t).replace(/```[a-z]*\s*$/i,"").trim(),r=o.search(/<\/title>/i);if(r===-1)return null;let n=r+8;return`${o.slice(0,n)}

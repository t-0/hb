 reinstalls on every sync, so it cannot stay removed. A change that only moves the pin of existing entries, with nothing else in the configuration changed, reaches running apps without a restart once the app's next two configuration checks both return it; any other change to this list asks for a restart. An `auto_install` or `required` entry without that pin (a full 40-character commit SHA in `ref`, or `manifestSha256` for a `url` source) is treated as `available` and reported as a config warning: the marketplace still lists, but the entry installs nothing. Left at (or treated as) `available`, a `url` marketplace served from your inference gateway's or bootstrap server's own origin may instead mark individual plugins `\"installationPreference\": \"auto_install\"` in its `marketplace.json`: those install automatically with no pin (each such archive needs a `sha256`), and a plugin the user removes stays removed. On any other origin those marks are ignored.",{docsOnly:!1})}}),credentialKind:ie.subfield(ft.z.enum(BD).optional(),_v),credentialHelper:ie.subfield(ft.z.string().min(1).optional(),{label:fe.msg({defaultMessage:"Credential helper",id:"9bQZ2JN+mX"}),remotePolicy:{requiresUserConsent:!0},description:{short:ie.shortDescription(fe.msg({defaultMessage:"Executable that prints an access token for this marketplace.",id:"+x3hZrl+4b"}),{docsOnly:!1}),long:ie.longDescription('Prints to stdout one of: a bare token (sent as the git password for username `x-access-token`, which GitHub, GitLab and Azure DevOps accept, and as `Authorization: Bearer` for `url` sources); git-credential lines `username=<user>` and `password=<token>` when the host needs a particular username (Bitbucket Data Center project or repository access tokens on 9.3+: `x-token-auth`; GitLab deploy tokens: `gitlab+deploy-token-N`) \u2014 sent as HTTP Basic for `url` sources; `authtype=Bearer` and `credential=<token>` to send `Authorization: Bearer <token>` (Bitbucket Data Center HTTP access tokens on any version); or, for `url` sources only, a JSON object of HTTP headers such as `{"Authorization": "Bearer \u2026", "X-Tenant": "acme"}` (the form an MCP server\'s `headersHelper` prints), all sent on every request to that marketplace \u2014 a `git` source refuses this form. Other keys, blank lines and CRLF are ignored in the line forms; output that opens with `{` must be a valid header object or the fetch is refused.',{docsOnly:!1})},predicates:{show:xD,required:xD}})};qD.marketplaceRef=ie.subfield(ft.z.string().min(1).optional(),{label:fe.msg({defaultMessage:"Ref",id:"Yz6RnPXq2r"}),placeholder:fe.msg({defaultMessage:"Branch, tag, or commit SHA",id:"r5djcSLDYh"}),description:{short:ie.shortDescription(fe.msg({defaultMessage:"Commit SHA, branch, or tag. Leave empty to track the default branch; auto_install and required need a full 40-character commit SHA.",id:"pMktRefDs1"}),{docsOnly:!1})},predicates:{show:KD}});var zD={ref:qD.marketplaceRef,path:ie.subfield(ft.z.string().min(1).optional(),{label:fe.msg({defaultMessage:"Subpath",id:"Hy0W3kYc6J"}),description:{short:ie.shortDescription(fe.msg({defaultMessage:"Folder within the repository that contains the marketplace, when it isn\u2019t at the root.",id:"pMktPathD1"}),{docsOnly:!1})},predicates:{show:KD}}),...bv},Xle={manifestSha256:ie.subfield(ft.z.string().regex(Xn.SHA256_HEX,"Manifest SHA-256 must be a 64-character hex digest").transform((e)=>e.toLowerCase()).optional(),{label:fe.msg({defaultMessage:"Manifest SHA-256",id:"pMktMfSha1"}),support:{availableInVersion:"1.32352.0"},placeholder:fe.msg({defaultMessage:"64-char hex SHA-256 of marketplace.json",id:"pMktMfSha2"}),description:{short:ie.shortDescription(fe.msg({defaultMessage:"SHA-256 of the exact marketplace.json to accept. Without it auto_install and required act as available; a served manifest with any other digest is refused.",id:"pMktMfSha3"}),{docsOnly:!1})},predicates:{show:Yle}}),...bv,credentialKind:ie.subfield(ft.z.enum(qD.MARKETPLACE_CREDENTIAL_KINDS).optional(),_v)},hv={label:fe.msg({defaultMessage:"Source",id:"cc9hc4+0K4"}),support:{values:{url:{availableInVersion:"1.32352.0"}}},optionLabels:{github:fe.msg({defaultMessage:"GitHub",id:"SYEyDpPjNk"}),git:fe.msg({defaultMessage:"Git URL",id:"TpLDdW3nvS"}),url:fe.msg({defaultMessage:"Marketplace URL",id:"PjhC2D2FaO"})},description:{short:ie.shortDescription(fe.msg({defaultMessage:"Where the marketplace is fetched from: a GitHub repository (set repo), any Git remote (set url), or a hosted marketplace.json file (set url).",id:"l67dEmmDaG"}))},predicates:{required:()=>!0}},Qle=`For \`git\` sources, the HTTPS remote the app clones. For \`url\` sources, the HTTPS address of a \`marketplace.json\` whose plugins are \`archive\` entries (a zip \`url\` plus its \`sha256\`; \`ref\` and \`path\` do not apply). Archive URLs must be same-origin with the manifest URL: that origin is the only host to open on the firewall and the only one a credential is sent to. If any archive fails to download or verify, nothing from that fetch is installed and the next sync retries.

When Installation is \`auto_install\` or \`required\`, set \`manifestSha256\` to the SHA-256 of that exact file and give every archive a \`sha256\`: a served manifest with a different digest is refused and unpinned archives are skipped, so publishing a new manifest means updating \`manifestSha256\`; with no \`manifestSha256\` at all the entry is treated as \`available\` (and a config warning says so). A marketplace served from your inference gateway's or bootstrap server's own origin may instead leave Installation at \`available\` and mark individual plugins \`"installationPreference": "auto_install"\` in the manifest (each with a \`sha256\`); those install with no pin and a new manifest is picked up on the periodic re-fetch. On any other origin the per-plugin marks are ignored.

\`credentialKind\` selects what is sent: \`anonymous\` (the default) nothing, \`userGit\` the user's stored git credential for that host as HTTP Basic, \`credentialHelper\` the helper's output as \`Authorization\` (or, for \`url\` sources, as the HTTP headers it prints as a JSON object), and \`inferenceCredential\` (\`url\` sources only) the credential the app already sends your inference gateway or enabled bootstrap server, so the manifest must be on one of those two origins; when there is nothing to send yet, no request is made and the entry reports why. See [Host the marketplace over HTTPS](${Xn.COWORK_3P_DOCS_BASE}/extensions#host-the-marketplace-over-https-instead-of-git) for an example manifest and credential details.`;qD.marketplaceUrl=ie.subfield(Bn.urlSchema({allowLoopbackHttp:!0}),{label:fe.msg({defaultMessage:"URL",id:"5M+YdqOWGS"}),isPrimaryKey:!0,description:{short:ie.shortDescription(fe.msg({defaultMessage:"HTTPS Git remote of the marketplace repository (git), or direct HTTPS URL of a hosted marketplace.json file (url).",id:"p6oo8hoZ4V"})),long:ie.longDescription(Qle)},predicates:{show:MD,required:MD}});qD.marketplaceRepo=ie.subfield(ft.z.string().regex(HD,"Repository must be in the form owner/repo, e.g. anthropics/skills").transform((e)=>e.toLowerCase()),{label:fe.msg({defaultMessage:"Repository",id:"ZHK3DVhcxt"}),isPrimaryKey:!0,placeholder:fe.msg({defaultMessage:"owner/repo",id:"3pZ8Ut7zIL"}),description:{short:ie.shortDescription(fe.msg({defaultMessage:"GitHub repository in owner/repo form. Case-insensitive.",id:"2cD0skIoWu"}))},predicates:{show:DD,required:DD}});qD.AllowedPluginMarketplace=yv(ft.z.discriminatedUnion("source",[ft.z.object({source:ie.subfield(ft.z.literal("github"),hv),repo:qD.marketplaceRepo,...zD}),ft.z.object({source:ie.subfield(ft.z.literal("git"),hv),url:qD.marketplaceUrl,...zD}),ft.z.object({source:ie.subfield(ft.z.literal("url"),hv),url:qD.marketplaceUrl,...Xle})])).transform((e)=>ZD(e)?{...e,installationPreference:"available"}:e);var ece=ie.annotate(ft.z.array(qD.AllowedPluginMarketplace.nullable().catch(null)),{maxItems:100}).transform((e)=>e.filter((t)=>t!==null));function VD(e,t){if(!Array.isArray(e))return;e.forEach((n,i)=>{var r;let o=qD.AllowedPluginMarketplace.safeParse(n),s=n&&typeof n==="object"?n:void 0,l=typeof(s===null||s===void 0?void 0:s.repo)==="string"&&HD.test(s.repo)?`"${s.repo}"`:`[${i}]`;if(o.success){let u=s===null||s===void 0?void 0:s.installationPreference;if(typeof u==="string"&&u!==((r=o.data.installationPreference)!==null&&r!==void 0?r:"available")){let p=o.data.source==="url"?"`manifestSha256`":"a full 40-character commit SHA in `ref`";t(`allowedPluginMarketplaces entry ${l}: ${u} requires ${p}; showing as available instead`,"clamp")}return}let c=o.error.issues.map((u)=>`${u.path.join(".")||"."}: ${u.message}`).join("; ");t(`allowedPluginMarketplaces entry ${l} dropped \u2014 ${c}`)})}qD.PluginsConfig=ft.z.object({remoteUrl:ie.field(ie.annotate(Bn.urlSchema().optional(),{redact:"hostname"}),{flatKey:"organizationPluginsUrl",support:{enabled:{scopes:["3p"],availableInVersion:"1.10628.0"},visibility:"public-undocumented",executionTarget:"desktop"},deprecations:[{path:"organizationPluginsUrl",use:'an allowedPluginMarketplaces entry with "source": "url"',effect:"plugins will no longer be fetched or updated from that endpoint; the ones it already installed will stay until the key is removed from the configuration, which then retires them",...Jh.BATCH_2026_09}],remotePolicy:{rejectLoopback:!0,originPinned:{carries:"local-credential"}},title:fe.msg({defaultMessage:"Organization plugins endpoint",id:"OrgPluginsUrl"}),egressRequirements:(e,t)=>{var n;return((n=t.bootstrap)===null||n===void 0?void 0:n.enabled)===!1?[]:Xn.singleHostEgress(e)},egressRequirementsLabel:fe.msg({defaultMessage:"Organization plugins index",id:"OrgPluginsUrlEgress"}),category:"plugins",predicates:{show:(e)=>{var t;return((t=e.plugins)===null||t===void 0?void 0:t.remoteUrl)!==void 0}},description:{short:ie.shortDescription(fe.msg({defaultMessage:"Typically supplied by your bootstrap server. Ignored when bootstrap is disabled.",id:"0PDitvSoS4"}))}}),settings:ie.field(ie.annotate(Bn.OrgPluginSettings.optional(),{redact:"keep"}),{flatKey:"orgPluginSettings",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.8089.0"}},title:fe.msg({defaultMessage:"Organization plugin settings",id:"hD0T/0cTEY"}),failClosedValue:Bn.ORG_PLUGIN_SETTINGS_PARSE_FAILED,unreadableStandIn:!0,checkDropped:Bn.checkOrgPluginSettingsForDrops,deprecations:[Bn.ORG_PLUGIN_SETTINGS_RECORD_FORM,Bn.ORG_PLUGIN_PERMISSION_ASK_SESSION],category:"plugins",customRenderer:"orgPluginSettings",description:{short:ie.shortDescription(fe.msg({defaultMessage:"Admin policy applied to plugin-delivered MCP servers.",id:"MW4a5sB6yS"})),long:ie.longDescription('Locks per-tool permissions on MCP servers provided by any installed plugin \u2014 from the org-plugins directory or a plugin marketplace, remote or run locally \u2014 one entry per server name (compared case-insensitively):\n```json\n[{"serverName": "internal-search", "tools": [{"toolName": "delete_document", "permission": "blocked"}]}]\n```\nThe older record form (`{"mcpServers": {"internal-search": {"toolPolicy": {"delete_document": "blocked"}}}}`) is deprecated and accepted only until '+Jh.formatDeprecationDate((pv=Bn.ORG_PLUGIN_SETTINGS_RECORD_FORM.supportEnds)!==null&&pv!==void 0?pv:"")+`. Desktop versions before 1.15200.0 parse only the record form: on those builds an array value is ignored and plugin tool locks are **not enforced**, so update the fleet past 1.15200.0 before deploying the array form.

If a Managed MCP servers entry is for the same server (same URL, else same name), that entry decides alone: its \`toolPolicy\` (if any) applies and the entry here is ignored. A value that cannot be read blocks every tool of every plugin-provided MCP server no Managed MCP servers entry covers.

`+Bn.PLUGIN_MCP_TOOL_POLICY_CHANNEL_NOTE,{docsUrl:`${Xn.COWORK_3P_DOCS_BASE}/configuration#orgpluginsettings`})}}),marketplaces:ie.field(ie.annotate(ece.optional(),{redact:"presence"}),{flatKey:"allowedPluginMarketplaces",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.17377.1"}},checkDropped:VD,remotePolicy:{marketplaceUrlHygiene:!0,hotAppliedWhen:Jle},title:fe.msg({defaultMessage:"Plugin marketplaces",id:"SbDWhfly4c"}),description:{short:ie.shortDescription(fe.msg({defaultMessage:"Git repositories or hosted marketplace.json URLs to surface as plugin marketplaces in the Directory\u2019s Organization tab. The app re-fetches each periodically.",id:"57U/34BfkA"}))},failClosedValue:[],egressRequirements:(e)=>Array.isArray(e)?e.map((t)=>t.source==="github"?"github.com":FD.egressAddress(t.url)).filter((t)=>!!t):[],egressRequirementsLabel:fe.msg({defaultMessage:"Plugin marketplaces",id:"SbDWhfly4c"}),category:"plugins",group:fe.msg({defaultMessage:"Plugin marketplaces",id:"SbDWhfly4c"}),addLabel:fe.msg({defaultMessage:"Add marketplace",id:"u1Y1OE1uGp"}),predicates:{warn:(e,t,n)=>ZD(e)?n.formatMessage(fe.msg({defaultMessage:"Automatic installation needs {source, select, url {a Manifest SHA-256} other {a full 40-character commit SHA in Ref}}. Without one this marketplace is treated as available: it is listed, but this setting installs nothing.",id:"BwpYj08tvc"}),{source:e.source}):null},presets:[{label:"GitHub repo",item:{source:"github",repo:""}},{label:"Git URL",item:{source:"git",url:""}},{label:"Marketplace URL",item:{source:"url",url:""}},...Wle,{label:"Salesforce",section:"From partners",description:"salesforce/salesforce-skills on GitHub",item:{source:"github",repo:"salesforce/salesforce-skills",ref:"claude-prod"}}]}),sharingEndpoint:ie.field(ie.annotate(yv(ft.z.object({url:ie.subfield(Bn.urlSchema({allowLoopbackHttp:!0,rejectQueryAndFragment:!0}),{label:fe.msg({defaultMessage:"URL",id:"5M+YdqOWGS"}),mono:!0,placeholder:fe.msg({defaultMessage:"https://share.example.com/publish",id:"OrgShareUrlPh"}),description:{short:ie.shortDescription(fe.msg({defaultMessage:"HTTPS address each published item is POSTed to, with no query or fragment. Plain http on a loopback host is taken only from device management or the local file.",id:"OrgShareUrlHint"}),{docsOnly:!1})},predicates:{required:()=>!0}}),credentialKind:ie.subfield(ft.z.enum(qle).optional(),{label:_v.label,default:"anonymous",description:{short:ie.shortDescription(fe.msg({defaultMessage:"What each request carries: nothing, a helper executable\u2019s output as Authorization, or the credential the app already sends its gateway or bootstrap server.",id:"OrgShareCredKd"}),{docsOnly:!1})}}),credentialHelper:bv.credentialHelper})).optional(),{redact:"presence"}),{flatKey:"sharingEndpoint",support:{enabled:{scopes:["3p"],availableInVersion:"2.9939.2"},visibility:"public-undocumented"},betaFeatureKey:"organizationSharing",exportTemplate:"organizationSharingOpenApi",remotePolicy:{rejectLoopback:!0,hybrid:{scope:"excluded"}},title:fe.msg({defaultMessage:"Organization sharing endpoint",id:"OrgShareTitle"}),egressRequirements:(e)=>Xn.singleHostEgress(e===null||e===void 0?void 0:e.url),category:"plugins",group:fe.msg({defaultMessage:"Plugin marketplaces",id:"SbDWhfly4c"}),description:{short:ie.shortDescription(fe.msg({defaultMessage:"HTTPS endpoint that receives the skills and plugins users publish to the organization. When set, users get a Publish to organization action.",id:"OrgShareHint"})),long:ie.longDescription("When set, **Publish to organization** appears on a user's own skills and plugins, and each submission is one HTTPS `POST` of the item to `url`, for your organization's own review pipeline to accept or reject. Nothing is installed from this endpoint: approved items reach members through your plugin marketplaces (`allowedPluginMarketplaces`). The request and response contract is documented separately.\n\n`credentialKind` selects what the request carries: `anonymous` (the default) nothing; `credentialHelper` the output of the `credentialHelper` executable, either as `Authorization` or, when it prints a JSON object of HTTP headers, as those headers (the same helper formats a `url` marketplace entry accepts); `inferenceCredential` the credential the app already sends your inference gateway or enabled bootstrap server, so `url` must be on one of those two origins, and when there is nothing to send yet no request is made and the action says why.\n\nThe app follows no redirects from `url`. A loopback or non-`https` value is dropped when a bootstrap server or the hosted console delivers it (device management and the local configuration file may name a loopback host over plain `http`); a `credentialHelper` delivered by a bootstrap server that was not device-managed is held until the user allows it. Unset: no publish action is shown.")}}),userPluginMarketplacesEnabled:ie.field(ft.z.boolean().optional(),{flatKey:"userPluginMarketplacesEnabled",remotePolicy:{hotApplied:!0},support:{enabled:{scopes:["3p"],availableInVersion:"1.37937.0"}},title:fe.msg({defaultMessage:"Allow user-added plugin marketplaces",id:"v/P6I/BbB8"}),default:{displayOnly:!0},failClosedValue:!1,category:"sandbox",group:Xh.GENERAL_RESTRICTIONS_GROUP,order:6.6,description:{short:ie.shortDescription(fe.msg({defaultMessage:"Allow users to add plugin marketplaces. When off, marketplaces your organization did not provision are hidden and the app\u2019s sessions do not load their plugins.",id:"oqdOf+hjLS"})),long:ie.longDescription("When on (default), users can add plugin marketplaces from the plugin browser. Set to `false` to restrict plugins to your organization's marketplaces: the add-marketplace surfaces are hidden, and the app refuses adds that still reach it (deep links, stale UI). Any other marketplace present on the device is then hidden in every tab, whether a user added it in the app earlier or something outside the app registered it (for example Claude Code in a terminal, under `~/.claude`): its plugins are not listed, and installs and updates from it are refused. The sessions the app starts load plugins only from your organization's marketplaces, the organization plugins directory, the app's own uploads and the user's own skills folder, enforced through Claude Code's marketplace allowlist (`strictKnownMarketplaces`, passed as the app's managed settings). Nothing is deleted: removing the key or setting it back to `true` restores them. Marketplaces provisioned by your organization (`allowedPluginMarketplaces`) and the organization plugins directory are unaffected, and plugins users uploaded are governed by `userPluginUploadsEnabled`, not this key.\n\nThis is a feature-availability control, not a data boundary. Claude Code in a terminal reads the same `~/.claude` folder and is governed only by its own managed settings, not by this key. Claude Code may ignore this allowlist on a device that deploys its own Claude Code managed settings; restrict marketplaces in those settings as well.\n\nThis key applies only while the app runs in third-party mode. If users could otherwise sign in to Claude.ai on the device, also set `disableDeploymentModeChooser` so the app stays in third-party mode.",{docsUrl:`${Xn.COWORK_3P_DOCS_BASE}/configuration#userpluginmarketplacesenabled`})}}),userPluginUploadsEnabled:ie.field(ft.z.boolean().optional(),{flatKey:"userPluginUploadsEnabled",remotePolicy:{hotApplied:!0},support:{enabled:{scopes:["3p"],availableInVersion:"1.37937.0"}},title:fe.msg({defaultMessage:"Allow user-added plugins",id:"FC6Rd6B6Wv"}),default:{displayOnly:!0},failClosedValue:!1,category:"sandbox",group:Xh.GENERAL_RESTRICTIONS_GROUP,order:6.7,description:{short:ie.shortDescription(fe.msg({defaultMessage:"Allow users to add their own plugins. When off, every in-app option for adding one is hidden and uploads that still reach the app are refused.",id:"7AFPPgSJBu"})),long:ie.longDescription("When on (default), users can upload plugin files and create plugins with Claude. Set to `false` to stop users adding plugins of their own: every in-app option for doing so is hidden, and the app refuses uploads that still reach it.\n\nThis is a feature-availability control enforced in the app, not a data boundary: plugins already installed (or placed on disk outside the app) are not removed or blocked by this key. Plugins from organization-provisioned marketplaces and the organization plugins directory are unaffected.\n\nThis key applies only while the app runs in third-party mode. If users could otherwise sign in to Claude.ai on the device, also set `disableDeploymentModeChooser` so the app stays in third-party mode.",{docsUrl:`${Xn.COWORK_3P_DOCS_BASE}/configuration#userpluginuploadsenabled`})}})})});var kc=R(function(pM){Object.defineProperty(pM,"__esModule",{value:!0});pM.FeatureDiscoveryConfig=pM.AutoUpdateConfig=pM.ExtensionsConfig=pM.SURFACE_GRANT_FIELDS=pM.ChatSurfaceConfig=pM.CodeSurfaceConfig=pM.SSH_CLIENT_UNREADABLE_STAND_IN=pM.CoworkSurfaceConfig=pM.TokenLimitsConfig=pM.DictationConfig=pM.OtlpConfig=pM.OTLP_CONTENT_CATEGORIES=void 0;pM.dictationBaseUrl=aM;pM.websocketCspSource=Ev;pM.dictationCspSource=oce;pM.dictationEndpoints=sce;pM.surfaceOptionLock=uce;pM.isPlainGitBranchName=cM;pM.surfaceGrantOf=Av;pM.surfacesOf=kv;var Oe=fn(),rM=_c(),Oc=Zr(),iM=pr(),z=mt(),$n=Cn(),N=pn(),oM=Sr(),aa=Or(),Er=Li(),Sc=Qh(),Ms=N.msg({defaultMessage:"OpenTelemetry",id:"dYlenA3UP7"});pM.OTLP_CONTENT_CATEGORIES=["userPrompts","assistantResponses","toolDetails","toolContent","rawApiBodies"];function rce(e){if(!e)return!1;try{let{protocol:t,hostname:n}=new URL(e);return t==="http:"&&!aa.LOOPBACK_HOSTS.has(n)}catch(t){return!1}}var QD=$n.legacyKvEncodingNotice("otlpHeaders","no exporter headers will be sent"),eM=$n.legacyKvEncodingNotice("otlpResourceAttributes","no custom resource attributes will be attached");pM.OtlpConfig=Oe.z.object({endpoint:z.field(z.annotate($n.urlWithSchemeCoercion.optional(),{redact:"hostname",gatewayServable:!1}),{flatKey:"otlpEndpoint",readers:["desktop","m365","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},remotePolicy:{rejectLoopback:!0},title:N.msg({defaultMessage:"OpenTelemetry collector endpoint",id:"xovdJlXIM6"}),egressRequirements:$n.singleHostEgress,category:"telemetry",group:Ms,order:10,placeholder:N.msg({defaultMessage:"https://otel.example.com",id:"b7vgLij1HS"}),description:{short:z.shortDescription(N.msg({defaultMessage:"Where OpenTelemetry logs and metrics are sent. Leave blank to disable.",id:"Zhe9UuhccO"}))}}),protocol:z.field(z.annotate(Oe.z.enum(["http/protobuf","http/json","grpc"]).optional(),{gatewayServable:!1}),{flatKey:"otlpProtocol",readers:["desktop","m365","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},title:N.msg({defaultMessage:"OpenTelemetry exporter protocol",id:"jETNRIFigw"}),default:"http/protobuf",category:"telemetry",group:Ms,order:11,description:{short:z.shortDescription(N.msg({defaultMessage:"Transport protocol for the OpenTelemetry exporters.",id:"OtlpProtocolHint"})),long:z.longDescription("Code sessions export over the protocol set here. Chats and Cowork tasks export over `http/protobuf` instead of `grpc` on Windows, and on other platforms whenever the Claude Code engine is given an HTTP proxy (the operating system's proxy, `egressProxyUrl` or `egressProxyPacUrl`, or `HTTPS_PROXY` / `HTTP_PROXY` in a Claude Code settings file); the application log notes the substitution. The desktop application's own events always go over `http/json` to `<endpoint>/v1/logs`. None of this changes the endpoint, so choose `grpc` only for a collector that also serves OTLP/HTTP at the same address; otherwise keep `http/protobuf` and point `otlpEndpoint` at the collector's OTLP/HTTP receiver (conventionally port 4318).")},predicates:{show:(e)=>{var t;return((t=e.otlp)===null||t===void 0?void 0:t.endpoint)!==void 0},warn:(e)=>e==="grpc"?N.msg({defaultMessage:"Chats and Cowork tasks on Windows or behind an HTTP proxy, and the app\u2019s own events, export over OTLP/HTTP to this same endpoint. Choose grpc only if the collector also accepts OTLP/HTTP there.",id:"OtlpProtocolGrpcWarn"}):null}}),headers:z.field(z.annotate($n.kvRecord(QD).optional(),{redact:"presence",gatewayServable:!1}),{flatKey:"otlpHeaders",readers:["desktop","m365","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},deprecations:[QD],title:N.msg({defaultMessage:"OpenTelemetry exporter headers",id:"fO2poeLmt6"}),category:"telemetry",group:Ms,order:12,placeholder:{key:N.msg({defaultMessage:"X-Scope-OrgID",id:"OtlpHeadersKeyPh"}),value:N.msg({defaultMessage:"tenant-a",id:"OtlpHeadersValuePh"})},addLabel:N.msg({defaultMessage:"Add header",id:"IxbsWX4wj4"}),description:{short:z.shortDescription(N.msg({defaultMessage:"Static collector headers \u2014 routing and tenant headers only. No credentials here; use Collector authentication or the headers helper script for tokens.",id:"OtlpHeadersHint2"}))},predicates:{show:(e)=>{var t;return((t=e.otlp)===null||t===void 0?void 0:t.endpoint)!==void 0},warn:(e,t,n)=>rM.credentialHeadersWarn(e,n,"headersHelper")}}),authMode:z.field(z.annotate(Oe.z.enum(["none","inference-credential"]).optional(),{gatewayServable:!1}),{flatKey:"otlpAuthMode",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.30096.1"}},title:N.msg({defaultMessage:"Collector authentication",id:"OtlpCollectorAuthTitle"}),default:{displayOnly:"none"},optionLabels:{none:N.msg({defaultMessage:"None (static headers only)",id:"OtlpCollectorAuthNone"}),"inference-credential":N.msg({defaultMessage:"Reuse the inference credential",id:"OtlpCollectorAuthReuse"})},category:"telemetry",group:Ms,order:12.3,description:{short:z.shortDescription(N.msg({defaultMessage:"inference-credential sends the user\u2019s inference bearer token to the collector as Authorization: Bearer.",id:"OtlpCollectorAuthHint"})),long:z.longDescription("`inference-credential` adds `Authorization: Bearer <token>` to every export, using the token the app currently holds for the inference provider, with no helper script to deploy. The collector must accept that token as issued: an identity-provider sign-in (`external-idp`, gateway or Bedrock proxy) forwards the identity provider\u2019s token, which carries the audience you registered, Microsoft Entra on Foundry issues the Foundry resource\u2019s token, and Vertex workforce identity forwards a Google Cloud access token; static gateway and Bedrock keys are forwarded as-is. Because the token can also call inference as the user, use this only for a collector you operate; for anything else, use the headers helper script with an ingest-scoped credential. Kinds that never produce a bearer (AWS SigV4 kinds on Bedrock, Google ADC / OAuth files on Vertex, API-key kinds) export without it \u2014 use the helper script instead. Cowork tasks pick up the current token each time they start; a Code session keeps the token it started with for as long as it stays open; the desktop\u2019s own event exporter uses the current token on every flush. Before sign-in, exports go out unauthenticated. An `Authorization` header printed by the headers helper script wins over this.")},predicates:{show:(e)=>{var t;return((t=e.otlp)===null||t===void 0?void 0:t.endpoint)!==void 0},warn:(e,t)=>{var n,i;if(e!=="inference-credential")return null;if(rce((n=t.otlp)===null||n===void 0?void 0:n.endpoint))return N.msg({defaultMessage:"This sends the user\u2019s inference token over plain http to another host. Use an https collector endpoint.",id:"OtlpCollectorAuthCleartext"});if(!((i=t.inference)===null||i===void 0?void 0:i.provider)||oM.credentialYieldsBearer(t.inference))return null;return N.msg({defaultMessage:"The configured inference credential is not sent as a bearer token, so telemetry will export without it. Use the headers helper script instead.",id:"OtlpCollectorAuthNoBearer"})}}}),headersHelper:z.field(z.annotate(aa.safeHelperPath.optional(),{pathKind:"file",gatewayServable:!1}),{flatKey:"otlpHeadersHelper",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.30096.1"}},remotePolicy:{requiresUserConsent:!0},title:N.msg({defaultMessage:"OpenTelemetry headers helper script",id:"OtlpHeadersHelperTitle"}),category:"telemetry",group:Ms,order:12.6,placeholder:N.msg({defaultMessage:"/usr/local/bin/otel-headers-helper",id:"OtlpHeadersHelperPlaceholder"}),description:{short:z.shortDescription(N.msg({defaultMessage:"Absolute path to an executable that prints a JSON object of collector headers. Merged over the static headers and Collector authentication; the helper wins.",id:"OtlpHeadersHelperHint"})),long:z.longDescription('Absolute path to an executable that prints a single JSON object of HTTP headers on stdout, e.g. `{"Authorization": "Bearer \u2026"}`. The desktop runs it (no arguments; output cached for a few minutes, and a failure is not retried for 30 seconds) whenever it needs collector headers and merges the result over **OpenTelemetry exporter headers** and the **Collector authentication** header (the helper wins on conflict). Cowork tasks get the current output when they start; Code and Cowork sessions are also given the script as Claude Code\u2019s own `otelHeadersHelper`, so an open session re-runs it as tokens rotate (on Windows this applies to `.exe`, `.cmd` and `.bat` helpers; a `.ps1` helper applies at session start only); the desktop\u2019s own event exporter re-runs it per flush. Session start waits at most two seconds for a slow helper and otherwise proceeds without its headers until it finishes. Use this when the collector needs a credential the inference sign-in cannot provide, when the collector token rotates, or when the config comes from a hosted admin console, which cannot store header values. If the helper fails, telemetry is sent without its headers \u2014 check the app log.')},predicates:{show:(e)=>{var t;return((t=e.otlp)===null||t===void 0?void 0:t.endpoint)!==void 0}}}),resourceAttributes:z.field(z.annotate($n.kvRecord(eM).optional(),{redact:"presence",gatewayServable:!1}),{flatKey:"otlpResourceAttributes",readers:["desktop","m365","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.5354.0"}},deprecations:[eM],title:N.msg({defaultMessage:"OpenTelemetry resource attributes",id:"JgRwRuBWFK"}),category:"telemetry",group:Ms,order:13,placeholder:{key:N.msg({defaultMessage:"enduser.id",id:"QkbhtcTa4t"}),value:N.msg({defaultMessage:"alice@example.com",id:"KER1zNW5fX"})},addLabel:N.msg({defaultMessage:"Add attribute",id:"fkzH83T+V/"}),description:{short:z.shortDescription(N.msg({defaultMessage:"Extra resource attributes to attach to every span/metric. A static enduser.id set here always wins over the runtime identity.",id:"avoHZ0YdKZ"})),long:z.longDescription("Extra resource attributes to attach to every span, metric, and log sent to your collector. When End-user attribution is on and no `enduser.id` is set here, the desktop fills it with the signed-in user's runtime identity; a value you set here always wins. `process.owner` (the OS login name) is always emitted; set it here to override.")},predicates:{show:(e)=>{var t;return((t=e.otlp)===null||t===void 0?void 0:t.endpoint)!==void 0}}}),desktopLogLevel:z.field(Oe.z.enum(["off","error","warn","info","debug"]).optional(),{flatKey:"otlpDesktopLogLevel",remotePolicy:{hotApplied:!0},support:{enabled:{scopes:["3p"],availableInVersion:"1.9255.0"}},title:N.msg({defaultMessage:"Desktop telemetry export level",id:"TcONUV0eiZ"}),default:"error",category:"telemetry",group:Ms,order:14,description:{short:z.shortDescription(N.msg({defaultMessage:"Controls the Claude Desktop application\u2019s events, separate from Cowork and Code sessions. Defaults to error.",id:"wkZUOJzo5S"}))},predicates:{show:(e)=>{var t;return((t=e.otlp)===null||t===void 0?void 0:t.endpoint)!==void 0}}}),contentCapture:z.field(z.annotate($n.lenientEnumArray(pM.OTLP_CONTENT_CATEGORIES).optional(),{redact:"keep"}),{flatKey:"otlpContentCapture",readers:["desktop","m365","code"],failClosedValue:[],support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.15962.0"}},title:N.msg({defaultMessage:"Content capture categories",id:"OtlpContentCaptureTitle"}),category:"telemetry",group:Ms,order:15,description:{short:z.shortDescription(N.msg({defaultMessage:"Content categories the desktop exporter sends unredacted to your collector. Leave empty to redact all content (default).",id:"OtlpContentCaptureHint"})),long:z.longDescription(`Each category enables a class of raw content in OpenTelemetry events sent to your collector (this data never reaches Anthropic):
`+"- `userPrompts` \u2014 user-typed prompt text\n"+"- `assistantResponses` \u2014 assistant message text\n"+"- `toolDetails` \u2014 tool input arguments, e.g. the web-search query string\n"+"- `toolContent` \u2014 tool output content, e.g. fetched page text or command stdout\n"+"- `rawApiBodies` \u2014 inference API request and response bodies, each cut at 61,440 characters by default\n\n"+"These mirror Claude Code's `OTEL_LOG_*` env vars; see the [Claude Code monitoring docs](https://code.claude.com/docs/en/monitoring-usage).")},predicates:{show:(e)=>{var t;return((t=e.otlp)===null||t===void 0?void 0:t.endpoint)!==void 0}}}),tracesEnabled:z.field(Oe.z.boolean().optional(),{flatKey:"otlpTracesEnabled",readers:["desktop","m365","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.22209.0"}},title:N.msg({defaultMessage:"Export traces",id:"bKPAH/MBRZ"}),category:"telemetry",group:Ms,order:16,description:{short:z.shortDescription(N.msg({defaultMessage:"Also export OpenTelemetry traces from Cowork tasks and Code sessions. Uses Claude Code\u2019s session tracing.",id:"eW1UlMFTJB"})),long:z.longDescription("Enables Claude Code's session tracing (`CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1` + `OTEL_TRACES_EXPORTER=otlp`) in spawned Cowork tasks and Code sessions. Each user interaction exports a trace whose spans and events carry `trace_id`/`span_id`, enabling end-to-end correlation in your observability backend (metrics do not carry trace context; correlate those via `session.id`). Traces go to the collector endpoint and protocol configured above. When `otlpEndpoint` is set, this key alone decides whether those sessions export traces: leaving it unset or `false` keeps traces off even if Claude Code's own settings or managed settings (for example a `managed-settings.json` on the device) turn tracing on. Without `otlpEndpoint` it has no effect. The span structure may evolve between Claude Code releases; see the [Claude Code monitoring docs](https://code.claude.com/docs/en/monitoring-usage).")},predicates:{show:(e)=>{var t;return((t=e.otlp)===null||t===void 0?void 0:t.endpoint)!==void 0}}})});pM.DictationConfig=Oe.z.object({enabled:z.field(Oe.z.boolean().optional(),{flatKey:"dictationEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.44121.1"},executionTarget:"desktop",visibility:"public-undocumented"},remotePolicy:{hybrid:{scope:"excluded"},hotApplied:!0},title:N.msg({defaultMessage:"Dictation",id:"DictationEnabled"}),category:"connection",predicates:{show:(e)=>{var t;return((t=e.dictation)===null||t===void 0?void 0:t.enabled)!==void 0}},description:{short:z.shortDescription(N.msg({defaultMessage:"Typically supplied by your bootstrap server when the gateway offers dictation.",id:"DictationEnabledDesc"}))}})});var ice="user/dictation";function sM(e){let t=e.inference;if((t===null||t===void 0?void 0:t.provider)!=="gateway"||!t.baseUrl)return null;let n;try{n=new URL(t.baseUrl)}catch(o){return null}if(n.protocol!=="https:"&&!aa.LOOPBACK_HOSTS.has(n.hostname))return null;if(n.hostname.startsWith("["))return null;let i=t.credential;if((i===null||i===void 0?void 0:i.kind)!=="interactive")return null;let r=i.oidc;if((r===null||r===void 0?void 0:r.issuer)||(r===null||r===void 0?void 0:r.tokenUrl))return null;return t.baseUrl}function aM(e){var t;if(!((t=e.dictation)===null||t===void 0?void 0:t.enabled))return null;let n=sM(e);if(n===null)return null;let i=new URL(n);if(!i.pathname.endsWith("/"))i.pathname+="/";return new URL(ice,i).href}function Ev(e){let t=new URL(e);return{host:t.host,scheme:t.protocol==="http:"?"ws://":"wss://"}}function oce(e){let t=sM(e);return t===null?null:Ev(t)}function sce(e){let t=aM(e);if(t===null)return null;let n=new URL(`${t}/`),i=new URL("stream",n);return i.protocol=Ev(t).scheme.slice(0,-2),{ticketUrl:new URL("ticket",n).href,streamUrl:i.href}}var tM=(e)=>{var t;return((t=e.tokenLimits)===null||t===void 0?void 0:t.maxPerWindow)!==void 0};pM.TokenLimitsConfig=Oe.z.object({maxPerWindow:z.field(Oe.
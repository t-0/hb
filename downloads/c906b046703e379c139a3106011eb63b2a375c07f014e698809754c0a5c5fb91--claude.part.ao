n Code first.",description:"\u201CCode\u201D is a product name \u2014 keep it untranslated in Latin script; translate the rest naturally.",id:"LastSurfaceOptionReason"});function Pv(e,t){let n=t==="codeSurface"?void 0:fM(e);if(n)return n;if(!em[t](e))return!1;for(let i of Object.keys(em))if(i!==t&&em[i](e))return!1;return lce}function Sv(e){return Av(e)===void 0}function uce(e,t,n){var i;if(!e.surfaceGrants||em.codeSurface(n))return!1;let r=(i=t===void 0?void 0:z.surfaceGrantFor(e.surfaceGrants,t))!==null&&i!==void 0?i:dM(n);return r.chat||r.cowork?!1:cce}pM.CoworkSurfaceConfig=Oe.z.object({enabled:z.field(Oe.z.boolean().optional(),{flatKey:"coworkTabEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.9659.0"}},title:N.msg({defaultMessage:"Allow Cowork",description:"\u201CCowork\u201D is a product name \u2014 keep it untranslated in Latin script; translate the rest of the sentence naturally.",id:"pq8krELyA1"}),default:!0,failClosedValue:!1,remotePolicy:{applyUnverified:!1},category:"sandbox",group:tm,label:N.msg({defaultMessage:"Cowork",description:"[no-translate] Product name; must remain exactly \u201CCowork\u201D in every locale.",id:"+MH0VdRCHz"}),order:0,predicates:{show:Sv,disabled:(e)=>Pv(e,"coworkSurface")},description:{short:z.shortDescription(N.msg({defaultMessage:"Enable Cowork. Claude works on longer tasks like research, analysis, and documents.",description:"\u201CCowork\u201D is a product name \u2014 keep it untranslated in Latin script; translate the rest of the sentence naturally.",id:"N8nKVnjFDF"}))}})});pM.SSH_CLIENT_UNREADABLE_STAND_IN="/dev/null/unreadable-ssh-client";var dce=/^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$/,lM=/^[A-Za-z0-9][A-Za-z0-9._-]{0,99}\/[A-Za-z0-9][A-Za-z0-9._-]{0,99}$/,wv=2048,fce=/^https:\/\/[^@?#\s]+$/,pce=/https?:\/\/[^/]+\/([^/]+\/[^/]+?)(?:\.git)?$/;function hce(e){return dce.test(e)&&!e.includes("..")&&!e.includes("/-")}function cM(e){return e!=="HEAD"&&!e.endsWith(".")&&!/^[0-9a-f]{40}$/i.test(e)&&!e.startsWith("refs/")&&hce(`refs/heads/${e}`)&&e.split("/").every((t)=>t!==""&&!t.startsWith(".")&&!t.endsWith(".lock"))}function mce(e){var t;let n={refused:`Must be at most ${wv} characters`};if(!/^https:\/\//i.test(e))return{refused:"Must be an https:// address"};if(e.length>wv)return n;let i;try{i=new URL(e)}catch(l){return{refused:"Not a valid URL"}}if(/[?#]/.test(e))return{refused:"Must not carry a query string or fragment"};let r=i.pathname.replace(/\/+$/,"");if(r==="")return{refused:"Must name a repository after the host"};if(/%(?!20)/.test(r))return{refused:"The path may hold no percent-escape but %20"};let o=`https://${i.host}${r}`;if(!fce.test(o))return{refused:"The path must not hold an @"};if(o.length>wv)return n;let s=(t=pce.exec(o))===null||t===void 0?void 0:t[1];if(s!==void 0&&`/${s}`!==r.replace(/\.git$/,""))return{refused:"An owner/repo may only be the whole path"};if(s!==void 0&&!lM.test(s))return{refused:"A two-part path is an owner and a repository: letters, numbers and . _ - (100 characters each), starting with a letter or number"};return{url:o}}pM.CodeSurfaceConfig=Oe.z.object({enabled:z.field(Oe.z.boolean().optional(),{flatKey:"isClaudeCodeForDesktopEnabled",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.2581.0"}},title:N.msg({defaultMessage:"Allow Code",id:"5fWJP5tZx6"}),default:!0,failClosedValue:!1,remotePolicy:{applyUnverified:!1},category:"sandbox",group:tm,label:N.msg({defaultMessage:"Code",id:"h2vipunVVd"}),order:1,predicates:{disabled:(e)=>Pv(e,"codeSurface")},description:{short:z.shortDescription(N.msg({defaultMessage:"Enable Code. Claude writes and runs code.",id:"/vs1W12TA0"}))}}),sshHostAllowlist:z.field(z.annotate(Oe.z.array(Oe.z.string().trim().min(1)).optional(),{glob:!0}),{flatKey:"sshHostAllowlist",support:{enabled:{scopes:["3p"],availableInVersion:"1.40609.0"},executionTarget:"desktop"},betaFeatureKey:"sshRemoteSessions",title:N.msg({defaultMessage:"SSH host allowlist",id:"t3bJrMvGzZ"}),failClosedValue:[],category:"sandbox",group:Er.CODE_SURFACE_GROUP,order:16,placeholder:N.msg({defaultMessage:"*.dev.example.com",id:"KWUwe1EqgP"}),predicates:{show:(e)=>{var t;return((t=e.codeSurface)===null||t===void 0?void 0:t.enabled)!==!1}},description:{short:z.shortDescription(N.msg({defaultMessage:"SSH hosts users may connect to for Code sessions. Empty or unset: off unless the device\u2019s Claude Code managed-settings allowlist applies. * allows any host.",id:"KXzmrLfnUT"})),long:z.longDescription("When off, the SSH option is hidden and any connection attempt is refused.\n\nEntries are exact hostnames (`build01.corp.example.com`) or `*.` wildcards (`*.corp.example.com` matches the apex and subdomains at any depth); matching is case-insensitive and ignores a `user@` prefix. The list is compared with the `HostName` that the user's SSH configuration (`~/.ssh/config`) gives for the host they entered, or with the entered host itself when the configuration has no entry for it or cannot be evaluated. So an alias is allowed when the host it points to is listed, whatever the alias is called, and refused when it is not. `ProxyCommand` is permitted when the resolved host matches (this key governs which hosts the app offers, not network egress); `ProxyJump` is permitted likewise on the system-OpenSSH engine (the default on macOS and Linux; see `sshTransport`) and refused, with a message suggesting `ProxyCommand`, by the built-in SSH library.\n\nThis is opt-in because a remote session runs Claude Code on the SSH host and the app forwards the session's inference credential to it, plus your OTLP collector endpoint and auth headers when `otlpEndpoint` is set. List only hosts you trust with those. Token-based credentials are forwarded. File-based credentials (Bedrock IAM Identity Center sign-in or AWS profile, Vertex Google sign-in or a credentials file) are never forwarded, and a session that needs one from the device is refused.\n\nIf this key is unset, an `sshHostAllowlist` in Claude Code's own managed-settings file on the device still applies; when both are set, this key wins where the app's configuration is admin-managed (MDM, the admin console, or a device-managed bootstrap URL) and otherwise applies only while that file sets none. `allowedWorkspaceFolders` still applies on the remote host. Claude Code's managed settings on a host replace the sandbox, network, permission, and MCP rules this app sends unless they set `parentSettingsBehavior` to `\"merge\"`.",{docsUrl:`${$n.COWORK_3P_DOCS_BASE}/ssh-remote-sessions`})}}),sshClientPath:z.field(z.annotate(aa.safeHelperPath.optional(),{pathKind:"file"}),{flatKey:"sshClientPath",support:{enabled:{scopes:["3p"],availableInVersion:"1.46388.1"},executionTarget:"desktop"},betaFeatureKey:"sshRemoteSessions",remotePolicy:{requiresUserConsent:!0},failClosedValue:pM.SSH_CLIENT_UNREADABLE_STAND_IN,unreadableStandIn:!0,title:N.msg({defaultMessage:"SSH client program",id:"TnZHycC4Xk"}),category:"sandbox",group:Er.CODE_SURFACE_GROUP,order:16.5,placeholder:N.msg({defaultMessage:"/opt/openssh/bin/ssh",id:"matzhaiItp"}),predicates:{show:(e)=>{var t;return((t=e.codeSurface)===null||t===void 0?void 0:t.enabled)!==!1}},description:{short:z.shortDescription(N.msg({defaultMessage:"Absolute path to the OpenSSH ssh program the app runs for SSH sessions. Unset: the first ssh on the user\u2019s PATH.",id:"CkU2BFhxiC"})),long:z.longDescription("Pins which OpenSSH client the app runs wherever it starts `ssh`: evaluating the user's SSH configuration (`ssh -G`), making the SSH connection and its channels, and the Code tab's terminal. `ssh-keygen` and `ssh-add` are taken from the same directory when they exist there, otherwise from PATH. The program must be OpenSSH 7.6 or newer (on Windows, Win32-OpenSSH 9.4 or newer to carry the connection); on macOS and Linux a wrapper script that ends in one is accepted, on Windows it must be a native `.exe` (not a .cmd, .bat or .ps1 script). When this key is set and the program is missing, cannot be run, or is too old, SSH sessions fail with an error telling the user to ask their IT administrator (the configured path is in its details) \u2014 the app never falls back to another ssh. The connection itself runs through this program on the system-OpenSSH engine, which the SSH connection engine setting's `system-openssh` value selects on every platform, including Windows; when the app's built-in SSH library makes the connection instead, this key still governs configuration evaluation (`ssh -G`), host-key lookups (`ssh-keygen`) and the terminal.",{docsUrl:`${$n.COWORK_3P_DOCS_BASE}/ssh-remote-sessions`})}}),sshTransport:z.field(Oe.z.enum(["auto","system-openssh","builtin"]).optional(),{flatKey:"sshTransport",support:{enabled:{scopes:["3p"],availableInVersion:"1.52386.0"},executionTarget:"desktop"},betaFeatureKey:"sshRemoteSessions",title:N.msg({defaultMessage:"SSH connection engine",id:"SshTransportTitle"}),default:{displayOnly:"auto"},optionLabels:{auto:N.msg({defaultMessage:"Automatic (the build\u2019s default)",id:"SshTransportAuto"}),"system-openssh":N.msg({defaultMessage:"System OpenSSH client",id:"SshTransportSystemOpenSsh"}),builtin:N.msg({defaultMessage:"Built-in SSH library",id:"SshTransportBuiltin"})},category:"sandbox",group:Er.CODE_SURFACE_GROUP,order:16.7,predicates:{show:(e)=>{var t;return((t=e.codeSurface)===null||t===void 0?void 0:t.enabled)!==!1}},description:{short:z.shortDescription(N.msg({defaultMessage:"Which SSH engine carries Code sessions: the OpenSSH ssh program on the device, or the app\u2019s built-in SSH library. Unset or auto: the build\u2019s default.",id:"SshTransportHint"})),long:z.longDescription("`system-openssh`: the app makes every SSH connection by running an OpenSSH `ssh` program \u2014 the one `sshClientPath` names, otherwise the first `ssh` on the user's PATH (on Windows, a Win32-OpenSSH `ssh.exe`: the PATH one, else the in-box or Microsoft-installed client) \u2014 so the organization's own OpenSSH build, with its Kerberos/GSSAPI, certificate and `ssh_config` support, is what authenticates. The program must be OpenSSH 7.6 or newer (Windows: Win32-OpenSSH 9.4 or newer). When `sshClientPath` is set and that program cannot be used, sessions fail with an error telling the user to ask their IT administrator rather than falling back; when it is unset and Windows has no usable client, the built-in library is used.\n\n`builtin`: the app's built-in SSH library makes the connection, whatever the build's default.\n\n`auto` or unset: the build's default engine.\n\nAn explicit value applies to new connections (sessions already connected keep their engine) and overrides the build's default in both directions, including any remote switch-off Anthropic ships for the OpenSSH engine \u2014 so with `system-openssh` set, switching back is done here, by setting `builtin`.",{docsUrl:`${$n.COWORK_3P_DOCS_BASE}/ssh-remote-sessions`})}}),allowedRepositories:z.field(z.annotate((()=>{let e=(o)=>o.source==="github",t=(o)=>o.source==="git",n={label:N.msg({defaultMessage:"Source",id:"cc9hc4+0K4"}),optionLabels:{github:N.msg({defaultMessage:"GitHub",id:"SYEyDpPjNk"}),git:N.msg({defaultMessage:"Git URL",id:"TpLDdW3nvS"})},description:{short:z.shortDescription(N.msg({defaultMessage:"Where the repository lives: GitHub (set repo) or any other Git host (set url).",id:"CodeRepoSourceHint"}))},predicates:{required:()=>!0}},i={ref:z.subfield(Sc.marketplaceRef.transform((o,s)=>{if(o===void 0)return;let l=o.trim().replace(/^refs\/heads\//,"");if(!cM(l))return s.addIssue("Branch names can only use letters, numbers, and . _ / -"),Oe.z.NEVER;return l}),{label:N.msg({defaultMessage:"Branch",id:"CodeRepoBranch"}),description:{short:z.shortDescription(N.msg({defaultMessage:"Branch a session starts from. Leave it out for the repository\u2019s default branch. The person starting a session may type another.",id:"CodeRepoBranchHint"}),{docsOnly:!1})}}),name:z.subfield(Oe.z.string().trim().min(1).max(64).optional(),{label:N.msg({defaultMessage:"Name",id:"CodeRepoName"}),description:{short:z.shortDescription(N.msg({defaultMessage:"Shown in the repository list in place of the address. Up to 64 characters.",id:"CodeRepoNameHint"}),{docsOnly:!1})}})},r=Oe.z.discriminatedUnion("source",[Oe.z.object({source:z.subfield(Oe.z.literal("github"),n),repo:z.subfield(Sc.marketplaceRepo.refine((o)=>lM.test(o),"Owner and repository names can only use letters, numbers, and . _ - (100 characters each)"),{label:N.msg({defaultMessage:"Repository",id:"ZHK3DVhcxt"}),isPrimaryKey:!0,placeholder:N.msg({defaultMessage:"owner/repo",id:"3pZ8Ut7zIL"}),description:{short:z.shortDescription(N.msg({defaultMessage:"GitHub repository in owner/repo form. Case-insensitive.",id:"2cD0skIoWu"}))},predicates:{show:e,required:e}}),...i}),Oe.z.object({source:z.subfield(Oe.z.literal("git"),n),url:z.subfield(Sc.marketplaceUrl.transform((o,s)=>{let l=mce(o);if("refused"in l)return s.addIssue(l.refused),Oe.z.NEVER;return l.url}),{label:N.msg({defaultMessage:"URL",id:"5M+YdqOWGS"}),isPrimaryKey:!0,description:{short:z.shortDescription(N.msg({defaultMessage:"HTTPS clone URL of the repository, with no user name, password, query string or fragment.",id:"CodeRepoUrlHint"}))},predicates:{show:t,required:t}}),...i})]);return z.annotate(Oe.z.array(r.nullable().catch(null)),{maxItems:100}).transform((o)=>o.filter((s)=>s!==null))})().optional(),{redact:"presence"}),{flatKey:"codeAllowedRepositories",support:{enabled:{scopes:["3p"],availableInVersion:"2.16120.0"},visibility:"public-undocumented"},betaFeatureKey:"selfHostedSessions",remotePolicy:{hybrid:{scope:"excluded"}},title:N.msg({defaultMessage:"Allowed repositories",id:"CodeReposTitle"}),failClosedValue:[],emptyListIsAuthored:!0,checkDropped:(e,t)=>{var n;let i=z.unwrapZod(pM.CodeSurfaceConfig.shape.allowedRepositories),r=z.unwrapZod((n=z.arrayElementOf(i))!==null&&n!==void 0?n:i);(Array.isArray(e)?e:[]).forEach((o,s)=>{let l=r.safeParse(o);if(!l.success){let c=l.error.issues.map((u)=>`${u.path.join(".")||"."}: ${u.message}`).join("; ");t(`codeAllowedRepositories[${s}] dropped: ${c}`)}})},category:"sandbox",group:Er.CODE_SURFACE_GROUP,order:17,predicates:{show:(e)=>{var t;return((t=e.codeSurface)===null||t===void 0?void 0:t.enabled)!==!1}},addLabel:N.msg({defaultMessage:"Add repository",id:"CodeReposAdd"}),presets:[{label:"GitHub repo",item:{source:"github",repo:""}},{label:"Git URL",item:{source:"git",url:""}}],description:{short:z.shortDescription(N.msg({defaultMessage:"Git repositories Claude Code may work in.",id:"CodeReposHint"})),long:z.longDescription('The git repositories Claude Code may work in on this install, in the two git forms a plugin marketplace entry takes: `{"source": "github", "repo": "owner/repo"}`, or `{"source": "git", "url": "https://git.example.com/group/project.git"}` for another Git host. Either may add `ref`, the branch a session starts from (a branch name, not a tag or commit; leave it out for the default branch; a person may type another), and `name`, a label shown for the address (up to 64 characters). A `url` is `https://` with no user name, password, query string or fragment (Azure DevOps shows a clone URL with a user name: leave it out); an address written without a scheme is read as `https://`.\n\nBeta. Today: where Code sessions run on a self-hosted session host, people pick a session\'s repository from this list and cannot type an address; with no list, or an empty one, none is offered and a session starts in the environment\'s own workspace. The session host still applies its own policy to what it clones. Where sessions run on the device, the key is accepted and has no effect yet: limiting local folders to those whose `origin` is listed, alongside `allowedWorkspaceFolders`, is planned.\n\nEntries are held to what a session host, the only reader so far, accepts: owner and repository names of letters, numbers and `. _ -` (100 characters each) that must start with a letter or number, a branch name both it and git accept, an address of at most 2048 characters whose path has no percent-escape but `%20`.\n\nUnset: there is no list. Empty, or a value that cannot be read as a list: there are no repositories, so none can be chosen; an unreadable value, or a list with no readable entry, is reported and never treated as unset; an empty list an admin writes stays an empty list on every surface. An entry that cannot be read is left out and reported by its position (the first is 0), with the reason; the other entries, and the rest of the configuration, stand.')}})});pM.ChatSurfaceConfig=Oe.z.object({enabled:z.field(Oe.z.boolean().optional(),{flatKey:"chatTabEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.13576.0"},executionTarget:"desktop"},title:N.msg({defaultMessage:"Allow Chat",id:"0Cc9oG2J04"}),category:"sandbox",group:tm,label:N.msg({defaultMessage:"Chat",id:"WTrOy36sdu"}),order:2,predicates:{show:Sv,disabled:(e)=>Pv(e,"chatSurface")},description:{short:z.shortDescription(N.msg({defaultMessage:"Enable Chat. Quick questions and drafting.",id:"z2x73mCBZ9"}))}}),advancedFileAnalysis:z.field(Oe.z.boolean().optional(),{flatKey:"chatAdvancedFileAnalysisEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.14271.0"},executionTarget:"desktop"},title:N.msg({defaultMessage:"Advanced file analysis",id:"ChatAdvancedFileAnalysisEnabled"}),category:"sandbox",group:ace,order:20,predicates:{show:(e)=>{var t;return Sv(e)&&((t=e.chatSurface)===null||t===void 0?void 0:t.enabled)!==!1},disabled:(e)=>{var t;return(t=fM(e))!==null&&t!==void 0?t:!1}},description:{short:z.shortDescription(N.msg({defaultMessage:"Allow Claude to run code in a local sandbox to analyze attached files it can\u2019t read natively \u2014 like Excel and PowerPoint. Off by default.",id:"EC49vAdH1s"})),long:z.longDescription("Also enables inline data analysis. Of the user's own files, the sandbox can read only those attached to the conversation, plus folders added to the chat's project through the app (read-only). By default it has no network access. Project folders are not available in the sandbox of a chat started while a rule on `Read`, `Grep` or `Glob` is set: in `disabledBuiltinTools`, in `builtinToolPolicy` with a value other than `allow`, or as a deny or ask rule in Claude Code's own managed settings on the device, whether or not the rule covers the folder. They are not available either where those managed settings cannot be read, or where Claude Code takes its managed settings from a gateway. Claude's file tools still read what the rules allow.")}}),desktopHome:z.field(Oe.z.enum(["standard","simple","no-vm","off"]).optional(),{flatKey:"desktopHome",support:{enabled:{scopes:["3p"],availableInVersion:"1.52386.0"},values:{"no-vm":{availableInVersion:"2.2553.0"}}},optionValues:["standard","off"],failClosedValue:"off",remotePolicy:{applyUnverified:!1},title:N.msg({defaultMessage:"Desktop home",id:"DesktopHome"}),surfaceGrants:{standard:{chat:!0,fileAnalysis:!0,cowork:!0},simple:{chat:!0,fileAnalysis:!0,cowork:!1},"no-vm":{chat:!0,fileAnalysis:!1,cowork:!1},off:{chat:!1,fileAnalysis:!1,cowork:!1}},surfaceGrantsReason:N.msg({defaultMessage:"Desktop home decides this while it is set.",description:"\u201CDesktop home\u201D is the title of another setting on this page; use the same translation as that title.",id:"DesktopHomeDecides"}),optionLabels:{standard:N.msg({defaultMessage:"Standard",id:"DesktopHomeStandard"}),simple:N.msg({defaultMessage:"Simple: Chat with file analysis",description:"\u201CChat\u201D is a product name \u2014 keep it untranslated in Latin script; translate the rest naturally.",id:"DesktopHomeSimple"}),"no-vm":N.msg({defaultMessage:"No VM: Chat without file analysis",description:"\u201CChat\u201D is a product name and \u201CVM\u201D abbreviates virtual machine \u2014 keep \u201CChat\u201D untranslated in Latin script; translate the rest naturally.",id:"DesktopHomeNoVm"}),off:N.msg({defaultMessage:"Off: Code only",description:"\u201CCode\u201D is a product name \u2014 keep it untranslated in Latin script; translate the rest naturally.",id:"DesktopHomeOff"})},category:"sandbox",group:tm,order:3,description:{short:z.shortDescription(N.msg({defaultMessage:"Unifies Chat and Cowork into one home. When set, it replaces Allow Chat, Advanced file analysis, and Allow Cowork. Leave unset to keep those.",description:"\u201CChat\u201D and \u201CCowork\u201D are product names \u2014 keep them untranslated in Latin script; translate the rest naturally.",id:"DesktopHomeDesc"})),long:z.longDescription("`standard` turns on Chat, file analysis, and Cowork together in one home. `off` turns all three off. `isClaudeCodeForDesktopEnabled` still decides Code. Remove the key to hand control back to `chatTabEnabled`, `chatAdvancedFileAnalysisEnabled`, and `coworkTabEnabled`. Values are case-sensitive, so `Standard` is not recognized. A value that the app does not recognize is read as `off`, so update the app on devices before you deploy a value added in a later version.")}})});pM.SURFACE_GRANT_FIELDS=Object.entries(pM.ChatSurfaceConfig.shape).flatMap(([e,t])=>{let n=z.fieldMetaForNode(t);return(n===null||n===void 0?void 0:n.surfaceGrants)&&n.flatKey?[{key:e,flatKey:n.flatKey,grants:n.surfaceGrants,reason:n.surfaceGrantsReason}]:[]});function uM(e){var t;let n=(t=e.chatSurface)!==null&&t!==void 0?t:{};for(let i of pM.SURFACE_GRANT_FIELDS){let r=z.surfaceGrantFor(i.grants,n[i.key]);if(r)return{field:i,grant:r}}return}function Av(e){var t;return(t=uM(e))===null||t===void 0?void 0:t.grant}function dM(e){var t,n,i;return{chat:((t=e.chatSurface)===null||t===void 0?void 0:t.enabled)===!0,fileAnalysis:((n=e.chatSurface)===null||n===void 0?void 0:n.advancedFileAnalysis)===!0,cowork:((i=e.coworkSurface)===null||i===void 0?void 0:i.enabled)!==!1}}function kv(e){var t;return(t=Av(e))!==null&&t!==void 0?t:dM(e)}function fM(e){var t;return(t=uM(e))===null||t===void 0?void 0:t.field.reason}var Ov=N.msg({defaultMessage:"Extensions",id:"nb2FlN/G2m"});pM.ExtensionsConfig=Oe.z.object({enabled:z.field(Oe.z.boolean().optional(),{flatKey:"isDesktopExtensionEnabled",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.2581.0"},executionTarget:"desktop"},title:N.msg({defaultMessage:"Allow desktop extensions",id:"knHnvzpkOf"}),default:!1,legacyFlatKey:{name:"isDxtEnabled",effect:"the old name will be reported as unreadable and the key will read as false: desktop extensions will be disabled until the name is updated",...Oc.BATCH_2026_09},failClosedValue:!1,egressRequirements:(e)=>e===!1?[]:iM.PYTHON_EXTENSION_RUNTIME_HOSTS,egressRequirementsLabel:N.msg({defaultMessage:"Desktop extensions (Python runtime)",id:"8Jc9WEC0S8"}),category:"connectors",group:Ov,order:11,description:{short:z.shortDescription(N.msg({defaultMessage:".dxt and .mcpb installs.",id:"2IB0Hxh1vO"})),long:z.longDescription("1P builds default to enabled at runtime unless this is explicitly set. In 3P, enabling this allows loading extensions; local install additionally requires an org policy backend.")}}),directoryEnabled:z.field(Oe.z.boolean().optional(),{flatKey:"isDesktopExtensionDirectoryEnabled",support:{enabled:{scopes:["1p"],availableInVersion:"1.2581.0"}},title:N.msg({defaultMessage:"Show extension directory",id:"bqOLf0vLQm"}),default:{displayOnly:!0},legacyFlatKey:{name:"isDxtDirectoryEnabled",effect:"the old name will be reported as unreadable and not read, leaving the key unset: the extension directory will show and no directory-only install restriction will apply until the name is updated",...Oc.BATCH_2026_09},category:"connectors",group:Ov,order:12,description:{short:z.shortDescription(N.msg({defaultMessage:"The in-app catalogue of installable extensions. Hide to allow sideload only.",id:"g8s4jWgsLf"}))},predicates:{show:(e)=>{var t;return((t=e.extensions)===null||t===void 0?void 0:t.enabled)!==!1}}}),signatureRequired:z.field(Oe.z.boolean().optional(),{flatKey:"isDesktopExtensionSignatureRequired",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.2581.0"},executionTarget:"desktop"},title:N.msg({defaultMessage:"Require signed extensions",id:"bmP92ZCban"}),default:!1,legacyFlatKey:{name:"isDxtSignatureRequired",effect:"the old name will be reported as unreadable and the key will read as true: only signed extensions will load until the name is updated",...Oc.BATCH_2026_09},failClosedValue:!0,category:"connectors",group:Ov,order:13,description:{short:z.shortDescription(N.msg({defaultMessage:"Reject desktop extensions that are not signed by a trusted publisher.",id:"DY0aw7svrD"}))},predicates:{show:(e)=>{var t;return((t=e.extensions)===null||t===void 0?void 0:t.enabled)!==!1}}})});pM.AutoUpdateConfig=Oe.z.object({disabled:z.field(Oe.z.boolean().optional(),{flatKey:"disableAutoUpdates",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.2581.0"}},appBehaviorOnly:!0,title:N.msg({defaultMessage:"Block auto-updates",id:"OX1+jdVwLL"}),default:!1,category:"telemetry",group:Er.UPDATES_GROUP,order:20,description:{short:z.shortDescription(N.msg({defaultMessage:"Stop Claude Desktop from fetching updates entirely (no time limit). You\u2019ll need to push new versions yourself.",id:"t/LNoeQ72j"})),long:z.longDescription("In third-party deployments this also keeps Cowork's workspace image and tools from being fetched ahead of use; they are then fetched when a task first needs them.")},predicates:{warn:(e)=>e===!0?N.msg({defaultMessage:"Security and compatibility fixes will not install automatically. Make sure IT has another distribution path.",id:"1oztgcYddf"}):null}}),enforcementHours:z.field(Oe.z.coerce.number().int().gt(0).lte(72).optional(),{flatKey:"autoUpdaterEnforcementHours",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.2581.0"}},appBehaviorOnly:!0,title:N.msg({defaultMessage:"Auto-update enforcement window",id:"jJz20QocAd"}),category:"telemetry",group:Er.UPDATES_GROUP,order:21,suffix:N.msg({defaultMessage:"hours",id:"4MengK4xQ/"}),description:{short:z.shortDescription(N.msg({defaultMessage:"Hours before a downloaded update force-installs. Only applies when auto-updates are enabled. Blank = 72-hour default.",id:"VyqfjIW6Iv"})),long:z.longDescription("Has no effect when `disableAutoUpdates` is in place at launch: the updater never starts, so nothing is downloaded and this timer never arms. If the policy reaches an already-running app after an update has downloaded, that one staged update still installs on this timer; no further updates are fetched.\n\nLeaving it blank uses the 72-hour default *and* then waits for the machine to be idle (10+ minutes without input) before restarting; setting any explicit value (including 72) restarts once the window elapses regardless of user activity. In both cases the restart holds off while Claude is mid-task.")},predicates:{show:(e)=>{var t;return((t=e.autoUpdate)===null||t===void 0?void 0:t.disabled)!==!0}}}),viaUpdatesHost:z.field(Oe.z.boolean().optional(),{flatKey:"updateViaUpdatesHost",remotePolicy:{hotApplied:!0},support:{enabled:{scopes:["3p"],availableInVersion:"1.26832.0"}},appBehaviorOnly:!0,title:N.msg({defaultMessage:"Check for updates on releases.claude.com",id:"UpdateViaUpdatesHost"}),default:!1,category:"telemetry",group:Er.UPDATES_GROUP,order:22,description:{short:z.shortDescription(N.msg({defaultMessage:"Read the update feed from releases.claude.com so api.anthropic.com can stay blocked.",id:"UpdateViaUpdatesHostShort"})),long:z.longDescription("By default the app asks `api.anthropic.com` which version to install. That host also serves the model APIs, so organizations that block un-approved LLM endpoints at the network edge end up blocking updates too.\n\nTurn this on to read the same feed from `releases.claude.com`, a hostname that carries no model API. `api.anthropic.com` can then stay blocked without breaking auto-update. Rollout behavior is unchanged; the installer download still comes from `downloads.claude.ai` as before.")},predicates:{show:(e)=>{var t;return((t=e.autoUpdate)===null||t===void 0?void 0:t.disabled)!==!0}}}),dangerousMaxVersion:z.field($n.desktopVersionString().optional(),{flatKey:"dangerousMaxVersion",support:{enabled:{scopes:["3p"],availableInVersion:"2.110.0"},visibility:"public-undocumented"},appBehaviorOnly:!0,title:N.msg({defaultMessage:"Maximum version",id:"DangerousMaxVersion"}),category:"telemetry",group:Er.UPDATES_GROUP,order:22.5,description:{short:z.shortDescription(N.msg({defaultMessage:"Third-party deployments only. Auto-update stops at this version (X.Y.Z) and devices on newer versions cannot open Claude. Delays security fixes; leave unset.",id:"DangerousMaxVersionShort"})),long:z.longDescription("Third-party deployments only. Caps the Claude version your devices run. Update checks take the newest release at or below this version and nothing newer. Devices on a version from before this setting existed don't send the cap, so they update past it and are then blocked: move your fleet onto a version that supports this setting, or turn off auto-updates, before you set a cap below the latest release. Use `X.Y.Z` form, e.g. `1.2581.0`; `v1.2581.0` also works.\n\nA device on a newer version, including a fresh install of one, cannot open Claude. It shows a message that names both versions and asks the person to contact their admin, and the only option is to quit. Only a cap your organization delivers blocks: a device-management profile or machine policy, the admin console, or a bootstrap server. A cap set only in the local Setup UI, or in a per-user Windows policy, caps updates but does not block. When a profile that configures the connection also names a configuration server, the served configuration is authoritative once fetched and must restate the cap; the profile's value blocks only while the server can't be reached, and before sign-in it caps updates without blocking. A profile that sets only app-behavior keys wins over a served value. The cap never downgrades or rolls back a device. An update that finished downloading before the cap reached a device can still install, and that device is then blocked too.\n\nWhile it is set, security and compatibility fixes in newer releases do not install, so Anthropic recommends leaving it unset. If you use it, raise it as you approve each new version: devices below the new value update to it on their next update check, and `autoUpdaterEnforcementHours` still restarts them within its window.\n\n`disableAutoUpdates` takes precedence for updates: with both set, nothing updates, and devices on a newer version are still blocked. On Linux, where the package manager (apt) delivers updates, it caps nothing but still blocks newer versions.")},predicates:{warn:(e)=>e?N.msg({defaultMessage:"Devices on a newer version cannot open Claude, and security fixes in newer releases do not install, until you raise or remove this cap.",id:"DangerousMaxVersionWarn"}):null}})});var gce=N.msg({defaultMessage:"Feature announcements",id:"FeatureAnnouncementsGroup"});pM.FeatureDiscoveryConfig=Oe.z.object({disabled:z.field(Oe.z.boolean().optional(),{flatKey:"disableFeatureDiscovery",remotePolicy:{hotApplied:!0},support:{enabled:{scopes:["3p"],availableInVersion:"1.21459.0"}},title:N.msg({defaultMessage:"Hide feature announcements",id:"DisableFeatureDiscoveryTitle"}),default:!1,failClosedValue:!0,category:"appearance",group:gce,order:10,description:{short:z.shortDescription(N.msg({defaultMessage:"Suppress unprompted feature-announcement UI: the post-update \u201CWhat\u2019s new\u201D nudge and new-feature tips. Users can still open release notes themselves.",id:"DisableFeatureDiscoveryHint"})),long:z.longDescription(`Covers the version-shipped announcement UI baked into each release: the **What's new** button that appears on its own after an update, and the one-time **New feature** tips (coach-marks) that point out newly shipped capabilities. Useful when your organization gates feature availability and doesn't want the app advertising capabilities you haven't rolled out.

`+"User-initiated surfaces stay: the What's-new menu item and header button still open the release notes on demand. Auto-update behavior is unaffected \u2014 that is governed by `disableAutoUpdates` and `autoUpdaterEnforcementHours`.")}})})});var Iv=R(function(wM){Object.defineProperty(wM,"__esModule",{value:!0});wM.BootstrapConfig=void 0;var Ec=fn(),vM=Zr(),At=mt(),qr=Cn(),kt=pn(),Pc=Or(),vi=Li(),dd=(e)=>{var t;return Boolean((t=e.bootstrap)===null||t===void 0?void 0:t.url)},bM=qr.legacyKvEncodingNotice("bootstrapHeaders","no bootstrap request headers will be sent (the fetch may then fail to authenticate)");wM.BootstrapConfig=Ec.z.object({enabled:At.field(Ec.z.boolean().optional(),{flatKey:"bootstrapEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.10628.0"}},remotePolicy:{type:"remote-disabled"},title:kt.msg({defaultMessage:"Use bootstrap config",id:"Q6zr1vGzlF"}),default:!0,category:"source",group:vi.BOOTSTRAP_GROUP,description:{short:At.shortDescription(kt.msg({defaultMessage:"Fetch and apply the URL above at launch. Turn off to keep the URL saved but skip the fetch.",id:"0Nsvk4xG6E"}))},predicates:{show:dd}}),url:At.field(At.annotate(Pc.httpsUrl.optional(),{redact:"hostname"}),{flatKey:"bootstrapUrl",support:{enabled:{scopes:["3p"],availableInVersion:"1.10628.0"}},remotePolicy:{type:"remote-disabled"},activatesThirdPartyMode:(e,t)=>{var n,i;return(t||Boolean((n=e.bootstrap)===null||n===void 0?void 0:n.url))&&((i=e.bootstrap)===null||i===void 0?void 0:i.enabled)!==!1},title:kt.msg({defaultMessage:"Bootstrap config URL",id:"MPdK0gXvRA"}),egressRequirements:(e,t)=>{var n;return((n=t.bootstrap)===null||n===void 0?void 0:n.enabled)===!1?[]:qr.singleHostEgress(e)},egressRequirementsLabel:kt.msg({defaultMessage:"Bootstrap config server",id:"qjMZL1XFnR"}),category:"source",group:vi.BOOTSTRAP_GROUP,placeholder:kt.msg({defaultMessage:"https://config.example.com/claude-desktop",id:"IHENczwSR2"}),description:{short:At.shortDescription(kt.msg({defaultMessage:"HTTPS endpoint that returns a per-user JSON config overlay. Values from the response override local settings and become read-only.",id:"5SJ4ZG3Kp2"}))}}),oidc:At.field(Pc.BootstrapFetchOidc.optional(),{flatKey:"bootstrapOidc",support:{enabled:{scopes:["3p"],availableInVersion:"1.10628.0"}},remotePolicy:{type:"remote-disabled"},title:kt.msg({defaultMessage:"Bootstrap OIDC parameters",id:"zS5yI0rzXy"}),egressRequirements:(e,t)=>{var n;return((n=t.bootstrap)===null||n===void 0?void 0:n.enabled)===!1?[]:qr.oidcEgressHosts(e)},egressRequirementsLabel:kt.msg({defaultMessage:"Bootstrap sign-in (OIDC)",id:"q2PtfeOums"}),category:"source",group:vi.BOOTSTRAP_GROUP,description:{short:At.shortDescription(kt.msg({defaultMessage:"When set, the bootstrap request sends a Bearer token from a browser sign-in (authorization-code-with-PKCE).",id:"USlfHdFqDQ"})),long:At.longDescription("Set this to use a separate identity provider (Microsoft Entra ID, Okta, Ping, or any compliant OIDC provider) for the bootstrap sign-in. The app runs an authorization-code-with-PKCE flow in the system browser. Omit to use device-code mode against the bootstrap server's own origin.\n\nThis is an **object-typed key** \u2014 in an MDM profile it is a single JSON-string value, not separate keys with dotted names like `bootstrapOidc.clientId`. Writing the sub-fields as separate registry values causes the app to silently fall through to device-code mode.",{docsUrl:`${qr.COWORK_3P_DOCS_BASE}/bootstrap`})},predicates:{show:dd}}),headers:At.field(At.annotate(qr.kvRecord(bM).optional(),{redact:"presence"}),{flatKey:"bootstrapHeaders",support:{enabled:{scopes:["3p"],availableInVersion:"1.32885.1"}},deprecations:[bM],remotePolicy:{type:"remote-disabled"},title:kt.msg({defaultMessage:"Bootstrap request headers",id:"BootstrapHeadersTitle"}),category:"source",group:vi.BOOTSTRAP_GROUP,placeholder:{key:kt.msg({defaultMessage:"Authorization",id:"BootstrapHdrKeyPh"}),value:kt.msg({defaultMessage:"Basic \u2026",id:"BootstrapHdrValPh"})},addLabel:kt.msg({defaultMessage:"Add header",id:"IxbsWX4wj4"}),description:{short:At.shortDescription(kt.msg({defaultMessage:"HTTP headers sent on every bootstrap config fetch. Use this instead of embedding user:pass@ in the URL.",id:"BootstrapHeadersHint"})),long:At.longDescription('Static headers sent on every request to the bootstrap config URL \u2014 for a service-account credential (`Authorization: Basic \u2026`, an API key header) or a routing/tenant header. When either this or the headers helper script is set and no separate `bootstrapOidc` provider is configured, the app treats the headers as sufficient auth and does not require a per-user sign-in for the bootstrap fetch. These headers (and the helper script\'s below) also accompany requests to a plugin marketplace this server hosts on its own origin (`allowedPluginMarketplaces` with `credentialKind: "inferenceCredential"`). Header values are masked in diagnostics and telemetry. For a rotating token, use the headers helper script instead.',{docsUrl:`${qr.COWORK_3P_DOCS_BASE}/bootstrap`})},predicates:{show:dd}}),headersHelper:At.field(At.annotate(Pc.safeHelperPath.optional(),{pathKind:"file"}),{flatKey:"bootstrapHeadersHelper",support:{enabled:{scopes:["3p"],availableInVersion:"1.32885.1"}},remotePolicy:{type:"remote-disabled"},title:kt.msg({defaultMessage:"Bootstrap headers helper script",id:"BootstrapHeadersHelperTitle"}),category:"source",group:vi.BOOTSTRAP_GROUP,placeholder:kt.msg({defaultMessage:"/usr/local/bin/bootstrap-headers-helper",id:"BootstrapHeadersHelperPh"}),mono:!0,description:{short:At.shortDescription(kt.msg({defaultMessage:"Absolute path to an executable that prints a JSON object of bootstrap request headers. Merged over the static headers; the helper wins.",id:"BootstrapHeadersHelperHint"})),long:At.longDescription('Absolute path to an executable that prints a single JSON object of HTTP headers on stdout, e.g. `{"Authorization": "Bearer \u2026"}`. The app runs it (no arguments; output cached for a few minutes) before each bootstrap config fetch and merges the result over **Bootstrap request headers** (the helper wins on conflict). Use this instead of embedding `user:pass@` in the bootstrap URL, or when the bootstrap server needs a rotating token from a secrets manager. When either this or the static headers are set and no separate `bootstrapOidc` provider is configured, the app treats them as sufficient auth and does not require a per-user sign-in for the bootstrap fetch. If a per-user sign-in also runs (`bootstrapOidc` or the server\u2019s own device-code flow), that Bearer token wins on `Authorization`.',{docsUrl:`${qr.COWORK_3P_DOCS_BASE}/bootstrap`})},predicates:{show:dd}}),trustBootstrapDelivery:At.field(Ec.z.boolean().optional(),{flatKey:"trustBootstrapDelivery",legacyFlatKey:{name:"trustBootstrapLocalExec",effect:"the key will read as false (its fail-closed value): each user will be asked to consent to bootstrap-delivered sign-in targets, endpoints, helper scripts and connectors, even when the bootstrap URL came from a device-managed profile",...vM.BATCH_2026_09},support:{enabled:{scopes:["3p"],availableInVersion:"1.26832.0"}},failClosedValue:!1,title:kt.msg({defaultMessage:"Trust bootstrap-delivered settings",id:"vRHCNG9xkY"}),default:!1,category:"source",group:vi.BOOTSTRAP_GROUP,remotePolicy:{type:"remote-disabled"},description:{short:At.shortDescription(kt.msg({defaultMessage:"Skip the per-user consent prompt for sign-in targets, inference endpoints, helper scripts, and connectors the bootstrap server delivers.",id:"f6Kz1NkBdU"}))},predicates:{show:dd}})})});var Cv=R(function(PM){Object.defineProperty(PM,"__esModule",{value:!0});PM.LifecycleConfig=PM.RELAUNCH_ENFORCEMENT_DEFAULT_HOURS=PM.CONFIG_RELAUNCH_IDLE_MINUTES=void 0;var ss=fn(),Qn=mt(),Pr=pn(),Ac=Li();PM.CONFIG_RELAUNCH_IDLE_MINUTES=2;PM.RELAUNCH_ENFORCEMENT_DEFAULT_HOURS=24;var SM=10,kM=2,EM=30;PM.LifecycleConfig=ss.z.object({relaunchEnforcementHours:Qn.field(ss.z.preprocess((e)=>typeof e==="string"&&e.trim()!==""?Number(e):e,ss.z.number().int().min(0).lte(336).optional()),{flatKey:"relaunchEnforcementHours",support:{enabled:{scopes:["3p"],availableInVersion:"1.40609.0"}},appBehaviorOnly:!0,remotePolicy:{hotApplied:!0},title:Pr.msg({defaultMessage:"Configuration relaunch window",id:"RelaunchEnforcementHoursTitle"}),default:PM.RELAUNCH_ENFORCEMENT_DEFAULT_HOURS,category:"telemetry",group:Ac.UPDATES_GROUP,order:23,suffix:Pr.msg({defaultMessage:"hours",id:"4MengK4xQ/"}),description:{short:Qn.shortDescription(Pr.msg({defaultMessage:"Hours a user may keep working on the old configuration after a managed-configuration change is detected. 0 = restart required at once. Blank = 24 hours.",id:"RelaunchEnforcementHoursShort"})),long:Qn.longDescription("Set it via MDM (plist, registry, or file) or serve it from your configuration endpoint (remote bootstrap configuration). When the running app observes a managed-configuration change it cannot apply without restarting, it shows the sidebar relaunch card and starts this window. The window starts at the running app\u2019s next configuration re-check (the re-check interval beside it), so allow up to one re-check interval on top of this value between saving a change and the restart dialog. When the window ends the app blocks with a restart dialog and restarts on its own after "+`${PM.CONFIG_RELAUNCH_IDLE_MINUTES} minutes with no activity (no running Claude task and no keyboard or pointer input); the user can also restart right away. Defaults to ${PM.RELAUNCH_ENFORCEMENT_DEFAULT_HOURS} hours. Set a larger value (up to 336 = 14 days) to give users longer; \`0\` shows the dialog at the first observation.

A served value is read from the newest served configuration, so tightening or loosening the window takes effect without a restart once two re-checks in a row have served it, and a change to this key alone never asks for one. Like the update keys beside it, a value from a device-management profile that sets only app-behavior keys applies without making the rest of the configuration device-managed, and takes precedence over a served one. Because the key is grouped with the other app-behavior keys, a profile that sets any of them claims the whole group: set this key in the same profile as the update keys you deploy, or a served value is ignored on those devices and the ${PM.RELAUNCH_ENFORCEMENT_DEFAULT_HOURS}-hour default applies.`)}}),configRecheckIntervalMinutes:Qn.field(ss.z.coerce.number().int().gte(kM).lte(EM).optional(),{flatKey:"configRecheckIntervalMinutes",support:{enabled:{scopes:["3p"],availableInVersion:"1.46388.1"}},appBehaviorOnly:!0,remotePolicy:{hotApplied:!0},title:Pr.msg({defaultMessage:"Configuration re-check interval",id:"ConfigRecheckIntervalMinutesTitle"}),default:SM,category:"telemetry",group:Ac.UPDATES_GROUP,order:24,suffix:Pr.msg({defaultMessage:"minutes",id:"ConfigRecheckIntervalMinutesSuffix"}),description:{short:Qn.shortDescription(Pr.msg({defaultMessage:"Minutes between the running app\u2019s checks for a changed managed configuration. Blank = 10 minutes.",id:"ConfigRecheckIntervalMinutesShort"})),long:Qn.longDescription(`How often the running app re-checks its managed configuration for changes: it re-polls your configuration endpoint with a conditional request, so an unchanged configuration costs one \`304\` round-trip. A detected change shows the sidebar relaunch card and starts the \`relaunchEnforcementHours\` window, so a saved change reaches a running app within roughly one interval. Defaults to ${SM} minutes; each wait is jittered by \xB110% so a fleet does not poll in lockstep. Values outside ${kM}\u2013${EM} are rejected with a parse error and the default applies.

`+"Applied without a restart: a new served value re-arms the timer once two checks in a row have served it, and a change to this key alone never asks for a relaunch. Set it via MDM or serve it from your configuration endpoint; like the update keys beside it, a value from a device-management profile that sets only app-behavior keys applies without making the rest of the configuration device-managed, and takes precedence over a served one. Because the key is grouped with the other app-behavior keys, a profile that sets any of them claims the whole group, and every key in it is then read from that profile alone: deploy this key in the same profile as the update keys (`disableAutoUpdates`, `autoUpdaterEnforcementHours`, \u2026). A profile that sets the update keys without it ignores a served interval and the default applies; a profile that sets only this key ignores served update settings, so a served `disableAutoUpdates` no longer holds on those devices. A profile that also manages the connection itself (sets `bootstrapUrl` or the provider keys) follows the normal tier order instead: once a served configuration is in hand it, not the profile, supplies this key.")}}),disableLocalConfigCache:Qn.field(ss.z.boolean().optional(),{flatKey:"disableLocalConfigCache",support:{enabled:{scopes:["3p"],availableInVersion:"2.7032.0"}},failClosedValue:!0,remotePolicy:{applyUnverified:!1,hotApplied:!0,hybrid:{scope:"only"}},title:Pr.msg({defaultMessage:"Keep only your organization ID and restrictions on disk",id:"DisableLocalConfigCacheTitle"}),default:!1,category:"telemetry",group:Ac.UPDATES_GROUP,order:25,description:{short:Qn.shortDescription(Pr.msg({defaultMessage:"Don\u2019t keep your organization\u2019s name or any permissive setting on disk between launches; only your organization ID and the restrictions you turn on are kept.",id:"DisableLocalConfigCacheShort"})),long:Qn.longDescription(`By default the app keeps on disk, from the last configuration the admin console served, your organization\u2019s ID and name and the few settings a launch applies before the console answers (the telemetry switches, the Microsoft 365 sign-in broker setting, and any restriction you have turned on). When this is on, it keeps only your organization ID and those restrictions (for example telemetry blocked, or local MCP servers off), never the name or anything you have allowed, and cuts an earlier copy down at the next launch that reaches the console, or at once when a running app confirms the change; signing out deletes the kept copy too. While on: crash and performance reports to Anthropic do not start on these devices, and the sign-in screen and account switcher cannot show your organization\u2019s name before the console answers.

`+"A running app picks up a change to this setting once two configuration checks in a row have served it; changing it alone never asks for a relaunch. It applies only to organizations managed from the Claude admin console; the setting is ignored when a customer configuration server or a device profile sends it.")}})})});var Mv=R(function(TM){Object.defineProperty(TM,"__esModule",{value:!0});TM.ModelsConfig=TM.MODEL_CATALOG_LOCATION_UNREADABLE_STAND_IN=TM.InferenceModel=void 0;TM.isBelowMinDesktopVersion=$ce;TM.modelDiscoveryUrlHint=$v;TM.usageCostEstimateEnabled=am;TM.effectiveModelPricing=Mce;TM.dropNonAnthropicModels=jce;TM.droppedModelMessage=xce;TM.nonAnthropicModelText=CM;var lt=fn(),lm=Yy(),Ic=pr(),Q=mt(),Xe=Cn(),oe=pn(),la=Sr(),om=Or(),as=Lu();function im(e){let t=e.match(/^(.+?)\[1m\]$/i);return t?t[1].trim():e}function Tv(e){return lt.z.preprocess((t)=>typeof t==="string"?t.trim().toLowerCase():t,lt.z.enum(e))}function $ce(e,t){return t!==void 0&&Xe.DESKTOP_VERSION_RE.test(t)&&Xe.DESKTOP_VERSION_RE.test(e)&&Q.compareDesktopVersions(e,t)<0}TM.InferenceModel=lt.z.object({name:Q.subfield(lt.z.string().trim().min(1),{label:oe.msg({defaultMessage:"Model ID",id:"/m0q/Dre6A"}),isPrimaryKey:!0,mono:!0,placeholder:oe.msg({defaultMessage:"claude-opus-4",id:"s+j6yEtVLW"}),description:{short:Q.shortDescription(oe.msg({defaultMessage:"Model ID exactly as the provider expects it. The first entry is the default model.",id:"1tZVf88rjp"}))}}),labelOverride:Q.subfield(lt.z.string().trim().transform((e)=>e||void 0).optional(),{label:oe.msg({defaultMessage:"Display name",id:"dOQCL8n7dZ"}),placeholder:oe.msg({defaultMessage:"Claude Opus 4",id:"c1LGvG2F3D"}),description:{short:Q.shortDescription(oe.msg({defaultMessage:"Shown in the model picker. Leave blank to auto-format from the ID.",id:"y8c8KzJEws"}),{docsOnly:!1})}}),supports1m:Q.subfield(lt.z.boolean().optional().catch(void 0),{label:oe.msg({defaultMessage:"Offer 1M-context variant",id:"a87VTwtQw3"}),description:{short:Q.shortDescription(oe.msg({defaultMessage:"Adds a 1M-context variant of this model to the picker. Set only if the deployment accepts 1M-token context for it.",id:"Dr5ZeQOODs"}),{docsOnly:!1})}}),prefer1m:Q.subfield(lt.z.boolean().optional().catch(void 0),{label:oe.msg({defaultMessage:"Only show the 1M option",id:"MiULGAn5+H"}),support:{availableInVersion:"1.21459.0"},description:{short:Q.shortDescription(oe.msg({defaultMessage:"Shows one option for this model and requests 1M from your provider. Does nothing unless the entry offers 1M.",id:"Sv+taooA73"}),{docsOnly:!1})},predicates:{show:(e)=>Boolean(e.supports1m)}}),anthropicFamilyTier:Q.subfield(Tv(as.ANTHROPIC_TIER_NAMES).optional().catch(void 0),{label:oe.msg({defaultMessage:"Tier alias",id:"y8qYHNqpeo"}),support:{availableInVersion:"1.13576.0"},description:{short:Q.shortDescription(oe.msg({defaultMessage:"Which Claude tier this model stands in for. Pins the bare alias (e.g. \u2018opus\u2019) and, for opus/fable, the refusal fallback.",id:"AJudB3RUvn"}),{docsOnly:!1})}}),isFamilyDefault:Q.subfield(lt.z.boolean().optional().catch(void 0),{label:oe.msg({defaultMessage:"Default for tier",id:"0yJnYjaXIK"}),support:{availableInVersion:"1.13576.0"},description:{short:Q.shortDescription(oe.msg({defaultMessage:"When several models share a tier alias, marks this one as the model the alias resolves to. Otherwise the first listed wins.",id:"trBeCWLw48"}))},predicates:{show:(e)=>Boolean(e.anthropicFamilyTier)}}),maxEffort:Q.subfield(Tv(as.EFFORT_LEVELS).optional().catch("low"),{label:oe.msg({defaultMessage:"Max effort",id:"6cacFh6uvE"}),support:{availableInVersion:"2.110.0"},description:{short:Q.shortDescription(oe.msg({defaultMessage:"Highest effort level offered for this model; higher levels are hidden and never requested by Claude Desktop. An unrecognized value caps the model at low.",id:"NsfxwZEink"}),{docsOnly:!1})}}),minDesktopVersion:Q.subfield(Xe.desktopVersionString().optional().catch(void 0),{label:oe.msg({defaultMessage:"Minimum app version",id:"UGoWM49v6Y"}),support:{availableInVersion:"2.19675.0",visibility:"public-undocumented"},predicates:{show:(e)=>e.minDesktopVersion!==void 0},description:{short:Q.shortDescription(oe.msg({defaultMessage:"Oldest Claude Desktop version that can use this model, as three numbers like 2.2553.0. Older apps that read this setting grey the model out and ask to update.",id:"xkocyM6Lej"}),{docsOnly:!1})}})});function Rce(e){var t;let n=e.map((l)=>typeof l==="string"?{name:l}:l),i=new Map;for(let l of n)if(im(l.name)===l.name&&!i.has(l.name))i.set(l.name,l);let r=(l)=>l.anthropicFamilyTier!==void 0||l.isFamilyDefault===!0,o=new Map;for(let l of n){let c=im(l.name),u=c===l.name?void 0:i.get(c);if(u&&!r(u)&&!r(l)){let p=(t=o.get(u))!==null&&t!==void 0?t:{plain:u,spellings:[]};p.spellings.push(l),o.set(u,p).set(l,p)}}let s=new Set;return n.flatMap((l)=>{let c=o.get(l);if(!c){let m=im(l.name);return[m===l.name?l:{...l,name:m,supports1m:!0}]}if(s.has(c))return[];s.add(c);let u=c.plain.prefer1m===void 0&&c.spellings.some((m)=>m.prefer1m===!0),p=[c.plain,...c.spellings].map((m)=>m.maxEffort).filter((m)=>m!==void 0).sort((m,y)=>as.EFFORT_LEVELS.indexOf(m)-as.EFFORT_LEVELS.indexOf(y))[0],h=[c.plain,...c.spellings].map((m)=>m.minDesktopVersion).filter((m)=>m!==void 0).sort(Q.compareDesktopVersions).at(-1);return[{...c.plain,supports1m:!0,...u&&{prefer1m:u},...p&&{maxEffort:p},...h&&{minDesktopVersion:h}}]})}var Dce=(e)=>{var t;return((t=e.inference)===null||t===void 0?void 0:t.provider)!==void 0&&!la.PROVIDER_CLI_FLAG[e.inference.provider]};function $v(e,t){let n=t.inference;switch(n===null||n===void 0?void 0:n.provider){case"anthropic":return`https://${Ic.ANTHROPIC_API_HOST}/v1/models`;case"gateway":return n.baseUrl?`${n.baseUrl.replace(/\/+$/,"")}/v1/models`:"/v1/models";case"bedrock":return n.region?Ic.bedrockControlPlaneHost(n.region):e.formatMessage({defaultMessage:"the Bedrock control-plane",id:"+aUKGm2IHp"});default:return e.formatMessage({defaultMessage:"the provider",id:"QL5gWJ5JBl"})}}var rm=()=>lt.z.number().min(0).max(1e4);TM.MODEL_CATALOG_LOCATION_UNREADABLE_STAND_IN="https://model-catalog.invalid/unreadable";TM.ModelsConfig=lt.z.object({discoveryEnabled:Q.field(lt.z.boolean().optional(),{flatKey:"modelDiscoveryEnabled",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.8089.0"},executionTarget:"desktop"},default:{displayOnly:!0},title:oe.msg({defaultMessage:"Model discovery",id:"jU4z+3Uk7+"}),category:"connection",group:Xe.MODELS_GROUP,order:-1,predicates:{show:(e)=>la.providerHasDiscovery(e)},description:{short:Q.shortDescription((e,t)=>Dce(t)?e.formatMessage({defaultMessage:"Auto-populate the model picker from {url} at launch; when this key isn\u2019t set in the config, discovery is skipped if the model list below makes it unnecessary.",id:"b/YbjgdGIX"},{url:$v(e,t)}):e.formatMessage({defaultMessage:"Auto-populate the model picker from {url} at launch.",id:"xWiIy0pAlB"},{url:$v(e,t)})),long:Q.longDescription("Auto-populate the model picker from the provider's model-list endpoint at launch. For gateway and Anthropic providers, a config that doesn't set this key skips discovery automatically when the model list below already makes it unnecessary; the toggle here only sets it explicitly on or off. Turn off if the endpoint isn't reachable from your network, or to use a fixed list. When off, the model list below is required and must use full model IDs (aliases like sonnet/opus are resolved via discovery).",{docsUrl:`${Xe.COWORK_3P_DOCS_BASE}/configuration#models`})}}),prefer1mContext:Q.field(lt.z.boolean().optional(),{flatKey:"modelPrefer1mContext",readers:["desktop","code"],remotePolicy:{hotApplied:!0},support:{enabled:{scopes:["3p"],availableInVersion:"1.28929.0"}},default:{displayOnly:!1},title:oe.msg({defaultMessage:"Use 1M wherever it\u2019s available",id:"FhHsMUG/nO"}),category:"connection",group:Xe.MODELS_GROUP,order:-0.5,description:{short:Q.shortDescription(oe.msg({defaultMessage:"Every model that offers 1M, in your list or from your gateway, shows one option and requests 1M.",id:"XbCo6omBCD"})),long:Q.longDescription("Every model that offers a 1M-token context window shows one option in the model picker, and sessions on it request 1M from your provider. A model offers 1M when its `inferenceModels` entry sets `supports1m` or, under discovery, when your gateway's model list marks it. Equivalent to setting `prefer1m` on each of those entries, but also applies under dynamic discovery. To leave one listed model out, remove its `supports1m`. Beside a model list in which no entry sets `supports1m`, this setting does nothing. Older Claude Desktop versions show both options and only start the default model on its 1M option.",{docsUrl:`${Xe.COWORK_3P_DOCS_BASE}/configuration#models`})}}),list:Q.field(Q.annotate(Q.annotate(lt.z.array(lt.z.union([lt.z.string().trim().min(1),TM.InferenceModel])).min(1),{maxItems:200}).transform(Rce).optional(),{redact:"hash",gatewayServable:!1}),{flatKey:"inferenceModels",readers:["desktop","m365","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},title:oe.msg({defaultMessage:"Model list",id:"hv0F38ESRM"}),groupOverride:"nameSubset",category:"connection",group:Xe.MODELS_GROUP,order:0,addLabel:oe.msg({defaultMessage:"Add model",id:"zUO6Ii5EAT"}),description:{short:Q.shortDescription((e,t)=>{var n;return((n=t.models)===null||n===void 0?void 0:n.discoveryEnabled)===!1||!la.providerHasDiscovery(t)?e.formatMessage({defaultMessage:"Models to show in the picker. First entry is the default.",id:"i8fSuvZDK/"}):e.formatMessage({defaultMessage:"Override the auto-discovered model list. First entry is the default.",id:"G/QQvx0Tsd"})}),long:Q.longDescription('Use the **provider\'s exact model ID**: Vertex publisher IDs (`claude-sonnet-5`), Bedrock inference-profile IDs (`us.anthropic.claude-sonnet-5`), or Foundry deployment names. Entries may be plain ID strings or objects.\n\n**Gateway:** the `name` must be the exact ID your gateway\'s `/v1/models` endpoint returns. If you set `supports1m` on an alias (`sonnet`) but discovery returns the full ID, the variant won\'t appear.\n\n**Extended context** (`supports1m`) is a capability assertion you make about your deployment; only set it for models you\'ve confirmed support the 1M-token window:\n```json\n[{"name": "claude-sonnet-5", "supports1m": true}, "claude-opus-4-8"]\n```\n`"claude-sonnet-5[1m]"` is shorthand for the same entry. When an ID is listed both bare and with `[1m]` (as a gateway lists it), the picker shows one model with a 1M variant; put `labelOverride` on the bare entry (a label on the `[1m]` spelling is ignored there); tier-tagged entries are not folded. `prefer1m: true` (no effect without `supports1m`) shows only the 1M variant of the model. Under dynamic discovery (no explicit list), set `modelPrefer1mContext` instead.\n\n**Display label** (`labelOverride`) is for IDs the picker can\'t derive a friendly name from (Bedrock ARNs, gateway routing aliases). Display-only; `name` is still what the app sends:\n```json\n[{"name": "arn:aws:bedrock:us-east-1:123:application-inference-profile/abc", "labelOverride": "Claude Opus (Prod)"}]\n```\n\n**Tier mapping** (`anthropicFamilyTier`) tells the app which Claude tier (`haiku`/`sonnet`/`opus`/`fable`/`mythos`) an entry stands in for, so bare tier aliases (e.g. in Code sessions) resolve to your model. `isFamilyDefault: true` picks the winner when several entries share a tier:\n```json\n[{"name": "us.anthropic.claude-opus-4-8", "anthropicFamilyTier": "opus"}]\n```',{docsUrl:`${Xe.COWORK_3P_DOCS_BASE}/configuration#models`})},predicates:{required:(e)=>{var t;return!Xe.hasActiveBootstrap(e)&&(((t=e.models)===null||t===void 0?void 0:t.discoveryEnabled)===!1||!la.providerHasDiscovery(e))},warn:(e,t,n)=>Lce(e.name,t,n)}}),defaultEffort:Q.field(Tv(as.EFFORT_LEVELS).optional(),{flatKey:"defaultModelEffort",readers:["desktop","code"],remotePolicy:{hotApplied:!0},support:{enabled:{scopes:["3p"],availableInVersion:"2.110.0"}},title:oe.msg({defaultMessage:"Default model effort",id:"63NOuwomJM"}),category:"connection",group:Xe.MODELS_GROUP,order:0.2,description:{short:Q.shortDescription(oe.msg({defaultMessage:"Effort level the default model (the first listed model) starts at, instead of Anthropic\u2019s recommended level: low, medium, high, xhigh or max.",id:"SBjuzIVQAJ"})),long:Q.longDescription("The effort level the default model (the first `inferenceModels` entry, or the first model your endpoint returns under discovery) starts at in Chat, Cowork and Code, in place of Anthropic's recommended level for that model: one of `low`, `medium`, `high`, `xhigh`, `max`. It is a starting point, not a lock: a person's own effort choice for that model still applies unless `alwaysStartWithDefaultModel` is on, and other models keep their recommended level. A level the model doesn't offer falls to the nearest level it offers below it (its lowest level when none is lower), and it never exceeds that model's `maxEffort`. In Code sessions a `CLAUDE_CODE_EFFORT_LEVEL` environment variable or an `effortLevel` in Claude Code's own settings still takes precedence, as it does over any picker default.",{docsUrl:`${Xe.COWORK_3P_DOCS_BASE}/configuration#models`})}}),alwaysStartWithDefault:Q.field(lt.z.boolean().optional(),{flatKey:"alwaysStartWithDefaultModel",readers:["desktop","code"],remotePolicy:{hotApplied:!0},support:{enabled:{scopes:["3p"],availableInVersion:"2.110.0"}},default:{displayOnly:!1},failClosedValue:!0,title:oe.msg({defaultMessage:"Always start with the default model",id:"IJXGYyxFSQ"}),category:"connection",group:Xe.MODELS_GROUP,order:0.3,description:{short:Q.shortDescription(oe.msg({defaultMessage:"When true, each new conversation or task starts on the default model, and a person\u2019s model and effort changes are no longer saved as their default.",id:"dayANLBel0"})),long:Q.longDescription("When `true`, each new conversation or task in Chat, Cowork and Code starts on the default model (the first `inferenceModels` entry), and the model and effort choices a person makes are no longer saved as their defaults. When unset or `false`, a person's last model and effort choice is remembered per tab, as before. Choices saved before the setting was turned on are kept and apply again if it is turned off.",{docsUrl:`${Xe.COWORK_3P_DOCS_BASE}/configuration#models`})}}),pricing:lt.z.object({enabled:Q.field(lt.z.boolean().optional(),{flatKey:"inferenceModelPricingEnabled",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.37937.0"},executionTarget:"desktop"},default:{displayOnly:!1},title:oe.msg({defaultMessage:"Show estimated cost",id:"dqCubkxbYK"}),category:"connection",group:Xe.MODELS_GROUP,order:1,description:{short:Q.shortDescription(oe.msg({defaultMessage:"Show an estimated cost on the Usage page at Anthropic list price; turn on to set a multiplier or per-model rates.",id:"O20EMso86S"})),long:Q.longDescription("Off unless set: the Usage page shows token counts only, since the app cannot know your negotiated provider rates. `true` turns on a USD estimate priced at Anthropic's published list price and is the only switch that does: `inferenceModelPricingMultiplier` and `inferenceModelPricing` refine the estimate while this is on and are ignored otherwise; turning this off hides them in the config editors without clearing them. Claude Code performs the calculation, so the same figures appear in its own cost reporting for Code sessions. Model IDs Claude Code cannot map to a Claude model (an opaque gateway alias, an inference-profile ARN it cannot resolve) are left out of the estimate until `inferenceModelPricing` gives them a rate. A machine-level Claude Code managed `modelPricing` (MDM / managed-settings.json / server-managed) takes precedence over all three keys.",{docsUrl:`${Xe.COWORK_3P_DOCS_BASE}/configuration#models`})}}),multiplier:Q.field(Q.annotate(lt.z.coerce.number().gt(0).lte(1).optional(),{redact:"presence"}),{flatKey:"inferenceModelPricingMultiplier",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.37937.0"},executionTarget:"desktop"},title:oe.msg({defaultMessage:"Price multiplier",id:"BvuzkKM8Bk"}),category:"connection",group:Xe.MODELS_GROUP,order:1.1,predicates:{show:am},placeholder:oe.msg({defaultMessage:"0.85",id:"SyOzaH65Yu"}),description:{short:Q.shortDescription(oe.msg({defaultMessage:"Scales every estimated cost (0.85 = 85% of the price); between 0 and 1.",id:"g06VJdp+L7"})),long:Q.longDescription("Mirrors Claude Code's managed `modelPricing.multiplier`: a number in (0, 1] applied to every computed cost, whether the model was priced at Anthropic list price or by an `inferenceModelPricing` row; use it for a flat contracted discount. Applies only while `inferenceModelPricingEnabled` is `true`; on its own it does not turn the estimate on. Ignored when a machine-level Claude Code managed `modelPricing` is present.",{docsUrl:`${Xe.COWORK_3P_DOCS_BASE}/configuration#models`})}}),models:Q.field(Q.annotate(lt.z.array(lt.z.object({name:Q.subfield(lt.z.string().trim().min(1),{label:oe.msg({defaultMessage:"Model ID",id:"/m0q/Dre6A"}),isPrimaryKey:!0,mono:!0,placeholder:oe.msg({defaultMessage:"claude-opus-4",id:"s+j6yEtVLW"}),description:{short:Q.shortDescription(oe.msg({defaultMessage:"A model ID from the list above, or any other ID or alias your provider serves. A built-in Claude ID also covers its dated and provider forms.",id:"usJ91EFnHr"}),{docsOnly:!1})}}),inputPerMtok:Q.subfield(rm(),{label:oe.msg({defaultMessage:"Input",id:"it6Ligcq3B"}),description:{short:Q.shortDescription(oe.msg({defaultMessage:"USD per million input tokens.",id:"nQMe9gkLHr"}))}}),outputPerMtok:Q.subfield(rm(),{label:oe.msg({defaultMessage:"Output",id:"fio5opLcOZ"}),description:{short:Q.shortDescription(oe.msg({defaultMessage:"USD per million output tokens.",id:"NPC4I65XQU"}))}}),cacheReadPerMtok:Q.subfield(rm(),{label:oe.msg({defaultMessage:"Cache read",id:"M4uIq3kw9y"}),description:{short:Q.shortDescription(oe.msg({defaultMessage:"USD per million prompt-cache read tokens.",id:"T5SCPPfeMB"}))}}),cacheWritePerMtok:Q.subfield(rm(),{label:oe.msg({defaultMessage:"Cache write",id:"tV/UHxu+ec"}),description:{short:Q.shortDescription(oe.msg({defaultMessage:"USD per million prompt-cache write tokens (5-minute and 1-hour writes alike).",id:"295mSyLyL7"}))}})})).optional(),{redact:"presence"}),{flatKey:"inferenceModelPricing",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.37937.0"},executionTarget:"desktop"},title:oe.msg({defaultMessage:"Model pricing",id:"Em5X7PlTGI"}),category:"connection",group:Xe.MODELS_GROUP,order:1.2,predicates:{show:am},addLabel:oe.msg({defaultMessage:"Add price",id:"Gk+NyPXeVe"}),description:{short:Q.shortDescription(oe.msg({defaultMessage:"Per-model rates replacing Anthropic list price in the Usage page\u2019s estimate.",id:"5Ho1RhYUiz"})),long:Q.longDescription('Each row replaces Anthropic list price for one model in the Usage page\'s estimate, in USD per million tokens (`inputPerMtok`, `outputPerMtok`, `cacheReadPerMtok`, `cacheWritePerMtok`, all four required; `cacheWritePerMtok` prices both 5-minute and 1-hour cache writes); rows apply only while `inferenceModelPricingEnabled` is `true` and do not turn the estimate on by themselves. Mirrors Claude Code\'s managed `modelPricing.overrides`, and `name` is matched the same way: a built-in Claude model ID (e.g. `claude-sonnet-4-6`, or its Bedrock, Vertex, or Foundry ID) covers every dated and provider spelling of that model; any other value (a gateway alias, an inference-profile ARN) matches that exact ID only (case-insensitive) and wins over a built-in row. An ID Claude Code cannot map to a Claude model at all gets no estimate until a row here prices it. `inferenceModelPricingMultiplier` still applies on top of a row.\n```json\n{"inferenceModelPricingEnabled": true, "inferenceModelPricingMultiplier": 0.9, "inferenceModelPricing": [{"name": "claude-sonnet-4-6", "inputPerMtok": 2.4, "outputPerMtok": 12, "cacheReadPerMtok": 0.24, "cacheWritePerMtok": 3}]}\n```\nThese are estimates for visibility, not an invoice; your provider bills at its own rates. A machine-level Claude Code managed `modelPricing` (MDM / managed-settings.json / server-managed) takes precedence over this table.',{docsUrl:`${Xe.COWORK_3P_DOCS_BASE}/configuration#models`})}})}).optional(),catalogEnabled:Q.field(lt.z.boolean().optional(),{flatKey:"modelCatalogEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"2.110.0"}},remotePolicy:{hybrid:{scope:"excluded"}},default:{displayOnly:!0},failClosedValue:!1,title:oe.msg({defaultMessage:"Model catalog metadata",id:"go+bdjd1f9"}),category:"connection",group:Xe.MODELS_GROUP,order:2,description:{short:Q.shortDescription(oe.msg({defaultMessage:"Label and describe the model picker\u2019s entries from the published Claude Code model catalog, instead of the app\u2019s built-in table.",id:"sikjjWW3Tp"})),long:Q.longDescription("When on (the default), the app reads the model catalog Anthropic publishes for Claude Code (a signed document fetched from `downloads.claude.ai`, or from `modelCatalogUrl` when that is set, and verified against a key built into the app; a copy bundled with the app is used until one has been fetched, or when the host is unreachable) and uses it to fill in each picker entry's display name, description, and thinking/effort options in the Chat, Cowork, and Code tabs. It never changes which models are offered, their order, or the default model (the first `inferenceModels` entry): those, 1M-context variants, and `labelOverride` still come from `inferenceModels` / discovery, and a model the catalog does not list keeps the built-in label. Set `modelCatalogEnabled: false` to keep the built-in labels and make no catalog fetch. Applies to deployments configured on the device or by a bootstrap server; an install managed from the Claude admin console takes its model names and options from the console's settings and never fetches the catalog.",{docsUrl:`${Xe.COWORK_3P_DOCS_BASE}/configuration#models`})}}),catalogUrl:Q.field(Q.annotate(om.httpsUrl.optional(),{redact:"hostname"}),{flatKey:"modelCatalogUrl",support:{enabled:{scopes:["3p"],availableInVersion:"2.110.0"}},remotePolicy:{hybrid:{scope:"excluded"},rejectLoopback:!0,applyUnverified:!0,hotApplied:!0},failClosedValue:TM.MODEL_CATALOG_LOCATION_UNREADABLE_STAND_IN,unreadableStandIn:!0,title:oe.msg({defaultMessage:"Model catalog URL",id:"7QWnJvdV6y"}),egressRequirements:(e,t)=>{var n;if(((n=t.models)===null||n===void 0?void 0:n.catalogEnabled)===!1||e===TM.MODEL_CATALOG_LOCATION_UNREADABLE_STAND_IN)return[];let i=Ic.safeHostname(e);return i&&!om.isLinkLocalOrMetadataHost(i)?Xe.singleHostEgress(e):[]},egressRequirementsLabel:oe.msg({defaultMessage:"Model catalog mirror",id:"a9epb+yGXN"}),category:"connection",group:Xe.MODELS_GROUP,order:2.1,placeholder:oe.msg({defaultMessage:"https://mirror.example.com/model-catalog/v1/catalog.json",id:"o9MdHULcKp"}),predicates:{show:(e)=>{var t;return((t=e.models)===null||t===void 0?void 0:t.catalogEnabled)!==!1}},description:{short:Q.shortDescription(oe.msg({defaultMessage:"Fetch the model catalog and its signature file from this URL (a mirror inside your network serving Anthropic\u2019s published files) instead of downloads.claude.ai.",id:"sFZOQNiiWa"})),long:Q.longDescription("When set, the app fetches the catalog document and its signature file (the same URL with `.raw-sig.json` appended to the path) from this URL instead of `https://downloads.claude.ai/model-catalog/v1/catalog.json`, for a gateway or mirror inside your network serving Anthropic's two published files byte-for-byte. The document is still verified against the key built into the app, so an edited or re-signed copy is refused and the app keeps its last verified copy (or the bundled one); there is no key to configure. `https://` is required (`http://` only to a loopback address, and only when set on the device itself; a bootstrap server may not deliver a loopback or non-`https://` value); the server must answer the GET directly (redirects are not followed) and may honor `If-None-Match` with `304`, and must serve a document at least as new as the one the install last accepted (or the bundled seed) \u2014 an older one is refused and re-fetched on the retry interval until the mirror catches up. Ignored when `modelCatalogEnabled` is `false`, and on an install managed from the Claude admin console (which never fetches the catalog). A value that is not a valid URL, names a link-local or cloud-metadata host (e.g. `169.254.169.254`, `metadata.google.internal`), or is a loopback / non-`https://` value a bootstrap server delivers, turns the catalog fetch off (no fallback to `downloads.claude.ai`); the last fetched or bundled copy keeps labelling the pickers. On an install configured for a bootstrap server, the default location is not fetched until the server's configuration applies after sign-in, so a device does not poll `downloads.claude.ai` while the server may yet name a mirror; a mirror URL set on the device, cached earlier, or served in a pre-sign-in subset still fetches. Diagnostics report the location only as `hosted`, `custom`, `invalid` or `pending`; the value itself is treated like `bootstrapUrl`: host name only in telemetry, printed in full in the diagnostics bundle.",{docsUrl:`${Xe.COWORK_3P_DOCS_BASE}/configuration#models`})}})});function am(e){var t,n;return((n=(t=e.models)===null||t===void 0?void 0:t.pricing)===null||n===void 0?void 0:n.enabled)===!0}function Mce(e){var t;let n=(t=e.models)===null||t===void 0?void 0:t.pricing;if(!n||!am(e))return;let{enabled:i,...r}=n;return r}function jce(e,t,n){let{inferenceProvider:i,inferenceModels:r}=e;if(!i||!Array.isArray(r))return e;let o=r.filter((s)=>{let l=lm.checkModel(i,s.name);if(!l.ok)t(s.name,l.reason);else if("warn"in l&&l.warn)n===null||n===void 0||n(l.warn);return l.ok});if(o.length!==r.length&&o.length>0)e.inferenceModels=o;return e}function xce(e,t){return`inferenceModels: "${e}" is not an Anthropic model and was removed from the list \u2014 ${t}`}function Lce(e,t,n){var i;let r=typeof e==="string"?im(e.trim()):"";if(!r||!((i=t.inference)===null||i===void 0?void 0:i.provider))return null;let o=lm.checkModel(t.inference.provider,r);return o.ok?null:CM(n,o.reason)}function CM(e,t){return e.formatMessage({defaultMessage:"Doesn\u2019t look like an Anthropic model: {reason}",id:"3RoY+bkhPc"},{reason:t})}});var jv=R(function(DM){Object.defineProperty(DM,"__esModule",{value:!0});DM.TelemetryConfig=void 0;var wi=fn(),zt=mt(),cm=Cn(),rn=pn(),ls=Li();DM.TelemetryConfig=wi.z.object({orgUuid:zt.field(zt.annotate(wi.z.string().optional(),{redact:"keep"}),{flatKey:"deploymentOrganizationUuid",support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},remotePolicy:{hybrid:{derived:!0},applyUnverified:!0},title:rn.msg({defaultMessage:"Organization UUID",id:"EATQrlttOw"}),category:"telemetry",group:ls.ANTHROPIC_TELEMETRY_GROUP,order:-1,placeholder:rn.msg({defaultMessage:"00000000-0000-0000-0000-000000000000",id:"oT3AdLMVZK"}),description:{short:zt.shortDescription(rn.msg({defaultMessage:"A UUID you generate. Tags telemetry so Anthropic support can locate your fleet\u2019s events, and namespaces each user\u2019s local data. Not used for auth.",id:"gvBRfDvKmN"})),long:zt.longDescription("If unset, the app uses the organization of your Anthropic sign-in, where the connection has one. Otherwise, telemetry is tagged with a value the app derives from your connection settings. Where it cannot derive one, telemetry is tagged with a placeholder UUID shared with other unconfigured deployments. In the last two cases, local data is stored under the placeholder. **Changing this value orphans data** stored under the previous value (sessions, skills, plugins).")}}),disableEssential:zt.field(wi.z.boolean().optional(),{flatKey:"disableEssentialTelemetry",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},remotePolicy:{default:!0,applyUnverified:!0},failClosedValue:!0,title:rn.msg({defaultMessage:"Block essential telemetry",id:"rdKIIOydC8"}),default:!1,category:"telemetry",group:ls.ANTHROPIC_TELEMETRY_GROUP,order:0,description:{short:zt.shortDescription(rn.msg({defaultMessage:"Crash and performance reports to Anthropic.",id:"EGOuVJosgc"})),long:zt.longDescription(`"Essential" means the signals Anthropic needs to keep your deployment working: **crash stacks**, **startup failure reasons**, **version/OS metadata**, and **crash dumps** (each an unfiltered copy of part of the app's memory). Reports carry a random install ID and an organization ID. The organization ID is the one you set, one the app takes from your Anthropic sign-in or derives from your connection settings, or a placeholder shared with other unconfigured deployments. Reports can also include a summary of your settings, the host names of addresses you configured, text you set for display (such as the display name, subtitle, and banner text and link), and a one-way digest of a session ID.

**What you lose when this is on:** when a Claude Desktop build hits a bug that only reproduces on your OS version or locale, Anthropic can't see it unless a user manually reports. Fixes ship slower.

**Why this is discouraged, not blocked:** some air-gapped environments require zero outbound telemetry as a matter of policy. The switch exists for them. If you don't have that constraint, leave it off.`,{docsUrl:`${cm.COWORK_3P_DOCS_BASE}/telemetry#essential-telemetry`})},predicates:{warn:(e)=>e===!0?rn.msg({defaultMessage:"Crash and error reports are how we diagnose failures specific to your inference setup. Support turnaround will be slower without them.",id:"ek/rdG0G9V"}):null}}),disableNonessential:zt.field(wi.z.boolean().optional(),{flatKey:"disableNonessentialTelemetry",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},remotePolicy:{default:!0,applyUnverified:!0},failClosedValue:!0,title:rn.msg({defaultMessage:"Block nonessential telemetry",id:"oo4Av05fBn"}),default:!1,category:"telemetry",group:ls.ANTHROPIC_TELEMETRY_GROUP,order:1,description:{short:zt.shortDescription(rn.msg({defaultMessage:"Product-usage analytics and diagnostic-report uploads. No message content.",id:"0X/lTj2Hvv"})),long:zt.longDescription(`"Nonessential" covers two things: **product-usage analytics** (which features get used, navigation patterns; no prompts or completions) and the **Send** action in Help \u2192 Generate Diagnostic Report. Turning this on stops both.

Destinations are listed under Egress Requirements \u2192 Nonessential telemetry.`,{docsUrl:`${cm.COWORK_3P_DOCS_BASE}/telemetry#non-essential-telemetry`})},predicates:{warn:(e)=>e===!0?rn.msg({defaultMessage:"Usage analytics help us prioritize improvements for third-party inference. Diagnostic-report uploads will also be blocked. No message content is included in either.",id:"XtXm3euW3d"}):null}}),disableNonessentialServices:zt.field(wi.z.boolean().optional(),{flatKey:"disableNonessentialServices",support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},failClosedValue:!0,title:rn.msg({defaultMessage:"Block nonessential services",id:"HA2UIzGsaT"}),default:!1,category:"telemetry",group:ls.ANTHROPIC_TELEMETRY_GROUP,order:2,description:{short:zt.shortDescription(rn.msg({defaultMessage:"Connector favicons, artifact-preview and MCP Apps iframes, and the Linux spellcheck dictionary. Connector widgets fall back to text; spellcheck is off on Linux.",id:"iwXupWG0F3"})),long:zt.longDescription(`"Nonessential services" covers these outbound fetches the app runs without: **connector favicons** (the icon proxy), the **artifact-preview** iframe origin, the **MCP Apps widget** iframe origin (\`*.claudemcpcontent.com\`), and the **spellcheck dictionary** the built-in spellchecker downloads on Linux. Turning this on blocks all of them. (macOS and Windows use the system spellchecker. Windows still downloads a dictionary for a language it cannot check natively; this key does not stop that download.)

**What you lose when this is on:** connectors show without icons, the hosted artifact preview frame does not load (artifacts still render locally, without the CDN chart libraries they can otherwise load), connectors that return MCP Apps show the text tool result instead of the widget, Excel files in the Code tab preview only through Claude\u2019s workspace (the local VM) instead of that frame, and spellcheck underlines are off on Linux.

Destinations are listed under Egress Requirements \u2192 Nonessential services.`)},predicates:{warn:(e)=>e===!0?rn.msg({defaultMessage:"This disables connector icons, hosted artifact previews and MCP Apps widgets, and also turns spellcheck off on Linux. Artifacts still render locally, without CDN libraries; connectors that return MCP Apps show the text tool result instead of the widget.",id:"VinFqhloIq"}):null}}),usageMetrics:zt.field(wi.z.boolean().optional(),{flatKey:"usageMetricsEnabled",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.46388.1"},visibility:"public-undocumented"},remotePolicy:{hybrid:{scope:"only",derived:!0},hotApplied:!0},predicates:{show:()=>!1},title:rn.msg({defaultMessage:"Report usage metrics to your Claude.ai organization",id:"hFaw5XYgDV"}),category:"telemetry",group:ls.ANTHROPIC_TELEMETRY_GROUP,order:3,description:{short:zt.shortDescription(rn.msg({defaultMessage:"Set by the control plane from the organization\u2019s Claude Code analytics setting; not editable here. Reports per-user token, cost and session counts (no content).",id:"6k4DCNJe7b"})),long:zt.longDescription(`Server-derived: the Claude.ai control plane sets this key, each time it serves the configuration, from the organization's Claude Code analytics setting in Admin settings; it is off until an admin turns that setting on, and off for organizations under HIPAA or customer-managed encryption keys. It is not authored in any form, MDM profile, or bootstrap server, and a value stored anywhere else is ignored.

When on, each signed-in desktop periodically reports usage counters to your Claude.ai organization: per-member **token counts** (input, output, cache read, cache write) by model, the desktop's **cost estimate** for those tokens, and **session counts**, tagged with the member's account, the model name, the app surface (Chat, Cowork or Code), an opaque per-session and per-install identifier, and the app version, operating system and architecture. No prompts, responses, file contents, tool inputs or outputs are included. Sessions and the cost estimate appear in your organization's Claude.ai analytics (Analytics \u2192 Claude Code); the Admin API Claude Code usage report carries those plus per-member, per-model token counts.

This is independent of **Block essential telemetry** and **Block nonessential telemetry**: those govern diagnostics sent to Anthropic, this one populates your own organization's dashboard, and either can be on without the other. Reports go to the same Claude.ai endpoint the desktop fetches its configuration from, so no additional firewall entry is needed. A change takes effect without a relaunch once two configuration syncs in a row have served it.`)}})})});var xv=R(function(xM){Object.defineProperty(xM,"__esModule",{value:!0});xM.MANAGED_MCP_PRESETS=void 0;xM.isAnthropicM365ConnectorUrl=jM;xM.isAnthropicM365Connector=qce;var Zce="07c030f6-5743-41b7-ba00-0a6e85f37c17",Vce=[".claude.com",".fedstart.com"];function jM(e){if(!e)return!1;if(!Vce.some((t)=>e.hostname.endsWith(t)))return!1;return e.hostname.startsWith("microsoft365.mcp.")||e.pathname.includes("/m365/")}function qce(e){if(!(e===null||e===void 0?void 0:e.url)||e.custom_oauth_client_id)return!1;try{return jM(new URL(e.url))}catch(t){return!1}}xM.MANAGED_MCP_PRESETS=[{label:"Microsoft 365",item:{name:"m365",url:"https://microsoft365.mcp.claude.com/mcp",transport:"http",oauth:{scope:`api://${Zce}/access_as_user offline_access`}}},{label:"Box",item:{name:"box",url:"https://mcp.box.com",transport:"http",oauth:{authorizationServer:["https://api.box.com"]}}},{label:"Microsoft 365",kind:"builtin",item:{name:"Microsoft 365",server:"microsoft365"}},{label:"Web search",kind:"builtin",item:{name:"Web search",server:"websearch",provider:"brave"}},{label:"GitHub",kind:"builtin",item:{name:"GitHub",server:"github"}}]});var Lv=R(function(BM){Object.defineProperty(BM,"__esModule",{value:!0});BM.McpConfig=void 0;BM.isMcpPersistentAlwaysAllowEnabled=Jce;var wn=fn(),zM=_c(),Cc=pr(),He=mt(),Ar=Cn(),Ze=pn(),FM=xv(),er=Or(),tr=Li();function Yce(e,t){var n;let i=typeof t.url==="string"?t.url.trim():"",r=t.headers&&typeof t.headers==="object"?t.headers:void 0,o=[],s;try{s=i?new URL(i):void 0}catch(u){}if((s===null||s===void 0?void 0:s.protocol)==="http:"){let u=s.hostname;if(u!=="localhost"&&u!=="127.0.0.1")o.push(e.formatMessage({defaultMessage:"Endpoint is plain HTTP; auth credentials travel in cleartext.",id:"sqfi+II5M9"}))}let l=zM.credentialHeadersWarn(r,e,"headersHelper");if(l!==null)o.push(l);let c=r?(n=Object.entries(r).find(([u])=>u.toLowerCase()==="authorization"))===null||n===void 0?void 0:n[1]:void 0;if(typeof c==="string"&&/^Bearer\s+\S{12,}$/i.test(c))o.push(e.formatMessage({defaultMessage:"Shared bearer token: every org member authenticates as the same identity.",id:"y4dl3eyfcO"}));return o.length>0?o.join(" "):null}function NM(e){let t=typeof e.serverUrl==="string"?e.serverUrl.trim():"";if(t===""||t==="*"||t.startsWith("*://")||/^(?:https?|wss?):/i.test(t))return null;return Ze.msg({defaultMessage:"Start the pattern with a scheme such as https://, or *:// for any scheme: Claude Code compares a pattern with the server\u2019s full address.",id:"itOI+H+YoF"})}function UM(e){return wn.z.strictObject({serverUrl:He.subfield(wn.z.string().trim().min(1),{label:Ze.msg({defaultMessage:"Server URL pattern",id:"ruFvKwQ1V2"}),description:{short:He.shortDescription(e)}})})}BM.McpConfig=wn.z.object({managedServers:He.field(He.annotate(er.ManagedMcpServers.optional(),{redact:"presence"}),{flatKey:"managedMcpServers",readers:["desktop","m365","code"],groupOverride:"nameSubset",groupItemOverride:["toolPolicy"],support:{enabled:[{scopes:["3p"],availableInVersion:"1.2581.0"},{scopes:["1p"],availableInVersion:"1.24012.11"}]},remotePolicy:{mcpUrlHygiene:!0},title:Ze.msg({defaultMessage:"Managed MCP servers",id:"DC+lIM7C8k"}),checkDropped:er.checkManagedMcpServersForDrops,deprecations:er.MANAGED_MCP_SERVERS_DEPRECATIONS,failClosedValue:er.MANAGED_MCP_SERVERS_PARSE_FAILED,unreadableStandIn:!0,egressRequirements:(e)=>Array.isArray(e)?e.flatMap((t)=>{if(er.isBuiltinMcpEntry(t))return[...er.hostsForBuiltinMcpEntry(t)];if(t.transport==="stdio"||t.transport===er.MCP_TRANSPORT_POLICY_ONLY)return[];let n=[Cc.egressAddress(t.url)];if(t.oauth&&t.oauth.mode!=="dcr"){let i=er.resolveByoAsSelection(t.oauth);if(i.via==="tenant")n.push("login.microsoftonline.com");n.push(...er.byoAsSelectionUrls(i).map(Cc.egressAddress))}return n}).filter((t)=>!!t):[],category:"connectors",group:tr.MCP_SERVERS_GROUP,order:0,addLabel:Ze.msg({defaultMessage:"Add server",id:"pOeEMxHCXp"}),customRenderer:"mcpProbe",description:{short:He.shortDescription(Ze.msg({defaultMessage:"Org-pushed MCP servers: remote (HTTP/SSE) or local (stdio command). May embed bearer tokens.",id:"wG2dpZSzTk"})),long:He.longDescription('For OAuth-authenticated entries, the app builds the redirect URI as `http://<callbackHost>:<callbackPort>/callback`; register that exact value with the OAuth provider. Tokens refresh automatically during a session.\n\n`toolPolicy` locks the per-tool approval state, keyed by tool name: `"blocked"` removes the tool from the session and labels it admin-blocked, `"ask"` requires approval on every call (Allow once / Deny only; no persistent always-allow; a scheduled Cowork task waits at that prompt), `"allow"` pre-approves. Tools **not listed** follow the user\'s choice: the prompt offers a persistent Always allow, except for tools that can modify data, which show a session-scoped **Allow for this task** alongside **Allow for all tasks** with a malicious-instruction warning. In Code sessions, `blocked` and `ask` are forwarded as Claude Code permission rules; `allow` is not.\n\nKeys may contain `*` wildcards (`"read_*"` matches every tool whose name starts with `read_`; anchored, and `*` is the only wildcard). When several wildcard keys match, the strictest applies (blocked > ask > allow). An exact-name key wins over matching wildcards, with two exceptions in the stricter direction: in Code sessions a wildcard `ask`, or a wildcard `blocked` other than the bare `"*"`, beats a less strict exact key (so `"*": "blocked"` plus exact `"allow"` entries still works as deny-by-default there); and in chat approval prompts and always-allow persistence a wildcard `ask` keeps every matching tool behind a per-call prompt even when a more permissive exact key matches, while direct tool invocations such as artifact or widget calls follow the exact key.\n\nFor the bundled Microsoft 365 connector, the send tools (`outlook_send_mail`, `outlook_send_draft`, `outlook_forward_mail`, `outlook_create_event`, `outlook_update_event`, `teams_send_chat_message`, `teams_send_channel_message`, `teams_reply_channel_message`) cannot be loosened below `ask`; an `allow` setting resolves to `ask`.',{docsUrl:`${Ar.COWORK_3P_DOCS_BASE}/configuration#managedmcpservers`})},presets:FM.MANAGED_MCP_PRESETS,blankItem:{transport:"http"},predicates:{warn:(e,t,n)=>Yce(n,e)}}),persistentAlwaysAllowEnabled:He.field(wn.z.boolean().optional(),{flatKey:"mcpPersistentAlwaysAllowEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.24012.9"}},title:Ze.msg({defaultMessage:"Allow persistent tool approvals",id:"OmQqCV/O12"}),default:!0,failClosedValue:!1,category:"connectors",group:tr.MCP_SERVERS_GROUP,order:1,description:{short:He.shortDescription(Ze.msg({defaultMessage:"Offer the persistent \u201CAlways allow\u201D approval options for MCP tools. Disable to keep tool approvals per-call or session-scoped only.",id:"GXMHY2UvCF"})),long:He.longDescription("When enabled (the default), approval prompts for tools without a `toolPolicy` entry offer a persistent grant \u2014 **Always allow**, or **Allow for all tasks** for tools that can modify data \u2014 the Tool permissions picker in Connector settings lets users pre-approve tools, and those grants persist across sessions with no expiry.\n\nWhen disabled, the persistent options are hidden from approval prompts and from the Connector settings picker, and previously stored persistent grants stop being honored. Scheduled-task runs also stop offering, recording and replaying the **Allow for all scheduled runs** approval, unless a scheduled-task approval lifetime of one day or more is set. Users can still approve each call. Outside scheduled-task runs they can also choose **Allow for this task**, except for read-only tools on servers they added themselves.\n\nA per-tool `toolPolicy` entry on `managedMcpServers` always takes precedence over this key: `blocked`, `ask`, and `allow` behave exactly as documented there whether this key is enabled or not.\n\nThis key governs the chat and Cowork surfaces. Code sessions use a separate permission path this key does not cover \u2014 govern Code tool approvals with per-tool `toolPolicy` entries, whose `blocked` and `ask` values are forwarded there.",{docsUrl:`${Ar.COWORK_3P_DOCS_BASE}/configuration#mcppersistentalwaysallowenabled`})}}),scheduledTaskApprovalLifetimeDays:He.field(wn.z.preprocess((e)=>typeof e==="string"&&e.trim()!==""?Number(e):e,wn.z.number().int().gte(0).lte(3650).optional()),{flatKey:"mcpScheduledTaskApprovalLifetimeDays",support:{enabled:{scopes:["3p"],availableInVersion:"2.7032.0"}},title:Ze.msg({defaultMessage:"Scheduled-task tool approval lifetime",id:"yqgGAUV4YP"}),failClosedValue:0,remotePolicy:{applyUnverified:"asFailClosed"},category:"connectors",group:tr.MCP_SERVERS_GROUP,order:1.5,suffix:Ze.msg({defaultMessage:"days",id:"Bc20laBenW"}),placeholder:Ze.msg({defaultMessage:"30",id:"HMv/M+VWJ6"}),description:{short:He.shortDescription(Ze.msg({defaultMessage:"How many days a scheduled task may reuse a lasting MCP-tool approval before it asks again. 0 removes the lasting option.",id:"au5x3V9PvH"})),long:He.longDescription("On a scheduled task, the approval prompt for an MCP tool can offer a lasting approval, so later runs use that tool without asking: **Allow for all scheduled runs** in Cowork, **Always allow** in the Code tab. This setting limits how long that approval lasts. With a limit, the button reads **Allow for N days**. Once an approval is older than that, the next run asks again, and approving again renews it. `0` removes the lasting option, and approvals already stored stop being reused. Leave it blank to change nothing. Choose a number comfortably longer than the gap between runs.\n\nThe limit covers MCP tools only, and a `toolPolicy` entry on `managedMcpServers` still takes precedence. If a configuration server delivers the setting, then after each launch scheduled tasks ask instead of reusing stored approvals (as at `0`) until the app has fetched the configuration again.\n\nCowork: if `mcpPersistentAlwaysAllowEnabled` is off, this setting brings the lasting option back for scheduled tasks only, with the time limit.\n\nCode tab: `mcpPersistentAlwaysAllowEnabled` has no effect. The limit covers only lasting approvals given after this setting took effect. An earlier one was usually saved as an allow rule in Claude Code's own settings: for a scheduled task, the project's `.claude/settings.local.json`, under `permissions.allow`. Any allow rule in Claude Code's settings, including one written by hand or by **Always allow** in an ordinary Code session in the same project, keeps allowing the tool without asking, even at `0`, until that entry is removed.",{docsUrl:`${Ar.COWORK_3P_DOCS_BASE}/configuration#mcpscheduledtaskapprovallifetimedays`})}}),claudeInChromeEnabled:He.field(wn.z.boolean().optional(),{flatKey:"claudeInChromeEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.34493.0"},executionTarget:"desktop",visibility:"public-undocumented"},remotePolicy:{hybrid:{scope:"only",derived:!0}},predicates:{show:()=>!1},title:Ze.msg({defaultMessage:"Enable Claude in Chrome",id:"q3VdR8mZpL"}),category:"connectors",group:tr.MCP_SERVERS_GROUP,order:3,description:{short:He.shortDescription(Ze.msg({defaultMessage:"Set by the control plane from the organization\u2019s Claude in Chrome admin setting; not editable here. Lets sessions drive the user\u2019s browser via the extension.",id:"Hn7tK2cWqs"})),long:He.longDescription(`Server-derived: the Claude.ai control plane sets this key, each time it serves the configuration, from the organization's Claude in Chrome setting (Admin settings \u2192 Claude in Chrome \u2014 the same switch, site allowlist/blocklist, and per-role access that govern the extension itself) and the signed-in member's role. It is not authored in any form, MDM profile, or bootstrap server, and a value stored anywhere else is ignored.

When on, Cowork and Code sessions can use the Claude in Chrome browser tools (navigate, read page, click, type, screenshot) in the user's Google Chrome or Microsoft Edge. Tool calls travel over the browser's local native-messaging connection between the app and the extension and are encrypted end to end between the two; page content is never relayed through Anthropic servers, and inference stays on the configured provider; the extension's hosted URL-safety check stays on, so the address of each page the agent acts on is checked against the Anthropic API. macOS and Windows only.

Before any tool call, Claude Desktop and the extension each obtain a short-lived signed identity statement from the Anthropic API and pair only when both belong to the same account in your organization, so those two small requests do go to Anthropic. Installed from the Chrome Web Store, the extension runs in third-party mode on its own for members of a hybrid organization \u2014 nothing runs that does not arrive over the verified pairing, and per-site permission prompts are delegated to Claude Desktop \u2014 so no separate Chrome policy is needed. Chrome managed policy stays optional for locked-down fleets: \`forceLoginOrgUUID\` may name the organization(s) allowed to take control of the extension wherever the policy reaches (a Claude Desktop from any other organization is refused), and \`blockedUrlPatterns\` may be added and applies on top of the hosted URL-safety check. Requires \`isLocalDevMcpEnabled\` to remain enabled. Off unless the organization's Claude in Chrome setting is on.`)}}),claudeInChromePasswordManagersEnabled:He.field(wn.z.boolean().optional(),{flatKey:"claudeInChromePasswordManagersEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"2.9939.2"},executionTarget:"desktop",visibility:"public-undocumented"},remotePolicy:{hybrid:{scope:"only",derived:!0},hotApplied:!0},predicates:{show:()=>!1},title:Ze.msg({defaultMessage:"Enable password managers in Claude in Chrome",id:"il2qeFDuRY"}),category:"connectors",group:tr.MCP_SERVERS_GROUP,order:3.1,description:{short:He.shortDescription(Ze.msg({defaultMessage:"Set by the control plane from the organization\u2019s Password managers setting under Claude in Chrome; not editable here. Lets a password manager fill sign-ins.",id:"y41oE2cG9U"})),long:He.longDescription(`Server-derived: the Claude.ai control plane sets this key, each time it serves the configuration, from the organization's Password managers setting (Admin settings \u2192 Claude in Chrome \u2192 Password managers, off until an admin turns it on) and the signed-in member's access. It is not authored in any form, MDM profile, or bootstrap server, and a value stored anywhere else is ignored.

When on, and Claude in Chrome is on, a member on macOS can connect a supported password manager's desktop app in Claude Desktop; sessions that can use Claude in Chrome can then ask that password manager to fill a sign-in form in the user's browser through the Claude in Chrome extension and the password manager's own extension. The user approves each request in the password manager and Claude never receives the credential itself: it passes on the device between the password manager, its browser extension and the page. The app's usage telemetry for the integration (outcomes only; no sites, credentials or item names) follows \`disableNonessentialTelemetry\`, and Claude in Chrome's own checks apply to the page as for any of its actions. A change takes effect without a relaunch once two configuration syncs in a row have served it. Off unless the organization's setting is on; requires \`claudeInChromeEnabled\`.`)}}),localStdioEnabled:He.field(wn.z.boolean().optional(),{flatKey:"isLocalDevMcpEnabled",readers:["desktop","code"],support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.2581.0"}},title:Ze.msg({defaultMessage:"Allow user-added MCP servers",id:"1QKV7FS8FM"}),default:!0,failClosedValue:!1,egressRequirements:(e)=>e===!1?[]:Cc.PYTHON_EXTENSION_RUNTIME_HOSTS,egressRequirementsLabel:Ze.msg({defaultMessage:"User-added MCP (Python runtime)",id:"O0zxaLsWs9"}),category:"connectors",group:tr.MCP_SERVERS_GROUP,order:2,description:{short:He.shortDescription(Ze.msg({defaultMessage:"Local stdio servers added via the Developer settings. Remote servers come from the managed list above or organization plugins.",id:"1NMgra1xGv"}))}}),allowedPluginServers:He.field(He.annotate(wn.z.array(UM(Ze.msg({defaultMessage:"URL pattern a plugin\u2019s remote server must match, with * wildcards.",id:"ERRP/7Z11f"})).nullable().catch(null)),{maxItems:100}).transform((e)=>e.filter((t)=>t!==null)).optional(),{flatKey:"allowedPluginMcpServers",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"2.2553.0"}},title:Ze.msg({defaultMessage:"Allowed plugin MCP servers",id:"vUSpcWJDNG"}),failClosedValue:[],emptyListIsAuthored:!0,predicates:{warn:NM},category:"connectors",group:tr.MCP_SERVERS_GROUP,order:2.5,description:{short:He.shortDescription(Ze.msg({defaultMessage:"Servers plugins may connect in sessions, beyond the managed list above and organization plugins. An empty list allows none; unset keeps today\u2019s rules.",id:"y4jySlHrtX"})),long:He.longDescription(`Unset (default): with managed servers listed, sessions take MCP servers only from plugins and the desktop; with no managed servers listed, nothing is restricted.

When set, Cowork, Chat and Code sessions connect the managed list above and the servers the desktop serves from the administrator's org-plugins directory, plus only servers declared by other plugins (user-installed or marketplace) that match an entry. An entry in the managed list above with \`transport: "policy-only"\` sets a plugin server's tool permissions but does not admit it; to admit that server, list the server's own URL here. Claude Code configuration-file servers (\`~/.claude.json\`, a project's \`.mcp.json\`, \`claude mcp add\`) are never connected. With the key set, the desktop starts no plugin server on the computer itself, whatever the entries say. The one exception is the MCP servers it serves to sessions from the org-plugins directory. Each entry is a URL pattern in Claude Code's form, \`{"serverUrl": "https://*.example.com/*"}\` (\`*\` wildcards; a host \`*\` spans \`a.b\`): a plugin's remote server connects when its URL matches an entry. No entry admits a plugin's local (stdio) server, and an empty list admits no plugin server. Other shapes, the \`serverName\` and \`serverCommand\` forms included, are dropped and reported; a value that is not a list, or has no readable entry, locks sessions to the managed list and the org-plugins directory's servers, and stops every other desktop-started plugin server. User-added local servers and extensions keep their own keys.

Coexistence with another Claude Code managed-settings source on the device: see [managed settings](${Ar.COWORK_3P_DOCS_BASE}/code#interaction-with-claude-code%E2%80%99s-own-managed-settings).`,{docsUrl:`${Ar.COWORK_3P_DOCS_BASE}/configuration#allowedpluginmcpservers`})}}),deniedPluginServers:He.field(He.annotate(wn.z.array(UM(Ze.msg({defaultMessage:"URL pattern of the remote servers to block, with * wildcards.",id:"/Glsg+l7xY"}))),{maxItems:100}).optional(),{flatKey:"deniedPluginMcpServers",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"2.16120.0"}},title:Ze.msg({defaultMessage:"Blocked plugin MCP servers",id:"nNohigULem"}),failClosedValue:[{serverUrl:"*"}],predicates:{warn:NM},category:"connectors",group:tr.MCP_SERVERS_GROUP,order:2.6,description:{short:He.shortDescription(Ze.msg({defaultMessage:"Remote servers plugins may not connect, even if the allowed list admits them; in Code sessions, configuration-file servers too. Unset or empty blocks none.",id:"PHP5kjRTiq"})),long:He.longDescription(`Unset (default) or an empty list: nothing is blocked.

When set, Cowork, Chat and Code sessions do not connect a plugin's remote server whose URL matches an entry. The key works with or without \`allowedPluginMcpServers\`; a server that matches both lists stays blocked. In a Code session that reads Claude Code configuration-file servers (\`~/.claude.json\`, a project's \`.mcp.json\`, \`claude mcp add\`), a matching remote server from those files is refused as well. The managed list above, the servers the desktop serves from the administrator's org-plugins directory, user-added local servers and extensions are not affected: remove those at their own keys. Each entry is a URL pattern in Claude Code's form, \`{"serverUrl": "https://*.example.com/*"}\` (\`*\` wildcards; a host \`*\` spans \`a.b\`). An entry matches an address, not a server: the same server under another host name or an IP address, or behind a plugin's local (stdio) server, which has no URL, is not matched. \`https://*.example.com/*\` does not match \`http://\`, \`wss://\` or the bare \`example.com\`; a pattern such as \`example.com/*\`, which names no scheme, matches nothing, and a lone \`*\` matches every URL. To keep a plugin's servers out whatever address they use, set \`allowedPluginMcpServers\`, which admits only the servers it lists. The desktop reads no other shape, the \`serverName\` and \`serverCommand\` forms included: a value that is not a list, or that holds any entry the desktop cannot read, is reported and blocks every plugin's remote server (and those configuration-file remote servers), because skipping an entry of a block list would let its server connect. The servers named above as not affected still connect.

Coexistence with another Claude Code managed-settings source on the device: see [managed settings](${Ar.COWORK_3P_DOCS_BASE}/code#interaction-with-claude-code%E2%80%99s-own-managed-settings).`,{docsUrl:`${Ar.COWORK_3P_DOCS_BASE}/configuration#deniedpluginmcpservers`})}}),toolTimeoutSec:He.field(wn.z.coerce.number().int().min(60).max(3600).optional(),{flatKey:"mcpToolTimeoutSec",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.37937.0"},executionTarget:"desktop"},title:Ze.msg({defaultMessage:"MCP tool call timeout",id:"yfZOCQ8bcU"}),category:"connectors",group:tr.MCP_SERVERS_GROUP,order:4,suffix:Ze.msg({defaultMessage:"seconds",id:"8TQoLRh7Ea"}),placeholder:Ze.msg({defaultMessage:"180",id:"H3SKnBW98K"}),description:{short:He.shortDescription(Ze.msg({defaultMessage:"Per-call timeout for MCP tool calls, in seconds. Default 180 (3 minutes).",id:"TKg4Ha2DBx"})),long:He.longDescription("Sets the per-call timeout the agent applies to every MCP tool call; a call that runs longer fails with a timeout error the model can see. Cowork and chat sessions default to 180 seconds. Code sessions have no desktop-imposed MCP tool timeout today, so setting this key introduces one there as well. The desktop's own request deadlines toward MCP servers \u2014 the managed servers above and, where `isLocalDevMcpEnabled` permits them, user-added local servers \u2014 follow this value so they never cut a call short first; while the key is unset, calls to user-added local servers are additionally limited to 60 seconds by the desktop. Values outside 60\u20133600 are rejected at parse time (the error is listed in the diagnostics report) and the defaults apply.\n\nThe timeout is global (there is no per-server or per-tool form), so size it for the slowest tool you need to complete: long-running tools on one server extend the window during which a stuck call on any server holds its turn. Cowork's built-in shell tool runs under the same cap: a single command's `timeout_ms` (itself limited to 600 seconds) cannot exceed this value.",{docsUrl:`${Ar.COWORK_3P_DOCS_BASE}/configuration#mcptooltimeoutsec`})}})});function Jce(e){var t;return((t=e.mcp)===null||t===void 0?void 0:t.persistentAlwaysAllowEnabled)!==!1}});var fd=R(function(lj){Object.defineProperty(lj,"__esModule",{value:!0});lj.WorkspaceConfig=lj.BUILTIN_TOOL_POLICY_ASK_SESSION=lj.BUILTIN_ASK_POLICY_VALUES=lj.BUILTIN_TOOL_NAMES=void 0;lj.builtinToolScope=iue;lj.scanRuleList=XM;lj.parseBuiltinRule=Mc;lj.builtinRuleToolName=Uv;lj.canonicalBuiltinRule=sl;lj.isScopedBuiltinRule=sue;lj.checkBuiltinToolPolicyForDrops=nj;lj.checkDisabledBuiltinToolsForDrops=rj;lj.builtinRuleWarnings=lue;lj.checkEgressHostsForDrops=ij;lj.resolveDisabledBuiltinTools=zv;lj.isChatTabEnabled=uue;lj.isCoworkSurfaceEnabled=due;lj.isSkillCreationEnabled=fue;lj.autoModeSurfaces=pue;lj.isChatAdvancedFileAnalysisEnabled=hue;lj.resolveBuiltinAskTools=sj;lj.toolsCoveredByScopedRule=aj;lj.resolveBuiltinAskToolNames=mue;var Ce=fn(),ca=Zr(),us=pr(),F=mt(),gt=Cn(),Z=pn(),fm=Sr(),cs=Or(),hSe=Rs(),Ft=Li(),Dc=kc(),ZM=Z.msg({defaultMessage:"Network proxy",id:"wER6775GSj"}),Qce=Z.msg({defaultMessage:"Workspace VM network",id:"ko4KhGaz+7"}),VM=Z.msg({defaultMessage:"End-user attribution",id:"enduserAttrTtl"}),eue=Ce.z.object({path:F.subfield(F.annotate(Ce.z.string().min(1),{pathKind:"folder"}),{label:Z.msg({defaultMessage:"Path",id:"P6LP7JosNq"}),support:{availableInVersion:"1.14271.0"},isPrimaryKey:!0,mono:!0,placeholder:Z.msg({defaultMessage:"~/Documents/work",id:"/dk65J5QxC"}),description:{short:F.shortDescription(Z.msg({defaultMessage:"Absolute folder path. May start with ~ or one of the listed %VAR% tokens, expanded per user. Subfolders are included.",id:"tFB6xfvwBv"}))}}),isDefaultSelected:F.subfield(Ce.z.boolean().optional(),{label:Z.msg({defaultMessage:"Pre-select on new task",id:"Dk3pnI8vXq"}),support:{availableInVersion:"1.14271.0"},description:{short:F.shortDescription(Z.msg({defaultMessage:"Shows as a folder chip on the new-task page and skips the trust prompt. Users can remove it.",id:"P3a+4xY9Hb"}),{docsOnly:!1})}}),mode:F.subfield(Ce.z.enum(["rw","ro"]).optional(),{label:Z.msg({defaultMessage:"Access mode",id:"Dt4A+S9duA"}),support:{availableInVersion:"1.26832.0"},description:{short:F.shortDescription(Z.msg({defaultMessage:"Read-only folders can be viewed and searched but not modified in Cowork. In Code, applies to file tools only. Over SSH, also to Bash in its sandbox.",id:"4W27f1A7Ah"}),{docsOnly:!1}),long:F.longDescription(`Read-only folders can be viewed and searched but not modified in Cowork (by Claude or via the UI). Bash runs in Cowork's isolated workspace where the folder is mounted read-only at the OS level; file-tool writes (Edit, Write) are blocked in-process by Claude Desktop.

In local Code sessions, read-only applies to Claude's file tools only; Bash does **not** yet enforce it.

In SSH sessions (earlier versions ignore the mode on the host), read-only is enforced by Claude Code's own permission rules: its file tools cannot modify the folder. A writable folder inside a read-only one is read-only too. Shell commands are stopped only where Claude Code's sandbox runs (Linux needs bubblewrap and socat), and only as far as that sandbox goes: keep read-only folders outside writable ones, and use the operating system's permissions where a folder must not change. The sandbox does not cover a path with \`* ? [ ] ( ) { } | +\` or a double quote. List each folder by its real path: shell commands may not be stopped in a folder listed through a link. Not enforced on Windows hosts, nor on a host with Claude Code managed settings of its own unless they set \`parentSettingsBehavior\` to \`merge\`. Not covered: MCP servers, hooks, the terminal, commands in \`sandbox.excludedCommands\`, and git worktrees, which Claude Desktop and Claude Code still create inside the folder.

A read-only folder that contains Claude's own data directory (for example the home folder; over SSH, \`~/.claude\` on the host) is enforced in Cowork only. Configure narrower folders for Code coverage. Over SSH, keep a Claude Code config folder moved by \`CLAUDE_CONFIG_DIR\` outside read-only folders.`,{docsOnly:!1})}})});lj.BUILTIN_TOOL_NAMES=["Bash","Read","Write","Edit","Glob","Grep","NotebookEdit","WebFetch","WebSearch","Task","TodoWrite","TaskCreate","TaskUpdate","TaskGet","TaskList","TaskStop","Skill","REPL","JavaScript","AskUserQuestion","ToolSearch","SendUserMessage"];var um=["WebSearch","WebFetch"],qM=["WebFetch"],tue="a scoped entry reaches Code sessions only, never Cowork; allow specific hosts with the egress host settings (coworkEgressAllowedHosts), one list for Cowork and Code",$c={Read:["Read","Grep","Glob"],Edit:["Edit","Write","NotebookEdit"]},GM=new Map(Object.entries($c).flatMap(([e,t])=>t.filter((n)=>n!==e).map((n)=>[n,e]))),WM="\\((\\S[^\\r\\n]*)\\)",nue={Bash:["curl *"],Read:["//etc/**","//**/secrets/**"],Edit:["//**/*.env","//etc/**"]},rue=["Bash","Task","Skill"];function iue(e){let t=nue[e];if(t!==void 0)return{examples:t};let n=GM.get(e);if(n!==void 0)return{via:n};return qM.includes(e)?{hostsViaEgress:!0}:void 0}var YM=new RegExp(`^(?:(${lj.BUILTIN_TOOL_NAMES.filter((e)=>!um.includes(e)).join("|")})(?:${WM})?|(${um.join("|")}))$`),JM=new RegExp(`^([^\\s()]+)(?:${WM})?$`);function XM(e){let t=(o,s)=>{let l=e.indexOf(e[o],o+1);for(let c=o+1,u=s;c<l;c++){let p=e[c];if(p==="(")u++;else if(p===")"&&u>0)u--;else if(p===","&&u===0)return-1}return l},n=[],i=0,r="";for(let o=0;o<e.length;o++){let s=e[o];if(s==='"'||s==="'"){let l=t(o,i);if(l!==-1){r+=e.slice(o,l+1),o=l;continue}}else if(s==="(")i++;else if(s===")"&&i>0)i--;else if(s===","&&i===0){n.push(r),r="";continue}r+=s}return n.push(r),{segments:n,open:i>0}}function QM(e){return XM(e).segments.length>1}var oue=/^[a-z_][a-z0-9_]+:/,ej=new Map(lj.BUILTIN_TOOL_NAMES.map((e)=>[e.toLowerCase(),e]));function Mc(e){let t=YM.exec(e);if(t===null||QM(e))return;return t[3]!==void 0?{tool:t[3]}:{tool:t[1],...t[2]!==void 0&&{content:t[2]}}}function Uv(e){var t;return(t=Mc(e))===null||t===void 0?void 0:t.tool}function sl(e){let t=JM.exec(e);if(t===null||ej.get(t[1].toLowerCase())!==t[1])return e;return t[2]==="*"||t[2]==="**"&&t[1]==="Bash"?t[1]:e}function sue(e){var t;return((t=Mc(e))===null||t===void 0?void 0:t.content)!==void 0}function tj(e){var t;let n=Mc(e);if(n!==void 0){let{tool:o,content:s}=n;if(s===void 0)return;if(sl(e)!==e)return`"(${s})" means every call; it is applied as the bare name "${o}"`;if(oue.test(s))return;let l=GM.get(o);if(l!==void 0)return`Claude Code matches file-path patterns only on ${l}(\u2026) rules, which cover ${$c[l].join("/")}; use "${l}(${s})"`;if(!(o in $c)&&!rue.includes(o))return`${o} matches rule content only in Claude Code's ${o}(<field>:<pattern>) form; use the bare name "${o}" to cover every call`;return}if(QM(e))return"looks like several rules joined by commas; use one entry per rule";let i=(t=JM.exec(e))===null||t===void 0?void 0:t[1];if(i===void 0)return"malformed rule; expected Tool or Tool(pattern) on one line";let r=ej.get(i.toLowerCase());if(r===void 0)return;if(r!==i)return`tool names are case-sensitive; use "${r}"`;return qM.includes(r)?`${r} takes the bare name only \u2014 ${tue}`:`${r} takes the bare name only`}var aue=`Each entry is a Claude Code tool name (\`${lj.BUILTIN_TOOL_NAMES.join("`, `")}\`) or an argument-scoped [permission rule](https://code.claude.com/docs/en/permissions#permission-rule-syntax) such as \`Bash(curl *)\` or \`Edit(//**/*.env)\`. A bare name covers every call (a bare \`Bash\` entry also covers the \`PowerShell\` tool); a scoped rule covers matching calls in every permission mode, including Auto and bypass. Scopes are matched for \`Bash(\u2026)\` (a command pattern) and for file paths written as \`Read(\u2026)\` (covers \`${$c.Read.join("`, `")}\`) or \`Edit(\u2026)\` (covers \`${$c.Edit.join("`, `")}\`); other tools take \`Tool(<field>:<pattern>)\`. \`${um.join("` and `")}\` are bare-name only: per-host web access is \`coworkEgressAllowedHosts\`.

Scoped \`Bash(\u2026)\` rules apply in Code sessions only; Cowork's shell follows only a bare \`Bash\` entry. Start absolute file paths with \`//\`, not \`/\`: a relative pattern such as \`Read(**/.env)\` covers only a Code session's project folder and none of Cowork's connected folders. Scoped rules need fleet-wide build support (\`disableAutoUpdates\` pins builds): an older build passes a scoped entry to Claude Code unchecked. An entry whose pattern contains \`)\` followed by a space or comma is enforced only through Claude Code's managed-settings channel, so another Claude Code [managed-settings source](${gt.COWORK_3P_DOCS_BASE}/code#interaction-with-claude-code%E2%80%99s-own-managed-settings) replaces it unless that source sets \`parentSettingsBehavior\` to \`"merge"\`; every other entry is enforced either way.

An unusable entry (a lowercase tool name, an unbalanced parenthesis, a scoped \`${um.join("(\u2026)` or `")}(\u2026)\`) is kept, because the deny list is served exactly as written, and raises a configuration warning.`;lj.BUILTIN_ASK_POLICY_VALUES=["allow","ask"];lj.BUILTIN_TOOL_POLICY_ASK_SESSION={path:'builtinToolPolicy: "ask-session"',use:'"ask"',effect:'the entry will be read as "ask" (approval on every call), like any unrecognized value',...ca.BATCH_2026_09,match:(e)=>typeof e==="object"&&e!==null&&!Array.isArray(e)&&Object.values(e).some((t)=>t==="ask-session"),rewrite:(e)=>Object.fromEntries(Object.entries(e).map(([t,n])=>[t,n==="ask-session"?"ask":n]))};function nj(e,t){var n;let i=ca.applyLegacy(lj.BUILTIN_TOOL_POLICY_ASK_SESSION,e);if(!i||typeof i!=="object")return;for(let[r,o]of Object.entries(i)){let s=sl(r);if(s!==r)t(`builtinToolPolicy["${r}"]: "${r.slice(s.length)}" means every call; applied as the bare name "${s}"`,"clamp");if(Uv(s)===void 0)t(`builtinToolPolicy["${r}"] dropped: ${(n=tj(r))!==null&&n!==void 0?n:"unknown built-in tool"}`,"drop");else if(o==="blocked")t(`builtinToolPolicy["${r}"]: "blocked" is not a built-in tool policy; treated as "ask" (use disabledBuiltinTools to remove the tool)`,"drop");else if(o!=="allow"&&o!=="ask")t(`builtinToolPolicy["${r}"]: unrecognized policy ${JSON.stringify(o)}; treated as "ask"`,"drop")}}function rj(e,t){if(!Array.isArray(e))return;e.forEach((n,i)=>{if(typeof n!=="string"){t(`disabledBuiltinTools[${i}] dropped: entries must be strings (got ${n===null?"null":Array.isArray(n)?"array":typeof n})`,"drop");return}let r=sl(n);if(r!==n)t(`disabledBuiltinTools entry ${JSON.stringify(n)}: "${n.slice(r.length)}" means every call; applied as the bare name "${r}"`,"clamp")})}function lue(e,t){return t.flatMap((n)=>{let i=tj(n);return i===void 0?[]:[`${e} entry ${JSON.stringify(n)} is not enforced as written: ${i}`]})}function ij(e,t){if(!Array.isArray(e))return;for(let n of e)if(typeof n!=="string"||us.parseEgressHostEntry(n)===null)t(`coworkEgressAllowedHosts entry ${JSON.stringify(n)} dropped: must be ${us.EGRESS_ENTRY_GRAMMAR}`)}lj.WorkspaceConfig=Ce.z.object({disabledBuiltinTools:F.field(Ce.z.preprocess((e)=>Array.isArray(e)?[...new Set(e.filter((t)=>typeof t==="string").map(sl))]:e,F.annotate(Ce.z.array(Ce.z.string()),{maxItems:100})).optional(),{flatKey:"disabledBuiltinTools",readers:["desktop","code"],failClosedValue:[...lj.BUILTIN_TOOL_NAMES],checkDropped:rj,support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.2581.0"},executionTarget:"desktop"},title:Z.msg({defaultMessage:"Disabled built-in tools",id:"iGPHC9Tm20"}),category:"sandbox",group:Ft.TOOLS_GROUP,order:4,customRenderer:"builtinToolRules",placeholder:Z.msg({defaultMessage:"WebSearch or Bash(curl *)",id:"KHWonN3qfv"}),description:{short:F.shortDescription(Z.msg({defaultMessage:"Built-in tools, or argument-scoped permission rules such as Read(//**/.env), denied in Cowork and Code.",id:"kMVrXfFbvZ"})),long:F.longDescription(aue)},predicates:{locked:[{when:(e)=>{var t;return fm.isBedrockFamily((t=e.inference)===null||t===void 0?void 0:t.provider)},append:["WebSearch"]}]}}),disableBundledSkills:F.field(Ce.z.boolean().optional(),{flatKey:"disableBundledSkills",readers:["desktop","code"],support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.15962.0"},executionTarget:"desktop"},failClosedValue:!0,title:Z.msg({defaultMessage:"Disable bundled skills and workflows",id:"kpCOjtwfPF"}),category:"sandbox",group:Ft.GENERAL_RESTRICTIONS_GROUP,order:6,description:{short:F.shortDescription(Z.msg({defaultMessage:"Disables Claude Code\u2019s bundled skills and workflows (deep-research and similar). Use where WebFetch/WebSearch aren\u2019t available.",id:"Q90IY9SGu1"}))}}),skillCreationEnabled:F.field(Ce.z.boolean().optional(),{flatKey:"skillCreationEnabled",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.25927.0"}},title:Z.msg({defaultMessage:"Allow user-created skills",id:"y486fMBVj/"}),default:{displayOnly:!0},failClosedValue:!1,category:"sandbox",group:Ft.GENERAL_RESTRICTIONS_GROUP,order:6.5,description:{short:F.shortDescription(Z.msg({defaultMessage:"Allow users to create and upload their own skills. When off, the creation and upload surfaces are hidden and the agent\u2019s skill-creation tools are disabled.",id:"Cpqtiix6lD"})),long:F.longDescription("When on (default), users can create new skills and upload skill files in the app. Set to `false` to block user skill creation: the skill-creation and upload surfaces are hidden (the `skill_creation` feature is served as blocked by the organization), and the agent's skill-creation tools (saving skills from a conversation, skill proposals) are not offered in sessions \u2014 the same effect as turning off the **User-created skills** organization setting available to claude.ai enterprise admins.\n\nThis is a feature-availability control enforced in the app's UI, not a data boundary: skills are files on the user's machine, and files already present there (or placed there outside the app) are not removed or blocked by this key. Skills themselves remain usable; organization-distributed plugins and bundled skills are unaffected (to disable bundled skills, use `disableBundledSkills`).",{docsUrl:`${gt.COWORK_3P_DOCS_BASE}/configuration#skillcreationenabled`})}}),scheduledTasksEnabled:F.field(Ce.z.boolean().optional(),{flatKey:"scheduledTasksEnabled",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"2.110.0"}},title:Z.msg({defaultMessage:"Allow scheduled tasks",id:"scheduledTasksEnabledTitle"}),default:{displayOnly:!0},failClosedValue:!1,category:"sandbox",group:Ft.GENERAL_RESTRICTIONS_GROUP,order:6.8,description:{short:F.shortDescription(Z.msg({defaultMessage:"Allow scheduled tasks in Cowork and Code. When off, the Scheduled page is hidden, existing tasks stop running, and Claude cannot create new ones.",id:"scheduledTasksEnabledShort"})),long:F.longDescription("When on (default), users can schedule Cowork tasks and Code sessions to run later or on a recurring schedule, and Claude can create such schedules when asked.\n\nSet to `false` to turn scheduled tasks off for every user. The Scheduled section in Cowork and the routines list in the Code tab are hidden, together with every other place a schedule can be created. Tasks that already exist on a device no longer run; they are kept, not deleted, and run again once the key is removed or set to `true`. Claude is not offered the tools that create, change or run these tasks, and sessions start without Claude Code's own in-session scheduling tools (the `/loop` command, its cron tools and its wake-up timer).\n\nIt does not remove task files already on the user's machine. A change takes effect at the next app launch.",{docsUrl:`${gt.COWORK_3P_DOCS_BASE}/configuration#scheduledtasksenabled`})}}),keepAwakeEnabled:F.field(Ce.z.boolean().optional(),{flatKey:"keepAwakeEnabled",remotePolicy:{hotApplied:!0},support:{enabled:{scopes:["3p"],availableInVersion:"2.7032.0"}},title:Z.msg({defaultMessage:"Allow keep awake",id:"keepAwakeEnabledTitle"}),default:{displayOnly:!0},failClosedValue:!1,category:"sandbox",group:Ft.GENERAL_RESTRICTIONS_GROUP,order:6.9,description:{short:F.shortDescription(Z.msg({defaultMessage:"Let Claude keep the computer awake. When off, Claude never prevents sleep and hides the keep-awake switches in Settings, the Scheduled page and the Code tab.",id:"keepAwakeEnabledShort"})),long:F.longDescription("When on (default), users can turn on **Keep computer awake** (Settings \u2192 This computer \u2192 System, also shown as **Keep awake** on the Scheduled page in Cowork and the Routines page in Code) so the computer does not idle-sleep while Claude is open and scheduled tasks keep running on an idle machine. The Code tab can also keep the computer awake while a session is working (**Keep computer awake while Claude works** in Settings \u2192 Claude Code, and a session's **Keep computer awake** menu item).\n\nSet to `false` to make sure Claude never prevents the computer from sleeping: those switches are hidden and no part of the app keeps the computer awake. Users' saved choices are kept but ignored, and apply again once the key is removed or set to `true`. Scheduled tasks are unaffected and still run only while the computer is awake and the app is open.\n\nA change takes effect on a running app.",{docsUrl:`${gt.COWORK_3P_DOCS_BASE}/configuration#keepawakeenabled`})}}),builtinToolPolicy:F.field(F.annotate(Ce.z.preprocess((e)=>{let t=ca.applyLegacy(lj.BUILTIN_TOOL_POLICY_ASK_SESSION,e);return t&&typeof t==="object"&&!Array.isArray(t)?Object.entries(t).filter(([n])=>Uv(sl(n))!==void 0).reduce((n,[i,r])=>{let o=sl(i),s=r==="allow"?"allow":"ask";return n[o]=n[o]==="ask"?"ask":s,n},{}):t},Ce.z.record(Ce.z.string().regex(YM),Ce.z.enum(lj.BUILTIN_ASK_POLICY_VALUES))).optional(),{redact:"toolRules"}),{flatKey:"builtinToolPolicy",readers:["desktop","code"],support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.8089.0"},values:{"ask-session":{availableInVersion:"1.40609.0"}}},title:Z.msg({defaultMessage:"Built-in tool policy",id:"hhKxQ3MtxT"}),failClosedValue:Object.fromEntries(lj.BUILTIN_TOOL_NAMES.map((e)=>[e,"ask"])),deprecations:[lj.BUILTIN_TOOL_POLICY_ASK_SESSION],checkDropped:nj,category:"sandbox",group:Ft.TOOLS_GROUP,order:3,customRenderer:"builtinToolRules",placeholder:Z.msg({defaultMessage:"WebFetch or Bash(curl *)",id:"tQLBe0W6Km"}),addLabel:Z.msg({defaultMessage:"Add policy",id:"6TgDeF8iRs"}),description:{short:F.shortDescription(Z.msg({defaultMessage:"Approval policy per built-in tool or argument-scoped rule such as Bash(curl *). \u201Cask\u201D requires user approval before each matching call; \u201Callow\u201D is the default.",id:"H4Ea6XAuEf"})),long:F.longDescription("Keys use the same tool names and argument-scoped rule syntax as **Disabled built-in tools** (`disabledBuiltinTools`), and scopes apply in the same sessions. A bare `Bash` key also governs Claude Code's `PowerShell` tool (its shell on Windows PCs without Git for Windows); argument-scoped `Bash(\u2026)` keys do not. Scoped **ask** rules reach sessions only through Claude Code's managed-settings channel, so another Claude Code managed-settings source replaces them unless it sets `parentSettingsBehavior` to `\"merge\"` (bare names hold either way). They need the same fleet-wide build support, and an older build drops a scoped **ask** entry as a configuration error (which also blocks WSL sessions on Windows until that client updates), so the tool runs unprompted.\n\nAn **ask** entry, bare or scoped, also turns off the app's remembered \u201Calways allow\u201D choices for that tool, so each prompted call is confirmed individually. **ask** on a file tool (`Read`, `Write`, `Edit`, `Glob`, `Grep`) prompts in Cowork, Chat and Code sessions. Calls that Cowork and Chat always refuse are still refused without a prompt: paths outside the session's connected folders (in Chat, outside its scratch directory and its project's folders) and protected or sensitive files inside them. A scheduled task in Cowork waits at the prompt, which appears in the task's session and, when that session is not in view, as a desktop notification. Code side chats cannot prompt, so they block matching calls. An unusable entry is dropped and recorded as a configuration error; a value other than `allow` or `ask` is treated as `ask` and reported. To remove a tool or deny a rule outright, use **Disabled built-in tools** instead.")}}),autoModeEnabled:F.field(Ce.z.boolean().optional(),{flatKey:"autoModeEnabled",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.10628.0"}},title:Z.msg({defaultMessage:"Allow Auto mode",id:"0QsHlMb8HD"}),default:{displayOnly:!0},failClosedValue:!1,category:"sandbox",group:Ft.GENERAL_RESTRICTIONS_GROUP,order:5,description:{short:F.shortDescription(Z.msg({defaultMessage:"Offer Auto mode in the Code permission selector (on unless set to false); set to true to also offer it in Cowork. Claude decides which actions need approval.",id:"94/7dcRsyP"})),long:F.longDescription(`Left unset, users can select **Auto mode** in Code and new Code sessions start in it; a mode the user already chose, or a Claude Code settings file's \`permissions.defaultMode\`, takes precedence, and Cowork does not offer it. Set to \`true\` to also offer **Automatically approve** in Cowork (Cowork sessions still start by asking before each action until the user picks it). Set to \`false\` to remove the option from both tabs. In Auto mode Claude runs a safety classifier on each action and only prompts for approval on actions it judges risky, instead of following the static per-tool policy.

Requires a model that supports the safety classifier \u2014 which models qualify depends on the deployment's provider and the app version. With a model that lacks support the option is greyed out and Code sessions do not start in it. \`builtinToolPolicy\` and this key may both be set; Auto mode is a user-selectable option alongside the default policy, not a replacement for it.

In Code sessions, a separately deployed Claude Code [managed-settings](${gt.COWORK_3P_DOCS_BASE}/code#interaction-with-claude-code%E2%80%99s-own-managed-settings) file that sets \`disableAutoMode\` to \`"disable"\` also keeps Auto mode hidden and off, whatever this key says.`,{docsUrl:`${gt.COWORK_3P_DOCS_BASE}/configuration#automodeenabled`})}}),disableBypassPermissionsMode:F.field(Ce.z.boolean().optional(),{flatKey:"disableBypassPermissionsMode",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.46388.1"}},title:Z.msg({defaultMessage:"Disable bypass permissions mode",id:"CIeOvXouGu"}),default:{displayOnly:!1},failClosedValue:!0,category:"sandbox",group:Ft.GENERAL_RESTRICTIONS_GROUP,order:5.5,description:{short:F.shortDescription(Z.msg({defaultMessage:"Remove the bypass permissions mode from Code sessions and Cowork tasks, so Claude always follows the permission policy. Off by default.",id:"eXwx/L4TgM"})),long:F.longDescription(`When set to \`true\`, sessions cannot run in bypass permissions mode: the app stops offering the mode in Code and Cowork, and a session that requests it anyway is downgraded. This is the \`disableBypassPermissionsMode\` setting from the \`permissions\` section of Claude Code's [managed settings](${gt.COWORK_3P_DOCS_BASE}/code#interaction-with-claude-code%E2%80%99s-own-managed-settings); a separately deployed Claude Code managed-settings file that sets it to \`"disable"\` also removes the mode, whichever source sets it.

Unset (default): users the deployment otherwise allows can choose bypass permissions mode.`,{docsUrl:`${gt.COWORK_3P_DOCS_BASE}/configuration#disablebypasspermissionsmode`})}}),toolSearchEnabled:F.field(Ce.z.boolean().optional(),{flatKey:"toolSearchEnabled",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.21459.0"},executionTarget:"desktop"},title:Z.msg({defaultMessage:"Enable tool search",id:"3b6nGnLx6b"}),default:!1,category:"sandbox",group:Ft.TOOLS_GROUP,order:5,description:{short:F.shortDescription(Z.msg({defaultMessage:"Load MCP tool schemas on demand (tool search) instead of inlining every schema into context.",id:"jPPLehrZ3d"})),long:F.longDescription("When enabled, Cowork, Code, and Chat sessions place only tool names in context up front, and Claude fetches a tool's full schema the first time it needs it. Use this when many MCP tools are configured and their inlined schemas crowd out the context window. If your endpoint does not accept the request shape it then receives, requests fail with HTTP 400.\n\n- **Claude API, Vertex AI, Bedrock, or Bedrock Mantle with no custom base URL**: not needed. The app leaves Claude Code's experimental betas on there, as terminal Claude Code does, so tool search is on by default (on Vertex AI, for Claude 4.5 and newer models). To turn it off in Code, Cowork, and Chat, set `ENABLE_TOOL_SEARCH` to `false` in the `env` block of OS-level Claude Code managed settings (with `parentSettingsBehavior: \"merge\"`). Earlier app versions treat these like the last case.\n- **Gateway provider, app versions bundling Claude Code 2.1.247 or later**: requests add only the tool-search shape (the `tool-search-tool-2025-10-19` `anthropic-beta` value, deferred tool loading, `tool_reference` content blocks); every other experimental Claude Code beta stays suppressed. OS-level Claude Code managed settings that keep that suppression or turn `ENABLE_TOOL_SEARCH` off still win; set `ENABLE_TOOL_SEARCH` to `force` there instead (with `parentSettingsBehavior: \"merge\"`). Sessions the app runs in Claude Code's gateway mode (an opt-in for users on the gateway's own sign-in) get its gateway-safe tool-search shape instead.\n- **Foundry, a custom base URL, and earlier app versions**: the app suppresses Claude Code's experimental betas for the session and the key lifts that, so requests carry the tool-search shape together with Claude Code's other experimental betas for that provider. On Vertex with app versions bundling Claude Code older than 2.1.221, leave this unset while any model older than Claude 4.5 is in use; those engines send the header regardless of model and Vertex's pre-4.5 stacks reject it.",{docsUrl:`${gt.COWORK_3P_DOCS_BASE}/gateway#mcp-tool-search`})}}),skipWebFetchPreflight:F.field(Ce.z.boolean().optional(),{flatKey:"skipWebFetchPreflight",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.37937.0"},executionTarget:"desktop"},title:Z.msg({defaultMessage:"Skip WebFetch domain check",id:"N2lNsOXNuF"}),default:{displayOnly:!1},category:"sandbox",group:Ft.GENERAL_RESTRICTIONS_GROUP,order:11,egressRequirements:(e,t)=>{var n;return e===!0||((n=t.codeSurface)===null||n===void 0?void 0:n.enabled)===!1?[]:[us.ANTHROPIC_API_HOST]},egressRequirementsLabel:Z.msg({defaultMessage:"WebFetch domain check",id:"nZmPQiUhiY"}),description:{short:F.shortDescription(Z.msg({defaultMessage:"Skip Claude Code\u2019s WebFetch domain lookup against api.anthropic.com in Code sessions. Off by default; turn on when that host is blocked.",id:"3dSlpHs3f5"})),long:F.longDescription(`Before fetching a page, Claude Code's WebFetch tool asks \`api.anthropic.com\` whether the domain is on Anthropic's content blocklist, and refuses the fetch if that lookup cannot complete. Third-party deployments route inference elsewhere and often block \`api.anthropic.com\` at the firewall; with the lookup on, every WebFetch in Code sessions then fails with "Unable to verify if domain \u2026 is safe to fetch", and where the host is reachable, every fetched hostname is sent to Anthropic. (Cowork sessions fetch through the app's own allowlisted fetch and never run this lookup.)

Off (default): the lookup runs as it does today, so \`api.anthropic.com\` must be reachable from users' machines for Code-session WebFetch to work (listed under Egress Requirements). Set to \`true\` when users' machines cannot reach \`api.anthropic.com\` (corporate firewall, government network) or you do not want fetched hostnames sent there: Code sessions then fetch without the lookup and never contact that host for it. This is the same \`skipWebFetchPreflight\` setting Claude Code reads from its own [managed-settings](${gt.COWORK_3P_DOCS_BASE}/code#interaction-with-claude-code%E2%80%99s-own-managed-settings) file; the app passes it to every session it starts. To restrict which domains Claude may fetch, use \`coworkEgressAllowedHosts\` or \`builtinToolPolicy\` instead.`)}}),allowedFolders:F.field(F.annotate(F.annotate(Ce.z.array(Ce.z.union([Ce.z.string().min(1),eue])),{maxItems:200}).transform((e)=>e.map((t)=>typeof t==="string"?{path:t}:t)).optional(),{pathKind:"folder"}),{flatKey:"allowedWorkspaceFolders",readers:["desktop","code"],support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.2581.0"}},title:Z.msg({defaultMessage:"Allowed workspace folders",id:"y3gym+4SMI"}),failClosedValue:[],emptyListIsAuthored:!0,category:"sandbox",group:Ft.GENERAL_RESTRICTIONS_GROUP,order:2,addLabel:Z.msg({defaultMessage:"Add folder",id:"kjqTjJbwtK"}),description:{short:F.shortDescription(Z.msg({defaultMessage:"Folders where Claude may work. Applies to Cowork and Code sessions and to the project folders a chat reads. Leave unset for unrestricted access.",id:"5BMPzic821"})),long:F.longDescription('Paths can reference `~` and these environment variables, expanded per user: `%OneDrive%`, `%OneDriveCommercial%`, `%OneDriveConsumer%`, `%APPDATA%`, `%LOCALAPPDATA%`, `%USERNAME%`, `%XDG_DOCUMENTS_DIR%`. The set is fixed; an entry that references any other `%VAR%`, or one that is unset on the device, is ignored.\n\nEach folder is interpreted on the machine the session runs on. For a Code session on an SSH host, `~` means the remote user\'s home, an entry that references a `%VAR%` is ignored there (environment variables belong to the machine that defines them), and the session\'s working directory must fall inside one of the folders as they exist on that host. One list serves every machine: `["~/work", "/srv/work"]` governs `~/work` for each user, on a managed Mac or a Linux host, and `/srv/work` on a host that has it. A folder that names nothing real on a given machine simply allows nothing there. An empty list allows no folder at all; unset leaves access unrestricted.\n\nA listed folder is one Claude may write as well as read, unless the entry\'s `mode` (Access mode in Setup) makes it read-only; that field\'s own description says how far read-only reaches. A Code session can reach every listed folder, not only the one it was opened in. Setting this key also turns on Claude Code\'s sandbox where it runs (macOS, or Linux and SSH hosts with bubblewrap): there a shell command normally writes in the listed folders without an approval prompt, and its writes to most other places, such as a package cache in the home directory, are refused. A home directory holds shell start-up files and SSH keys, so list work folders, not a whole home directory.\n\nThe list also limits which folders of a project a chat reads.',{docsUrl:`${gt.COWORK_3P_DOCS_BASE}/configuration#allowedworkspacefolders`})}}),blockReadsOutsideWorkingDirectories:F.field(Ce.z.boolean().optional(),{flatKey:"blockReadsOutsideWorkingDirectories",readers:["desktop","code"],support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.46388.1"},executionTarget:"desktop"},failClosedValue:!0,title:Z.msg({defaultMessage:"Block reads outside working directories",id:"GQrrmfzD4R"}),default:{displayOnly:!1},category:"sandbox",group:Ft.GENERAL_RESTRICTIONS_GROUP,order:2.5,description:{short:F.shortDescription(Z.msg({defaultMessage:"Keep Claude from reading files outside a Code session\u2019s working directories. File tools refuse such reads; sandboxed shell commands lose the home directory.",id:"vSpvldmS33"})),long:F.longDescription(`When set to \`true\`, Code sessions refuse reads outside their working directories (the session folder plus any \`allowedWorkspaceFolders\`). The file tools (Read, Grep, Glob) refuse them in every permission mode; where Claude Code's sandbox runs (macOS, or Linux and SSH hosts with bubblewrap, once \`allowedWorkspaceFolders\` is set or an egress allowlist applies: in third-party deployments one applies unless \`coworkEgressAllowedHosts\` contains \`*\`, in first-party deployments none does) shell commands cannot see the home directory and other user folders (\`/Users\`, \`/home\`, mounted volumes) and a read there is refused with no prompt; elsewhere (Windows, Linux without bubblewrap, or neither folders nor an egress allowlist in effect) such shell reads prompt for approval. The app keeps the user's git configuration files (which may themselves embed credentials such as URL tokens; a symlinked one stays hidden), its own Claude Code installation, and the session's plugin and attachment folders readable (not on a Windows SSH host, where plugin files and attachments stay out of the file tools' reach under the block). An allowed folder that is or contains the home directory leaves it readable.

Users can re-open folders (even their whole home) in their own Claude Code settings with \`sandbox.filesystem.allowRead\` or \`permissions.additionalDirectories\`; settings files tracked in a git repository cannot. The key travels on Claude Code's managed-settings channel: another Claude Code managed-settings source replaces it unless that source sets \`parentSettingsBehavior\` to \`"merge"\`, and one that sets \`sandbox.filesystem.allowManagedReadPathsOnly\` reduces it to approval prompts. This is \`permissions.blockReadsOutsideWorkingDirectories\` in Claude Code's [managed settings](${gt.COWORK_3P_DOCS_BASE}/code#interaction-with-claude-code%E2%80%99s-own-managed-settings).

Unset (default): nothing changes.`,{docsUrl:`${gt.COWORK_3P_DOCS_BASE}/configuration#blockreadsoutsideworkingdirectories`})}}),disableWslSessions:F.field(Ce.z.boolean().optional(),{flatKey:"disableWslSessions",remotePolicy:{hotApplied:!0},support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.19367.0"},visibility:"public-undocumented",executionTarget:"desktop"},appBehaviorOnly:!0,title:Z.msg({defaultMessage:"Block WSL sessions",id:"DpHm4YbvWC"}),category:"sandbox",group:Ft.CODE_SURFACE_GROUP,order:15,predicates:{show:(e)=>{var t;return((t=e.codeSurface)===null||t===void 0?void 0:t.enabled)!==!1}},description:{short:F.shortDescription(Z.msg({defaultMessage:"Block Code sessions that run inside a WSL distro. Windows endpoint policy does not reach inside WSL.",id:"722/v6Am9J"})),long:F.longDescription("Sessions started inside a WSL distro run Claude Code where Windows host endpoint policy (this managed configuration, and Claude Code's own managed-settings.json) does not apply. On a device with any managed configuration present, WSL sessions are blocked unless this key is explicitly set to `false`. Set to `true` to block WSL sessions unconditionally; set to `false` to allow them on managed devices; leave unset to block whenever the device is managed.\n\nThis key is honored only when deployed through machine-scoped management \u2014 MDM on macOS, the HKLM policy hive on Windows, the root-owned `/etc` file on Linux \u2014 never via the in-app Setup panel or user-writable stores; in particular, an explicit `false` written to the user-writable HKCU hive is ignored (and its presence still marks the device as managed). Because the key is grouped with the other app-behavior keys, deploying it claims that whole group: the auto-update keys (`disableAutoUpdates`, `autoUpdaterEnforcementHours`, \u2026) are then resolved from the managed tier alone, and any local- or remote-tier values for them stop applying.")}}),claudeCodeProcessWrapperEnabled:F.field(Ce.z.boolean().optional(),{flatKey:"claudeCodeProcessWrapperEnabled",support:{enabled:[{scopes:["3p"],availableInVersion:"2.7032.0"},{scopes:["1p"],availableInVersion:"2.16120.0"}],visibility:"public-undocumented",executionTarget:"desktop"},remotePolicy:{hotApplied:!0},appBehaviorOnly:!0,title:Z.msg({defaultMessage:"Use Claude Code\u2019s corporate launcher",id:"ClaudeCodeProcessWrapperEnabledTitle"}),default:{displayOnly:!1},failClosedValue:!0,category:"sandbox",group:Ft.CODE_SURFACE_GROUP,order:15.5,predicates:{show:(e)=>{var t;return((t=e.codeSurface)===null||t===void 0?void 0:t.enabled)!==!1}},description:{short:F.shortDescription(Z.msg({defaultMessage:"Start Claude Code through the launcher in Claude Code\u2019s managed settings (processWrapper) \u2014 this device\u2019s, and an SSH host\u2019s for SSH sessions. Off by default.",id:"ClaudeCodeProcessWrapperEnabledHint"})),long:F.longDescription("When `true` and Claude Code's managed settings name a corporate launcher in `processWrapper` or `env.CLAUDE_CODE_PROCESS_WRAPPER`, the Code tab starts the app's Claude Code through it: on this device (managed-settings file or MDM profile, never server-managed), and, for an SSH session, through the one in the host's managed-settings files (`/etc/claude-code`; `/Library/Application Support/ClaudeCode` on macOS). Either way it is handed none of the app's inference credential (claude.ai sign-in, provider key, token, auth header or credential file) and reads no stored login or ambient cloud credential of this device (over SSH, the host account's own environment still applies); the launcher must put one in its environment \u2014 `ANTHROPIC_BASE_URL` with `ANTHROPIC_AUTH_TOKEN` or `ANTHROPIC_API_KEY`, or, for the Bedrock, Vertex or Foundry routing the app leaves set (`CLAUDE_CODE_USE_*`; override to switch), that provider's keys or credential file \u2014 or the start fails; it makes no non-essential Anthropic calls. The third-party connection test and title generation start directly. An unusable launcher, an unreadable host settings file or another Claude Code version refuses or ends the session with an error. Device launcher: macOS and Linux (ignored on Windows); SSH hosts: Linux or macOS, from any device; never WSL or Cowork; both deployment modes.\n\nUnset or `false` (default): the app never reads that setting and starts Claude Code directly, with its own credential. A change applies at the next Claude Code start on third party (a served value once fetched) and at the next app launch on a claude.ai install (profile or local configuration file).\n\nThe key is in the app-behavior group (`disableAutoUpdates`, \u2026): a profile that sets any group key is the only source read for all of them \u2014 set it in the profile, with every group key you need, when the profile sets any of them or the launcher must hold against the device's own user; else in the admin console or configuration server.")}}),relocateUncUserData:F.field(Ce.z.boolean().optional(),{flatKey:"relocateUncUserData",support:{enabled:{scopes:["1p"],availableInVersion:"1.32352.0"}},appBehaviorOnly:!0,title:Z.msg({defaultMessage:"Move app data off network shares",id:"hnH9BhZfMz"}),category:"sandbox",group:Ft.GENERAL_RESTRICTIONS_GROUP,order:7.5,description:{short:F.shortDescription(Z.msg({defaultMessage:"Store app data in local AppData on Windows devices where Roaming AppData is redirected to a network share, which Cowork tasks cannot run from.",id:"3SHQ+DxHRI"})),long:F.longDescription("AD Folder Redirection can point %APPDATA% at a network (UNC) share, where Cowork tasks fail to start. The sandbox cannot mount a network path. With this key set to `true`, the app stores its data in a product-specific `<ProductName>-Data` folder under %LOCALAPPDATA% on such devices instead. The key only takes effect when %APPDATA% actually resolves to a UNC path, so it is a no-op on devices with a local profile and does not move a healthy install.\n\nBecause the key is grouped with the other app-behavior keys, deploying it claims that whole group: the auto-update keys (`disableAutoUpdates`, `autoUpdaterEnforcementHours`, \u2026) are then resolved from the managed tier alone, and any local- or remote-tier values for them stop applying. Deploy it together with any auto-update keys you rely on in the same managed (MDM / HKLM `Policies\\Claude`) tier.\n\nThe relocation is a fresh start, not a move: nothing is carried over from the share. The new local folder begins empty, so users sign in again and re-enter their settings, preferences, and MCP server configuration after the move. Nothing is deleted from the share either; removing the key returns the app to the share with its previous contents (including the previous sign-in state) intact, so the rollback path keeps working.")}}),allowedEgressHosts:F.field(F.annotate(Ce.z.preprocess((e)=>Array.isArray(e)?e.filter((t)=>typeof t==="string"&&us.parseEgressHostEntry(t)!==null):e,F.annotate(Ce.z.array(Ce.z.string().min(1)),{maxItems:500}).optional()),{glob:!0}),{checkDropped:ij,flatKey:"coworkEgressAllowedHosts",readers:["desktop","code"],failClosedValue:[],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"},executionTarget:"desktop"},title:Z.msg({defaultMessage:"Allowed egress hosts",id:"5oTa1gWQsk"}),egressRequirements:(e)=>!Array.isArray(e)?[]:e.includes("*")?us.DEPENDENCY_INSTALL_DOMAINS:e,egressRequirementsLabel:Z.msg({defaultMessage:"Tool egress (Cowork, Code and Chat)",id:"pcNPpyq4F7"}),category:"sandbox",group:Ft.GENERAL_RESTRICTIONS_GROUP,order:1,placeholder:gt.HOST_LIST_PLACEHOLDER,description:{short:F.shortDescription(Z.msg({defaultMessage:"Hostnames the agent\u2019s tools may reach from Cowork, Code and Chat. Also surfaced under Egress Requirements.",id:"JNR06VQqQI"})),long:F.longDescription(`Applies only to **tool calls**, in Cowork, Code and Chat. In Cowork it covers the sandbox's web fetch, shell commands and package installs. In Chat it covers web fetch, and the file-analysis sandbox only if you open its network. In Code it's [translated into Claude Code's network sandbox allowlist](${gt.COWORK_3P_DOCS_BASE}/code#applied-as-managed-policy), and by default a separately deployed Claude Code managed-settings file takes precedence. It does **not** cover Web Search (which runs at your inference provider), inference, or MCP traffic. A list other than \`*\` also bounds where Claude may browse in the built-in browser. When unset, only the inference endpoint is reachable from the sandbox, so the agent's package installs and web fetches fail with a 403.

Entries are exact hostnames (\`api.github.com\`), wildcards (\`*.corp.com\` matches subdomains at any depth, not \`corp.com\` itself), or \`*\` to allow all. IP addresses match only when listed exactly. Web fetch always blocks \`localhost\` and private-network addresses. Shell commands and package installs run in a network sandbox that can reach only the listed hosts plus, outside Chat, your inference provider. With \`*\`, that sandbox is disabled and web fetch still blocks private addresses.

Any entry except bare \`*\` may carry a \`:port\` suffix (\`*.corp.com:8443\`) restricting it to that port. IPv6 literals are not supported. Invalid entries are dropped with a log warning and the rest still work. An unreadable value counts as an empty list. Ports are enforced for the Cowork sandbox's web fetch, shell, and package-install egress; plugin CLIs ignore port-scoped entries for now, and the Code translation treats them as the bare host. Only deploy port-scoped entries once your whole fleet supports them (\`disableAutoUpdates\` pins builds). On an older build, a single one invalidates the session's whole shell and package-install allowlist.

Open listed hosts on your network firewall too.`,{docsUrl:`${gt.COWORK_3P_DOCS_BASE}/web-tools#web-fetch`})}}),egressProxyUrl:F.field(F.annotate(cs.urlSchema({allowHttp:!0}).optional(),{redact:"hostname"}),{flatKey:"egressProxyUrl",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.44121.1"}},appBehaviorOnly:!0,remotePolicy:{type:"remote-disabled"},title:Z.msg({defaultMessage:"Proxy server URL",id:"A/z9Ko1sje"}),egressRequirements:gt.singleHostEgress,egressRequirementsLabel:Z.msg({defaultMessage:"Proxy server",id:"B/iAs+tICD"}),category:"connection",group:ZM,order:1,placeholder:Z.msg({defaultMessage:"http://proxy.example.com:8080",id:"F8dd6JjEQu"}),description:{short:F.shortDescription(Z.msg({defaultMessage:"Send the app\u2019s and the agent\u2019s traffic through this HTTP proxy instead of the operating system\u2019s proxy settings.",id:"XX6zi7GmwV"})),long:F.longDescription("Pins the app (sign-in, the connection test, model discovery, MCP servers, plugins), the Claude Code engine behind Chat, Cowork, and Code, and on macOS and Windows the Cowork workspace VM (the agent's shell, package-install, `git`, and plugin commands) to one HTTP proxy. Use it when your gateway or the internet is reachable only through a corporate proxy and you cannot rely on the system proxy. It is a reachability setting, not an egress control.\n\nThe value is an `http://` or `https://` URL, usually with a port. SOCKS proxies and embedded credentials (`user:pass@`) are rejected. Give a local forwarding proxy on the device as `http://127.0.0.1:port`; an `https://` loopback address cannot be verified from inside the Cowork workspace VM. Requests to `localhost`, `127.0.0.1`, `[::1]`, and `*.local` names bypass the proxy so local MCP servers keep working; everything else goes through it, and if the proxy is unreachable requests fail rather than connect directly. The engine receives it as `HTTPS_PROXY` and `HTTP_PROXY` with a matching `NO_PROXY`; if Claude Code managed settings on the device set those variables, they win for the engine on the host. Traffic that never uses this proxy: the Cowork workspace VM on Linux, credential and header helper scripts, the update download, the Windows sign-in broker, and pages opened in the system browser.\n\nRead once at launch from device management (MDM) or the local configuration file only; a configuration server cannot deliver it, because the app may need the proxy to reach that server. A profile that sets only this key (or only the other app-behavior keys, such as `disableAutoUpdates`) does not take over a connection users set up in the app, but those keys are read from one source as a group, so put the proxy in the same profile as your update settings. Changes apply at the next app start. When `egressProxyPacUrl` is also set, the PAC file wins and this key is ignored.",{docsUrl:`${gt.COWORK_3P_DOCS_BASE}/network-proxy`})}}),egressProxyPacUrl:F.field(F.annotate(cs.urlSchema({allowHttp:!0}).optional(),{redact:"hostname"}),{flatKey:"egressProxyPacUrl",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.44121.1"}},appBehaviorOnly:!0,remotePolicy:{type:"remote-disabled"},title:Z.msg({defaultMessage:"Proxy auto-config (PAC) URL",id:"0DhMVtlmyQ"}),egressRequirements:gt.singleHostEgress,egressRequirementsLabel:Z.msg({defaultMessage:"Proxy auto-config file",id:"Gqm6SFn9I2"}),category:"connection",group:ZM,order:2,placeholder:Z.msg({defaultMessage:"http://wpad.example.com/proxy.pac",id:"E7zJ/trntg"}),description:{short:F.shortDescription(Z.msg({defaultMessage:"URL of a PAC file that decides the proxy per request. Wins over the proxy server URL when both are set.",id:"dRsQ1NgKdo"})),long:F.longDescription("At launch the app downloads the PAC script and asks it which proxy to use for each request, as a browser would, instead of following the operating system's proxy settings. Same value rules, coverage, exclusions, and delivery as `egressProxyUrl`, except that bypassing is the script's decision: `localhost`, `127.0.0.1`, and `[::1]` still never use a proxy, but `*.local` names and everything else follow whatever it returns. If the PAC file cannot be downloaded, the app connects directly rather than failing.\n\nOn macOS and Windows the Cowork workspace VM is handed a copy of the script when it starts and evaluates it for each request itself; there `myIpAddress()` returns the VM's internal address rather than the device's, so a script that chooses by client subnet gives the VM its off-network answer (if that download fails, the VM connects directly). The Claude Code engine behind Chat, Cowork, and Code cannot evaluate a PAC file, so the app hands it one proxy (whichever the script returns for your inference endpoint) plus a bypass for loopback and `*.local` names. If the script answers `DIRECT` or only `SOCKS` for that endpoint, the engine uses no proxy at all, so have it return an HTTP `PROXY host:port` entry there; if the engine needs different rules, set `HTTPS_PROXY` and `NO_PROXY` in Claude Code managed settings, which win for the engine on the host.",{docsUrl:`${gt.COWORK_3P_DOCS_BASE}/network-proxy`})}}),edrExtension:F.field(cs.configuredHostPath.optional(),{flatKey:"coworkEDRIntegration",support:{enabled:{scopes:["3p","1p"],availableInVersion:"2.16120.0"},visibility:"public-undocumented",executionTarget:"desktop"},remotePolicy:{type:"remote-disabled"},appBehaviorOnly:!0,title:Z.msg({defaultMessage:"EDR Integration package path",id:"IBdsVeIXWe"}),category:"sandbox",predicates:{show:()=>!1},description:{short:F.shortDescription(Z.msg({defaultMessage:"Path on the user\u2019s computer to the signed package an endpoint security (EDR) vendor supplies for the Cowork workspace VM. Read from device management only.",id:"rhY1Zx/tks"})),long:F.longDescription("The path on the user's computer of the signed package your endpoint security (EDR) vendor supplies for the Cowork workspace VM. Put its signature file beside the file this path points to, named as that file plus `.sig`. Keep both, and every folder above them, where ordinary users cannot write. Each time the workspace VM starts, it checks that signature and, only if it is from the vendor named in `coworkEDRIntegrationVendor`, which you must also set, runs the package's `install.sh` as root to install or update the sensor. The signature covers only the package file, `install.sh` included; what the sensor downloads afterwards, including its own updates, is the vendor's and is not checked by Claude. macOS only.\n\nClaude reads this key only from configuration that only an administrator can install: an MDM profile on macOS, or the root-owned file under `/etc/claude-desktop` on Linux. It ignores the key in the in-app Setup panel, in any file the user can edit, and from a configuration server. It is one of the app-behavior keys (`disableAutoUpdates`, `relaunchEnforcementHours`, `egressProxyUrl`, \u2026), which Claude takes as a set: once your profile sets any of them, values for the others from a local file or a configuration server stop applying, so put every one you use in the same profile.\n\nUnset (default): no vendor package is installed in the workspace VM. Removing this key only stops later runs of the package. It does not remove or stop a sensor already installed, which stays on the workspace VM's disk until that VM is deleted or replaced.\n\nNetwork access: `install.sh` and whatever it installs run as root in the workspace VM and are not part of any session, so the network egress allowlist, the proxy keys (`egressProxyUrl`, `egressProxyPacUrl`) and the device's proxy settings do not apply to them. Claude does not otherwise limit which internet hosts they can reach; their connections are ordinary traffic from the device, subject to your own network-layer controls.")}}),edrExtensionVendor:F.field(cs.vendorId.optional(),{flatKey:"coworkEDRIntegrationVendor",support:{enabled:{scopes:["3p","1p"],availableInVersion:"2.16120.0"},visibility:"public-undocumented",executionTarget:"desktop"},remotePolicy:{type:"remote-disabled"},appBehaviorOnly:!0,title:Z.msg({defaultMessage:"EDR Integration vendor ID",id:"/BHf6muvcS"}),category:"sandbox",predicates:{show:()=>!1},description:{short:F.shortDescription(Z.msg({defaultMessage:"The ID of the vendor that signed the package coworkEDRIntegration points to. Required with that key, or nothing is installed. Read from device management only.",id:"HBPYbmIcrk"})),long:F.longDescription("The ID of the endpoint security (EDR) vendor that signed the package `coworkEDRIntegration` points to: 1 to 32 characters from a to z, 0 to 9 and the hyphen, not starting with a hyphen, for example `example-vendor`. It must be an ID this release of Claude accepts; ask your vendor which ID to use. Required whenever `coworkEDRIntegration` is set. The workspace VM runs the package only if this vendor signed it; a package signed by anyone else is refused, even another vendor this release of Claude accepts. The signature the VM checks is the `.sig` file described under `coworkEDRIntegration`. macOS only.\n\nClaude reads this key only from the configuration described under `coworkEDRIntegration`, and ignores a value from anywhere else. It is one of the app-behavior keys (see `coworkEDRIntegration`), so put it in the same profile as every other app-behavior key you use.\n\nUnset (default): if `coworkEDRIntegration` is set, nothing is installed, and each time the workspace VM starts `cowork_vm_node.log` in the app's logs folder records the reason, `vendor_not_named`. It records `config_invalid` for a value not of the form above and `vendor_unknown` for an ID this release of Claude does not accept; neither installs anything. To turn the feature off without these entries, remove `coworkEDRIntegration`, not this key. Removing either key only stops later runs: a sensor already installed stays on the workspace VM's disk until that VM is deleted or replaced.")}}),vmIpv6Enabled:F.field(Ce.z.boolean().optional(),{flatKey:"coworkVmIpv6Enabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.52386.0"},executionTarget:"desktop"},title:Z.msg({defaultMessage:"Enable IPv6 in the workspace VM",id:"JHTnwZf+m3"}),default:{displayOnly:!1},category:"connection",group:Qce,order:1,description:{short:F.shortDescription(Z.msg({defaultMessage:"Give the Cowork workspace VM an IPv6 address and route so the agent\u2019s tools can reach IPv6-only hosts through the device. macOS and Windows; off by default.",id:"v9YS8eHay0"})),long:F.longDescription("When set to `true`, the Cowork workspace VM on macOS and Windows gets a static IPv6 address (a unique local `fd\u2026` address) and an IPv6 default route on its virtual network next to its IPv4 address, and the VM's gateway forwards that traffic over the device's own IPv6 connectivity, as it already does for IPv4. Use it when the tools the agent runs in the VM (shell commands, package installs, `git`, and plugin commands) must reach IPv6-only destinations. The VM's resolver then also returns IPv6 (AAAA) answers. A connection the VM makes over IPv6 succeeds only where the device's own IPv6 does; on a device without working IPv6, destinations that have both keep working over IPv4 and IPv6-only destinations stay unreachable. Because the VM's address is unique-local, most tools in it keep preferring IPv4 for destinations that have both, so IPv6 mostly carries traffic to IPv6-only destinations.\n\nThis is a reachability setting, not an egress control: `coworkEgressAllowedHosts` keeps deciding which hostnames the agent's tools may reach, by name, over either protocol, and IPv6 literals are still not accepted there. Hosts your policies allow must also be reachable, and filtered the way you intend, over IPv6 on your network.\n\nUnset (default): the VM is IPv4-only and its resolver returns no IPv6 answers. A change takes effect the next time the workspace VM starts, typically at the next app launch. Does not apply to the Cowork workspace VM on Linux or to Code sessions, which use the device's own network stack.")}}),secureVmEnabled:F.field(Ce.z.boolean().optional(),{flatKey:"secureVmFeaturesEnabled",support:{enabled:{scopes:["1p"],availableInVersion:"1.2581.0"},executionTarget:"desktop"},failClosedValue:!1,title:Z.msg({defaultMessage:"Secure VM features",id:"+AQagzW8cG"}),category:"sandbox",description:{short:F.shortDescription(Z.msg({defaultMessage:"Enable additional VM-level isolation for the Cowork sandbox.",id:"SecureVmFeaturesHint"}),{docsOnly:!0})}}),hardwareBuddyEnabled:F.field(Ce.z.boolean().optional(),{flatKey:"hardwareBuddyEnabled",support:{enabled:{scopes:["1p"],availableInVersion:"1.18286.0"},executionTarget:"desktop"},title:Z.msg({defaultMessage:"Allow Hardware Buddy devices",id:"HardwareBuddyEnabled"}),default:!0,failClosedValue:!1,category:"connectors",description:{short:F.shortDescription(Z.msg({defaultMessage:"Allow pairing Hardware Buddy Bluetooth devices in Cowork.",id:"HardwareBuddyHint"}),{docsOnly:!0})}}),quickWriteEnabled:F.field(Ce.z.boolean().optional(),{flatKey:"quickWriteEnabled",support:{enabled:{scopes:["1p"],availableInVersion:"2.26454.0"},visibility:"public-undocumented"},appBehaviorOnly:!0,title:Z.msg({defaultMessage:"Allow Quick Write",id:"ae+sNvqJZe"}),category:"sandbox",description:{short:F.shortDescription(Z.msg({defaultMessage:"Off on a managed computer until set to true.",id:"ui6EQvL97l"}))}}),requireFullVmSandbox:F.field(Ce.z.boolean().optional(),{flatKey:"requireCoworkFullVmSandbox",support:{enabled:{scopes:["1p"],availableInVersion:"1.2581.0"},deprecated:{scopes:["3p"],availableInVersion:"1.2581.0"},executionTarget:"desktop"},title:Z.msg({defaultMessage:"Require full VM sandbox",id:"wQRUBw9rk7"}),default:!1,failClosedValue:!0,category:"sandbox",description:{short:F.shortDescription(Z.msg({defaultMessage:"Runs tools inside an isolated VM instead of the host. Stronger isolation; slower file access and no host-process tools.",id:"LVgbWJo83E"}))},predicates:{warn:(e)=>e===!0?Z.msg({defaultMessage:"The default host-native mode starts faster and works behind restricted networks. Shell commands run inside the VM; file tools run on the host with path-based access control. Enable this only if your security review requires the agent loop itself to run in the VM.",id:"05sWumUU1+"}):null}}),endUserAttribution:F.field(Ce.z.boolean().optional(),{flatKey:"endUserAttribution",readers:["desktop","code"],legacyFlatKey:{name:"enduserAttribution",effect:"the key will read as false (its fail-closed value): end-user attribution will stay off \u2014 no identity shown, no enduser.id emitted \u2014 whatever the old name said",...ca.BATCH_2026_09},support:{enabled:{scopes:["3p"],availableInVersion:"1.25927.0"}},failClosedValue:!1,remotePolicy:{applyUnverified:!1},default:{displayOnly:!0},title:VM,category:"appearance",group:VM,description:{short:F.shortDescription(Z.msg({defaultMessage:"Show the signed-in user\u2019s identity-provider identity in the sidebar and account menu, and emit it as the OpenTelemetry enduser.id resource attribute.",id:"enduserAttrHnt"})),long:F.longDescription("When on (default), the app resolves the signed-in user's identity from the configured credential source (the identity provider claim, or the OS login name when no claim is available) and shows it in the sidebar footer, the account menu, and the Code session greeting. If an OpenTelemetry collector is configured, the same identity is also emitted as the `enduser.id` resource attribute on every span, metric, and log sent to your collector \u2014 unless you have set a static `enduser.id` under OpenTelemetry resource attributes, in which case your static value is kept and the runtime identity is not emitted. When off, no identity is shown in the app and no runtime `enduser.id` is emitted; a static `enduser.id` under OpenTelemetry resource attributes still passes through unchanged. This setting does not gate the `process.owner` resource attribute (the OS login name), which is standard OpenTelemetry process metadata and is always emitted \u2014 set a static `process.owner` under OpenTelemetry resource attributes to override it. Applies to both Cowork tasks and Code sessions.")}}),userContentRendererUrl:F.field(cs.urlSchema({rejectLoopback:!0}).optional(),{flatKey:"userContentRendererUrl",support:{enabled:{scopes:["3p"],availableInVersion:"1.24012.0"}},remotePolicy:{rejectLoopback:!0},title:Z.msg({defaultMessage:"Artifact preview iframe origin",id:"ucrUrlTitle"}),category:"connection",egressRequirements:gt.singleHostEgress,egressRequirementsLabel:Z.msg({defaultMessage:"Artifact preview iframe",id:"ucrUrlEgrs"}),description:{short:F.shortDescription(Z.msg({defaultMessage:"HTTPS origin of the user-content-renderer deployment used for artifact and file previews. Defaults to the commercial host when unset.",id:"ucrUrlHint"}))}}),organizationInstructions:F.field(Ce.z.string().trim().min(1).max(3000).optional(),{flatKey:"organizationInstructions",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.37937.0"},executionTarget:"desktop"},title:Z.msg({defaultMessage:"Organization instructions",id:"t2ElSZR3Hy"}),category:"sandbox",group:Z.msg({defaultMessage:"Organization instructions",id:"t2ElSZR3Hy"}),multiline:!0,placeholder:Z.msg({defaultMessage:"Always answer in British English. Never include customer account numbers in a response.",id:"tevwj/1wDb"}),description:{short:F.shortDescription(Z.msg({defaultMessage:"Appended to Claude\u2019s system prompt in Chat, Cowork, and Code. Guidance the model follows, not an enforced control. Up to 3,000 characters.",id:"1h3TR2uKST"})),long:F.longDescription(`Free-text instructions from your organization that Claude Desktop appends, in a clearly delimited block, after its own system prompt in **Chat**, **Cowork**, and **Code** (every chat, task, and Code session, including the sub-agents they spawn): for example house style, data-handling rules, or topics to decline. The model is told these instructions come from the organization's administrator and take priority over a user's personal preferences.

This is guidance the model follows, not an enforced control: like any system-prompt text it steers the model's behavior and is usually honored, but it does not guarantee an outcome and is not a substitute for the restriction keys (tool policy, egress allowlist, folder allowlist). The app's own system prompt is never replaced or shortened by this key; in Code sessions it is added after Claude Code's own prompt and any \`CLAUDE.md\` instructions still apply.

Read from the app's loaded configuration when a session starts; a changed value generally takes effect for sessions started after the next app launch. Leading and trailing whitespace is trimmed; an empty string is treated as unset. Maximum 3,000 characters; a longer value is rejected (the key is ignored with a configuration error) rather than truncated. Line breaks are preserved when the value is delivered as JSON, a bootstrap response, a \`.mobileconfig\` profile, or a \`.reg\` file; the Group Policy (ADMX) and Intune text box for this setting is single-line.`)}})});var Nv={Bash:"mcp__workspace__bash",WebFetch:"mcp__workspace__web_fetch"},cue={Bash:[Nv.Bash,"PowerShell"],WebFetch:[Nv.WebFetch]};function oj(e){for(let[t,n]of Object.entries(cue))if(e.has(t))for(let i of n)e.add(i);return[...e]}function zv(e){var t,n,i;let r=new Set((n=(t=e.workspace)===null||t===void 0?void 0:t.disabledBuiltinTools)!==null&&n!==void 0?n:[]);if(fm.isBedrockFamily((i=e.inference)===null||i===void 0?void 0:i.provider))r.add("WebSearch");return oj(r)}function uue(e){return Dc.surfacesOf(e).chat}function due(e){return Dc.surfacesOf(e).cowork}function fue(e){var t;return((t=e.workspace)===null||t===void 0?void 0:t.skillCreationEnabled)!==!1}function pue(e){var t;let n=(t=e.workspace)===null||t===void 0?void 0:t.autoModeEnabled;return{code:n!==!1,cowork:n===!0}}function hue(e){let t=Dc.surfacesOf(e);return t.chat&&t.fileAnalysis&&!zv(e).includes(Nv.Bash)}function sj(e){var t,n;let i=new Set(zv(e)),r=new Set;for(let[o,s]of Object.entries((n=(t=e.workspace)===null||t===void 0?void 0:t.builtinToolPolicy)!==null&&n!==void 0?n:{}))if(s!=="allow"&&Mc(o)!==void 0)r.add(o);return oj(r).filter((o)=>!i.has(o))}function aj(e){var t;return(t=$c[e])!==null&&t!==void 0?t:[e]}function mue(e){let t=new Set;for(let n of sj(e)){let i=Mc(n);if((i===null||i===void 0?void 0:i.content)===void 0)t.add(n);else for(let r of aj(i.tool))t.add(r)}return[...t]}});var pd=R(function(hj){Object.defineProperty(hj,"__esModule",{value:!0});hj.AuthenticationConfig=hj.ORG_UUID_VALUE=void 0;hj.forceLoginOrgUUIDList=pj;var On=fn(),dj=Zr(),it=mt(),ct=pn(),pm=Or(),ua=Li(),Fv=On.z.guid();function fj(e){let t=e.trim();if(t==="")return[];let n;try{n=t.startsWith("[")?JSON.parse(t):[t]}catch(i){return}return Array.isArray(n)&&n.every((i)=>typeof i==="string")?n.map((i)=>i.trim().toLowerCase()):void 0}function pj(e){var t;let n=(t=fj(e))===null||t===void 0?void 0:t.filter((i)=>Fv.safeParse(i).success);return n!==void 0&&n.length>0?n:void 0}var jue=On.z.string().refine((e)=>e.trim()===""||pj(e)!==void 0,{message:'expected a UUID, or a JSON array of UUIDs such as ["<uuid>","<uuid>"]'}).optional();function xue(e,t){let n=typeof e==="string"?fj(e):[];for(let i of n!==null&&n!==void 0?n:[])if(!Fv.safeParse(i).success)t(`forceLoginOrgUUID entry ${JSON.stringify(i)} is not a UUID and admits no organization`)}hj.ORG_UUID_VALUE=On.z.string().trim().toLowerCase().refine((e)=>Fv.safeParse(e).success,{message:"expected an organization UUID"});var Lue=hj.ORG_UUID_VALUE.optional();hj.AuthenticationConfig=On.z.object({disableClaudeAiSignIn:it.field(On.z.boolean().optional(),{flatKey:"disableDeploymentModeChooser",support:{enabled:{scopes:["3p"],availableInVersion:"1.3834.0"}},remotePolicy:{hybrid:{scope:"excluded"},applyUnverified:!0},failClosedValue:!0,title:ct.msg({defaultMessage:"Disable Claude.ai sign-in",id:"DHdnIxD7G9"}),default:!1,category:"sandbox",group:ua.GENERAL_RESTRICTIONS_GROUP,order:8,description:{short:it.shortDescription(ct.msg({defaultMessage:"Users see only this provider at the login screen. The option to sign in to Claude.ai is hidden.",id:"hesC0E8eFo"}))}}),forceLoginOrgUUID:it.field(jue,{flatKey:"forceLoginOrgUUID",support:{enabled:{scopes:["1p"],availableInVersion:"1.2581.0"}},failClosedValue:"[]",checkDropped:xue,title:ct.msg({defaultMessage:"Required organization",id:"b6/n7wQhfO"}),category:"connection",description:{short:it.shortDescription(ct.msg({defaultMessage:"Restricts login to specific org UUID(s). Single UUID string or JSON array.",id:"Rio+Mmk17s"}))},placeholder:ct.msg({defaultMessage:"00000000-0000-0000-0000-000000000000",id:"oT3AdLMVZK"})}),disableMultiAccount:it.field(On.z.boolean().optional(),{flatKey:"disableMultiAccount",support:{enabled:{scopes:["1p"],availableInVersion:"1.46388.1"},visibility:"public-undocumented"},failClosedValue:!0,title:ct.msg({defaultMessage:"Single account only",id:"kgqT50kiPY"}),default:!1,category:"connection",description:{short:it.shortDescription(ct.msg({defaultMessage:"Keep Claude Desktop signed in to one account at a time.",id:"Q6M73CMjXz"}))}}),ssoOrgDomain:it.field(On.z.string().optional(),{flatKey:"loginSsoOrgDomain",support:{enabled:{scopes:["1p"],availableInVersion:"1.10628.0"}},title:ct.msg({defaultMessage:"SSO login domain",id:"RyA8yzgAlp"}),category:"connection",description:{short:it.shortDescription(ct.msg({defaultMessage:"Surfaces one-click SSO for this email domain on the login screen, without restricting login.",id:"1fy7qkmmCd"}))},placeholder:ct.msg({defaultMessage:"example.com",id:"YKl6sxhgrC"})}),importThirdPartyHistoryIntoOrgUUID:it.field(Lue,{flatKey:"importThirdPartyHistoryIntoOrgUUID",support:{enabled:{scopes:["1p"],availableInVersion:"2.2553.0"},visibility:"public-undocumented"},title:ct.msg({defaultMessage:"Import earlier third-party sessions into this organization",id:"x7AG7nw4s/"}),category:"connection",description:{short:it.shortDescription(ct.msg({defaultMessage:"After sign-in to this organization, copies this computer\u2019s earlier third-party sessions into the user\u2019s local first-party profile, once per account and org.",id:"VVXfXFMXOB"})),long:it.longDescription("Set through your device management (MDM or machine policy) to the UUID of the organization your users sign in to; a value in a user's own configuration file is ignored. After a user signs in to that organization in Claude Desktop on a computer where an earlier third-party configuration of Claude Desktop left chats, Cowork tasks or Code sessions, the app copies them into the user's first-party profile on the same computer; once the user resumes a copied session it behaves like any other first-party session. The copy also uploads the skills the user saved in that third-party configuration (under this organization or none) to their own skills in the organization, only where the organization lets members create skills and scans uploaded skills; otherwise nothing is uploaded. A skill whose SKILL.md declares hooks or tool permissions, or whose folder holds plugin files, is never uploaded. Where that configuration has local MCP servers, the app shows one notification offering to review them in Settings \u203A Import; no server is added without the user's confirmation there. If Anthropic has enabled memory import, that configuration's Cowork memory notes come too, unless the user had paused memory: used at once without review, never overwriting a note, synced like other Cowork memory. Chats, tasks and sessions themselves are not uploaded. The copy runs in the background, once per account and organization, and leaves the originals in place. Without this key, the organization's own setting (Admin settings in claude.ai) decides, and a deployed key takes precedence over it. A value that is not a UUID is reported as a configuration error and copies nothing; one that names a different organization than the one signed in copies nothing and is noted in the app's log. Like other first-party keys, deploying it puts the app's configuration under management, so a third-party connection a user set up in the app's own settings no longer applies. Anthropic can switch the copy off remotely.")},placeholder:ct.msg({defaultMessage:"00000000-0000-0000-0000-000000000000",id:"oT3AdLMVZK"})}),disableDeepLinks:it.field(On.z.boolean().optional(),{flatKey:"disableDeepLinkRegistration",support:{enabled:{scopes:["3p"],availableInVersion:"1.6889.0"}},failClosedValue:!0,title:ct.msg({defaultMessage:"Disable claude:// deep-link handling",id:"CCUxBOb3va"}),default:!1,category:"sandbox",group:ua.GENERAL_RESTRICTIONS_GROUP,order:9,description:{short:it.shortDescription(ct.msg({defaultMessage:"Stop external apps and websites from opening Claude Desktop via claude:// links.",id:"0I38l/TM7C"}))}}),disableConnectorSignInInApp:it.field(On.z.boolean().optional(),{flatKey:"disableConnectorSignInInApp",support:{enabled:{scopes:["1p"],availableInVersion:"2.26454.0"},visibility:"public-undocumented"},failClosedValue:!0,appBehaviorOnly:!0,title:ct.msg({defaultMessage:"Keep connector sign-in in the browser",id:"QjCp+5pd3a"}),default:!1,category:"connectors",description:{short:it.shortDescription(ct.msg({defaultMessage:"Finish claude.ai connector (MCP) sign-ins in the browser rather than letting the app finish them from a claude:// link.",id:"hPVthk75/t"})),long:it.longDescription("When true, a claude.ai connector's (remote MCP server's) OAuth sign-in started from Claude Desktop runs and completes in the system browser, and the claude:// link that then reopens the app only reports the outcome. When false (the default), on accounts where finishing in the app is available (a server-side rollout, not a setting in this configuration), the browser opens only the connector's own sign-in page and the app finishes the sign-in itself. Other claude:// links (chats, projects, Claude Code sessions) are unaffected; in third-party deployments `disableDeepLinkRegistration` turns those off. Set it through device management (MDM or machine policy); it applies from the app's next launch, and a value that cannot be read as true or false counts as true. An app-behavior key like `disableAutoUpdates`: a profile that sets any of them becomes the only source for all of them, so deploy them together; a profile that sets only such keys leaves the rest of the user's configuration in effect.")}}),microsoftAuthBroker:it.field(On.z.enum(["auto","disabled","required"]).optional(),{flatKey:"microsoftAuthBroker",support:{enabled:[{scopes:["3p"],availableInVersion:"1.19367.0"},{scopes:["1p"],availableInVersion:"1.24012.11"}],values:{required:{availableInVersion:"1.49585.0"}}},failClosedValue:"disabled",remotePolicy:{applyUnverified:!0},title:ct.msg({defaultMessage:"Microsoft 365 native sign-in broker",id:"1r8dFJPLbj"}),default:"auto",category:"connectors",group:ua.MCP_SERVERS_GROUP,order:2,predicates:{show:(e)=>{var t,n;return((n=(t=e.mcp)===null||t===void 0?void 0:t.managedServers)!==null&&n!==void 0?n:[]).some((i)=>pm.isBuiltinMcpEntry(i)&&i.server==="microsoft365")}},description:{short:it.shortDescription(ct.msg({defaultMessage:"\u201Cdisabled\u201D forces browser-based Microsoft 365 sign-in; \u201Crequired\u201D fails sign-in when the OS broker is unavailable, so the refresh token stays broker-held.",id:"MicrosoftAuthBrokerHint"})),long:it.longDescription("`auto` (default): use the OS sign-in broker where available (WAM on Windows, the Company Portal SSO extension on macOS) and fall back to a browser sign-in otherwise. `disabled`: always use the browser sign-in. `required`: fail sign-in when the broker is unavailable rather than falling back to the browser, so the refresh token stays broker-held. Linux has no broker, so `required` is not supported there. Desktop builds older than the version that introduced `required` treat it as `disabled` (browser-only sign-in) \u2014 the opposite posture \u2014 so gate rollout on client version.")}}),microsoftAuthDefaultAccount:it.field(On.z.enum(["enabled","disabled"]).optional(),{flatKey:"microsoftAuthDefaultAccount",support:{enabled:{scopes:["3p"],availableInVersion:"2.26454.0"}},failClosedValue:"disabled",title:ct.msg({defaultMessage:"Microsoft 365 sign-in with the Windows account",id:"q3TlGsQ/DF"}),default:"disabled",category:"connectors",group:ua.MCP_SERVERS_GROUP,order:3,predicates:{show:(e)=>{var t,n;return((n=(t=e.mcp)===null||t===void 0?void 0:t.managedServers)!==null&&n!==void 0?n:[]).some((i)=>pm.isBuiltinMcpEntry(i)&&i.server==="microsoft365")}},description:{short:it.shortDescription(ct.msg({defaultMessage:"\u201Cenabled\u201D: when a user clicks Connect on Windows, Microsoft 365 signs in with the work account already signed in to Windows, without the account picker.",id:"ng6kkd2GLe"})),long:it.longDescription("`disabled` (default): Connect shows the account picker when no account is connected. `enabled`: on Windows, when `microsoftAuthBroker` is not `disabled`, Connect first signs in silently with the account Windows already uses. The `tenantId` on the `microsoft365` entry in managed MCP servers must be a tenant GUID. With `common`, `organizations` or `consumers`, users always get the picker. Users also get the picker for accounts from another tenant, guest accounts and personal Microsoft accounts, when the silent sign-in fails, and when the computer cannot store credentials securely. A user who already signed in to Microsoft 365 through the browser keeps that account. After a user disconnects Microsoft 365, or a different person signs in to Claude on this computer, Connect always shows the picker for that connector on this computer, including for a disconnect that happened before this setting was turned on. Turning this setting off stops new silent sign-ins and signs nobody out: users already connected keep their account until they disconnect. macOS and Linux are not affected. Third-party deployments only: first-party installs ignore this setting.")}}),allowOptionalClientAuth:it.field(On.z.boolean().optional(),{flatKey:"allowOptionalClientAuth",support:{enabled:{scopes:["3p"],availableInVersion:"1.17377.1"},visibility:"public-undocumented"},deprecations:[{path:"allowOptionalClientAuth",use:"Claude Desktop 1.49585.0 or later on every device, then remove the key",effect:"the value will be reported as an unreadable setting and the managed configuration will count as degraded until the key is removed; 1.46388 is the last release that reads it (later releases present TLS client certificates natively through Electron 44)",...dj.BATCH_2026_11}],description:{short:it.shortDescription(ct.msg({defaultMessage:"Allow optional client-certificate fallback for mTLS endpoints.",id:"AllowOptionalClientAuthHint"}),{docsOnly:!0})},title:ct.msg({defaultMessage:"Allow optional client-certificate fallback",id:"AllowOptionalClientAuthTitle"}),category:"connection"})})});var Bv=R(function(_j){Object.defineProperty(_j,"__esModule",{value:!0});_j.AppearanceConfig=void 0;var da=fn(),Rn=mt(),Ir=pn(),yj=Ir.msg({defaultMessage:"Deployment identity",id:"dplIdntGrp"}),Uue=Ir.msg({defaultMessage:"Configuration notices",id:"qg0hZsga3q"});_j.AppearanceConfig=da.z.object({deploymentDisplayName:Rn.field(Rn.annotate(da.z.string().trim().min(1).max(60).optional(),{redact:"keep"}),{flatKey:"deploymentDisplayName",support:{enabled:{scopes:["3p"],availableInVersion:"1.24012.0"}},remotePolicy:{hybrid:{derived:!0},hotApplied:!0},title:Ir.msg({defaultMessage:"Deployment display name",id:"dplDsNmTtl"}),category:"appearance",group:yj,description:{short:Rn.shortDescription(Ir.msg({defaultMessage:"Overrides the provider label shown in the sidebar footer, user-menu header, and connection-error banner.",id:"dplDsNmHnt"})),long:Rn.longDescription('Set this to the name users should see for this deployment (for example, "Claude for Government"). When unset, the desktop shows the default provider label. Maximum 60 characters.')}}),deploymentDisplaySubtitle:Rn.field(Rn.annotate(da.z.string().trim().min(1).max(60).optional(),{redact:"keep"}),{flatKey:"deploymentDisplaySubtitle",support:{enabled:{scopes:["3p"],availableInVersion:"1.24012.0"}},remotePolicy:{hybrid:{scope:"excluded"},hotApplied:!0},title:Ir.msg({defaultMessage:"Deployment display subtitle",id:"dplDsSbTtl"}),category:"appearance",group:yj,description:{short:Rn.shortDescription(Ir.msg({defaultMessage:"Optional detail shown after the deployment display name in the account-menu header.",id:"dplDsSbHn2"})),long:Rn.longDescription('Optional detail shown after the deployment display name in the account-menu header (for example, "Claude for Veterans Affairs \xB7 Claude for Government"). Shown only when the display name is also set. Maximum 60 characters.')},predicates:{show:(e)=>{var t,n;return((n=(t=e.appearance)===null||t===void 0?void 0:t.deploymentDisplayName)!==null&&n!==void 0?n:"").trim().length>0}}}),disableConfigDeprecationWarnings:Rn.field(da.z.boolean().optional(),{flatKey:"disableConfigDeprecationWarnings",remotePolicy:{hotApplied:!0},support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.40609.0"}},title:Ir.msg({defaultMessage:"Hide configuration deprecation warnings",id:"8SscF6CJAT"}),default:{displayOnly:!1},category:"appearance",group:Uue,description:{short:Rn.shortDescription(Ir.msg({defaultMessage:"Don\u2019t show users the in-app warning that this configuration uses a deprecated field. The final reminder in the 24 hours before the cut-off still appears.",id:"84H2bDOPZR"})),long:Rn.longDescription("When the organization's configuration uses a field that is deprecated \u2014 a renamed key, or a legacy value or entry form \u2014 the app shows every user a dismissable warning naming the field, what to use instead, and the date support ends (each field's cut-off is listed in the configuration changelog and takes effect at 12:00 PM Pacific Time on that date). The warning shows from the field's announced warning date until dismissed, and once more in the 24 hours before the cut-off. Set this to `true` to suppress the first showing for your users while you migrate; the final 24-hour reminder is always shown, and the deprecation stays listed in the diagnostic report (Help \u2192 Troubleshooting) and the hosted configuration editor regardless.")}})})});var hm=R(function(Oj){Object.defineProperty(Oj,"__esModule",{value:!0});Oj.MAX_BANNER_TEXT_CHARS=Oj.BANNER_DEFAULT_TEXT_COLOR=Oj.BANNER_DEFAULT_BACKGROUND_COLOR=void 0;Oj.isValidBannerHexColor=Hv;Oj.isValidBannerLinkUrl=wj;Oj.resolveBannerConfig=Fu
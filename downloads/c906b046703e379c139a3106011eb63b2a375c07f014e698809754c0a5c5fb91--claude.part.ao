uration does not restate it. Deletion stops at the first configuration fetch that carries this value, before it takes effect as configuration at the next relaunch; a device that cannot reach its configuration server deletes nothing.")}})})});var al=R(function(Xj){Object.defineProperty(Xj,"__esModule",{value:!0});Xj.ManagedConfig=Xj.DISCRIMINATORS=void 0;var vm=fn(),bm=pr(),fs=mt(),jc=pn(),wm=Sr(),Uj=Bv(),zj=pd(),Fj=Iv(),Bj=jj(),Hj=Cv(),Kj=Lv(),Zj=Mv(),Vj=Vv(),qj=Qh(),Gj=Yh(),Wj=Nj(),rr=kc(),Yj=jv(),Jj=fd(),tde=fs.field(vm.z.enum(fs.PROVIDERS).optional(),{flatKey:"inferenceProvider",readers:["desktop","m365","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"},values:{mantle:{availableInVersion:"1.13576.0"}},executionTarget:"desktop"},activatesThirdPartyMode:(e,t)=>t||e.inference!==void 0,title:jc.msg({defaultMessage:"Inference provider",id:"QQpUrtO7kr"}),egressRequirements:(e)=>e==="anthropic"?[bm.ANTHROPIC_API_HOST,bm.PLATFORM_CLAUDE_HOST]:[],egressRequirementsLabel:jc.msg({defaultMessage:"Claude API",id:"Fo2tzWOJzu"}),category:"connection",customRenderer:"providerSelect",description:{short:fs.shortDescription(jc.msg({defaultMessage:"Selects the inference backend. Setting this key activates third-party mode.",id:"aRuqK/KXrl"})),long:fs.longDescription("Setting this key asks for 3P mode. The app opens in 3P mode unless the user chose to sign in to Claude.ai at the login screen, a choice `disableDeploymentModeChooser` removes. In 3P mode, if the selected provider's required credential keys are missing or invalid, the app shows a configuration error. A value the app cannot read (a misspelt, wrongly cased or unknown provider, or a value of the wrong type) still counts as set when machine-wide device management sent it: a macOS configuration profile, Windows policy under `HKLM`, or the root-owned policy file on Linux. The app then asks for 3P mode and, in 3P mode, shows a configuration error whose details name this key. An unreadable `bootstrapUrl` from the same sources counts the same way unless `bootstrapEnabled` is `false`. An unreadable value does not count where the user can write it: the local configuration file, or Windows policy under `HKCU`. Neither does an empty value (a value of only spaces is unreadable, not empty), or a Windows value of type `REG_BINARY`, `REG_MULTI_SZ` or `REG_QWORD`. Each of those reads as not set. When this key is not set, the app launches in standard mode unless another setting asks for 3P mode, such as a `bootstrapUrl` that `bootstrapEnabled` has not turned off. Keys for providers other than the selected one are ignored. Each provider's required keys are documented on its dedicated page under Inference providers.")}});Xj.DISCRIMINATORS={inferenceProvider:{node:tde,nestedPath:["inference","provider"],discriminates:"provider"},inferenceCredentialKind:{node:wm.inferenceCredentialKindField,nestedPath:["inference","credential","kind"],discriminates:"credentialKind"}};Xj.ManagedConfig=vm.z.object({inference:fs.annotate(wm.InferenceConfig.optional(),{gatewayServable:!1}),selfHosted:Gj.SelfHostedConfig.optional(),otlp:rr.OtlpConfig.optional(),dictation:rr.DictationConfig.optional(),tokenLimits:rr.TokenLimitsConfig.optional(),coworkSurface:rr.CoworkSurfaceConfig.optional(),codeSurface:rr.CodeSurfaceConfig.optional(),chatSurface:rr.ChatSurfaceConfig.optional(),sessionRetention:Wj.SessionRetentionConfig.optional(),extensions:rr.ExtensionsConfig.optional(),autoUpdate:rr.AutoUpdateConfig.optional(),featureDiscovery:rr.FeatureDiscoveryConfig.optional(),bootstrap:Fj.BootstrapConfig.optional(),lifecycle:Hj.LifecycleConfig.optional(),models:Zj.ModelsConfig.optional(),plugins:qj.PluginsConfig.optional(),telemetry:Yj.TelemetryConfig.optional(),mcp:Kj.McpConfig.optional(),workspace:Jj.WorkspaceConfig.optional(),builtinBrowser:Bj.BuiltinBrowserConfig.optional(),authentication:zj.AuthenticationConfig.optional(),appearance:Uj.AppearanceConfig.optional(),...Vj.PASSTHROUGH_FIELDS})});var Om=R(function(t
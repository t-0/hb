i.msg({defaultMessage:"https://claude-sessions.example.com",id:"SelfHostedUrlPlaceholder"}),description:{short:kr.shortDescription(bi.msg({defaultMessage:"HTTPS endpoint of the self-hosted session host (beta).",id:"SelfHostedUrlHint"})),long:kr.longDescription("Beta. The app sends its session API to this endpoint with the configured credential, and the block's presence makes the whole install self-hosted: no session runs on the device, though the local MCP servers on it (the person's own and the organization's) still start on the device and serve the host's sessions (built-in and remote servers do not; of a plugin's servers, only the local (stdio) MCP servers of a plugin in the organization plugins directory do, unless a managed server has the same name), an inference provider configured beside it is ignored, and every key that only configures on-device sessions (marked `x-executionTarget: desktop`) stops applying \u2014 that policy belongs to the infrastructure the sessions run on. The credential is the inference credential keys, read for the endpoint instead: `inferenceCredentialKind` (`external-idp` with `inferenceIdpOidc` and `inferenceIdpAuthFlow`; `helper-script` with `inferenceCredentialHelper` and its leaves; `static` with `selfHostedToken`). Must be `https://` (plain `http://` is read only for a loopback host, from device management or the local configuration file; a settings server may not name a loopback host), with no query string or fragment. While essential telemetry is not blocked, crash and error reports from this install can carry a mark that its sessions run off the device, and true-or-false values and counts that describe what this endpoint offers. The app counts its starts and its failures by kind (crashes, errors, and failures to read settings, sign in, connect to local tools or update). It hands the numbers to this endpoint, if it accepts them, with words from a fixed list, the app's version, and the operating system's name, version and processor. The numbers hold no message, name, path, address or ID. The endpoint can tell whose app sent them. It adds totals to its usage report for Anthropic, if you set one up; what it passes on names nobody. Blocking essential telemetry stops the counting.")}}),credential:Lle.optional()}),{remotePolicy:{hybrid:{scope:"excluded"}}})});var Li=R(function(AD){Object.defineProperty(AD,"__esModule",{value:!0});AD.GROUP_DESCRIPTIONS=AD.BUILTIN_BROWSER_GROUP=AD.CODE_SURFACE_GROUP=AD.UPDATES_GROUP=AD.BOOTSTRAP_GROUP=AD.MCP_SERVERS_GROUP=AD.ANTHROPIC_TELEMETRY_GROUP=AD.TOOLS_GROUP=AD.GENERAL_RESTRICTIONS_GROUP=void 0;var Tn=pn();AD.GENERAL_RESTRICTIONS_GROUP=Tn.msg({defaultMessage:"General restrictions",id:"fHh9zisMLR"});AD.TOOLS_GROUP=Tn.msg({defaultMessage:"Tools",id:"nUT0LvZVOx"});AD.ANTHROPIC_TELEMETRY_GROUP=Tn.msg({defaultMessage:"Anthropic telemetry",id:"auYj3lyf1+"});AD.MCP_SERVERS_GROUP=Tn.msg({defaultMessage:"MCP servers",id:"K9q4XwLJd2"});AD.BOOTSTRAP_GROUP=Tn.msg({defaultMessage:"Bootstrap config URL",id:"MPdK0gXvRA"});AD.UPDATES_GROUP=Tn.msg({defaultMessage:"Updates",id:"recCg9im82"});AD.CODE_SURFACE_GROUP=Tn.msg({defaultMessage:"Code surface",id:"NHwL+4YYfH"});AD.BUILTIN_BROWSER_GROUP=Tn.msg({defaultMessage:"Built-in browser",id:"Yx/kiytXbg"});AD.GROUP_DESCRIPTIONS={[AD.GENERAL_RESTRICTIONS_GROUP.id]:Tn.msg({defaultMessage:"These apply regardless of which surfaces are enabled.",id:"kTD7aU+1xd"}),[AD.TOOLS_GROUP.id]:Tn.msg({defaultMessage:"Built-in tool restrictions and on-demand MCP tool loading.",id:"XVYTn+sJ/a"}),[AD.CODE_SURFACE_GROUP.id]:Tn.msg({defaultMessage:"Settings for Code sessions. These apply only while Code is enabled.",id:"R0nTUNCSi6"})}});var Qh=R(function(qD){var pv;Object.defineProperty(qD,"__esModule",{value:!0});qD.PluginsConfig=qD.AllowedPluginMarketplace=qD.marketplaceRepo=qD.marketplaceUrl=qD.marketplaceRef=qD.MARKETPLACE_CREDENTIAL_KINDS=qD.MARKETPLACE_INSTALL_PREFS=void 0;qD.requireHelperForHelperKind=yv;qD.checkAllowedPluginMarketplacesForDro
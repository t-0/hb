Destinations are listed under Egress Requirements \u2192 Nonessential services.`)},predicates:{warn:(e)=>e===!0?Ut.msg({defaultMessage:"This disables connector icons, artifact previews, and MCP Apps widgets. Artifacts will not render in conversations, and connectors that return MCP Apps show the text tool result instead of the widget.",id:"aqHCy/bK6k"}):null}}),usageMetrics:vt.field(jr.z.boolean().optional(),{flatKey:"usageMetricsEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.46388.1"},visibility:"public-undocumented"},remotePolicy:{hybrid:{scope:"only",derived:!0},hotApplied:!0},predicates:{show:()=>!1},title:Ut.msg({defaultMessage:"Report usage metrics to your Claude.ai organization",id:"hFaw5XYgDV"}),category:"telemetry",group:co.ANTHROPIC_TELEMETRY_GROUP,order:3,description:{short:vt.shortDescription(Ut.msg({defaultMessage:"Set by the control plane from the organization\u2019s Claude Code analytics setting; not editable here. Reports per-user token, cost and session counts (no content).",id:"6k4DCNJe7b"})),long:vt.longDescription(`Server-derived: the Claude.ai control plane sets this key, each time it serves the configuration, from the organization's Claude Code analytics setting in Admin settings; it is off until an admin turns that setting on, and off for organizations under HIPAA or customer-managed encryption keys. It is not authored in any form, MDM profile, or bootstrap server, and a value stored anywhere else is ignored.

When on, each signed-in desktop periodically reports usage counters to your Claude.ai organization: per-member **token counts** (input, output, cache read, cache write) by model, the desktop's **cost estimate** for those tokens, and **session counts**, tagged with the member's account, the model name, the app surface (Chat, Cowork or Code), an opaque per-session and per-install identifier, and the app version, operating system and architecture. No prompts, responses, file contents, tool inputs or outputs are included. Sessions and the cost estimate appear in your organization's Claude.ai analytics (Analytics \u2192 Claude Code); the Admin API Claude Code usage report carries those plus per-member, per-model token counts.

This is independent of **Block essential telemetry** and **Block nonessential telemetry**: those govern diagnostics sent to Anthropic, this one populates your own organization's dashboard, and either can be on without the other. Reports go to the same Claude.ai endpoint the desktop fetches its configuration from, so no additional firewall entry is needed. A change takes effect at the next configuration sync without a relaunch.`)}})})});var Z_=v(function(QA){Object.defineProperty(QA,"__esModule",{value:!0});QA.MANAGED_MCP_PRESETS=void 0;QA.isAnthropicM365ConnectorUrl=XA;QA.isAnthropicM365Connector=zte;var Lte="07c030f6-5743-41b7-ba00-0a6e85f37c17",Ute=[".claude.com",".fedstart.com"];function XA(e){if(!e)return!1;if(!Ute.some((t)=>e.hostname.endsWith(t)))return!1;return e.hostname.startsWith("microsoft365.mcp.")||e.pathname.includes("/m365/")}function zte(e){if(!(e===null||e===void 0?void 0:e.url)||e.custom_oauth_client_id)return!1;try{return XA(new URL(e.url))}catch(t){return!1}}QA.MANAGED_MCP_PRESETS=[{label:"Microsoft 365",item:{name:"m365",url:"https://microsoft365.mcp.claude.com/mcp",transport:"http",oauth:{scope:`api://${Lte}/access_as_user offline_access`}}},{label:"Box",item:{name:"box",url:"https://mcp.box.com",transport:"http",oauth:{authorizationServer:["https://api.box.com"]}}},{label:"Microsoft 365",kind:"builtin",item:{name:"Microsoft 365",server:"microsoft365"}},{label:"Web search",kind:"builtin",item:{name:"Web search",server:"websearch",provider:"brave"}},{label:"GitHub",kind:"builtin",item:{name:"GitHub",server:"github"}}]});var B_=v(function(iT){Object.defineProperty(iT,"__esModule",{value:!0});iT.McpConfig=void 0;iT.isMcpPersistentAlwaysAllowEnabled=Kte;var fo=sn(),tT=Ws(),nl=Dn(),Pt=st(),il=En(),zt=ln(),rT=Z_(),ar=pr(),po=so();function Bte(e,t){var r;let i=typeof t.url==="string"?t.url.trim():"",n=t.headers&&typeof t.headers==="object"?t.headers:void 0,o=[],s;try{s=i?new URL(i):void 0}catch(d){}if((s===null||s===void 0?void 0:s.protocol)==="http:"
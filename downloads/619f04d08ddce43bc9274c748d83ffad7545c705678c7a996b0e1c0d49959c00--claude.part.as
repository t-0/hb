("`, `")}\`); other tools take \`Tool(<field>:<pattern>)\`. \`${Bm.join("` and `")}\` are bare-name only: per-host web access is \`coworkEgressAllowedHosts\`.

Scoped \`Bash(\u2026)\` rules apply in Code sessions only; Cowork's shell follows only a bare \`Bash\` entry. Start absolute file paths with \`//\`, not \`/\`: a relative pattern such as \`Read(**/.env)\` covers only a Code session's project folder and none of Cowork's connected folders. Scoped rules need fleet-wide build support (\`disableAutoUpdates\` pins builds): an older build passes a scoped entry to Claude Code unchecked. An entry whose pattern contains \`)\` followed by a space or comma is enforced only through Claude Code's managed-settings channel, so another Claude Code [managed-settings source](${At.COWORK_3P_DOCS_BASE}/code#interaction-with-claude-code%E2%80%99s-own-managed-settings) replaces it unless that source sets \`parentSettingsBehavior\` to \`"merge"\`; every other entry is enforced either way.

An unusable entry (a lowercase tool name, an unbalanced parenthesis, a scoped \`${Bm.join("(\u2026)` or `")}(\u2026)\`) is kept, because the deny list is served exactly as written, and raises a configuration warning.`;nx.BUILTIN_ASK_POLICY_VALUES=["allow","ask"];nx.BUILTIN_TOOL_POLICY_ASK_SESSION={path:'builtinToolPolicy: "ask-session"',use:'"ask"',effect:'the entry will be read as "ask" (approval on every call), like any unrecognized value',...Ea.BATCH_2026_09,match:(e)=>typeof e==="object"&&e!==null&&!Array.isArray(e)&&Object.values(e).some((t)=>t==="ask-session"),rewrite:(e)=>Object.fromEntries(Object.entries(e).map(([t,n])=>[t,n==="ask-session"?"ask":n]))};function Yj(e,t){var n;let s=Ea.applyLegacy(nx.BUILTIN_TOOL_POLICY_ASK_SESSION,e);if(!s||typeof s!=="object")return;for(let[r,a]of Object.entries(s)){let l=bl(r);if(l!==r)t(`builtinToolPolicy["${r}"]: "${r.slice(l.length)}" means every call; applied as the bare name "${l}"`,"clamp");if(Tw(l)===void 0)t(`builtinToolPolicy["${r}"] dropped: ${(n=Wj(r))!==null&&n!==void 0?n:"unknown built-in tool"}`,"drop");else if(a==="blocked")t(`builtinToolPolicy["${r}"]: "blocked" is not a built-in tool policy; treated as "ask" (use disabledBuiltinTools to remove the tool)`,"drop");else if(a!=="allow"&&a!=="ask")t(`builtinToolPolicy["${r}"]: unrecognized policy ${JSON.stringify(a)}; treated as "ask"`,"drop")}}function Jj(e,t){if(!Array.isArray(e))return;e.forEach((n,s)=>{if(typeof n!=="string"){t(`disabledBuiltinTools[${s}] dropped: entries must be strings (got ${n===null?"null":Array.isArray(n)?"array":typeof n})`,"drop");return}let r=bl(n);if(r!==n)t(`disabledBuiltinTools entry ${JSON.stringify(n)}: "${n.slice(r.length)}" means every call; applied as the bare name "${r}"`,"clamp")})}function Bde(e,t){return t.flatMap((n)=>{let s=Wj(n);return s===void 0?[]:[`${e} entry ${JSON.stringify(n)} is not enforced as written: ${s}`]})}function Xj(e,t){if(!Array.isArray(e))return;for(let n of e)if(typeof n!=="string"||ks.parseEgressHostEntry(n)===null)t(`coworkEgressAllowedHosts entry ${JSON.stringify(n)} dropped: must be ${ks.EGRESS_ENTRY_GRAMMAR}`)}nx.WorkspaceConfig=ze.z.object({disabledBuiltinTools:G.field(ze.z.preprocess((e)=>Array.isArray(e)?[...new Set(e.filter((t)=>typeof t==="string").map(bl))]:e,G.annotate(ze.z.array(ze.z.string()),{maxItems:100})).optional(),{flatKey:"disabledBuiltinTools",readers:["desktop","code"],failClosedValue:[...nx.BUILTIN_TOOL_NAMES],checkDropped:Jj,support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.2581.0"},executionTarget:"desktop"},title:J.msg({defaultMessage:"Disabled built-in tools",id:"iGPHC9Tm20"}),category:"sandbox",group:Xt.TOOLS_GROUP,order:4,customRenderer:"builtinToolRules",placeholder:J.msg({defaultMessage:"WebSearch or Bash(curl *)",id:"KHWonN3qfv"}),description:{short:G.shortDescription(J.msg({defaultMessage:"Built-in tools, or argument-scoped permission rules such as Read(//**/.env), denied in Cowork and Code.",id:"kMVrXfFbvZ"})),long:G.longDescription(Fde)},predicates:{locked:[{when:(e)=>{var t;return Zm.isBedrockFamily((t=e.inference)===null||t===void 0?void 0:t.provider)},append:["WebSearch"]}]}}),disableBundledSkills:G.field(ze.z.boolean().optional(),{flatKey:"disableBundledSkills",readers:["desktop","code"],support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.15962.0"},executionTarget:"desktop"},failClosedValue:!0,title:J.msg({defaultMessage:"Disable bundled skills and workflows",id:"kpCOjtwfPF"}),category:"sandbox",group:Xt.GENERAL_RESTRICTIONS_GROUP,order:6,description:{short:G.shortDescription(J.msg({defaultMessage:"Disables Claude Code\u2019s bundled skills and workflows (deep-research and similar). Use where WebFetch/WebSearch aren\u2019t available.",id:"Q90IY9SGu1"}))}}),skillCreationEnabled:G.field(ze.z.boolean().optional(),{flatKey:"skillCreationEnabled",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.25927.0"}},title:J.msg({defaultMessage:"Allow user-created skills",id:"y486fMBVj/"}),default:{displayOnly:!0},failClosedValue:!1,category:"sandbox",group:Xt.GENERAL_RESTRICTIONS_GROUP,order:6.5,description:{short:G.shortDescription(J.msg({defaultMessage:"Allow users to create and upload their own skills. When off, the creation and upload surfaces are hidden and the agent\u2019s skill-creation tools are disabled.",id:"Cpqtiix6lD"})),long:G.longDescription("When on (default), users can create new skills and upload skill files in the app. Set to `false` to block user skill creation: the skill-creation and upload surfaces are hidden (the `skill_creation` feature is served as blocked by the organization), and the agent's skill-creation tools (saving skills from a conversation, skill proposals) are not offered in sessions \u2014 the same effect as turning off the **User-created skills** organization setting available to claude.ai enterprise admins.\n\nThis is a feature-availability control enforced in the app's UI, not a data boundary: skills are files on the user's machine, and files already present there (or placed there outside the app) are not removed or blocked by this key. Skills themselves remain usable; organization-distributed plugins and bundled skills are unaffected (to disable bundled skills, use `disableBundledSkills`).",{docsUrl:`${At.COWORK_3P_DOCS_BASE}/configuration#skillcreationenabled`})}}),scheduledTasksEnabled:G.field(ze.z.boolean().optional(),{flatKey:"scheduledTasksEnabled",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"2.110.0"}},title:J.msg({defaultMessage:"Allow scheduled tasks",id:"scheduledTasksEnabledTitle"}),default:{displayOnly:!0},failClosedValue:!1,category:"sandbox",group:Xt.GENERAL_RESTRICTIONS_GROUP,order:6.8,description:{short:G.shortDescription(J.msg({defaultMessage:"Allow scheduled tasks in Cowork and Code. When off, the Scheduled page is hidden, existing tasks stop running, and Claude cannot create new ones.",id:"scheduledTasksEnabledShort"})),long:G.longDescription("When on (default), users can schedule Cowork tasks and Code sessions to run later or on a recurring schedule, and Claude can create such schedules when asked.\n\nSet to `false` to turn scheduled tasks off for every user. The Scheduled section in Cowork and the routines list in the Code tab are hidden, together with every other place a schedule can be created. Tasks that already exist on a device no longer run; they are kept, not deleted, and run again once the key is removed or set to `true`. Claude is not offered the tools that create, change or run these tasks, and sessions start without Claude Code's own in-session scheduling tools (the `/loop` command, its cron tools and its wake-up timer).\n\nIt does not remove task files already on the user's machine. A change takes effect at the next app launch.",{docsUrl:`${At.COWORK_3P_DOCS_BASE}/configuration#scheduledtasksenabled`})}}),keepAwakeEnabled:G.field(ze.z.boolean().optional(),{flatKey:"keepAwakeEnabled",remotePolicy:{hotApplied:!0},support:{enabled:{scopes:["3p"],availableInVersion:"2.7032.0"}},title:J.msg({defaultMessage:"Allow keep awake",id:"keepAwakeEnabledTitle"}),default:{displayOnly:!0},failClosedValue:!1,category:"sandbox",group:Xt.GENERAL_RESTRICTIONS_GROUP,order:6.9,description:{short:G.shortDescription(J.msg({defaultMessage:"Let Claude keep the computer awake. When off, Claude never prevents sleep and hides the keep-awake switches in Settings, the Scheduled page and the Code tab.",id:"keepAwakeEnabledShort"})),long:G.longDescription("When on (default), users can turn on **Keep computer awake** (Settings \u2192 This computer \u2192 System, also shown as **Keep awake** on the Scheduled page in Cowork and the Routines page in Code) so the computer does not idle-sleep while Claude is open and scheduled tasks keep running on an idle machine. The Code tab can also keep the computer awake while a session is working (**Keep computer awake while Claude works** in Settings \u2192 Claude Code, and a session's **Keep computer awake** menu item).\n\nSet to `false` to make sure Claude never prevents the computer from sleeping: those switches are hidden and no part of the app keeps the computer awake. Users' saved choices are kept but ignored, and apply again once the key is removed or set to `true`. Scheduled tasks are unaffected and still run only while the computer is awake and the app is open.\n\nA change takes effect on a running app.",{docsUrl:`${At.COWORK_3P_DOCS_BASE}/configuration#keepawakeenabled`})}}),builtinToolPolicy:G.field(G.annotate(ze.z.preprocess((e)=>{let t=Ea.applyLegacy(nx.BUILTIN_TOOL_POLICY_ASK_SESSION,e);return t&&typeof t==="object"&&!Array.isArray(t)?Object.entries(t).filter(([n])=>Tw(bl(n))!==void 0).reduce((n,[s,r])=>{let a=bl(s),l=r==="allow"?"allow":"ask";return n[a]=n[a]==="ask"?"ask":l,n},{}):t},ze.z.record(ze.z.string().regex(Kj),ze.z.enum(nx.BUILTIN_ASK_POLICY_VALUES))).optional(),{redact:"toolRules"}),{flatKey:"builtinToolPolicy",readers:["desktop","code"],support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.8089.0"},values:{"ask-session":{availableInVersion:"1.40609.0"}}},title:J.msg({defaultMessage:"Built-in tool policy",id:"hhKxQ3MtxT"}),failClosedValue:Object.fromEntries(nx.BUILTIN_TOOL_NAMES.map((e)=>[e,"ask"])),deprecations:[nx.BUILTIN_TOOL_POLICY_ASK_SESSION],checkDropped:Yj,category:"sandbox",group:Xt.TOOLS_GROUP,order:3,customRenderer:"builtinToolRules",placeholder:J.msg({defaultMessage:"WebFetch or Bash(curl *)",id:"tQLBe0W6Km"}),addLabel:J.msg({defaultMessage:"Add policy",id:"6TgDeF8iRs"}),description:{short:G.shortDescription(J.msg({defaultMessage:"Approval policy per built-in tool or argument-scoped rule such as Bash(curl *). \u201Cask\u201D requires user approval before each matching call; \u201Callow\u201D is the default.",id:"H4Ea6XAuEf"})),long:G.longDescription("Keys use the same tool names and argument-scoped rule syntax as **Disabled built-in tools** (`disabledBuiltinTools`), and scopes apply in the same sessions. A bare `Bash` key also governs Claude Code's `PowerShell` tool (its shell on Windows PCs without Git for Windows); argument-scoped `Bash(\u2026)` keys do not. Scoped **ask** rules reach sessions only through Claude Code's managed-settings channel, so another Claude Code managed-settings source replaces them unless it sets `parentSettingsBehavior` to `\"merge\"` (bare names hold either way). They need the same fleet-wide build support, and an older build drops a scoped **ask** entry as a configuration error (which also blocks WSL sessions on Windows until that client updates), so the tool runs unprompted.\n\nAn **ask** entry, bare or scoped, also turns off the app's remembered \u201Calways allow\u201D choices for that tool, so each prompted call is confirmed individually. **ask** on a file tool (`Read`, `Write`, `Edit`, `Glob`, `Grep`) prompts in Cowork, Chat and Code sessions. Calls that Cowork and Chat always refuse are still refused without a prompt: paths outside the session's connected folders (in Chat, outside its scratch directory and its project's folders) and protected or sensitive files inside them. A scheduled task in Cowork waits at the prompt, which appears in the task's session and, when that session is not in view, as a desktop notification. Code side chats cannot prompt, so they block matching calls. An unusable entry is dropped and recorded as a configuration error; a value other than `allow` or `ask` is treated as `ask` and reported. To remove a tool or deny a rule outright, use **Disabled built-in tools** instead.")}}),autoModeEnabled:G.field(ze.z.boolean().optional(),{flatKey:"autoModeEnabled",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.10628.0"}},title:J.msg({defaultMessage:"Allow Auto mode",id:"0QsHlMb8HD"}),default:{displayOnly:!0},failClosedValue:!1,category:"sandbox",group:Xt.GENERAL_RESTRICTIONS_GROUP,order:5,description:{short:G.shortDescription(J.msg({defaultMessage:"Offer Auto mode in the Code permission selector (on unless set to false); set to true to also offer it in Cowork. Claude decides which actions need approval.",id:"94/7dcRsyP"})),long:G.longDescription(`Left unset, users can select **Auto mode** in Code and new Code sessions start in it; a mode the user already chose, or a Claude Code settings file's \`permissions.defaultMode\`, takes precedence, and Cowork does not offer it. Set to \`true\` to also offer **Automatically approve** in Cowork (Cowork sessions still start by asking before each action until the user picks it). Set to \`false\` to remove the option from both tabs. In Auto mode Claude runs a safety classifier on each action and only prompts for approval on actions it judges risky, instead of following the static per-tool policy.

Requires a model that supports the safety classifier \u2014 which models qualify depends on the deployment's provider and the app version. With a model that lacks support the option is greyed out and Code sessions do not start in it. \`builtinToolPolicy\` and this key may both be set; Auto mode is a user-selectable option alongside the default policy, not a replacement for it.

In Code sessions, a separately deployed Claude Code [managed-settings](${At.COWORK_3P_DOCS_BASE}/code#interaction-with-claude-code%E2%80%99s-own-managed-settings) file that sets \`disableAutoMode\` to \`"disable"\` also keeps Auto mode hidden and off, whatever this key says.`,{docsUrl:`${At.COWORK_3P_DOCS_BASE}/configuration#automodeenabled`})}}),disableBypassPermissionsMode:G.field(ze.z.boolean().optional(),{flatKey:"disableBypassPermissionsMode",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.46388.1"}},title:J.msg({defaultMessage:"Disable bypass permissions mode",id:"CIeOvXouGu"}),default:{displayOnly:!1},failClosedValue:!0,category:"sandbox",group:Xt.GENERAL_RESTRICTIONS_GROUP,order:5.5,description:{short:G.shortDescription(J.msg({defaultMessage:"Remove the bypass permissions mode from Code sessions and Cowork tasks, so Claude always follows the permission policy. Off by default.",id:"eXwx/L4TgM"})),long:G.longDescription(`When set to \`true\`, sessions cannot run in bypass permissions mode: the app stops offering the mode in Code and Cowork, and a session that requests it anyway is downgraded. This is the \`disableBypassPermissionsMode\` setting from the \`permissions\` section of Claude Code's [managed settings](${At.COWORK_3P_DOCS_BASE}/code#interaction-with-claude-code%E2%80%99s-own-managed-settings); a separately deployed Claude Code managed-settings file that sets it to \`"disable"\` also removes the mode, whichever source sets it.

Unset (default): users the deployment otherwise allows can choose bypass permissions mode.`,{docsUrl:`${At.COWORK_3P_DOCS_BASE}/configuration#disablebypasspermissionsmode`})}}),toolSearchEnabled:G.field(ze.z.boolean().optional(),{flatKey:"toolSearchEnabled",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.21459.0"},executionTarget:"desktop"},title:J.msg({defaultMessage:"Enable tool search",id:"3b6nGnLx6b"}),default:!1,category:"sandbox",group:Xt.TOOLS_GROUP,order:5,description:{short:G.shortDescription(J.msg({defaultMessage:"Load MCP tool schemas on demand (tool search) instead of inlining every schema into context.",id:"jPPLehrZ3d"})),long:G.longDescription("When enabled, Cowork, Code, and Chat sessions place only tool names in context up front, and Claude fetches a tool's full schema the first time it needs it. Use this when many MCP tools are configured and their inlined schemas crowd out the context window. If your endpoint does not accept the request shape it then receives, requests fail with HTTP 400.\n\n- **Claude API, Vertex AI, Bedrock, or Bedrock Mantle with no custom base URL**: not needed. The app leaves Claude Code's experimental betas on there, as terminal Claude Code does, so tool search is on by default (on Vertex AI, for Claude 4.5 and newer models). To turn it off in Code, Cowork, and Chat, set `ENABLE_TOOL_SEARCH` to `false` in the `env` block of OS-level Claude Code managed settings (with `parentSettingsBehavior: \"merge\"`). Earlier app versions treat these like the last case.\n- **Gateway provider, app versions bundling Claude Code 2.1.247 or later**: requests add only the tool-search shape (the `tool-search-tool-2025-10-19` `anthropic-beta` value, deferred tool loading, `tool_reference` content blocks); every other experimental Claude Code beta stays suppressed. OS-level Claude Code managed settings that keep that suppression or turn `ENABLE_TOOL_SEARCH` off still win; set `ENABLE_TOOL_SEARCH` to `force` there instead (with `parentSettingsBehavior: \"merge\"`). Sessions the app runs in Claude Code's gateway mode (an opt-in for users on the gateway's own sign-in) get its gateway-safe tool-search shape instead.\n- **Foundry, a custom base URL, and earlier app versions**: the app suppresses Claude Code's experimental betas for the session and the key lifts that, so requests carry the tool-search shape together with Claude Code's other experimental betas for that provider. On Vertex with app versions bundling Claude Code older than 2.1.221, leave this unset while any model older than Claude 4.5 is in use; those engines send the header regardless of model and Vertex's pre-4.5 stacks reject it.",{docsUrl:`${At.COWORK_3P_DOCS_BASE}/gateway#mcp-tool-search`})}}),skipWebFetchPreflight:G.field(ze.z.boolean().optional(),{flatKey:"skipWebFetchPreflight",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.37937.0"},executionTarget:"desktop"},title:J.msg({defaultMessage:"Skip WebFetch domain check",id:"N2lNsOXNuF"}),default:{displayOnly:!1},category:"sandbox",group:Xt.GENERAL_RESTRICTIONS_GROUP,order:11,egressRequirements:(e,t)=>{var n;return e===!0||((n=t.codeSurface)===null||n===void 0?void 0:n.enabled)===!1?[]:[ks.ANTHROPIC_API_HOST]},egressRequirementsLabel:J.msg({defaultMessage:"WebFetch domain check",id:"nZmPQiUhiY"}),description:{short:G.shortDescription(J.msg({defaultMessage:"Skip Claude Code\u2019s WebFetch domain lookup against api.anthropic.com in Code sessions. Off by default; turn on when that host is blocked.",id:"3dSlpHs3f5"})),long:G.longDescription(`Before fetching a page, Claude Code's WebFetch tool asks \`api.anthropic.com\` whether the domain is on Anthropic's content blocklist, and refuses the fetch if that lookup cannot complete. Third-party deployments route inference elsewhere and often block \`api.anthropic.com\` at the firewall; with the lookup on, every WebFetch in Code sessions then fails with "Unable to verify if domain \u2026 is safe to fetch", and where the host is reachable, every fetched hostname is sent to Anthropic. (Cowork sessions fetch through the app's own allowlisted fetch and never run this lookup.)

Off (default): the lookup runs as it does today, so \`api.anthropic.com\` must be reachable from users' machines for Code-session WebFetch to work (listed under Egress Requirements). Set to \`true\` when users' machines cannot reach \`api.anthropic.com\` (corporate firewall, government network) or you do not want fetched hostnames sent there: Code sessions then fetch without the lookup and never contact that host for it. This is the same \`skipWebFetchPreflight\` setting Claude Code reads from its own [managed-settings](${At.COWORK_3P_DOCS_BASE}/code#interaction-with-claude-code%E2%80%99s-own-managed-settings) file; the app passes it to every session it starts. To restrict which domains Claude may fetch, use \`coworkEgressAllowedHosts\` or \`builtinToolPolicy\` instead.`)}}),allowedFolders:G.field(G.annotate(G.annotate(ze.z.array(ze.z.union([ze.z.string().min(1),Mde])),{maxItems:200}).transform((e)=>e.map((t)=>typeof t==="string"?{path:t}:t)).optional(),{pathKind:"folder"}),{flatKey:"allowedWorkspaceFolders",readers:["desktop","code"],support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.2581.0"}},title:J.msg({defaultMessage:"Allowed workspace folders",id:"y3gym+4SMI"}),failClosedValue:[],emptyListIsAuthored:!0,category:"sandbox",group:Xt.GENERAL_RESTRICTIONS_GROUP,order:2,addLabel:J.msg({defaultMessage:"Add folder",id:"kjqTjJbwtK"}),description:{short:G.shortDescription(J.msg({defaultMessage:"Folders where Claude may work. Applies to Cowork and Code sessions and to the project folders a chat reads. Leave unset for unrestricted access.",id:"5BMPzic821"})),long:G.longDescription('Paths can reference `~` and these environment variables, expanded per user: `%OneDrive%`, `%OneDriveCommercial%`, `%OneDriveConsumer%`, `%APPDATA%`, `%LOCALAPPDATA%`, `%USERNAME%`, `%XDG_DOCUMENTS_DIR%`. The set is fixed; an entry that references any other `%VAR%`, or one that is unset on the device, is ignored.\n\nEach folder is interpreted on the machine the session runs on. For a Code session on an SSH host, `~` means the remote user\'s home, an entry that references a `%VAR%` is ignored there (environment variables belong to the machine that defines them), and the session\'s working directory must fall inside one of the folders as they exist on that host. One list serves every machine: `["~/work", "/srv/work"]` governs `~/work` for each user, on a managed Mac or a Linux host, and `/srv/work` on a host that has it. A folder that names nothing real on a given machine simply allows nothing there. An empty list allows no folder at all; unset leaves access unrestricted.\n\nA listed folder is one Claude may write as well as read, unless the entry\'s `mode` (Access mode in Setup) makes it read-only; that field\'s own description says how far read-only reaches. A Code session can reach every listed folder, not only the one it was opened in. Setting this key also turns on Claude Code\'s sandbox where it runs (macOS, or Linux and SSH hosts with bubblewrap): there a shell command normally writes in the listed folders without an approval prompt, and its writes to most other places, such as a package cache in the home directory, are refused. A home directory holds shell start-up files and SSH keys, so list work folders, not a whole home directory.\n\nThe list also limits which folders of a project a chat reads.',{docsUrl:`${At.COWORK_3P_DOCS_BASE}/configuration#allowedworkspacefolders`})}}),blockReadsOutsideWorkingDirectories:G.field(ze.z.boolean().optional(),{flatKey:"blockReadsOutsideWorkingDirectories",readers:["desktop","code"],support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.46388.1"},executionTarget:"desktop"},failClosedValue:!0,title:J.msg({defaultMessage:"Block reads outside working directories",id:"GQrrmfzD4R"}),default:{displayOnly:!1},category:"sandbox",group:Xt.GENERAL_RESTRICTIONS_GROUP,order:2.5,description:{short:G.shortDescription(J.msg({defaultMessage:"Keep Claude from reading files outside a Code session\u2019s working directories. File tools refuse such reads; sandboxed shell commands lose the home directory.",id:"vSpvldmS33"})),long:G.longDescription(`When set to \`true\`, Code sessions refuse reads outside their working directories (the session folder plus any \`allowedWorkspaceFolders\`). The file tools (Read, Grep, Glob) refuse them in every permission mode; where Claude Code's sandbox runs (macOS, or Linux and SSH hosts with bubblewrap, once \`allowedWorkspaceFolders\` is set or an egress allowlist applies: in third-party deployments one applies unless \`coworkEgressAllowedHosts\` contains \`*\`, in first-party deployments none does) shell commands cannot see the home directory and other user folders (\`/Users\`, \`/home\`, mounted volumes) and a read there is refused with no prompt; elsewhere (Windows, Linux without bubblewrap, or neither folders nor an egress allowlist in effect) such shell reads prompt for approval. The app keeps the user's git configuration files (which may themselves embed credentials such as URL tokens; a symlinked one stays hidden), its own Claude Code installation, and the session's plugin and attachment folders readable (not on a Windows SSH host, where plugin files and attachments stay out of the file tools' reach under the block). An allowed folder that is or contains the home directory leaves it readable.

Users can re-open folders (even their whole home) in their own Claude Code settings with \`sandbox.filesystem.allowRead\` or \`permissions.additionalDirectories\`; settings files tracked in a git repository cannot. The key travels on Claude Code's managed-settings channel: another Claude Code managed-settings source replaces it unless that source sets \`parentSettingsBehavior\` to \`"merge"\`, and one that sets \`sandbox.filesystem.allowManagedReadPathsOnly\` reduces it to approval prompts. This is \`permissions.blockReadsOutsideWorkingDirectories\` in Claude Code's [managed settings](${At.COWORK_3P_DOCS_BASE}/code#interaction-with-claude-code%E2%80%99s-own-managed-settings).

Unset (default): nothing changes.`,{docsUrl:`${At.COWORK_3P_DOCS_BASE}/configuration#blockreadsoutsideworkingdirectories`})}}),disableWslSessions:G.field(ze.z.boolean().optional(),{flatKey:"disableWslSessions",remotePolicy:{hotApplied:!0},support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.19367.0"},visibility:"public-undocumented",executionTarget:"desktop"},appBehaviorOnly:!0,title:J.msg({defaultMessage:"Block WSL sessions",id:"DpHm4YbvWC"}),category:"sandbox",group:Xt.CODE_SURFACE_GROUP,order:15,predicates:{show:(e)=>{var t;return((t=e.codeSurface)===null||t===void 0?void 0:t.enabled)!==!1}},description:{short:G.shortDescription(J.msg({defaultMessage:"Block Code sessions that run inside a WSL distro. Windows endpoint policy does not reach inside WSL.",id:"722/v6Am9J"})),long:G.longDescription("Sessions started inside a WSL distro run Claude Code where Windows host endpoint policy (this managed configuration, and Claude Code's own managed-settings.json) does not apply. On a device with any managed configuration present, WSL sessions are blocked unless this key is explicitly set to `false`. Set to `true` to block WSL sessions unconditionally; set to `false` to allow them on managed devices; leave unset to block whenever the device is managed.\n\nThis key is honored only when deployed through machine-scoped management \u2014 MDM on macOS, the HKLM policy hive on Windows, the root-owned `/etc` file on Linux \u2014 never via the in-app Setup panel or user-writable stores; in particular, an explicit `false` written to the user-writable HKCU hive is ignored (and its presence still marks the device as managed). Because the key is grouped with the other app-behavior keys, deploying it claims that whole group: the auto-update keys (`disableAutoUpdates`, `autoUpdaterEnforcementHours`, \u2026) are then resolved from the managed tier alone, and any local- or remote-tier values for them stop applying.")}}),claudeCodeProcessWrapperEnabled:G.field(ze.z.boolean().optional(),{flatKey:"claudeCodeProcessWrapperEnabled",support:{enabled:[{scopes:["3p"],availableInVersion:"2.7032.0"},{scopes:["1p"],availableInVersion:"2.16120.0"}],visibility:"public-undocumented",executionTarget:"desktop"},remotePolicy:{hotApplied:!0},appBehaviorOnly:!0,title:J.msg({defaultMessage:"Use Claude Code\u2019s corporate launcher",id:"ClaudeCodeProcessWrapperEnabledTitle"}),default:{displayOnly:!1},failClosedValue:!0,category:"sandbox",group:Xt.CODE_SURFACE_GROUP,order:15.5,predicates:{show:(e)=>{var t;return((t=e.codeSurface)===null||t===void 0?void 0:t.enabled)!==!1}},description:{short:G.shortDescription(J.msg({defaultMessage:"Start Claude Code through the launcher in Claude Code\u2019s managed settings (processWrapper) \u2014 this device\u2019s, and an SSH host\u2019s for SSH sessions. Off by default.",id:"ClaudeCodeProcessWrapperEnabledHint"})),long:G.longDescription("When `true` and Claude Code's managed settings name a corporate launcher in `processWrapper` or `env.CLAUDE_CODE_PROCESS_WRAPPER`, the Code tab starts the app's Claude Code through it: on this device (managed-settings file or MDM profile, never server-managed), and, for an SSH session, through the one in the host's managed-settings files (`/etc/claude-code`; `/Library/Application Support/ClaudeCode` on macOS). Either way it is handed none of the app's inference credential (claude.ai sign-in, provider key, token, auth header or credential file) and reads no stored login or ambient cloud credential of this device (over SSH, the host account's own environment still applies); the launcher must put one in its environment \u2014 `ANTHROPIC_BASE_URL` with `ANTHROPIC_AUTH_TOKEN` or `ANTHROPIC_API_KEY`, or, for the Bedrock, Vertex or Foundry routing the app leaves set (`CLAUDE_CODE_USE_*`; override to switch), that provider's keys or credential file \u2014 or the start fails; it makes no non-essential Anthropic calls. The third-party connection test and title generation start directly. An unusable launcher, an unreadable host settings file or another Claude Code version refuses or ends the session with an error. Device launcher: macOS and Linux (ignored on Windows); SSH hosts: Linux or macOS, from any device; never WSL or Cowork; both deployment modes.\n\nUnset or `false` (default): the app never reads that setting and starts Claude Code directly, with its own credential. A change applies at the next Claude Code start on third party (a served value once fetched) and at the next app launch on a claude.ai install (profile or local configuration file).\n\nThe key is in the app-behavior group (`disableAutoUpdates`, \u2026): a profile that sets any group key is the only source read for all of them \u2014 set it in the profile, with every group key you need, when the profile sets any of them or the launcher must hold against the device's own user; else in the admin console or configuration server.")}}),relocateUncUserData:G.field(ze.z.boolean().optional(),{flatKey:"relocateUncUserData",support:{enabled:{scopes:["1p"],availableInVersion:"1.32352.0"}},appBehaviorOnly:!0,title:J.msg({defaultMessage:"Move app data off network shares",id:"hnH9BhZfMz"}),category:"sandbox",group:Xt.GENERAL_RESTRICTIONS_GROUP,order:7.5,description:{short:G.shortDescription(J.msg({defaultMessage:"Store app data in local AppData on Windows devices where Roaming AppData is redirected to a network share, which Cowork tasks cannot run from.",id:"3SHQ+DxHRI"})),long:G.longDescription("AD Folder Redirection can point %APPDATA% at a network (UNC) share, where Cowork tasks fail to start. The sandbox cannot mount a network path. With this key set to `true`, the app stores its data in a product-specific `<ProductName>-Data` folder under %LOCALAPPDATA% on such devices instead. The key only takes effect when %APPDATA% actually resolves to a UNC path, so it is a no-op on devices with a local profile and does not move a healthy install.\n\nBecause the key is grouped with the other app-behavior keys, deploying it claims that whole group: the auto-update keys (`disableAutoUpdates`, `autoUpdaterEnforcementHours`, \u2026) are then resolved from the managed tier alone, and any local- or remote-tier values for them stop applying. Deploy it together with any auto-update keys you rely on in the same managed (MDM / HKLM `Policies\\Claude`) tier.\n\nThe relocation is a fresh start, not a move: nothing is carried over from the share. The new local folder begins empty, so users sign in again and re-enter their settings, preferences, and MCP server configuration after the move. Nothing is deleted from the share either; removing the key returns the app to the share with its previous contents (including the previous sign-in state) intact, so the rollback path keeps working.")}}),allowedEgressHosts:G.field(G.annotate(ze.z.preprocess((e)=>Array.isArray(e)?e.filter((t)=>typeof t==="string"&&ks.parseEgressHostEntry(t)!==null):e,G.annotate(ze.z.array(ze.z.string().min(1)),{maxItems:500}).optional()),{glob:!0}),{checkDropped:Xj,flatKey:"coworkEgressAllowedHosts",readers:["desktop","code"],failClosedValue:[],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"},executionTarget:"desktop"},title:J.msg({defaultMessage:"Allowed egress hosts",id:"5oTa1gWQsk"}),egressRequirements:(e)=>!Array.isArray(e)?[]:e.includes("*")?ks.DEPENDENCY_INSTALL_DOMAINS:e,egressRequirementsLabel:J.msg({defaultMessage:"Tool egress (Cowork, Code and Chat)",id:"pcNPpyq4F7"}),category:"sandbox",group:Xt.GENERAL_RESTRICTIONS_GROUP,order:1,placeholder:At.HOST_LIST_PLACEHOLDER,description:{short:G.shortDescription(J.msg({defaultMessage:"Hostnames the agent\u2019s tools may reach from Cowork, Code and Chat. Also surfaced under Egress Requirements.",id:"JNR06VQqQI"})),long:G.longDescription(`Applies only to **tool calls**, in Cowork, Code and Chat. In Cowork it covers the sandbox's web fetch, shell commands and package installs. In Chat it covers web fetch, and the file-analysis sandbox only if you open its network. In Code it's [translated into Claude Code's network sandbox allowlist](${At.COWORK_3P_DOCS_BASE}/code#applied-as-managed-policy), and by default a separately deployed Claude Code managed-settings file takes precedence. It does **not** cover Web Search (which runs at your inference provider), inference, or MCP traffic. A list other than \`*\` also bounds where Claude may browse in the built-in browser. When unset, only the inference endpoint is reachable from the sandbox, so the agent's package installs and web fetches fail with a 403.

Entries are exact hostnames (\`api.github.com\`), wildcards (\`*.corp.com\` matches subdomains at any depth, not \`corp.com\` itself), or \`*\` to allow all. IP addresses match only when listed exactly. Web fetch always blocks \`localhost\` and private-network addresses. Shell commands and package installs run in a network sandbox that can reach only the listed hosts plus, outside Chat, your inference provider. With \`*\`, that sandbox is disabled and web fetch still blocks private addresses.

Any entry except bare \`*\` may carry a \`:port\` suffix (\`*.corp.com:8443\`) restricting it to that port. IPv6 literals are not supported. Invalid entries are dropped with a log warning and the rest still work. An unreadable value counts as an empty list. Ports are enforced for the Cowork sandbox's web fetch, shell, and package-install egress; plugin CLIs ignore port-scoped entries for now, and the Code translation treats them as the bare host. Only deploy port-scoped entries once your whole fleet supports them (\`disableAutoUpdates\` pins builds). On an older build, a single one invalidates the session's whole shell and package-install allowlist.

Open listed hosts on your network firewall too.`,{docsUrl:`${At.COWORK_3P_DOCS_BASE}/web-tools#web-fetch`})}}),egressProxyUrl:G.field(G.annotate(Ss.urlSchema({allowHttp:!0}).optional(),{redact:"hostname"}),{flatKey:"egressProxyUrl",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.44121.1"}},appBehaviorOnly:!0,remotePolicy:{type:"remote-disabled"},title:J.msg({defaultMessage:"Proxy server URL",id:"A/z9Ko1sje"}),egressRequirements:At.singleHostEgress,egressRequirementsLabel:J.msg({defaultMessage:"Proxy server",id:"B/iAs+tICD"}),category:"connection",group:Uj,order:1,placeholder:J.msg({defaultMessage:"http://proxy.example.com:8080",id:"F8dd6JjEQu"}),description:{short:G.shortDescription(J.msg({defaultMessage:"Send the app\u2019s and the agent\u2019s traffic through this HTTP proxy instead of the operating system\u2019s proxy settings.",id:"XX6zi7GmwV"})),long:G.longDescription("Pins the app (sign-in, the connection test, model discovery, MCP servers, plugins), the Claude Code engine behind Chat, Cowork, and Code, and on macOS and Windows the Cowork workspace VM (the agent's shell, package-install, `git`, and plugin commands) to one HTTP proxy. Use it when your gateway or the internet is reachable only through a corporate proxy and you cannot rely on the system proxy. It is a reachability setting, not an egress control.\n\nThe value is an `http://` or `https://` URL, usually with a port. SOCKS proxies and embedded credentials (`user:pass@`) are rejected. Give a local forwarding proxy on the device as `http://127.0.0.1:port`; an `https://` loopback address cannot be verified from inside the Cowork workspace VM. Requests to `localhost`, `127.0.0.1`, `[::1]`, and `*.local` names bypass the proxy so local MCP servers keep working; everything else goes through it, and if the proxy is unreachable requests fail rather than connect directly. The engine receives it as `HTTPS_PROXY` and `HTTP_PROXY` with a matching `NO_PROXY`; if Claude Code managed settings on the device set those variables, they win for the engine on the host. Traffic that never uses this proxy: the Cowork workspace VM on Linux, credential and header helper scripts, the update download, the Windows sign-in broker, and pages opened in the system browser.\n\nRead once at launch from device management (MDM) or the local configuration file only; a configuration server cannot deliver it, because the app may need the proxy to reach that server. A profile that sets only this key (or only the other app-behavior keys, such as `disableAutoUpdates`) does not take over a connection users set up in the app, but those keys are read from one source as a group, so put the proxy in the same profile as your update settings. Changes apply at the next app start. When `egressProxyPacUrl` is also set, the PAC file wins and this key is ignored.",{docsUrl:`${At.COWORK_3P_DOCS_BASE}/network-proxy`})}}),egressProxyPacUrl:G.field(G.annotate(Ss.urlSchema({allowHttp:!0}).optional(),{redact:"hostname"}),{flatKey:"egressProxyPacUrl",support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.44121.1"}},appBehaviorOnly:!0,remotePolicy:{type:"remote-disabled"},title:J.msg({defaultMessage:"Proxy auto-config (PAC) URL",id:"0DhMVtlmyQ"}),egressRequirements:At.singleHostEgress,egressRequirementsLabel:J.msg({defaultMessage:"Proxy auto-config file",id:"Gqm6SFn9I2"}),category:"connection",group:Uj,order:2,placeholder:J.msg({defaultMessage:"http://wpad.example.com/proxy.pac",id:"E7zJ/trntg"}),description:{short:G.shortDescription(J.msg({defaultMessage:"URL of a PAC file that decides the proxy per request. Wins over the proxy server URL when both are set.",id:"dRsQ1NgKdo"})),long:G.longDescription("At launch the app downloads the PAC script and asks it which proxy to use for each request, as a browser would, instead of following the operating system's proxy settings. Same value rules, coverage, exclusions, and delivery as `egressProxyUrl`, except that bypassing is the script's decision: `localhost`, `127.0.0.1`, and `[::1]` still never use a proxy, but `*.local` names and everything else follow whatever it returns. If the PAC file cannot be downloaded, the app connects directly rather than failing.\n\nOn macOS and Windows the Cowork workspace VM is handed a copy of the script when it starts and evaluates it for each request itself; there `myIpAddress()` returns the VM's internal address rather than the device's, so a script that chooses by client subnet gives the VM its off-network answer (if that download fails, the VM connects directly). The Claude Code engine behind Chat, Cowork, and Code cannot evaluate a PAC file, so the app hands it one proxy (whichever the script returns for your inference endpoint) plus a bypass for loopback and `*.local` names. If the script answers `DIRECT` or only `SOCKS` for that endpoint, the engine uses no proxy at all, so have it return an HTTP `PROXY host:port` entry there; if the engine needs different rules, set `HTTPS_PROXY` and `NO_PROXY` in Claude Code managed settings, which win for the engine on the host.",{docsUrl:`${At.COWORK_3P_DOCS_BASE}/network-proxy`})}}),edrExtension:G.field(Ss.configuredHostPath.optional(),{flatKey:"coworkEDRIntegration",support:{enabled:{scopes:["3p","1p"],availableInVersion:"2.16120.0"},visibility:"public-undocumented",executionTarget:"desktop"},remotePolicy:{type:"remote-disabled"},appBehaviorOnly:!0,title:J.msg({defaultMessage:"EDR Integration package path",id:"IBdsVeIXWe"}),category:"sandbox",predicates:{show:()=>!1},description:{short:G.shortDescription(J.msg({defaultMessage:"Path on the user\u2019s computer to the signed package an endpoint security (EDR) vendor supplies for the Cowork workspace VM. Read from device management only.",id:"rhY1Zx/tks"})),long:G.longDescription("The path on the user's computer of the signed package your endpoint security (EDR) vendor supplies for the Cowork workspace VM. Put its signature file beside the file this path points to, named as that file plus `.sig`. Keep both, and every folder above them, where ordinary users cannot write. Each time the workspace VM starts, it checks that signature and, only if it is from the vendor named in `coworkEDRIntegrationVendor`, which you must also set, runs the package's `install.sh` as root to install or update the sensor. The signature covers only the package file, `install.sh` included; what the sensor downloads afterwards, including its own updates, is the vendor's and is not checked by Claude. macOS only.\n\nClaude reads this key only from configuration that only an administrator can install: an MDM profile on macOS, or the root-owned file under `/etc/claude-desktop` on Linux. It ignores the key in the in-app Setup panel, in any file the user can edit, and from a configuration server. It is one of the app-behavior keys (`disableAutoUpdates`, `relaunchEnforcementHours`, `egressProxyUrl`, \u2026), which Claude takes as a set: once your profile sets any of them, values for the others from a local file or a configuration server stop applying, so put every one you use in the same profile.\n\nUnset (default): no vendor package is installed in the workspace VM. Removing this key only stops later runs of the package. It does not remove or stop a sensor already installed, which stays on the workspace VM's disk until that VM is deleted or replaced.\n\nNetwork access: `install.sh` and whatever it installs run as root in the workspace VM and are not part of any session, so the network egress allowlist, the proxy keys (`egressProxyUrl`, `egressProxyPacUrl`) and the device's proxy settings do not apply to them. Claude does not otherwise limit which internet hosts they can reach; their connections are ordinary traffic from the device, subject to your own network-layer controls.")}}),edrExtensionVendor:G.field(Ss.vendorId.optional(),{flatKey:"coworkEDRIntegrationVendor",support:{enabled:{scopes:["3p","1p"],availableInVersion:"2.16120.0"},visibility:"public-undocumented",executionTarget:"desktop"},remotePolicy:{type:"remote-disabled"},appBehaviorOnly:!0,title:J.msg({defaultMessage:"EDR Integration vendor ID",id:"/BHf6muvcS"}),category:"sandbox",predicates:{show:()=>!1},description:{short:G.shortDescription(J.msg({defaultMessage:"The ID of the vendor that signed the package coworkEDRIntegration points to. Required with that key, or nothing is installed. Read from device management only.",id:"HBPYbmIcrk"})),long:G.longDescription("The ID of the endpoint security (EDR) vendor that signed the package `coworkEDRIntegration` points to: 1 to 32 characters from a to z, 0 to 9 and the hyphen, not starting with a hyphen, for example `example-vendor`. It must be an ID this release of Claude accepts; ask your vendor which ID to use. Required whenever `coworkEDRIntegration` is set. The workspace VM runs the package only if this vendor signed it; a package signed by anyone else is refused, even another vendor this release of Claude accepts. The signature the VM checks is the `.sig` file described under `coworkEDRIntegration`. macOS only.\n\nClaude reads this key only from the configuration described under `coworkEDRIntegration`, and ignores a value from anywhere else. It is one of the app-behavior keys (see `coworkEDRIntegration`), so put it in the same profile as every other app-behavior key you use.\n\nUnset (default): if `coworkEDRIntegration` is set, nothing is installed, and each time the workspace VM starts `cowork_vm_node.log` in the app's logs folder records the reason, `vendor_not_named`. It records `config_invalid` for a value not of the form above and `vendor_unknown` for an ID this release of Claude does not accept; neither installs anything. To turn the feature off without these entries, remove `coworkEDRIntegration`, not this key. Removing either key only stops later runs: a sensor already installed stays on the workspace VM's disk until that VM is deleted or replaced.")}}),vmIpv6Enabled:G.field(ze.z.boolean().optional(),{flatKey:"coworkVmIpv6Enabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.52386.0"},executionTarget:"desktop"},title:J.msg({defaultMessage:"Enable IPv6 in the workspace VM",id:"JHTnwZf+m3"}),default:{displayOnly:!1},category:"connection",group:Dde,order:1,description:{short:G.shortDescription(J.msg({defaultMessage:"Give the Cowork workspace VM an IPv6 address and route so the agent\u2019s tools can reach IPv6-only hosts through the device. macOS and Windows; off by default.",id:"v9YS8eHay0"})),long:G.longDescription("When set to `true`, the Cowork workspace VM on macOS and Windows gets a static IPv6 address (a unique local `fd\u2026` address) and an IPv6 default route on its virtual network next to its IPv4 address, and the VM's gateway forwards that traffic over the device's own IPv6 connectivity, as it already does for IPv4. Use it when the tools the agent runs in the VM (shell commands, package installs, `git`, and plugin commands) must reach IPv6-only destinations. The VM's resolver then also returns IPv6 (AAAA) answers. A connection the VM makes over IPv6 succeeds only where the device's own IPv6 does; on a device without working IPv6, destinations that have both keep working over IPv4 and IPv6-only destinations stay unreachable. Because the VM's address is unique-local, most tools in it keep preferring IPv4 for destinations that have both, so IPv6 mostly carries traffic to IPv6-only destinations.\n\nThis is a reachability setting, not an egress control: `coworkEgressAllowedHosts` keeps deciding which hostnames the agent's tools may reach, by name, over either protocol, and IPv6 literals are still not accepted there. Hosts your policies allow must also be reachable, and filtered the way you intend, over IPv6 on your network.\n\nUnset (default): the VM is IPv4-only and its resolver returns no IPv6 answers. A change takes effect the next time the workspace VM starts, typically at the next app launch. Does not apply to the Cowork workspace VM on Linux or to Code sessions, which use the devi
ceModelPricingEnabled": true, "inferenceModelPricingMultiplier": 0.9, "inferenceModelPricing": [{"name": "claude-sonnet-4-6", "inputPerMtok": 2.4, "outputPerMtok": 12, "cacheReadPerMtok": 0.24, "cacheWritePerMtok": 3}]}\n```\nThese are estimates for visibility, not an invoice; your provider bills at its own rates. A machine-level Claude Code managed `modelPricing` (MDM / managed-settings.json / server-managed) takes precedence over this table.',{docsUrl:`${at.COWORK_3P_DOCS_BASE}/configuration#models`})}})}).optional(),catalogEnabled:ie.field(gt.z.boolean().optional(),{flatKey:"modelCatalogEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"2.110.0"}},remotePolicy:{hybrid:{scope:"excluded"}},default:{displayOnly:!0},failClosedValue:!1,title:ae.msg({defaultMessage:"Model catalog metadata",id:"go+bdjd1f9"}),category:"connection",group:at.MODELS_GROUP,order:2,description:{short:ie.shortDescription(ae.msg({defaultMessage:"Label and describe the model picker\u2019s entries from the published Claude Code model catalog, instead of the app\u2019s built-in table.",id:"sikjjWW3Tp"})),long:ie.longDescription("When on (the default), the app reads the model catalog Anthropic publishes for Claude Code (a signed document fetched from `downloads.claude.ai`, or from `modelCatalogUrl` when that is set, and verified against a key built into the app; a copy bundled with the app is used until one has been fetched, or when the host is unreachable) and uses it to fill in each picker entry's display name, description, and thinking/effort options in the Chat, Cowork, and Code tabs. It never changes which models are offered, their order, or the default model (the first `inferenceModels` entry): those, 1M-context variants, and `labelOverride` still come from `inferenceModels` / discovery, and a model the catalog does not list keeps the built-in label. Set `modelCatalogEnabled: false` to keep the built-in labels and make no catalog fetch. Applies to deployments configured on the device or by a bootstrap server; an install managed from the Claude admin console takes its model names and options from the console's settings and never fetches the catalog.",{docsUrl:`${at.COWORK_3P_DOCS_BASE}/configuration#models`})}}),catalogUrl:ie.field(ie.annotate(Nm.httpsUrl.optional(),{redact:"hostname"}),{flatKey:"modelCatalogUrl",support:{enabled:{scopes:["3p"],availableInVersion:"2.110.0"}},remotePolicy:{hybrid:{scope:"excluded"},rejectLoopback:!0,applyUnverified:!0,hotApplied:!0},failClosedValue:Ej.MODEL_CATALOG_LOCATION_UNREADABLE_STAND_IN,unreadableStandIn:!0,title:ae.msg({defaultMessage:"Model catalog URL",id:"7QWnJvdV6y"}),egressRequirements:(e,t)=>{var n;if(((n=t.models)===null||n===void 0?void 0:n.catalogEnabled)===!1||e===Ej.MODEL_CATALOG_LOCATION_UNREADABLE_STAND_IN)return[];let s=Hc.safeHostname(e);return s&&!Nm.isLinkLocalOrMetadataHost(s)?at.singleHostEgress(e):[]},egressRequirementsLabel:ae.msg({defaultMessage:"Model catalog mirror",id:"a9epb+yGXN"}),category:"connection",group:at.MODELS_GROUP,order:2.1,placeholder:ae.msg({defaultMessage:"https://mirror.example.com/model-catalog/v1/catalog.json",id:"o9MdHULcKp"}),predicates:{show:(e)=>{var t;return((t=e.models)===null||t===void 0?void 0:t.catalogEnabled)!==!1}},description:{short:ie.shortDescription(ae.msg({defaultMessage:"Fetch the model catalog and its signature file from this URL (a mirror inside your network serving Anthropic\u2019s published files) instead of downloads.claude.ai.",id:"sFZOQNiiWa"})),long:ie.longDescription("When set, the app fetches the catalog document and its signature file (the same URL with `.raw-sig.json` appended to the path) from this URL instead of `https://downloads.claude.ai/model-catalog/v1/catalog.json`, for a gateway or mirror inside your network serving Anthropic's two published files byte-for-byte. The document is still verified against the key built into the app, so an edited or re-signed copy is refused and the app keeps its last verified copy (or the bundled one); there is no key to configure. `https://` is required (`http://` only to a loopback address, and only when set on the device itself; a bootstrap server may not deliver a loopback or non-`https://` value); the server must answer the GET directly (redirects are not followed) and may honor `If-None-Match` with `304`, and must serve a document at least as new as the one the install last accepted (or the bundled seed) \u2014 an older one is refused and re-fetched on the retry interval until the mirror catches up. Ignored when `modelCatalogEnabled` is `false`, and on an install managed from the Claude admin console (which never fetches the catalog). A value that is not a valid URL, names a link-local or cloud-metadata host (e.g. `169.254.169.254`, `metadata.google.internal`), or is a loopback / non-`https://` value a bootstrap server delivers, turns the catalog fetch off (no fallback to `downloads.claude.ai`); the last fetched or bundled copy keeps labelling the pickers. On an install configured for a bootstrap server, the default location is not fetched until the server's configuration applies after sign-in, so a device does not poll `downloads.claude.ai` while the server may yet name a mirror; a mirror URL set on the device, cached earlier, or served in a pre-sign-in subset still fetches. Diagnostics report the location only as `hosted`, `custom`, `invalid` or `pending`; the value itself is treated like `bootstrapUrl`: host name only in telemetry, printed in full in the diagnostics bundle.",{docsUrl:`${at.COWORK_3P_DOCS_BASE}/configuration#models`})}})});function Um(e){var t,n;return((n=(t=e.models)===null||t===void 0?void 0:t.pricing)===null||n===void 0?void 0:n.enabled)===!0}function fde(e){var t;let n=(t=e.models)===null||t===void 0?void 0:t.pricing;if(!n||!Um(e))return;let{enabled:s,...r}=n;return r}function pde(e,t,n){let{inferenceProvider:s,inferenceModels:r}=e;if(!s||!Array.isArray(r))return e;let a=r.filter((l)=>{let c=zm.checkModel(s,l.name);if(!c.ok)t(l.
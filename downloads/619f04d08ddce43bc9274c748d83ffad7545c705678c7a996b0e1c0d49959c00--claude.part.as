leEssential:Jt.field(xi.z.boolean().optional(),{flatKey:"disableEssentialTelemetry",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},remotePolicy:{default:!0,applyUnverified:!0},failClosedValue:!0,title:fn.msg({defaultMessage:"Block essential telemetry",id:"rdKIIOydC8"}),default:!1,category:"telemetry",group:Os.ANTHROPIC_TELEMETRY_GROUP,order:0,description:{short:Jt.shortDescription(fn.msg({defaultMessage:"Crash and performance reports to Anthropic.",id:"EGOuVJosgc"})),long:Jt.longDescription(`"Essential" means the signals Anthropic needs to keep your deployment working: **crash stacks**, **startup failure reasons**, **version/OS metadata**, and **crash dumps** (each an unfiltered copy of part of the app's memory). Reports carry a random install ID and an organization ID. The organization ID is the one you set, one the app takes from your Anthropic sign-in or derives from your connection settings, or a placeholder shared with other unconfigured deployments. Reports can also include a summary of your settings, the host names of addresses you configured, text you set for display (such as the display name, subtitle, and banner text and link), and a one-way digest of a session ID.

**What you lose when this is on:** when a Claude Desktop build hits a bug that only reproduces on your OS version or locale, Anthropic can't see it unless a user manually reports. Fixes ship slower.

**Why this is discouraged, not blocked:** some air-gapped environments require zero outbound telemetry as a matter of policy. The switch exists for them. If you don't have that constraint, leave it off.`,{docsUrl:`${Fm.COWORK_3P_DOCS_BASE}/telemetry#essential-telemetry`})},predicates:{warn:(e)=>e===!0?fn.msg({defaultMessage:"Crash and error reports are how we diagnose failures specific to your inference setup. Support turnaround will be slower without them.",id:"ek/rdG0G9V"}):null}}),disableNonessential:Jt.field(xi.z.boolean().optional(),{flatKey:"disableNonessentialTelemetry",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},remotePolicy:{default:!0,applyUnverified:!0},failClosedValue:!0,title:fn.msg({defaultMessage:"Block nonessential telemetry",id:"oo4Av05fBn"}),default:!1,category:"telemetry",group:Os.ANTHROPIC_TELEMETRY_GROUP,order:1,description:{short:Jt.shortDescription(fn.msg({defaultMessage:"Product-usage analytics and diagnostic-report uploads. No message content.",id:"0X/lTj2Hvv"})),long:Jt.longDescription(`"Nonessential" covers two things: **product-usage analytics** (which features get used, navigation patterns; no prompts or completions) and the **Send** action in Help \u2192 Generate Diagnostic Report. Turning this on stops both.

Destinations are listed under Egress Requirements \u2192 Nonessential telemetry.`,{docsUrl:`${Fm.COWORK_3P_DOCS_BASE}/telemetry#non-essential-telemetry`})},predicates:{warn:(e)=>e===!0?fn.msg({defaultMessage:"Usage analytics help us prioritize improvements for third-party inference. Diagnostic-report uploads will also be blocked. No message content is included in either.",id:"XtXm3euW3d"}):null}}),disableNonessentialServices:Jt.field(xi.z.boolean().optional(),{flatKey:"disableNonessentialServices",support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},failClosedValue:!0,title:fn.msg({defaultMessage:"Block nonessential services",id:"HA2UIzGsaT"}),default:!1,category:"telemetry",group:Os.ANTHROPIC_TELEMETRY_GROUP,order:2,description:{short:Jt.shortDescription(fn.msg({defaultMessage:"Connector favicons, artifact-preview and MCP Apps iframes, and the Linux spellcheck dictionary. Connector widgets fall back to text; spellcheck is off on Linux.",id:"iwXupWG0F3"})),long:Jt.longDescription(`"Nonessential services" covers these outbound fetches the app runs without: **connector favicons** (the icon proxy), the **artifact-preview** iframe origin, the **MCP Apps widget** iframe origin (\`*.claudemcpcontent.com\`), and the **spellcheck dictionary** the built-in spellchecker downloads on Linux. Turning this on blocks all of them. (macOS and Windows use the system spellchecker. Windows still downloads a dictionary for a language it cannot check natively; this key does not stop that download.)

**What you lose when this is on:** connectors show without icons, the hosted artifact preview frame does not load (artifacts still render locally, without the CDN chart libraries they can otherwise load), connectors that return MCP Apps show the text tool result instead of the widget, Excel files in the Code tab preview only through Claude\u2019s workspace (the local VM) instead of that frame, and spellcheck underlines are off on Linux.

Destinations are listed under Egress Requirements \u2192 Nonessential services.`)},predicates:{warn:(e)=>e===!0?fn.msg({defaultMessage:"This disables connector icons, hosted artifact previews and MCP Apps widgets, and also turns spellcheck off on Linux. Artifacts still render locally, without CDN libraries; connectors that return MCP Apps show the text tool result instead of the widget.",id:"VinFqhloIq"}):null}}),usageMetrics:Jt.field(xi.z.boolean().optional(),{flatKey:"usageMetricsEnabled",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.46388.1"},visibility:"public-undocumented"},remotePolicy:{hybrid:{scope:"only",derived:!0},hotApplied:!0},predicates:{show:()=>!1},title:fn.msg({defaultMessage:"Report usage metrics to your Claude.ai organization",id:"hFaw5XYgDV"}),category:"telemetry",group:Os.ANTHROPIC_TELEMETRY_GROUP,order:3,description:{short:Jt.shortDescription(fn.msg({defaultMessage:"Set by the control plane from the organization\u2019s Claude Code analytics setting; not editable here. Reports per-user token, cost and session counts (no content).",id:"6k4DCNJe7b"})),long:Jt.longDescription(`Server-derived: the Claude.ai control plane sets this key, each time it serves the configuration, from the organization's Claude Code analytics setting in Admin settings; it is off until an admin turns that setting on, and off for organizations under HIPAA or customer-managed encryption keys. It is not authored in any form, MDM profile, or bootstrap server, and a value stored anywhere else is ignored.

When on, each signed-in desktop periodically reports usage counters to your Claude.ai organization: per-member **token counts** (input, output, cache read, cache write) by model, the desktop's **cost estimate** for those tokens, and **session counts**, tagged with the member's account, the model name, the app surface (Chat, Cowork or Code), an opaque per-session and per-install identifier, and the app version, operating system and architecture. No prompts, responses, file contents, tool inputs or outputs are included. Sessions and the cost estimate appear in your organization's Claude.ai analytics (Analytics \u2192 Claude Code); the Admin API Claude Code usage report carries those plus per-member, per-model token counts.

This is independent of **Block essential telemetry** and **Block nonessential telemetry**: those govern diagnostics sent to Anthropic, this one populates your own organization's dashboard, and either can be on without the other. Reports go to the same Claude.ai endpoint the desktop fetches its configuration from, so no additional firewall entry is needed. A change takes effect without a relaunch once two configuration syncs in a row have served it.`)}})})});var Aw=M(function($j){Object.defineProperty($j,"__esModule",{value:!0});$j.MANAGED_MCP_PRESETS=void 0;$j.isAnthropicM365ConnectorUrl=Tj;$j.isAnthropicM365Connector=Pde;var kde="07c030f6-5743-41b7-ba00-0a6e85f37c17",Ede=[".claude.com",".fedstart.com"];function Tj(e){if(!e)return!1;if(!Ede.some((t)=>e.hostname.endsWith(t)))return!1;return e.hostname.startsWith("microsoft365.mcp.")||e.pathname.includes("/m365/")}function Pde(e){if(!(e===null||e===void 0?void 0:e.url)||e.custom_oauth_client_id)return!1;try{return Tj(new URL(e.url))}catch(t){return!1}}$j.MANAGED_MCP_PRESETS=[{label:"Microsoft 365",item:{name:"m365",url:"https://microsoft365.mcp.claude.com/mcp",transport:"http",oauth:{scope:`api://${kde}/access_as_user offline_access`}}},{label:"Box",item:{name:"box",url:"https://mcp.box.com",transport:"http",oauth:{authorizationServer:["https://api.box.com"]}}},{label:"Microsoft 365",kind:"builtin",item:{name:"Microsoft 365",server:"microsoft365"}},{label:"Web search",kind:"builtin",item:{name:"Web search",server:"websearch",provider:"brave"}},{label:"GitHub",kind:"builtin",item:{name:"GitHub",server:"github"}}]});var Iw=M(function(Lj){Object.defineProperty(Lj,"__esModule",{value:!0});Lj.McpConfig=void 0;Lj.isMcpPersistentAlwaysAllowEnabled=Tde;var Cn=On(),jj=Rc(),Kc=Sr(),Je=Et(),Nr=Nn(),et=Sn(),xj=Aw(),pr=Dr(),hr=eo();function Cde(e,t){var n;let s=typeof t.url==="string"?t.url.trim():"",r=t.headers&&typeof t.headers==="object"?t.headers:void 0,a=[],l;try{l=s?new URL(s):void 0}catch(h){}if((l===null||l===void 0?void 0
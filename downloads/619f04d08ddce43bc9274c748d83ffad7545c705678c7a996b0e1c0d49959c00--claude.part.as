.egressAddress(t.url)];if(t.oauth&&t.oauth.mode!=="dcr"){let s=pr.resolveByoAsSelection(t.oauth);if(s.via==="tenant")n.push("login.microsoftonline.com");n.push(...pr.byoAsSelectionUrls(s).map(Kc.egressAddress))}return n}).filter((t)=>!!t):[],category:"connectors",group:hr.MCP_SERVERS_GROUP,order:0,addLabel:et.msg({defaultMessage:"Add server",id:"pOeEMxHCXp"}),customRenderer:"mcpProbe",description:{short:Je.shortDescription(et.msg({defaultMessage:"Org-pushed MCP servers: remote (HTTP/SSE) or local (stdio command). May embed bearer tokens.",id:"wG2dpZSzTk"})),long:Je.longDescription('For OAuth-authenticated entries, the app builds the redirect URI as `http://<callbackHost>:<callbackPort>/callback`; register that exact value with the OAuth provider. Tokens refresh automatically during a session.\n\n`toolPolicy` locks the per-tool approval state, keyed by tool name: `"blocked"` removes the tool from the session and labels it admin-blocked, `"ask"` requires approval on every call (Allow once / Deny only; no persistent always-allow; a scheduled Cowork task waits at that prompt), `"allow"` pre-approves. Tools **not listed** follow the user\'s choice: the prompt offers a persistent Always allow, except for tools that can modify data, which show a session-scoped **Allow for this task** alongside **Allow for all tasks** with a malicious-instruction warning. In Code sessions, `blocked` and `ask` are forwarded as Claude Code permission rules; `allow` is not.\n\nKeys may contain `*` wildcards (`"read_*"` matches every tool whose name starts with `read_`; anchored, and `*` is the only wildcard). When several wildcard keys match, the strictest applies (blocked > ask > allow). An exact-name key wins over matching wildcards, with two exceptions in the stricter direction: in Code sessions a wildcard `ask`, or a wildcard `blocked` other than the bare `"*"`, beats a less strict exact key (so `"*": "blocked"` plus exact `"allow"` entries still works as deny-by-default there); and in chat approval prompts and always-allow persistence a wildcard `ask` keeps every matching tool behind a per-call prompt even when a more permissive exact key matches, while direct tool invocations such as artifact or widget calls follow the exact key.\n\nFor the bundled Microsoft 365 connector, the send tools (`outlook_send_mail`, `outlook_send_draft`, `outlook_forward_mail`, `outlook_create_event`, `outlook_update_event`, `teams_send_chat_message`, `teams_send_channel_message`, `teams_reply_channel_message`) cannot be loosened below `ask`; an `allow` setting resolves to `ask`.',{docsUrl:`${Nr.COWORK_3P_DOCS_BASE}/configuration#managedmcpservers`})},presets:xj.MANAGED_MCP_PRESETS,blankItem:{transport:"http"},predicates:{warn:(e,t,n)=>Cde(n,e)}}),persistentAlwaysAllowEnabled:Je.field(Cn.z.boolean().optional(),{flatKey:"mcpPersistentAlwaysAllowEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.24012.9"}},title:et.msg({defaultMessage:"Allow persistent tool approvals",id:"OmQqCV/O12"}),default:!0,failClosedValue:!1,category:"connectors",group:hr.MCP_SERVERS_GROUP,order:1,description:{short:Je.shortDescription(et.msg({defaultMessage:"Offer the persistent \u201CAlways allow\u201D approval options for MCP tools. Disable to keep tool approvals per-call or session-scoped only.",id:"GXMHY2UvCF"})),long:Je.longDescription("When enabled (the default), approval prompts for tools without a `toolPolicy` entry offer a persistent grant \u2014 **Always allow**, or **Allow for all tasks** for tools that can modify data \u2014 the Tool permissions picker in Connector settings lets users pre-approve tools, and those grants persist across sessions with no expiry.\n\nWhen disabled, the persistent options are hidden from approval prompts and from the Connector settings picker, and previously stored persistent grants stop being honored. Scheduled-task runs also stop offering, recording and replaying the **Allow for all scheduled runs** approval, unless a scheduled-task approval lifetime of one day or more is set. Users can still approve each call. Outside scheduled-task runs they can also choose **Allow for this task**, except for read-only tools on servers they added themselves.\n\nA per-tool `toolPolicy` entry on `managedMcpServers` always takes precedence over this key: `blocked`, `ask`, and `allow` behave exactly as documented there whether this key is enabled or not.\n\nThis key governs the chat and Cowork surfaces. Code sessions use a separate permission path this key does not cover \u2014 govern Code tool approvals with per-tool `toolPolicy` entries, whose `blocked` and `ask` values are forwarded there.",{docsUrl:`${Nr.COWORK_3P_DOCS_BASE}/configuration#mcppersistentalwaysallowenabled`})}}),scheduledTaskApprovalLifetimeDays:Je.field(Cn.z.preprocess((e)=>typeof e==="string"&&e.trim()!==""?Number(e):e,Cn.z.number().int().gte(0).lte(3650).optional()),{flatKey:"mcpScheduledTaskApprovalLifetimeDays",support:{enabled:{scopes:["3p"],availableInVersion:"2.7032.0"}},title:et.msg({defaultMessage:"Scheduled-task tool approval lifetime",id:"yqgGAUV4YP"}),failClosedValue:0,remotePolicy:{applyUnverified:"asFailClosed"},category:"connectors",group:hr.MCP_SERVERS_GROUP,order:1.5,suffix:et.msg({defaultMessage:"days",id:"Bc20laBenW"}),placeholder:et.msg({defaultMessage:"30",id:"HMv/M+VWJ6"}),description:{short:Je.shortDescription(et.msg({defaultMessage:"How many days a scheduled task may reuse a lasting MCP-tool approval before it asks again. 0 removes the lasting option.",id:"au5x3V9PvH"})),long:Je.longDescription("On a scheduled task, the approval prompt for an MCP tool can offer a lasting approval, so later runs use that tool without asking: **Allow for all scheduled runs** in Cowork, **Always allow** in the Code tab. This setting limits how long that approval lasts. With a limit, the button reads **Allow for N days**. Once an approval is older than that, the next run asks again, and approving again renews it. `0` removes the lasting option, and approvals already stored stop being reused. Leave it blank to change nothing. Choose a number comfortably longer than the gap between runs.\n\nThe limit covers MCP tools only, and a `toolPolicy` entry on `managedMcpServers` still takes precedence. If a configuration server delivers the setting, then after each launch scheduled tasks ask instead of reusing stored approvals (as at `0`) until the app has fetched the configuration again.\n\nCowork: if `mcpPersistentAlwaysAllowEnabled` is off, this setting brings the lasting option back for scheduled tasks only, with the time limit.\n\nCode tab: `mcpPersistentAlwaysAllowEnabled` has no effect. The limit covers only lasting approvals given after this setting took effect. An earlier one was usually saved as an allow rule in Claude Code's own settings: for a scheduled task, the project's `.claude/settings.local.json`, under `permissions.allow`. Any allow rule in Claude Code's settings, including one written by hand or by **Always allow** in an ordinary Code session in the same project, keeps allowing the tool without asking, even at `0`, until that entry is removed.",{docsUrl:`${Nr.COWORK_3P_DOCS_BASE}/configuration#mcpscheduledtaskapprovallifetimedays`})}}),claudeInChromeEnabled:Je.field(Cn.z.boolean().optional(),{flatKey:"claudeInChromeEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"1.34493.0"},executionTarget:"desktop",visibility:"public-undocumented"},remotePolicy:{hybrid:{scope:"only",derived:!0}},predicates:{show:()=>!1},title:et.msg({defaultMessage:"Enable Claude in Chrome",id:"q3VdR8mZpL"}),category:"connectors",group:hr.MCP_SERVERS_GROUP,order:3,description:{short:Je.shortDescription(et.msg({defaultMessage:"Set by the control plane from the organization\u2019s Claude in Chrome admin setting; not editable here. Lets sessions drive the user\u2019s browser via the extension.",id:"Hn7tK2cWqs"})),long:Je.longDescription(`Server-derived: the Claude.ai control plane sets this key, each time it serves the configuration, from the organization's Claude in Chrome setting (Admin settings \u2192 Claude in Chrome \u2014 the same switch, site allowlist/blocklist, and per-role access that govern the extension itself) and the signed-in member's role. It is not authored in any form, MDM profile, or bootstrap server, and a value stored anywhere else is ignored.

When on, Cowork and Code sessions can use the Claude in Chrome browser tools (navigate, read page, click, type, screenshot) in the user's Google Chrome or Microsoft Edge. Tool calls travel over the browser's local native-messaging connection between the app and the extension and are encrypted end to end between the two; page content is never relayed through Anthropic servers, and inference stays on the configured provider; the extension's hosted URL-safety check stays on, so the address of each page the agent acts on is checked against the Anthropic API. macOS and Windows only.

Before any tool call, Claude Desktop and the extension each obtain a short-lived signed identity statement from the Anthropic API and pair only when both belong to the same account in your organization, so those two small requests do go to Anthropic. Installed from the Chrome Web Store, the extension runs in third-party mode on its own for members of a hybrid organization \u2014 nothing runs that does not arrive over the verified pairing, and per-site permission prompts are delegated to Claude Desktop \u2014 so no separate Chrome policy is needed. Chrome managed policy stays optional for locked-down fleets: \`forceLoginOrgUUID\` may name the organization(s) allowed to take control of the extension wherever the policy reaches (a Claude Desktop from any other organization is refused), and \`blockedUrlPatterns\` may be added and applies on top of the hosted URL-safety check. Requires \`isLocalDevMcpEnabled\` to remain enabled. Off unless the organization's Claude in Chrome setting is on.`)}}),claudeInChromePasswordManagersEnabled:Je.field(Cn.z.boolean().optional(),{flatKey:"claudeInChromePasswordManagersEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"2.9939.2"},executionTarget:"desktop",visibility:"public-undocumented"},remotePolicy:{hybrid:{scope:"only",derived:!0},hotApplied:!0},predicates:{show:()=>!1},title:et.msg({defaultMessage:"Enable password managers in Claude in Chrome",id:"il2qeFDuRY"}),category:"connectors",group:hr.MCP_SERVERS_GROUP,order:3.1,description:{short:Je.shortDescription(et.msg({defaultMessage:"Set by the control plane from the organization\u2019s Password managers setting under Claude in Chrome; not editable here. Lets a password manager fill sign-ins.",id:"y41oE2cG9U"})),long:Je.longDescription(`Server-derived: the Claude.ai control plane sets this key, each time it serves the configuration, from the organization's Password managers setting (Admin settings \u2192 Claude in Chrome \u2192 Password managers, off until an admin turns it on) and the signed-in member's access. It is not authored in any form, MDM profile, or bootstrap server, and a value stored anywhere else is ignored.

When on, and Claude in Chrome is on, a member on macOS can connect a supported password manager's desktop app in Claude Desktop; sessions that can use Claude in Chrome can then ask that password manager to fill a sign-in form in the user's browser through the Claude in Chrome extension and the password manager's own extension. The user approves each request in the password manager and Claude never receives the credential itself: it passes on the device between the password manager, its browser extension and the page. The app's usage telemetry for the integration (outcomes only; no sites, credentials or item names) follows \`disableNonessentialTelemetry\`, and Claude in Chrome's own checks apply to the page as for any of its actions. A change takes effect without a relaunch once two configuration syncs in a row have served it. Off unless the organization's setting is on; requires \`claudeInChromeEnabled\`.`)}}),localStdioEnabled:Je.field(Cn.z.boolean().optional(),{flatKey:"isLocalDevMcpEnabled",readers:["desktop","code"],support:{enabled:{scopes:["3p","1p"],availableInVersion:"1.2581.0"}},title:et.msg({defaultMessage:"Allow user-added MCP servers",id:"1QKV7FS8FM"}),default:!0,failClosedValue:!1,egressRequirements:(e)=>e===!1?[]:Kc.PYTHON_EXTENSION_RUNTIME_HOSTS,egressRequirementsLabel:et.msg({defaultMessage:"User-added MCP (Python runtime)",id:"O0zxaLsWs9"}),category:"connectors",group:hr.MCP_SERVERS_GROUP,order:2,description:{short:Je.shortDescription(et.msg({defaultMessage:"Local stdio servers added via the Developer settings. Remote servers come from the managed list above or organization plugins.",id:"1NMgra1xGv"}))}}),allowedPluginServers:Je.field(Je.annotate(Cn.z.array(Mj(et.msg({defaultMessage:"URL pattern a plugin\u2019s remote server must match, with * wildcards.",id:"ERRP/7Z11f"})).nullable().catch(null)),{maxItems:100}).transform((e)=>e.filter((t)=>t!==null)).optional(),{flatKey:"allowedPluginMcpServers",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"2.2553.0"}},title:et.msg({defaultMessage:"Allowed plugin MCP servers",id:"vUSpcWJDNG"}),failClosedValue:[],emptyListIsAuthored:!0,predicates:{warn:Dj},category:"connectors",group:hr.MCP_SERVERS_GROUP,order:2.5,description:{short:Je.shortDescription(et.msg({defaultMessage:"Servers plugins may connect in sessions, beyond the managed list above and organization plugins. An empty list allows none; unset keeps today\u2019s rules.",id:"y4jySlHrtX"})),long:Je.longDescription(`Unset (default): with managed servers listed, sessions take MCP servers only from plugins and the desktop; with no managed servers listed, nothing is restricted.

When set, Cowork, Chat and Code sessions connect the managed list above and the servers the desktop serves from the administrator's org-plugins directory, plus only servers declared by other plugins (user-installed or marketplace) that match an entry. An entry in the managed list above with \`transport: "policy-only"\` sets a plugin server's tool permissions but does not admit it; to admit that server, list the server's own URL here. Claude Code configuration-file servers (\`~/.claude.json\`, a project's \`.mcp.json\`, \`claude mcp add\`) are never connected. With the key set, the desktop starts no plugin server on the computer itself, whatever the entries say. The one exception is the MCP servers it serves to sessions from the org-plugins directory. Each entry is a URL pattern in Claude Code's form, \`{"serverUrl": "https://*.example.com/*"}\` (\`*\` wildcards; a host \`*\` spans \`a.b\`): a plugin's remote server connects when its URL matches an entry. No entry admits a plugin's local (stdio) server, and an empty list admits no plugin server. Other shapes, the \`serverName\` and \`serverCommand\` forms included, are dropped and reported; a value that is not a list, or has no readable entry, locks sessions to the managed list and the org-plugins directory's servers, and stops every other desktop-started plugin server. User-added local servers and extensions keep their own keys.

Coexistence with another Claude Code managed-settings source on the device: see [managed settings](${Nr.COWORK_3P_DOCS_BASE}/code#interaction-with-claude-code%E2%80%99s-own-managed-settings).`,{docsUrl:`${Nr.COWORK_3P_DOCS_BASE}/configuration#allowedpluginmcpservers`})}}),deniedPluginServers:Je.field(Je.annotate(Cn.z.array(Mj(et.msg({defaultMessage:"URL pattern of the remote servers to block, with * wildcards.",id:"/Glsg+l7xY"}))),{maxItems:100}).optional(),{flatKey:"deniedPluginMcpServers",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"2.16120.0"}},title:et.msg({defaultMessage:"Blocked plugin MCP servers",id:"nNohigULem"}),failClosedValue:[{serverUrl:"*"}],predicates:{warn:Dj},category:"connectors",group:hr.MCP_SERVERS_GROUP,order:2.6,description:{short:Je.shortDescription(et.msg({defaultMessage:"Remote servers plugins may not connect, even if the allowed list admits them; in Code sessions, configuration-file servers too. Unset or empty blocks none.",id:"PHP5kjRTiq"})),long:Je.longDescription(`Unset (default) or an empty list: nothing is blocked.

When set, Cowork, Chat and Code sessions do not connect a plugin's remote server whose URL matches an entry. The key works with or without \`allowedPluginMcpServers\`; a server that matches both lists stays blocked. In a Code session that reads Claude Code configuration-file servers (\`~/.claude.json\`, a project's \`.mcp.json\`, \`claude mcp add\`), a matching remote server from those files is refused as well. The managed list above, the servers the desktop serves from the administrator's org-plugins directory, user-added local servers and extensions are not affected: remove those at their own keys. Each entry is a URL pattern in Claude Code's form, \`{"serverUrl": "https://*.example.com/*"}\` (\`*\` wildcards; a host \`*\` spans \`a.b\`). An entry matches an address, not a server: the same server under another host name or an IP address, or behind a plugin's local (stdio) server, which has no URL, is not matched. \`https://*.example.com/*\` does not match \`http://\`, \`wss://\` or the bare \`example.com\`; a pattern such as \`example.com/*\`, which names no scheme, matches nothing, and a lone \`*\` matches every URL. To keep a plugin's servers out whatever address they use, set \`allowedPluginMcpServers\`, which admits only the servers it lists. The desktop reads no other shape, the \`serverName\` and \`serverCommand\` forms included: a value that is not a list, or that holds any entry the desktop cannot read, is reported and blocks every plugin's remote server (and those configuration-file remote servers), because skipping an entry of a block list would let its server connect. The servers named above as not affected still connect.

Coexistence with another Claude Code managed-settings source on the device: see [managed settings](${Nr.COWORK_3P_DOCS_BASE}/code#interaction-with-claude-code%E2%80%99s-own-managed-settings).`,{docsUrl:`${Nr.COWORK_3P_DOCS_BASE}/configuration#deniedpluginmcpservers`})}}),toolTimeoutSec:Je.field(Cn.z.coerce.number().int().min(60).max(3600).optional(),{flatKey:"mcpToolTimeoutSec",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.37937.0"},executionTarget:"desktop"},title:et.msg({defaultMessage:"MCP tool call timeout",id:"yfZOCQ8bcU"}),category:"connectors",group:hr.MCP_SERVERS_GROUP,order:4,suffix:et.msg({defaultMessage:"seconds",id:"8TQoLRh7Ea"}),placeholder:et.msg({defaultMessage:"180",id:"H3SKnBW98K"}),description:{short:Je.shortDescription(et.msg({defaultMessage:"Per-call timeout for MCP tool calls, in seconds. Default 180 (3 minutes).",id:"TKg4Ha2DBx"})),long:Je.longDescription("Sets the per-call timeout the agent applies to every MCP tool call; a call that runs longer fails with a timeout error the model can see. Cowork and chat sessions default to 180 seconds. Code sessions have no desktop-imposed MCP tool timeout today, so setting this key introduces one there as well. The desktop's own request deadlines toward MCP servers \u2014 the managed servers above and, where `isLocalDevMcpEnabled` permits them, user-added local servers \u2014 follow this value so they never cut a call short first; while the key is unset, calls to user-added local servers are additionally limited to 60 seconds by the desktop. Values outside 60\u20133600 are rejected at parse time (the error is listed in the diagnostics report) and the defaults apply.\n\nThe timeout is global (there is no per-server or per-tool form), so size it for the slowest tool you need to complete: long-running tools on one server extend the window during which a stuck call on any server holds its turn. Cowork's built-in shell tool runs under the same cap: a single command's `timeout_ms` (itself limited to 600 seconds) cannot exceed this value.",{docsUrl:`${Nr.COWORK_3P_DOCS_BASE}/configuration#mcptooltimeoutsec`})}})});function Tde(e){var t;return((t=e.mcp)===null||t===void 0?void 0:t.persistentAlwaysAllowEnabled)!==!1}});var Md=M(function(nx){Object.defineProperty(nx,"__esModule",{value:!0});nx.WorkspaceConfig=nx.BUILTIN_TOOL_POLICY_ASK_SESSION=nx.BUILTIN_ASK_POLICY_VALUES=nx.BUILTIN_TOOL_NAMES=void 0;nx.builtinToolScope=Nde;nx.scanRuleList=Vj;nx.parseBuiltinRule=Gc;nx.builtinRuleToolName=Tw;nx.canonicalBuiltinRule=bl;nx.isScopedBuiltinRule=zde;nx.checkBuiltinToolPolicyForDrops=Yj;nx.checkDisabledBuiltinToolsForDrops=Jj;nx.builtinRuleWarnings=Bde;nx.checkEgressHostsForDrops=Xj;nx.resolveDisabledBuiltinTools=$w;nx.isChatTabEnabled=Kde;nx.isCoworkSurfaceEnabled=Zde;nx.isSkillCreationEnabled=Vde;nx.autoModeSurfaces=qde;nx.isChatAdvancedFileAnalysisEnabled=Gde;nx.resolveBuiltinAskTools=ex;nx.toolsCoveredByScopedRule=tx;nx.resolveBuiltinAskToolNames=Wde;var ze=On(),Ea=oi(),ks=Sr(),G=Et(),At=Nn(),J=Sn(),Zm=Mr(),Ss=Dr(),mEe=Vs(),Xt=eo(),qc=Uc(),Uj=J.msg({defaultMessage:"Network proxy",id:"wER6775GSj"}),Dde=J.msg({defaultMessage:"Workspace VM network",id:"ko4KhGaz+7"}),zj=J.msg({defaultMessage:"End-user attribution",id:"enduserAttrTtl"}),Mde=ze.z.object({path:G.subfield(G.annotate(ze.z.string().min(1),{pathKind:"folder"}),{label:J.msg({defaultMessage:"Path",id:"P6LP7JosNq"}),support:{availableInVersion:"1.14271.0"},isPrimaryKey:!0,mono:!0,placeholder:J.msg({defaultMessage:"~/Documents/work",id:"/dk65J5QxC"}),description:{short:G.shortDescription(J.msg({defaultMessage:"Absolute folder path. May start with ~ or one of the listed %VAR% tokens, expanded per user. Subfolders are included.",id:"tFB6xfvwBv"}))}}),isDefaultSelected:G.subfield(ze.z.boolean().optional(),{label:J.msg({defaultMessage:"Pre-select on new task",id:"Dk3pnI8vXq"}),support:{availableInVersion:"1.14271.0"},description:{short:G.shortDescription(J.msg({defaultMessage:"Shows as a folder chip on the new-task page and skips the trust prompt. Users can remove it.",id:"P3a+4xY9Hb"}),{docsOnly:!1})}}),mode:G.subfield(ze.z.enum(["rw","ro"]).optional(),{label:J.msg({defaultMessage:"Access mode",id:"Dt4A+S9duA"}),support:{availableInVersion:"1.26832.0"},description:{short:G.shortDescription(J.msg({defaultMessage:"Read-only folders can be viewed and searched but not modified in Cowork. In Code, applies to file tools only. Over SSH, also to Bash in its sandbox.",id:"4W27f1A7Ah"}),{docsOnly:!1}),long:G.longDescription(`Read-only folders can be viewed and searched but not modified in Cowork (by Claude or via the UI). Bash runs in Cowork's isolated workspace where the folder is mounted read-only at the OS level; file-tool writes (Edit, Write) are blocked in-process by Claude Desktop.

In local Code sessions, read-only applies to Claude's file tools only; Bash does **not** yet enforce it.

In SSH sessions (earlier versions ignore the mode on the host), read-only is enforced by Claude Code's own permission rules: its file tools cannot modify the folder. A writable folder inside a read-only one is read-only too. Shell commands are stopped only where Claude Code's sandbox runs (Linux needs bubblewrap and socat), and only as far as that sandbox goes: keep read-only folders outside writable ones, and use the operating system's permissions where a folder must not change. The sandbox does not cover a path with \`* ? [ ] ( ) { } | +\` or a double quote. List each folder by its real path: shell commands may not be stopped in a folder listed through a link. Not enforced on Windows hosts, nor on a host with Claude Code managed settings of its own unless they set \`parentSettingsBehavior\` to \`merge\`. Not covered: MCP servers, hooks, the terminal, commands in \`sandbox.excludedCommands\`, and git worktrees, which Claude Desktop and Claude Code still create inside the folder.

A read-only folder that contains Claude's own data directory (for example the home folder; over SSH, \`~/.claude\` on the host) is enforced in Cowork only. Configure narrower folders for Code coverage. Over SSH, keep a Claude Code config folder moved by \`CLAUDE_CONFIG_DIR\` outside read-only folders.`,{docsOnly:!1})}})});nx.BUILTIN_TOOL_NAMES=["Bash","Read","Write","Edit","Glob","Grep","NotebookEdit","WebFetch","WebSearch","Task","TodoWrite","TaskCreate","TaskUpdate","TaskGet","TaskList","TaskStop","Skill","REPL","JavaScript","AskUserQuestion","ToolSearch","SendUserMessage"];var Bm=["WebSearch","WebFetch"],Fj=["WebFetch"],jde="a scoped entry reaches Code sessions only, never Cowork; allow specific hosts with the egress host settings (coworkEgressAllowedHosts), one list for Cowork and Code",Zc={Read:["Read","Grep","Glob"],Edit:["Edit","Write","NotebookEdit"]},Bj=new Map(Object.entries(Zc).flatMap(([e,t])=>t.filter((n)=>n!==e).map((n)=>[n,e]))),Hj="\\((\\S[^\\r\\n]*)\\)",xde={Bash:["curl *"],Read:["//etc/**","//**/secrets/**"],Edit:["//**/*.env","//etc/**"]},Lde=["Bash","Task","Skill"];function Nde(e){let t=xde[e];if(t!==void 0)return{examples:t};let n=Bj.get(e);if(n!==void 0)return{via:n};return Fj.includes(e)?{hostsViaEgress:!0}:void 0}var Kj=new RegExp(`^(?:(${nx.BUILTIN_TOOL_NAMES.filter((e)=>!Bm.includes(e)).join("|")})(?:${Hj})?|(${Bm.join("|")}))$`),Zj=new RegExp(`^([^\\s()]+)(?:${Hj})?$`);function Vj(e){let t=(a,l)=>{let c=e.indexOf(e[a],a+1);for(let f=a+1,h=l;f<c;f++){let m=e[f];if(m==="(")h++;else if(m===")"&&h>0)h--;else if(m===","&&h===0)return-1}return c},n=[],s=0,r="";for(let a=0;a<e.length;a++){let l=e[a];if(l==='"'||l==="'"){let c=t(a,s);if(c!==-1){r+=e.slice(a,c+1),a=c;continue}}else if(l==="(")s++;else if(l===")"&&s>0)s--;else if(l===","&&s===0){n.push(r),r="";continue}r+=l}return n.push(r),{segments:n,open:s>0}}function qj(e){return Vj(e).segments.length>1}var Ude=/^[a-z_][a-z0-9_]+:/,Gj=new Map(nx.BUILTIN_TOOL_NAMES.map((e)=>[e.toLowerCase(),e]));
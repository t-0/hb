port"/$bunfs/root/chunk-r2trdfdb.js";import"/$bunfs/root/chunk-9ezkv9rk.js";import"/$bunfs/root/chunk-crgn2kck.js";import{Ii}from"/$bunfs/root/chunk-kty1a0q6.js";import"/$bunfs/root/chunk-jq0909qp.js";import"/$bunfs/root/chunk-308r2n92.js";import"/$bunfs/root/chunk-jza308vc.js";import"/$bunfs/root/chunk-3t04bq57.js";import"/$bunfs/root/chunk-hcv75t0m.js";import"/$bunfs/root/chunk-29pf53gz.js";import"/$bunfs/root/chunk-5vptq8f3.js";import"/$bunfs/root/chunk-x7qj5bmz.js";import"/$bunfs/root/chunk-77kk3b1p.js";import"/$bunfs/root/chunk-h0hb3fy1.js";import"/$bunfs/root/chunk-2sxey6yt.js";import"/$bunfs/root/chunk-js9c8z1x.js";import"/$bunfs/root/chunk-pfq9n5z3.js";import"/$bunfs/root/chunk-51r7pzpm.js";import"/$bunfs/root/chunk-h2h1db7q.js";import"/$bunfs/root/chunk-sm3y26zq.js";import"/$bunfs/root/chunk-44h0631d.js";import"/$bunfs/root/chunk-364aze2s.js";import"/$bunfs/root/chunk-5x6d5j8w.js";import"/$bunfs/root/chunk-034v2nnk.js";import{Wa}from"/$bunfs/root/chunk-616229ap.js";import"/$bunfs/root/chunk-1630q85a.js";import"/$bunfs/root/chunk-8ymk7rsy.js";import{ao}from"/$bunfs/root/chunk-ae60fng3.js";import"/$bunfs/root/chunk-c2ng2f1k.js";import{o,oe,u,_t}from"/$bunfs/root/chunk-g4mt1xmg.js";import"/$bunfs/root/chunk-p7mwgxe0.js";import"/$bunfs/root/chunk-mkz6kdvd.js";import"/$bunfs/root/chunk-a0jksnkd.js";import"/$bunfs/root/chunk-29vgs7s1.js";import"/$bunfs/root/chunk-409rha2c.js";import"/$bunfs/root/chunk-p6kf951e.js";import"/$bunfs/root/chunk-07spk723.js";import"/$bunfs/root/chunk-mrcj3k0r.js";import"/$bunfs/root/chunk-03k721nh.js";import"/$bunfs/root/chunk-epmfhn4m.js";var R="enable__mcp__claude-in-chrome",U="enable__mcp__remote-devices__Claude_Browser",B="enable__mcp__remote-devices__computer",c="request_computer",I="Enable Claude in Chrome, the Claude extension in the Chrome browser on the user's own computer, for this conversation. If you already have tools whose names contain claude-in-chrome__ or Claude_in_Chrome__, use those directly instead of calling this. Otherwise call it once, before any other Claude in Chrome tool, when the user asks you to do something in their browser or on a website that needs their own sign-in, or explicitly asks for Claude in Chrome. Do not call it for questions you can answer from the conversation or with web search, or merely because a request mentions a website.",k="Enable Claude in Chrome, the Claude extension in the Chrome browser on the user's own computer, for this conversation. If you already have tools whose names contain claude-in-chrome__ or Claude_in_Chrome__, use those directly instead of calling this. Otherwise call it once, before any other Claude in Chrome tool, when the user asks you to do something in their browser or on a website that needs their own sign-in, when a step in a skill or task the user asked you to carry out needs their browser or such a website, or when the user explicitly asks for Claude in Chrome. If the tools it turns on, or the tools for files on that computer, are missing from your tool list, calling it is how they are added, possibly a turn later. Do not call it for questions you can answer from the conversation or with web search, or merely because a request mentions a website.",N="Enable the browser built into the Claude desktop app on the user's computer for this conversation. If you already have tools whose names contain Claude_Browser__, use those directly instead of calling this. Otherwise call it once, before any other Claude app browser tool, when the user asks you to do something in the Claude app's own browser or on a website that needs their own sign-in, or explicitly asks for that browser. Do not call it for questions you can answer from the conversation or with web search, or merely because a request mentions a website.",L="Enable the browser built into the Claude desktop app on the user's computer for this conversation. If you already have tools whose names contain Claude_Browser__, use those directly instead of calling this. Otherwise call it once, before any other Claude app browser tool, when the user asks you to do something in the Claude app's own browser or on a website that needs their own sign-in, when a step in a skill or task the user asked you to carry out needs that browser or such a website, or when the user explicitly asks for that browser. If the tools it turns on, or the tools for files on that computer, are missing from your tool list, calling it is how they are added, possibly a turn later. Do not call it for questions you can answer from the conversation or with web search, or merely because a request mentions a website.",E={type:"object",properties:{task:{type:"string",description:"Optional: what you are about to do in the browser, in one or two sentences."}},additionalProperties:!1},v=`Any of them that was announced as available through ${Ii} must be loaded before you call it, unless ${Ii} has loaded it since`,A=`${v}: load the ones you expect to need in one ${Ii} call (for example, query "select:<name>[,<name>...]"), and use them once that result has come back, not in the same reply`,M="If no tool with such a name is in your list or was announced, or you have since been told that they are no longer available, do not call or load one. That applies to those tools only.",D=`Claude in Chrome needs no enabling: its tools are the ones whose names contain claude-in-chrome or Claude_in_Chrome. ${A}. ${M} If you have no browser tool of any kind, tell the user in one plain sentence that you can't use Claude in Chrome in this chat right now, and continue with what you can do here. You don't know the cause: don't say that Chrome or its extension isn't connected, and suggest no steps or settings for Claude in Chrome.`,x=`The Claude desktop app's built-in browser needs no enabling: its tools are the ones whose names contain Claude_Browser. ${A}. ${M} If you have no browser tool of any kind, tell the user that the browser in their Claude desktop app is not available in this chat right now and continue with what you can do here.`,P="Enable computer use on the user's own computer for this conversation, so you can see its screen and work in its applications (take screenshots, click, type, scroll, open apps). If you already have tools whose names start with mcp__remote-devices__computer_, use those directly instead of calling this. Otherwise call it once, before any other computer-use tool, when the user asks you to do something in an application on their computer, or explicitly asks you to use their computer or their screen. Do not call it for questions you can answer from the conversation or with web search, for work that only needs their web browser, or merely because a request mentions an application.",H="Enable computer use on the user's own computer for this conversation, so you can see its screen and work in its applications (take screenshots, click, type, scroll, open apps). If you already have tools whose names start with mcp__remote-devices__computer_, use those directly instead of calling this. Otherwise call it once, before any other computer-use tool, when the user asks you to do something in an application on their computer, when a step in a skill or task the user asked you to carry out needs an application on their computer, or when the user explicitly asks you to use their computer or their screen. If the tools it turns on, or the tools for files on that computer, are missing from your tool list, calling it is how they are added, possibly a turn later. Do not call it for questions you can answer from the conversation or with web search, for work that only needs their web browser, or merely because a request mentions an application.",q={type:"object",properties:{task:{type:"string",description:"Optional: what you are about to do on the computer, in one or two sentences."}},additionalProperties:!1},O=`mcp__${Bo}__computer_`,W=`The computer-use tools are the ${O} tools; there is no separate enable step. ${v}: load them all in one ${Ii} call (query "${O}", max_results 100), and use them once that result has come back, not in the same reply. Try the user's request with them, asking for access to the applications you need first, the way those tools describe. Don't tell the user their computer is connected until a call to one of them has succeeded; if calls keep not responding, the Claude app on the user's computer isn't answering: it may be closed or the computer asleep. Tell the user that, ask them to open the Claude app on that computer, and carry on with what you can do here. If you have no such tools here, tell the user that computer use isn't available on their computer right now and that the Claude app on that computer may show why under Settings \u2192 This computer \u2192 Computer use, then continue with what you can do here. Don't say a permission was denied unless a result says so.`,F=`If the request is about files or folders on the user's computer and you have device tools here (loaded or through tool search), such as mcp__${Bo}__device_list_dir, use them for that part; if it is and you have none, tell the user that files on their computer can't be reached right now.`,z="Does nothing. This tool cannot connect a computer here. Tools whose names start with mcp__remote-devices__, if you have any, run on the user's computer; use whichever of them fits the task.",J=`This call did not connect a computer, and no tool here can. Tools whose names start with mcp__${Bo}__, if you have any, run on the user's computer; use whichever of them fits the task, loading it with ${Ii} first, and waiting for that result, if it was only announced as available there and has not been loaded since. Otherwise carry on with the tools you have here, and if the task needs the user's computer, tell the user so.`,V=`This chat isn't linked to a computer right now, and no tool here can link one, including ${c} and the tools whose names start with enable__. That is a normal state, not an outage or a connection problem, so while you have no tools that run on the user's computer there is no point looking or waiting for them. The link can change during the conversation: if such tools (their names start with mcp__${Bo}__ or mcp__${Wa}__) are later in your tool list or announced to you, use them, whatever this result says. When your reply ends, the user may get a card under it about using one of their computers; you can't tell whether they get it. Tell the user it isn't linked in three or four plain sentences, in their language and without tool names, then do the task another way with the tools you have here if you can. For example: "I can't do that from here, because this chat isn't linked to a computer right now. If a card about using your computer appears below, you can go on from there. If none appears and you have the Claude desktop app on a computer, opening this chat there and sending a message can link it. If I still can't use your computer after that, adding a folder from that computer to this chat, in the desktop app, can." Say nothing about what you could do once it is linked or when that might be, and suggest no other steps or settings, with one exception: you can say that a file you made here can be put on their computer once it is linked. If the user's next message is only "Continue" or the name of a computer and you now have tools that run on their computer, go on with what they asked for, with those tools. If the user later says they did any of these and you still have no such tools, say that it still isn't linked, and name again only the steps they have not said they tried. If they say they tried all of them and you still have none, say only that it still isn't linked: no cause, and no step such as restarting or waiting.`,j=`Claude in Chrome is switched off for this chat, and no tool here can switch it on. Tell the user so in one or two plain sentences, in their language and without tool names. For example: "I can't use Chrome from here, because Claude in Chrome is switched off for this chat. You can switch it on under Connectors in this chat, on the web or in the Claude desktop app, if your organization allows Claude in Chrome." Then, if you have tools whose names contain Claude_Browser, offer to use the browser built into the Claude desktop app instead; otherwise do the task another way with the tools you have here if you can. Say nothing about what you could do once it is on, don't say that Chrome or its extension isn't connected, and suggest no other steps or settings for Claude in Chrome, with one exception: if the user says the switch already shows on, ask them to switch it off and on again there. If the user says they can't switch it on there, say only that you can't tell why from here, and that an organization can block Claude in Chrome for its members: no other cause, and no step. If the user says they switched it on, use Claude in Chrome's tools if you now have any (their names contain claude-in-chrome or Claude_in_Chrome); otherwise say only that you still can't use it here: no cause, and no step such as refreshing or waiting.`,Q=`Claude in Chrome is switched off for this chat, and this chat isn't linked to a computer right now. No tool here can change either, including ${c} and the tools whose names start with enable__. Both are normal states, not an outage or a connection problem. While you have none of Claude in Chrome's tools (their names contain ${Wa}__ or Claude_in_Chrome__) there is no point looking or waiting for them. Either state can change during the conversation: if such tools are later in your tool list or announced to you, use them, whatever this result says. Tell the user both in three or four plain sentences, in their language and without tool names, then do the task another way with the tools you have here if you can. For example: "I can't use Chrome from here: Claude in Chrome is switched off for this chat, and the chat isn't linked to a computer right now. You can switch Claude in Chrome on under Connectors in this chat, on the web or in the Claude desktop app, if your organization allows Claude in Chrome. If you have the desktop app on a computer, opening this chat there and sending a message can link it. If I still can't use your computer after that, adding a folder from that computer to this chat, in the desktop app, can." Say nothing about what you could do after that or when that might be, and suggest no other steps or settings for either, with one exception: if the user says the switch already shows on, ask them to switch it off and on again there. If the user says they can't switch it on there, say only that you can't tell why from here, and that an organization can block Claude in Chrome for its members: no other cause, and no step. If the user says they did any of these and you still have none of Claude in Chrome's tools, say that you still can't use it here, with no cause, and name again only the steps they have not said they tried. If they say they tried all of them and you still have none, say only that you still can't use it here: no cause, and no step such as refreshing or waiting.`,i="This call enables nothing, and no tool here can add Claude in Chrome: this chat has none of its tools right now. Tell the user in one plain sentence, in their language and without tool names, that you can't use Claude in Chrome in this chat right now. Then, if you have tools whose names contain Claude_Browser, offer to use the browser built into the Claude desktop app instead; otherwise do the task another way with the tools you have here if you can. You don't know the cause: don't say that Chrome or its extension isn't connected, and suggest no steps or settings for Claude in Chrome. If you later have its tools (their names contain claude-in-chrome or Claude_in_Chrome), use them.";var ee=f(()=>_t({task:oe().optional()})),te=f(()=>u({message:o()}));function w({description:e,sharedDescription:n,result:s}){if(n===void 0||Vie()===null||Kn("tengu_peaceful_leaf",!1)!==!0)return{descri
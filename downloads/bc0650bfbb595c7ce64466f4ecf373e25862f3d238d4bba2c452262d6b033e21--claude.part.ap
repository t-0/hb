function ifs(t){return/\bgit\b(?:\s+(?:-C\s+\S+|-c\s+\S+=\S+|--\S+))*\s+commit(?:\s|$)/.test(t)}function afs(t,n,s){if(s!==void 0)return s===0;let e=[/\[\w+[^\]]*\]\s+/,/create mode/,/\d+ files? changed/,/\d+ insertions?/,/\d+ deletions?/],i=t+n;return e.some((o)=>o.test(i))}
export{ifs,afs};

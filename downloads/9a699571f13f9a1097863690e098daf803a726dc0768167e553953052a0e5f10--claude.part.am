rectPort`.\n\n**Refresh.** With `offline_access` the app renews the token silently and prompts a browser sign-in only when refresh fails. Google never returns an `id_token` on refresh, so a Google Workspace-backed gateway in `id_token` mode re-prompts about hourly; `access_token` mode is unaffected.",{docsUrl:`${$e.COWORK_3P_DOCS_BASE}/gateway#single-sign-on-with-your-identity-provider`})}})}),Cee]),Dee=z.z.object({provider:z.z.literal("gateway"),baseUrl:C.field(C.annotate(Rr.httpsUrl.optional(),{redact:"hostname"}),{flatKey:"inferenceGatewayBaseUrl",readers:["desktop","m365"],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},remotePolicy:{rejectLoopback:!0,originPinned:{carries:"server-issued-credential"},requiresUserConsent:!0},title:M.msg({defaultMessage:"Gateway base URL",id:"JQs8c3pGcl"}),egressRequirements:(e,t)=>{var r;if(((r=t.inference)===null||r===void 0?void 0:r.provider)!=="gateway")return[];let i=Vt.safeHostname(e);return i?[i]:[]},category:"connection",predicates:{required:(e)=>!$e.hasActiveBootstrap(e)},placeholder:M.msg({defaultMessage:"https://llm-gateway.example.com",id:"we1m4ZIlaP"}),description:{short:C.shortDescription(M.msg({defaultMessage:"Full URL of the inference gateway endpoint.",id:"6cmRKZgiFv"}))}}),streamIdleTimeoutSec:C.field(z.z.coerce.number().int().min(300).max(1800).optional(),{flatKey:"inferenceStreamIdleTimeoutSec",support:{enabled:{scopes:["3p"],availableInVersion:"1.44121.1"}},title:M.msg({defaultMessage:"Stream idle timeout",id:"1zaCZqzDhD"}),category:"connection",order:85,suffix:M.msg({defaultMessage:"seconds",id:"8TQoLRh7Ea"}),placeholder:M.msg({defaultMessage:"300",id:"ady/daA2aj"}),description:{short:C.shortDescription(M.msg({defaultMessage:"Extra seconds to wait for model output on a streaming response that is sending only keep-alive pings. Gateway provider only. Default 300.",id:"vVjD8kgAio"})),long:C.longDescription("Raises how long Cowork, Chat and Code sessions wait for the next model event on an open st
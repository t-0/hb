ceModelPricingEnabled": true, "inferenceModelPricingMultiplier": 0.9, "inferenceModelPricing": [{"name": "claude-sonnet-4-6", "inputPerMtok": 2.4, "outputPerMtok": 12, "cacheReadPerMtok": 0.24, "cacheWritePerMtok": 3}]}\n```\nThese are estimates for visibility, not an invoice; your provider bills at its own rates. A machine-level Claude Code managed `modelPricing` (MDM / managed-settings.json / server-managed) takes precedence over this table.',{docsUrl:`${at.COWORK_3P_DOCS_BASE}/configuration#models`})}})}).optional(),catalogEnabled:ie.field(gt.z.boolean().optional(),{flatKey:"modelCatalogEnabled",support:{enabled:{scopes:["3p"],availableInVersion:"2.110.0"}},remotePolicy:{hybrid:{scope:"excluded"}},default:{displayOnly:!0},failClosedValue:!1,title:ae.msg({defaultMessage:"Model catalog metadata",id:"go+bdjd1f9"}),category:"connection",group:at.MODELS_GROUP,order:2,description:{short:ie.shortDescription(ae.msg({defaultMessage:"Label and describe the model picker\u2019s entries from the published Claude Code model catalog, instead of the app\u2019s built-in table.",id:"sikjjWW3Tp"})),long:ie.longDescription("When on (the default), the app reads the model catalog Anthropic publishes for Claude Code (a signed document fetched from `downloads.claude.ai`, or from `modelCatalogUrl` when that is set, and verified against a key built into the app; a copy bundled with the app is used until one has been fetched, or when the host is unreachable) and uses it to fill in each picker entry's display name, description, and thinking/effort options in the Chat, Cowork, and Code tabs. It never changes which models are offered, their order, or the default model (the first `inferenceModels` entry): those, 1M-context variants, and `labelOverride` still come from `inferenceModels` / discovery, and a model the catalog does not list keeps the built-in label. Set `modelCatalogEnabled: false` to keep the built-in labels and make no catalog fetch. Applies to deployments configured on the device or by a bootstrap server; an install managed from the Claude admin console takes its model names and options from the console's settings and never fetches the catalog.",{docsUrl:`${at.COWORK_3P_DOCS_BASE}/configuration#models`})}}),catalogUrl:ie.field(ie.annotate(Nm.httpsUrl.optional(),{redact:"hostname"}),{flatKey:"modelCatalogUrl",support:{enabled:{scopes:["3p"],availableInVersion:"2.110.0"}},remotePolicy:{hybrid:{scope:"excluded"},rejectLoopback:!0,applyUnverified:!0,hotApplied:!0},failClosedValue:Sj.MODEL_CATALOG_LOCATION_UNREADABLE_STAND_IN,unreadableStandIn:!0,title:ae.msg({defaultMessage:"Model catalog URL",id:"7QWnJvdV6y"}),egressRequirements:(e,t)=>{var n;if(((n=t.models)===null||n===void 0?void 0:n.catalogEnabled)===!1||e===Sj.MODEL_CATALOG_LOCATION_UNREADABLE_STAND_IN)return[];let i=Vu.safeHostname(e);return i&&!Nm.isLinkLocalOrMetadataHost(i)?at.singleHostEgress(e):[]},egressRequirementsLabel:ae.msg({defaultMessage:"Model catalog mirror",id:"a9epb+yGXN"}),category:"connection",group:at.MODELS_GROUP,order:2.1,placeholder:ae.msg({defaultMessage:"https://mirror.example.com/model-catalog/v1/catalog.json",id:"o9MdHULcKp"}),predicates:{show:(e)=>{var t;return((t=e.models)===null||t===void 0?void 0:t.catalogEnabled)!==!1}},description:{short:ie.shortDescription(ae.msg({defaultMessage:"Fetch the model catalog and its signature file from this URL (a mirror inside your network serving Anthropic\u2019s published files) instead of downloads.claude.ai.",id:"sFZOQNiiWa"})),long:ie.longDescription("When set, the app fetches the catalog document and its signature file (the same URL with `.raw-sig.json` appended to the path) from this URL instead of `https://downloads.claude.ai/model-catalog/v1/catalog.json`, for a gateway or mirror inside your network serving Anthropic's two published files byte-for-byte. The document is still verified against the key built into the app, so an edited or re-signed copy is refused and the app keeps its last verified copy (or the bundled one); there is no key to configure. `https://` is required (`http://` only to a loopback address, and only when set on the device itself; a bootstrap server may not deliver a loopback or non-`https://` value); the server must answer the GET directly (redirects are not followed) and may honor `If-None-Match` with `304`, and must serve a document at least as new as the one the install last accepted (or the bundled seed) \u2014 an older one is refused and re-fetched on the retry interval until the mirror catches up. Ignored when `modelCatalogEnabled` is `false`, and on an install managed from the Claude admin console (which never fetches the catalog). A value that is not a valid URL, names a link-local or cloud-metadata host (e.g. `169.254.169.254`, `metadata.google.internal`), or is a loopback / non-`https://` value a bootstrap server delivers, turns the catalog fetch off (no fallback to `downloads.claude.ai`); the last fetched or bundled copy keeps labelling the pickers. On an install configured for a bootstrap server, the default location is not fetched until the server's configuration applies after sign-in, so a device does not poll `downloads.claude.ai` while the server may yet name a mirror; a mirror URL set on the device, cached earlier, or served in a pre-sign-in subset still fetches. Diagnostics report the location only as `hosted`, `custom`, `invalid` or `pending`; the value itself is treated like `bootstrapUrl`: host name only in telemetry, printed in full in the diagnostics bundle.",{docsUrl:`${at.COWORK_3P_DOCS_BASE}/configuration#models`})}})});function Um(e){var t,n;return((n=(t=e.models)===null||t===void 0?void 0:t.pricing)===null||n===void 0?void 0:n.enabled)===!0}function cde(e){var t;let n=(t=e.models)===null||t===void 0?void 0:t.pricing;if(!n||!Um(e))return;let{enabled:i,...r}=n;return r}function dde(e,t,n){let{inferenceProvider:i,inferenceModels:r}=e;if(!i||!Array.isArray(r))return e;let a=r.filter((l)=>{let d=zm.checkModel(i,l.name);if(!d.ok)t(l.name,d.reason);else if("warn"in d&&d.warn)n===null||n===void 0||n(d.warn);return d.ok});if(a.length!==r.length&&a.length>0)e.inferenceModels=a;return e}function fde(e,t){return`inferenceModels: "${e}" is not an Anthropic model and was removed from the list \u2014 ${t}`}function pde(e,t,n){var i;let r=typeof e==="string"?Lm(e.trim()):"";if(!r||!((i=t.inference)===null||i===void 0?void 0:i.provider))return null;let a=zm.checkModel(t.inference.provider,r);return a.ok?null:Oj(n,a.reason)}function Oj(e,t){return e.formatMessage({defaultMessage:"Doesn\u2019t look like an Anthropic model: {reason}",id:"3RoY+bkhPc"},{reason:t})}});var Ow=L(function(Pj){Object.defineProperty(Pj,"__esModule",{value:!0});Pj.TelemetryConfig=void 0;var Mi=wn(),Jt=Et(),Fm=Nn(),dn=On(),Ss=eo();Pj.TelemetryConfig=Mi.z.object({orgUuid:Jt.field(Jt.annotate(Mi.z.string().optional(),{redact:"keep"}),{flatKey:"deploymentOrganizationUuid",support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},remotePolicy:{hybrid:{derived:!0},applyUnverified:!0},title:dn.msg({defaultMessage:"Organization UUID",id:"EATQrlttOw"}),category:"telemetry",group:Ss.ANTHROPIC_TELEMETRY_GROUP,order:-1,placeholder:dn.msg({defaultMessage:"00000000-0000-0000-0000-000000000000",id:"oT3AdLMVZK"}),description:{short:Jt.shortDescription(dn.msg({defaultMessage:"A UUID you generate. Tags telemetry so Anthropic support can locate your fleet\u2019s events, and namespaces each user\u2019s local data. Not used for auth.",id:"gvBRfDvKmN"})),long:Jt.longDescription("If unset, the app uses the organization of your Anthropic sign-in, where the connection has one. Otherwise, telemetry is tagged with a value the app derives from your connection settings. Where it cannot derive one, telemetry is tagged with a placeholder UUID shared with other unconfigured deployments. In the last two cases, local data is stored under the placeholder. **Changing this value orphans data** stored under the previous value (sessions, skills, plugins).")}}),disableEssential:Jt.field(Mi.z.boolean().optional(),{flatKey:"disableEssentialTelemetry",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},remotePolicy:{default:!0,applyUnverified:!0},failClosedValue:!0,title:dn.msg({defaultMessage:"Block essential telemetry",id:"rdKIIOydC8"}),default:!1,category:"telemetry",group:Ss.ANTHROPIC_TELEMETRY_GROUP,order:0,description:{short:Jt.shortDescription(dn.msg({defaultMessage:"Crash and performance reports to Anthropic.",id:"EGOuVJosgc"})),long:Jt.longDescription(`"Essential" means the signals Anthropic needs to keep your deployment working: **crash stacks**, **startup failure reasons**, **version/OS metadata**, and **crash dumps** (each an unfiltered copy of part of the app's memory). Reports carry a random install ID and an organization ID. The organization ID is the one you set, one the app takes from your Anthropic sign-in or derives from your connection settings, or a placeholder shared with other unconfigured deployments. Reports can also include a summary of your settings, the host names of addresses you configured, text you set for display (such as the display name, subtitle, and banner text and link), and a one-way digest of a session ID.

**What you lose when this is on:** when a Claude Desktop build hits a bug that only reproduces on your OS version or locale, Anthropic can't see it unless a user manually reports. Fixes ship slower.

**Why this is discouraged, not blocked:** some air-gapped environments require zero outbound telemetry as a matter of policy. The switch exists for them. If you don't have that constraint, leave it off.`,{docsUrl:`${Fm.COWORK_3P_DOCS_BASE}/telemetry#essential-telemetry`})},predicates:{warn:(e)=>e===!0?dn.msg({defaultMessage:"Crash and error reports are how we diagnose failures specific to your inference setup. Support turnaround will be slower without them.",id:"ek/rdG0G9V"}):null}}),disableNonessential:Jt.field(Mi.z.boolean().optional(),{flatKey:"disableNonessentialTelemetry",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},remotePolicy:{default:!0,applyUnverified:!0},failClosedValue:!0,title:dn.msg({defaultMessage:"Block nonessential telemetry",id:"oo4Av05fBn"}),default:!1,category:"telemetry",group:Ss.ANTHROPIC_TELEMETRY_GROUP,order:1,description:{short:Jt.shortDescription(dn.msg({defaultMessage:"Product-usage analytics and diagnostic-report uploads. No message content.",id:"0X/lTj2Hvv"})),long:Jt.longDescription(`"Nonessential" covers two things: **product-usage analytics** (which features get used, navigation patterns; no prompts or completions) and the **Send** action in Help \u2192 Generate Diagnostic Report. Turning this on stops both.

Destinations are listed under Egress Requirements \u2192 Nonessential telemetry.`,{docsUrl:`${Fm.COWORK_3P_DOCS_BASE}/telemetry#non-essential-telemetry`})},predicates:{warn:(e)=>e===!0?dn.msg({defaultMessage:"Usage analytics help us prioritize improvements for third-party inference. Diagnostic-report uploads will also be blocked. No message content is included in either.",id:"XtXm3euW3d"}):null}}),disableNonessentialServices:Jt.field(Mi.z.boolean().optional(),{flatKey:"disableNonessentialServices",support:{enabled:{scopes:["3p"],availableInVersion:"1.2581.0"}},failClosedValue:!0,title:dn.msg({defaultMessage:"Block nonessential services",id:"HA2UIzGsaT"}),default:!1,category:"telemetry",group:Ss.ANTHROPIC_TELEMETRY_GROUP,order:2,description:{short:Jt.shortDescription(dn.msg({defaultMessage:"Connector favicons, artifact-preview and MCP Apps iframes, and the Linux spellcheck dictionary. Connector widgets fall back to text; spellcheck is off on Linux.",id:"iwXupWG0F3"})),long:Jt.longDescription(`"Nonessential services" covers these outbound fetches the app runs without: **connector favicons** (the icon proxy), the **artifact-preview** iframe origin, the **MCP Apps widget** iframe origin (\`*.claudemcpcontent.com\`), and the **spellcheck dictionary** the built-in spellchecker downloads on Linux. Turning this on blocks all of them. (macOS and Windows use the system spellchecker. Windows still downloads a dictionary for a language it cannot check natively; this key does not stop that download.)

**What you lose when this is on:** connectors show without icons, the hosted artifact preview frame does not load (artifacts still render locally, without the CDN chart libraries they can otherwise load), connectors that return MCP Apps show the text tool result instead of the widget, Excel files in the Code tab preview only through Claude\u2019s workspace (the local VM) instead of that frame, and spellcheck underlines are off on Linux.

Destinations are listed under Egress Requirements \u2192 Nonessential services.`)},predicates:{warn:(e)=>e===!0?dn.msg({defaultMessage:"This disables connector icons, hosted artifact previews and MCP Apps widgets, and also turns spellcheck off on Linux. Artifacts still render locally, without CDN libraries; connectors that return MCP Apps show the text tool result instead of the widget.",id:"VinFqhloIq"}):null}}),usageMetrics:Jt.field(Mi.z.boolean().optional(),{flatKey:"usageMetricsEnabled",readers:["desktop","code"],support:{enabled:{scopes:["3p"],availableInVersion:"1.46388.1"},visibility:"public-undocumented"},remotePolicy:{hybrid:{scope:"only",derived:!0},hotApplied:!0},predicates:{show:()=>!1},title:dn.msg({defaultMessage:"Report usage metrics to your Claude.ai organization",id:"hFaw5XYgDV"}),category:"telemetry",group:Ss.ANTHROPIC_TELEMETRY_GROUP,order:3,description:{short:Jt.shortDescription(dn.msg({defaultMessage:"Set by the control plane from the organization\u2019s Claude Code analytics setting; not editable here. Reports per-user token, cost and session counts (no content).",id:"6k4DCNJe7b"})),long:Jt.longDescription(`Server-derived: the Claude.ai control plane sets this key, each time it serves the configuration, from the organization's Claude Code analytics setting in Admin settings; it is off until an admin turns that setting on, and off for organizations under HIPAA or customer-managed encryption keys. It is not authored in any form, MDM profile, or bootstrap server, and a value stored anywhere else is ignored.

When on, each signed-in desktop periodically reports usage counters to your Claude.ai organization: per-member **token counts** (input, output, cache read, cache write) by model, the desktop's **cost estimate** for those tokens, and **session counts**, tagged with the member's account, the model name, the app surface (Chat, Cowork or Code), an opaque per-session and per-install identifier, and the app version, operating system and architecture. No prompts, responses, file contents, tool inputs or outputs are included. Sessions and the cost estimate appear in your organization's Claude.ai analytics (Analytics \u2192 Claude Code); the Admin API Claude Code usage report carries those plus per-member, per-model token counts.

This is independent of **Block essential telemetry** and **Block nonessential telemetry**: those govern diagnostics sent to Anthropic, this one populates your own organization's dashboard, and either can be on without the other. Reports go to the same Claude.ai endpoint the desktop fetches its configuration from, so no additional firewall entry is needed. A change takes effect without a relaunch once two configuration syncs in a row have served it.`)}})})});var Sw=L(function(Cj){Object.defineProperty(Cj,"__esModule",{value:!0});Cj.MANAGED_MCP_PRESETS=void 0;Cj.isAnthropicM365ConnectorUrl=Ij;Cj.isAnthropicM365Connector=Sde;var wde="07c030f6-5743-41b7-ba00-0a6e85f37c17",Ode=[".claude.com",".fedstart.com"];function Ij(e){if(!e)return!1;if(!Ode.some((t)=>e.hostname.endsWith(t)))return!1;return e.hostname.startsWith("microsoft365.mcp.")||e.pathname.includes("/m365/")}function Sde(e){if(!(e===null||e===void 0?void 0:e.url)||e.custom_oauth_client_id)return!1;try{return Ij(new URL(e.url))}catch(t){return!1}}Cj.MANAGED_MCP_PRESETS=[{label:"Microsoft 365",item:{name:"m365",url:"https://microsoft365.mcp.claude.com/mcp",transport:"http",oauth:{scope:`api://${wde}/access_as_user offline_access`}}},{label:"Box",item:{name:"box",url:"https://mcp.box.com",transport:"http",oauth:{authorizationServer:["https://api.box.com"]}}},{label:"Microsoft 365",kind:"builtin",item:{name:"Microsoft 365",server:"microsoft365"}},{label:"Web search",kind:"builtin",item:{name:"Web search",server:"websearch",provider:"brave"}},{label:"GitHub",kind:"builtin",item:{name:"GitHub",server:"github"}}]});var kw=L(function(jj){Object.defineProperty(jj,"__esModule",{value:!0});jj.McpConfig=void 0;jj.isMcpPersistentAlwaysAllowEnabled=Ade;var In=wn(),Dj=xu(),qu=Sr(),Ye=Et(),Nr=Nn(),Qe=On(),Mj=Sw(),fr=Rr(),pr=eo();function Pde(e,t){var n;let i=typeof t.url==="string"?t.url.trim():"",r=t.headers&&typeof t.headers==="object"?t.headers:void 0,a=[],l;try{l=i?new URL(i):void 0}catch(p){}if((l===null||l===void 0?void 0
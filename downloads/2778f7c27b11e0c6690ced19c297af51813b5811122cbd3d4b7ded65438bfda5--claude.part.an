Any extra args are passed to the underlying Claude Code session.`);return}await j6t(s);let a=await nje(s);if(a!==null)HIe(a.reason);n3();let n=RB(s);if(l3e(n),K()&&n!==void 0){QW({storageV5:n}),cW(n);let[{composePolicyLimitsClient:o,primePolicyLimitsCache:c},{credentialsStoreFor:p},{primeFastPathCredentials:m}]=await Promise.all([import("/$bunfs/root/chunk-q86dc1z5.js"),import("/$bunfs/root/chunk-pskbze2n.js"),import("/$bunfs/root/chunk-n7fkbdyb.js")]);o({storageV5:n}),await m(p(n)),await c(n),await j5(n)}let r=h(rTs()),u=Mf()?[]:[process.argv[1]],d=t.length>0&&!t[0].startsWith("-")?[]:[v],l=[...u,...d,"--append-system-prompt",r,"--tools",g,"--permission-mode","default",...t];if(i.DEBUG)console.error("[self-hosted-runner:setup] spawning:",_({argv:[process.execPath,...l.map((o)=>o===r?`<${r.length} chars>`:o)]}));let e=f(process.execPath,l,{stdio:"inherit"});if(e.error)return await Vt("cli_self_hosted_setup","spawn_failed"),console.error(`[self-hosted-runner:setup] failed to spawn child: ${e.error.message}`),Ho(1);if(e.status!==null&&e.status!==0||e.signal)await Vt("cli_self_hosted_setup",e.signal?"child_signal":"child_nonzero"),console.error(`[self-hosted-runner:setup] child exited with status ${e.status??"(null)"}${e.signal?`, signal ${e.signal}`:""}`);else await jr("cli_self_hosted_setup");return console.error("[self-hosted-runner:setup] To continue setup, re-run `claude self-hosted-runner setup` \u2014 resuming the session with `claude --resume`/`-c` will not re-enable the setup tools."),Ho(e.status!==null?e.status:1)}export{q as selfHostedRunnerSetupMain};

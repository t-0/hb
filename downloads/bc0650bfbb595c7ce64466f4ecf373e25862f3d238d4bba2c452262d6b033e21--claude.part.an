What does NOT arrive: per-suite CI successes, new pushes to the PR branch, and merge conflict transitions. The server only forwards check_run events whose conclusion is \`failure\` or \`timed_out\` \u2014 individual passing, skipped, and cancelled checks are dropped; the all-green signal arrives once as the \`check_suite.completed\` notice above. Pushes (\`synchronize\`) are not forwarded to bound sessions either \u2014 poll \`gh pr view N --json headRefOid\` if you need to detect new commits. GitHub computes \`mergeable_state\` lazily on API fetch and does not fire a webhook when the base branch advances and creates a conflict. If you're babysitting a PR to landing, poll \`gh pr view N --json mergeable\` between webhook events \u2014 webhooks alone will miss a PR going from clean to conflicted.`;var fts=new Set([si,Rf,Za,MN,Lht,vy]),mts=new Set([Be,Tt]);function e0n(e,n){let{action:r}=n;if(e===Zt){let s=(r===void 0||r==="publish")&&n.asset===!0;return G3o(n)&&!s||r==="watch"||r==="resume_replies"}return e===a_&&r==="watch"&&(n.replies===!0||n.on!==!1&&n.url!==void 0)}var t0n=(e,n)=>(r,s)=>{let h=e(r.tool),y=nY(r),b=y.run_in_background,w=b===!0||b==="true",H=h===Z$n&&y.action!=="unsubscribe",K=fts.has(h)||mts.has(h)&&w||H||e0n(h,y)?OC(s,"$.tool.call"):void 0;if(K!==void 0)pm(()=>vje(s.plugin));let Q=e0n(h,y)?"a page publish, a watch or a resume of replies arms a watch on the page":H?"a subscription's events would arrive as input":h===vy?"a script of it can start an agent, which nothing inside it holds":"it starts background work, a schedule or a goal";return K===void 0?n(r,s):Promise.resolve({deny:`${h} was not run: ${Q}, and ${K}`})};var llt=Object.freeze({[ht]:"runs the Agent tool: that is $.agent.spawn",[es]:"runs the AskUserQuestion tool: that is $.ui.ask",[au]:"runs the Workflow tool, whose agents run outside the at-once bound on spawns: $.agent.spawn is the door"});var n0n={check:(e)=>{if(!D(e)||typeof e.tool!=="string"||String(e.tool)==="")return"takes the ev
,ho=f(()=>B(["authentication_failed","oauth_org_not_allowed","account_on_hold","verification_required","billing_error","rate_limit","overloaded","invalid_request","model_not_found","server_error","unknown","max_output_tokens","cloud_credential_error"])),NF=f(()=>Fe([T("compacting"),T("requesting"),Zf()])),CA=f(()=>u({uri:o(),name:o(),title:o().optional(),description:o().optional(),mimeType:o().optional(),size:E().optional(),annotations:me(o(),oe()).optional()})),IF=f(()=>u({kind:B(lri),servers:C(o()).optional().describe("mcp_needs_auth / mcp_disabled: the server names as configured. mcp_required_missing: the name patterns the agent definition requires that no connected server matches."),provider:B(dri).optional().describe("auth_expired / auth_overridden / auth_missing_scope / design_needs_authorization: whose login the fix names \u2014 'claude_ai' (the claude.ai account, /login) or 'claude_design' (Claude Design's own authorization, /design login)."),path:o().optional().describe("outside_reads_blocked: the path the read block refused, when the refusal names one. staged_for_review: the settings file the write was held for."),managed:O().optional().describe("outside_reads_blocked: an organization policy sets the block, so the user cannot remove it. auth_overridden: the overriding credential was injected by the host environment, so nothing in this session can unset it."),feature:B(cri).optional().describe("feature_disabled / policy_denied: the feature that is off."),cause:B(uri).optional().describe("feature_disabled: why the feature is off \u2014 'managed_settings' (CLAUDE_CODE_DISABLE_WORKFLOWS, or disableWorkflows or enableWorkflows: false set by a layer above the user's own settings), 'org_policy', 'unavailable' (not launched for this account), 'user_setting' (the user's /config setting is off, including a disableWorkflows in their own settings, and nothing the user cannot clear also keeps them off), or 'unsupported_runtime' (this Claude Code process is not running on Bun, the runtime its binary is built with, and workflow scripts run only there)."),policy_kind:B(pri).optional().describe("policy_denied: the verdict \u2014 'org_denied' (the organization's policy turns the feature off) or 'latched' (a HIPAA-regulated organization signed in earlier in this process; restarting clears it).")}).describe("@internal The fix a host can offer for a tool result, stamped from structured producer state (never parsed from the result text). Kinds: mcp_needs_auth, mcp_disabled, mcp_required_missing, auth_expired, auth_overridden, auth_missing_scope, design_needs_authorization, sandbox_violation, outside_reads_blocked, memory_paused, feature_disabled, policy_denied, spawn_arg_limit (the command's exec image exceeded the OS argument limit), staged_for_review (a settings-file write held for the machine owner's review). New kinds are additive; treat an unknown kind as absent.")),uo=f(()=>Kr("kind",[u({kind:T("human")}),u({kind:T("channel"),server:o()}),u({kind:T("peer"),from:o(),fromMode:B(["bypass","prompting"]).optional().describe("The SENDING session's permission class as declared by the host that injects this message on local stdin ('bypass' for sessions that run tools without asking, 'prompting' otherwise). Lets the recipient deliver a same-class message immediately while a cross-class or undeclared sender is still held at a recipient that runs without asking. Honored only from the injecting host on local stdin; absent when the host does not declare it."),name:o().optional().describe("Sender display name, normalized by the harness: Unicode control, format, surrogate, and line/paragraph-separator code points stripped (categories Cc/Cf/Cs/Zl/Zp \u2014 covers bidi controls, zero-width characters, and tag characters), trimmed, at most 64 code points (+ ellipsis, never splitting a surrogate pair). Sender-asserted display text (the addressable identity is `from`) \u2014 render it as reported speech, but no client-side character sanitization is needed. Absent when the wire is not exactly one harness-formed envelope and on messages from older senders."),fromSession:o().optional().describe("The sender's host-openable session id (the envelope's `from-session` attribute \u2014 e.g. a desktop `local_<uuid>` or a cloud session `session_`/`ses_` id), set by the sender's host so a receiving UI can link this message back to the sending session. Sender-asserted like `from`: a navigation target only, never authority. Absent when the sender's host provides none and on messages from older senders."),inbound_origin:o().optional().describe("@internal Server-asserted ingest path of the demoted delivery, copied at classification from the message-level `inbound_origin`."),senderTaskId:o().optional().describe("Task id of the in-process background subagent that sent this message, stamped by the harness from the sending loop (never from tool input). Absent for cross-session peers."),body:o().optional().describe("Decoded message body with the peer envelope stripped \u2014 byte-exact with what the model sees. Present only when the turn is exactly one harness-formed envelope (or an in-process agent message); render this instead of re-parsing the message text."),verifiedPeerPid:E().optional().describe("Kernel-verified pid of the process that connected to this session's cross-session messaging socket, read from the connection (SO_PEERCRED / LOCAL_PEERPID) \u2014 never from the payload. This identifies the CONNECTING process, which for relayed traffic (e.g. a daemon forwarding on another session's behalf) is the relay, not the message's author. Key sender identity on this, never on `from`: `from` is sender-authored and kept only for reply routing, so it is forgeable by any same-user process. Absent when unverifiable (Windows, non-UDS ingress) \u2014 never a wrong value. Pids are recyclable: provenance, not an authentication token."),handback:T(!0).optional().describe("@internal Present, and always true, when the message is a subagent's final report to the agent that launched it, delivered through the SubagentHandback tool. Stamped by the harness, never from tool input. `body` is then the hand-back frame line with the indented report under it, and any harness note above it; `handbackReportText` and `handbackNote` carry those two parts for display. A boolean mark: not the `handback` state string of a task notification or of an Agent tool result. A hand-back is never joined, so neither this mark nor `flagged` appears beside `members`."),flagged:T(!0).optional().describe("@internal Present, and always true, on a hand-back that auto mode's review blocked, or that it could not judge because a safety filter refused the review request: the report was delivered all the same, under the SECURITY WARNING that `handbackNote` carries. Never cap or fold such a message: show the note and the report in full. Absent on a hand-back that was not flagged, including one delivered under the note that the review was unavailable."),handbackNote:o().optional().describe("@internal On a hand-back: the note the harness composed above the frame line in `body`, without the indent. On a blocked report it quotes the review's reason, which can quote the report, so show it as untrusted text. Absent when there is no note."),handbackReportText:o().optional().describe("@internal On a hand-back: the subagent's report as the model reads it, under the frame line in `body`, without the indent. Draw it as a separate element from `handbackNote`: the two fields are their only boundary. Absent wherever `body` is and on a message that is not a hand-back."),members:C(u({body:o()})).optional().describe("@internal On a prompt that joins several queued messages from this sender: the joined messages in the order the model reads them, each with its own `body`. The origin's `body` is then absent. Absent on a message that was not joined and when any joined message had no `body`.")}),u({kind:T("task-notification"),subkind:B(["scheduled-trigger","peer-send-message","projects-relay","session-inbox"]).optional().describe("Present when the delivery is the fired stored prompt of a scheduled task/routine ('scheduled-trigger', stamped from server-asserted provenance, or declared by a local host for its own scheduled runs; the schedule attests storage, not authorship) or a coordinator co-member SendMessage delivery ('peer-send-message': model-authored text from another of the same user's sessions, verified by the server-stamped receiver co-membership \u2014 task-notification for prompt authority, but distinguishable so the receive-side crossSessionInbound setting can apply to it). The harness frames a scheduled-trigger delivery as the session's assigned task instead of the generic background-notification frame. Absent on webhook, PR-steward, plugin, and background-event deliveries."),fireReason:o().optional().describe("On a 'scheduled-trigger' delivery, why it fired: a short lowercase token such as 'scheduled', 'manual', 'retry', 'catch_up' or 'api'. Set by the server for cloud routines, or declared by a local host for its own scheduled runs, which is honored only in a process the host started with CLAUDE_CODE_HOST_SCHEDULED_RUN=1 (a local host's value is kept only if it is 1 to 32 lowercase letters or underscores); absent when neither sent one."),producer:T("session-task").optional().describe("@internal Present ('session-task') when the notification reports on work this session itself launched: a background agent, shell command, workflow, monitor, MCP or remote task settling, a detached tool call, or a hook rewake or worker check-in following up on such work. Absent on webhook, artifact and other externally-authored deliveries."),runId:o().optional().describe("On a background task's own notification: the run_id its task_* events carried, as of when the notification was queued. Not part of the text the model reads."),taskKind:T("mcp-task").optional().describe("@internal Present ('mcp-task') only on a notification that an MCP server's own task has ended, and not on every one. Narrower than task_type 'mcp_task', which also covers an MCP tool call moved to the background.")}),u({kind:T("coordinator")}),u({kind:T("unclassified")}).describe("Injected turn whose ingress classification found no provenance. Framed by the harness as a non-user source in both drains; never presumed human, never host-replayed."),u({kind:T("observer"),from:o(),senderTaskId:o()}).describe("Report from a background observer agent to the agent it observes. One-way by construction \u2014 the observed agent must not reply."),u({kind:T("auto-continuation")}),u({kind:T("observer-activity")}).describe("Activity digest delivered to an observer agent. The message body is the self-framing digest (envelope + postamble); observed content is data, not instructions.")]).describe("Provenance of a user-role message (peer session, team lead, channel). A host wrapping keyboard input must stamp {kind:'human'} explicitly \u2014 absent origin is treated as unattributed and fails closed at strict isHuman() trust gates.")),OA=f(()=>u({type:T("user"),message:kF(),parent_tool_use_id:o().nullable(),isSynthetic:O().optional(),tool_use_result:oe().optional().describe("Structured tool output \u2014 the tool's full Output object, not the string content sent to the model. The shape is per-tool, keyed by the matching tool_use block's name (see the *Output types in toolTypes); MCP and dynamic tools carry their own shapes, so the field stays unknown-typed. For the Agent/Task tool the completed shape is the subagent's final report without the model-directed agentId/usage trailer, plus run totals \u2014 render from it instead of parsing the tool_result text. A call that stepped aside for a message the user sent (today a WebFetch or WebSearch call) carries `{ detachedToolCall: true }` in place of its Output: the call is still running, and its result reaches the model in a later turn."),priority:B(["now","next","later"]).optional(),requeue_if_interrupted_within_ms:E().int().positive().optional().describe("@internal Input only. Asks the CLI to put this prompt back in its queue, instead of losing it, when an interrupt crosses with a running turn taking the prompt in: the interrupt was sent while its sender still believed the prompt was waiting. The value says for how long an interrupt is taken to have been sent so: a whole number of milliseconds from 1, and above 10000 it counts as 10000. The time runs from the moment the turn announces the model request that carries the prompt (system/status 'requesting', which is on the wire only with partial messages); until then it has not begun. The prompt is put back when an interrupt control request without cancel_queued stops that turn within the time and before the model's next reply has begun to arrive. It goes back to the front of the queue under the same uuid and runs in a later turn of its own, after any queued prompt of higher priority; prompts queued behind it are not merged into that turn's prompt, though the turn can take them in as any turn does. The interrupt's response lists it under still_queued and under put_back, and from then on cancel_async_message can withdraw it. The stopped turn reports no 'cancelled' for it, counts it in its result's queued_turn_count (if its origin is stamped user-driven, as for any queued prompt) and leaves it out of that result's user_message_uuids (on an error result an empty list, with no user_message_uuid, if nothing else is listed). On stdout it reports command_lifecycle 'queued' a second time; over a remote transport its delivery is not reported 'processed' until its later turn ends. With cancel_queued:true it stays with the stopped turn and is not listed under the response's cancelled. The row the stopped turn wrote for it (a queued_command attachment) leaves the conversation and is never stored, so the model sees the prompt once; until the prompt can no longer be put back, that row and the rows after it are kept out of the stored transcript. UserPromptSubmit hooks run for it twice, and what they added to the stopped turn stays. If a compaction begins while that row is kept out, the row is stored at once and stays in the conversation, so the prompt, if an interrupt puts it back or has just done so, is seen twice. A prompt is put back at most once, and never after the host's own cancel_async_message for it answered cancelled:false. Of several prompts taken in since the model last spoke, only the last can be put back; the others stay with the stopped turn. The field is ignored when it is not such a number, when the message has no uuid or has shouldQuery:false, and when the message is not a person's own typing: a synthetic, hidden, client-composed, seeded, peer or relayed message, one that declares a non-human origin, or one whose client_platform names no app or keyboard that a person types in. claude-code-server also needs a client_platform, and one that names an app. A CLI that does not advertise interrupt_requeue_taken_v1 on system/init ignores the field too."),origin:uo().optional(),client_platform:o().optional().describe("@internal The `anthropic-client-platform` value of the client that sent this message (e.g. `ios`, `android`, `web_claude_ai`, `desktop_app`). Injected server-side by CCR ingress from the request header."),inbound_origin:o().optional().describe("@internal Server-asserted ingest path that produced this message. Not settable by clients."),server_received_wall_ms:E().optional().describe("@internal Epoch ms on the session server's clock when it received the HTTP request that delivered this message. Written by the session server; the CLI copies it to the turn's result as user_message_server_received_wall_ms."),historical:O().optional().describe("@internal Replayed history rather than a live message: the Remote Control bridge stamps it on the messages it flushes to the session server, which also stamps it on deliveries it replays."),shouldQuery:O().optional().describe("When false, the message is appended to the transcript without triggering an assistant turn. It will be merged into the next user message that does query."),timestamp:o().optional().describe("ISO timestamp when the message was created on the originating process. Older emitters omit it; consumers should fall back to receive time."),is_meta:T(!0).optional().describe("@internal True when the message was synthesized by the loop (not user keyboard input). From internal UserMessage.isMeta."),seeded_summon:T(!0).optional().describe("@internal Desktop host only: the host's own seeded summon."),client_composed:T(!0).optional().describe("The client composed this turn from content the user did not type; the CLI delivers its text as written, with no `@path` file-mention expansion and no slash-command dispatch. On current CLIs the turn-start attachment pass is skipped as a whole: `@server:resource` MCP mentions are not expanded either, and the prompt is sent without the context the CLI normally attaches alongside it (nested `CLAUDE.md` and rules files, skill and tool listings, reminders); the pass the CLI runs between tool calls is unaffected."),text_not_typed:Ia(Qr,T(!0).optional()).describe("@internal No person typed this message's text in this session (a server or an app composed it). The text is delivered as written and is not treated as typing: no slash-command dispatch, no at-mention expansion beyond the message's own uploaded files, no reminder or command from keywords in it, and a skill named in it does not count as typed by the user. Who sent the message, and whether a person is present, stays with its origin. The checks of whether a message's words are the user's own do not read this mark yet: they too go by the origin. Unlike client_composed, the turn-start attachment pass still runs. Any value other than false or null is read as true."),initiator:o().optional().describe("@internal The host's own label for what started this turn (e.g. the desktop app's `scheduled-task`, `sleep-auto-resume`); `user` or absent means a person sent it. Usage attribution only; it does not change how the turn runs."),is_visible_in_transcript_only:T(!0).optional().describe("@internal True when the message is stored in the transcript but not rendered in the live UI."),is_virtual:T(!0).optional().describe("@internal Display-only: rendered in the UI but filtered before API send."),is_compact_summary:T(!0).optional().describe("@internal True when this user message is a compact-summary synthetic message."),summarize_metadata:u({messages_summarized:E().int(),user_context:o().optional(),direction:B(["from","up_to"]).optional()}).optional().describe('@internal Metadata for "Summarize from here" / "Summarize up to here" summaries (from internal UserMessage.summarizeMetadata).'),mcp_meta:u({_meta:me(o(),oe()).optional(),structured_content:me(o(),oe()).optional(),resource_links:C(CA()).optional().describe("CLI-owned: the `resource_link` content blocks the MCP tool returned, collected from the raw result before the CLI rewrites each into the `[Resource link: NAME] URI` text line the model reads \u2014 so a host renders the files without parsing that line. At most 50 links and 64 KiB serialized; absent when the result had none, and absent on a subagent's tool results (parent_tool_use_id set), whose mcpMeta carries `_meta` only. On today's wire this rides the mcpMeta spread as `tool_use_result.resourceLinks`. A sibling of `_meta`, never inside it: a server cannot supply it, and server `_meta` keys under the CLI-reserved `com.anthropic/` prefix are dropped before this message.")}).optional().describe("@internal MCP protocol metadata passed through to SDK consumers, never sent to the model (from internal UserMessage.mcpMeta)."),tool_result_meta:C(u({id:o(),non_execution_kind:B(Azt).optional(),user_feedback:o().optional(),remedy:IF().optional(),permission_decision:u({decision:B(mA),source:o(),reason_type:B(Okt).optional().catch(void 0)}).optional().catch(void 0)})).optional().describe("@internal Display metadata for this message's tool_result blocks, keyed by tool_use_id. non_execution_kind is the harness-stamped reason an is_error:true result did not carry the tool's own execution output (user-rejected / permission-rule / automode-* / interrupted / cancelled); absent means the tool ran to completion. remedy is the fix a host can offer for what the result reports (see SDKToolResultRemedy). An entry may carry a remedy alone, on a result that did run (a staged write, a sandbox violation on exit 0), so whether a call ran is read from non_execution_kind, never from an entry's presence. On a subagent's messages (parent_tool_use_id set), entries carry only permission_decision, so those messages do not say whether a call ran. permission_decision is how the call's permission check ended, as Claude Code's claude_code.tool.blocked_on_user trace span reports it. decision is accept, reject or cancelled. source names what decided: config, classifier, hook, user_temporary, user_permanent, user_reject, user_abort, or invalid_input, permission_updated_input_invalid or server_fallback_tombstone when bad input or the server ended the wait. Which label a rule gets depends on the session: in SDK sessions a rule for this session or in the user's own settings reports user_temporary, user_permanent or user_reject and other rules report config, while interactive sessions report every rule as config. reason_type is the kind of reason the check gave when it decided by itself, such as 'rule' whenever a rule decided, or 'classifier' for an auto-mode allow, which reports source config. reason_type is absent when a person or the SDK host answered the question, when the check's outcome was still a question, and for user_abort and the last three sources above. permission_decision is absent when the call ended before its permission check, and on some results built apart from the call's own run, such as a plugin hook's refusal, a hook's rewrite of a denied result, or the result the tool executor writes for a queued call that a stop cancelled. user_feedback is the deny comment a human typed at a permission prompt (the local dialog or a bridge client's deny UI), before the CLI's reject-message framing \u2014 absent when the deny was resolved by a coordinator, channel relay, or hook rather than a human. A deny answered through the SDK control protocol (can_use_tool / --permission-prompt-tool) currently reports as 'permission-rule' with no user_feedback, because that wire carries no human-provenance signal. Wrapper-level sibling \u2014 never inside `message.content` \u2014 so it is not replayed to the model. Clients read this instead of string-matching the result prose."),source_tool_use_id:o().optional().describe("@internal When this message was generated by a tool via newMessages, links it to that tool_use id."),source_tool_assistant_uuid:o().optional().describe("@internal For tool_result messages: UUID of the assistant message containing the matching tool_use block. Used for parentUuid assignment in transcript."),image_paste_ids:C(E().int()).optional().describe("@internal Paste IDs for images in this message, in order of appearance. REPL-local state \u2014 candidate for surface-side if daemon has no use for it."),plan_content:o().optional().describe("@internal Plan to implement (cleared-context flow). When set, the message is rendered with plan styling."),permission_mode:de().optional().describe("@internal Permission mode active when this message was sent (for rewind restoration)."),interrupted_message_id:o().optional().describe("@internal For [Request interrupted by user] markers only: the API msg_* id that Esc cancelled."),refused_message_id:o().optional().describe("@internal Only on the synthetic message that re-asks the same model after a refusal: the API msg_* id of the refused response. Absent when the CLI has no well-formed id for it.")})),un=f(()=>OA().extend({uuid:p().optional(),pasted_content:C(zF()).optional().describe("Content the user pasted into the prompt rather than typed: each entry a string or an array of content blocks. The CLI appends the text of each entry after the typed text, in order, and may wrap it in `<pasted_content>` tags. Blocks other than text are ignored; send images and documents in `message.content`. A list of over 1,000 entries and blocks in all is ignored."),inline_pastes:C(o()).optional().describe("Text the user pasted that is still in `message.content` where they put it: each entry one paste. The prompt is not changed by the host; the CLI may wrap each entry in `<pasted_content>` tags where it still stands in the last text block. It looks for the first 100 entries that are not blank. For a paste the host took out of `message`, use `pasted_content` instead."),session_id:o().optional(),agent_id:o().optional().describe("ID of the subagent that produced this message: the `task_id` of its task events, unchanged when the subagent is resumed. Absent on main-thread messages."),subagent_type:o().optional().describe("Subagent type that produced this message."),task_description:o().optional().describe("Description of the subagent task that produced this message."),file_attachments:C(oe()).optional().describe("@internal Files a remote client attached to this prompt (each {file_uuid, file_name, is_image?, sha256?, file_size?}; src/bridge/inboundAttachmentSchema.ts reads them). Typed like SDKUserMessageReplay.file_attachments so the two message types stay assignable.")}).describe("A user-role message. A client writes one to the CLI to submit a prompt (this starts a turn); the CLI emits them for user-role content it adds to the conversation itself, chiefly the tool_result blocks answering the assistant's tool_use blocks.")),PF=f(()=>OA().extend({uuid:p(),session_id:o(),isReplay:T(!0),file_attachments:C(oe()).optional()})),NA=f(()=>u({type:T("bash_command"),command:o().describe("Shell command run verbatim, without the model and without permission checks. Trust model matches the local TUI `!cmd` path (no sandbox, no per-command prompt). By default it runs in a one-shot `/bin/sh -c` (or `pwsh`) beside the conversation, which never sees it; on a cloud worker with tengu_cloud_session_shell on it runs as the TUI's `!cmd` does, through the Bash tool (its working directory carries over to later commands and to the model's Bash calls), as a turn of its own, so the model sees the command and its output. The worker refuses some commands with a row saying why (for example a stale one, one over 65,536 characters, one containing control characters, or one sent to a host that does not run them) and skips a duplicate silently (cli/headlessHost/bashCommand.ts)."),cwd:o().optional().describe("Working directory for the command. Falls back to the session cwd when omitted. With tengu_cloud_session_shell on, the command runs in the session's current directory and one naming any other directory is refused."),uuid:p().optional(),session_id:o().optional()}).describe("@internal A user-initiated shell command. Input-only \u2014 sent by CCR clients that surface a dedicated terminal UI; never emitted on stdout. Acknowledged on arrival and, unless blank, too long or a duplicate, echoed at once as a `<bash-input>` replay row; then answered with exactly one more row: its output (a replay frame when run beside the conversation; a plain user message after its own turn when it joins the conversation, possibly followed by the model replying) or a `<bash-stderr>Not run: \u2026</bash-stderr>` replay row saying why it was refused or dropped. A blank or too-long command gets only its Not run row; a duplicate gets nothing. Other rows can come between the echo and that row.")),uKr=f(()=>u({status:B(["allowed","allowed_warning","rejected"]),resetsAt:E().int().optional(),rateLimitType:B(["five_hour","seven_day","seven_day_opus","seven_day_sonnet","seven_day_overage_included","overage"]).optional(),utilization:E().optional(),unifiedWindows:u({five_hour:u({utilization:E(),resetsAt:E().int()}).optional(),seven_day:u({utilization:E(),resetsAt:E().int()}).optional(),seven_day_overage_included:u({utilization:E(),resetsAt:E().int()}).optional()}).optional().describe("@internal Per-window usage for the session (5-hour), weekly (7-day), and overage-included weekly (per-model bucket; present only for accounts whose responses carry that window) subscription rate-limit windows, as read from the anthropic-ratelimit-unified-* response headers. utilization is the fraction of the window used (usually 0-1, same scale as the top-level utilization field; values above 1 occur when usage legitimately runs past a window's cap, e.g. lower-priority episodes past the 5-hour limit); resetsAt is unix epoch seconds. Unlike the top-level status/utilization fields, which describe the currently limiting window, both windows are tracked on every observation, and events are emitted when a window's rounded percentage or reset time moves, not only on status transitions. Windows absent from the account state are absent here. Absent until the first response carrying these headers is observed, and always absent for API-key, Bedrock, and Vertex sessions, whose responses do not carry them."),overageStatus:B(["allowed","allowed_warning","rejected"]).optional(),overageResetsAt:E().int().optional(),overageDisabledReason:B(["overage_not_provisioned","org_level_disabled","org_level_disabled_until","out_of_credits","seat_tier_level_disabled","member_level_disabled","seat_tier_zero_credit_limit","group_zero_credit_limit","member_zero_credit_limit","org_service_level_disabled","no_limits_configured","fetch_error","unknown"]).optional(),isUsingOverage:O().optional(),overageInUse:O().optional(),overageEnabled:O().optional(),surpassedThreshold:E().optional(),rateLimitGraceActive:O().optional().describe("@internal Usage-limit grace signal. Follows the latest served main-loop or subagent response: set when it reports grace-zone utilization > 0 (the server reports that only to a request that sent `anthropic-usage-limit: extended`, tengu_lantern_spool), cleared when a response the limiter ran on reports none or, if the latest in-zone response named the grace window's reset, once that reset passes on this machine's clock. Side calls, and responses with no `anthropic-ratelimit-unified-status` (the limiter did not run), are not read. A refused request's 429 is not read either, so while requests are refused the last value persists: still expire any UI derived from this field via resetsAt. While set, overageStatus allowed / allowed_warning means paid extra usage covers the overflow (nothing will be cut off). Stays true at hard exhaustion (status rejected); combine with status instead of reading this field alone as \"still usable\"."),overagePeriodMonthly:u({utilization:E()}).optional().describe("@internal Monthly service spend-cap telemetry for the Claude-in-Slack surface (CLAUDE_IN_SLACK_V2): utilization is fraction-of-cap."),overagePeriodChannel:u({utilization:E()}).optional().describe("@internal Per-Slack-channel spend-cap telemetry for the Claude-in-Slack surface (CLAUDE_IN_SLACK_V2): utilization is fraction-of-cap. Absent when the channel has no individual cap."),limitScope:B(["service","channel","group_pool"]).optional().describe("Which spend limit blocked the request when it is not the member's own cap: 'group_pool' means a pooled group budget shared by the member's team is used up (the denial otherwise looks like the member's own monthly cap). Absent on a plain member denial and from older CLIs."),errorCode:B(["credits_required"]).optional(),canUserPurchaseCredits:O().optional(),hasChargeableSavedPaymentMethod:O().optional(),usageCreditOffer:u({kind:B(["pct_off","extra_credit"]),headlinePct:E().int(),daysLeft:E().int(),label:o()}).optional().describe("@internal A limited-time offer on usage credits the account holds at this limit, for the IDE extension's limit banner: the kind (a steeper discount, or extra credit for the same price), the headline percent every credit pack meets or beats, whole days left in the account's offer window, and the ready-made banner text. Present only on a rejected frame from a session the VS Code extension owns, once the server has answered that the account holds an active offer; absent otherwise. The prices themselves apply wherever the credits are bought."),adminRequestOffer:u({state:B(["can_ask","pending","sending","sent"]),label:o(),doneLabel:o(),confirm:O(),confirmPrompt:o(),lastFileFailed:O().optional(),revision:E().int().optional()}).optional().describe("@internal The IDE limit banner's offer to ask the member's admin for a higher spend limit: its state (can ask, already pending, sending, sent), its copy, whether the last filing failed, and a counter that moves when a click could not be acted on. Present only on a rejected frame from a VS Code extension session for a Team or Enterprise member at their own spend limit, while tengu_tallow_quoit serves it, its kill switch is on and the organization's requests are not switched off.")}).describe("Rate limit information for claude.ai subscription users.")),qe=128,MF=64,Aqo=f(()=>u({session:u({total_cost_usd:E(),total_api_duration_ms:E().int(),total_duration_ms:E().int(),total_lines_added:E().int(),total_lines_removed:E().int(),model_usage:me(o(),Ge())}).describe("Cost and usage accumulated by the current session."),rate_limits:u({limits:C(u({kind:o().max(qe).describe("The server's meter kind, e.g. 'session', 'weekly_all' or 'weekly_scoped'. Classify a row on this, never on a label."),group:o().max(qe).describe("The server's row group, e.g. 'session' or 'weekly'; rows render grouped under it, in the server's order."),percent:E().describe("Share of the window used, 0-100."),resets_at:o().max(qe).nullable().describe("ISO 8601 timestamp when the window resets."),scope:u({model:u({display_name:o().max(qe)}).nullable().optional(),surface:u({display_name:o().max(qe)}).nullable().optional()}).nullable().optional().describe("What a scoped row is for, a model or a surface, with the server's display label."),severity:o().max(qe).describe("The server's reading of the row for a meter's colour, e.g. 'normal', 'warning' or 'critical'. Every row here is the server's, so a client never grades a row itself."),is_active:O().describe("The server's headline pick: the row a single-value indicator shows.")})).max(MF).nullable().describe("The server's usage rows (the usage endpoint's limits[]), as sent: which meters apply, their scope, labels, severity and order are the server's, so a client renders them verbatim and a new meter needs no client release. Empty when the server reported no meters; null when the body carried no rows at all (a server that predates them). Null too while the usage fetch is failing: the rows here are only ever the server's current reply, so neither the row the CLI builds from rate-limit response headers for its own screen nor its snapshot of an earlier reply appears here."),extra_usage:u({is_enabled:O(),monthly_limit:E().nullable(),used_credits:E().nullable(),utilization:E().nullable(),currency:o().max(qe).nullable().optional()}).nullable().optional().describe("Extra-usage (overage) spend for the billing period, when the plan has it. Amounts are in minor units of `currency` (cents for USD); is_enabled is false while extra usage cannot cover sends.")}).nullable().describe("The plan's usage rows and extra-usage spend from the claude.ai usage endpoint; null when the CLI could not fetch them (no plan on this lane, or a token without the profile scope).")}).describe("Structured twin of a /usage result, carried beside its text: the session's totals, the plan's usage rows as the server sent them and the extra-usage spend, and nothing else from the usage body (the get_usage control reply carries the rest). Experimental \u2014 the shape may change.")),snr=["used","free","buffer","deferred"],pKr=["system_prompt","system_tools","mcp_tools","mcp_instructions","mcp_tools_deferred","system_tools_deferred","custom_agents","memory_files","skills","messages","autocompact_buffer","compact_buffer","free_space"],xF=f(()=>u({name:o().describe('Display name of the row as the CLI renders it, e.g. "Messages" or "MCP tools (deferred)". Use `kind` (not this name) to classify the row.'),tokens:E().int(),kind:B(snr).describe("What the row is: 'used' content occupies the window; 'free' is the remaining window; 'buffer' is the compaction reserve (autocompact or manual); 'deferred' rows are out-of-window tool schemas \u2014 listed for awareness, excluded from usage math.")}).describe("One row of the /context usage-by-category breakdown. Rows may carry zero tokens; renderers typically hide those.")),DF=f(()=>u({model:o().describe("Main-loop model the usage was computed for."),total_tokens:E().int().describe("Estimated tokens in use, unclamped \u2014 may exceed raw_max_tokens when over limit."),raw_max_tokens:E().int().describe("The window usage is measured against: the resolved autocompact window \u2014 the model's believed limit, or a smaller compaction-policy window (a configured value, or e.g. the 200K boundary on 1M-window models)."),percentage:E().int().describe("Rounded total_tokens / raw_max_tokens, 0-100+."),over_limit:u({tokens_over:E().int(),kind:B(["hard_limit","compaction_window"])}).optional().describe("Present when total_tokens exceeds raw_max_tokens. kind says how the window was resolved, not whether the API will accept the next request: 'hard_limit' means the window is the model's believed limit (the API will refuse past it); 'compaction_window' means a compaction-policy window, which may or may not coincide with the model's hard limit."),categories:C(xF()),mcp_tools:C(u({name:o().describe('Wire name, e.g. "mcp__linear__create_issue".'),server_name:o(),tokens:E().int()})),memory_files:C(u({path:o(),type:o().describe('Display label of the memory-file source, e.g. "Project" or "User".'),tokens:E().int()})),agents:C(u({agent_type:o(),source:o().describe("Raw source identifier, e.g. 'projectSettings', 'userSettings', 'plugin'. Built-in agents are excluded by the producer. Display labels are the renderer's concern."),tokens:E().int()})),skills:C(u({name:o(),source:o().describe("Raw source identifier, e.g. 'userSettings', 'plugin', 'syncedSkills'."),plugin_name:o().optional(),tokens:E().int()})).optional().describe("Omitted when no skills contribute tokens.")}).describe("Structured twin of the /context report \u2014 the data a client needs to render the context-usage card without parsing the markdown table. Evolves additively (new optional fields); a breaking reshape would ship as a sibling field, so consumers can trust the fields they know.")),pn=f(()=>u({type:T("assistant"),message:CF(),parent_tool_use_id:o().nullable(),error:ho().optional(),uuid:p(),historical:O().optional().describe("@internal Replayed history rather than a live message (stamped by the Remote Control bridge when it flushes history to the session server)."),session_id:o(),request_id:o().optional(),refused_message_id:o().optional().describe("@internal Only on the assistant message that reports a refusal: the API msg_* id of the refused response (message.id on this message is a local UUID). Absent when the CLI has no well-formed id for it."),user_message_uuid:o().optional().describe("Client uuid of the user message this turn is answering (submitMessage options.uuid), stamped on an assistant message each time that send changes \u2014 the turn's FIRST top-level assistant message (which may carry only a thinking block, or be a synthetic API-error message), and then, for a turn started by a synthetic (meta) prompt, the first assistant message after each queued user message folded in mid-turn (the fold takes the echo over); with --include-partial-messages the turn's first non-ping stream event is stamped too, independently (see SDKPartialAssistantMessage), so the same uuid may appear on both \u2014 either binds the reply to the send it answers without waiting for the result; the server keeps the first stamp it sees per uuid. A turn started by a typed prompt keeps that uuid for its whole turn, so it stamps once per frame kind. A meta turn's own uuid is stamped only when the host vouches it is the client event's own (on a hosted session, the uuid the session server persisted: delivered content such as a Slack owner ping, a Slack-bot observation or a client-injected synthetic turn), never for a prompt the CLI minted itself \u2014 except that a turn carrying resume_reason, such as the boot-time rescue turn re-running a turn a worker restart interrupted mid-way, stamps the interrupted turn's own last user prompt, the send it answers, where that can be vouched for (a turn that goes on from a permission answer or from in-flight tool calls may first re-send, unstamped, the assistant message that made those calls); either way a user message folded into a meta turn takes the echo over from it (the rescue turn absorbing messages sent while the session was down; a bot-observation turn absorbing a human's post), and the first reply frame of each kind after that fold carries the folded message's uuid \u2014 the first reply that message got. Wrapper-level sibling \u2014 never inside `message.content` \u2014 so it is not replayed to the model. Absent on every other frame of the turn, on subagent frames (parent_tool_use_id set), on turns that neither had a client uuid nor folded a user message in, and from older producers."),user_message_uuids:C(o()).optional().describe("Client uuids of every user message whose prompt this turn has consumed so far, in consumption order \u2014 all members of a prompt batch the host merged into this one turn (several messages sent close together run as one turn whose user_message_uuid is the LAST member's), then any user message folded into the turn before this frame \u2014 so a consumer that sent any of them can bind this reply to its own send by finding its uuid anywhere in the list. Always contains user_message_uuid; at most 64 entries. Present exactly when user_message_uuid is, on the same frames; absent from older producers (fall back to user_message_uuid)."),resume_reason:o().optional().describe("Why this frame's turn continues one that a worker restart interrupted. Such a turn is the automatic re-run of the interrupted turn (CLAUDE_CODE_RESUME_INTERRUPTED_TURN), or one that goes on from the answer to the permission prompt the new worker took over, or from that turn's tool calls still in flight. The value is the host's CLAUDE_CODE_RESUME_REASON when it set one (host_draining, checkpoint_restore, container_recreated, \u2026), else 'interrupted_turn'. Stamped on the same reply frames as user_message_uuid (which on such a turn names the interrupted turn's own last user prompt), so a consumer can tell its first reply from the interrupted attempt's. Absent on every other turn (also one that goes on from the answer to any other permission prompt), on thinking_tokens frames, and from older producers."),resumed_from_incomplete_thinking:T(!0).optional().describe("This turn continued the preceding truncated assistant turn inside its trailing signed thinking block (max-output-tokens recovery). Its thinking signatures are cumulative over that preceding thinking-only turn, so a history replayed through the bridge must carry this flag back for the normalizer to keep the run's prefix on the wire. Wrapper-level sibling \u2014 never inside `message.content` \u2014 so it is not replayed to the model."),supersedes:C(p()).optional().describe("Wire uuids of previously-delivered messages that this message replaces (refusal-fallback supersede). The list can include tombstoned tool_result frames from the refused leg, not only assistant frames. Evict the named messages on arrival and treat this frame as their canonical replacement. Idempotent with the end-of-turn model_refusal_fallback notice, whose retracted_message_uuids remains the complete audit record for the turn."),aborted:T(!0).optional().describe("True when this assistant message was truncated by an interrupt/abort before the stream completed: stop_reason was never received and the content may end mid-word. Absent on normally completed messages."),agent_id:o().optional().describe("ID of the subagent that produced this message: the `task_id` of its task events, unchanged when the subagent is resumed. Absent on main-thread messages."),subagent_type:o().optional().describe("Subagent type that produced this message."),task_description:o().optional().describe("Description of the subagent task that produced this message."),tool_use_meta:C(u({id:o(),display_name:o(),server_display_name:o().optional(),icon_url:o().optional(),server_id:o().optional(),server_id_stamp:o().optional(),tool_name:o().optional()})).optional().describe("@internal Display metadata for this message's tool_use blocks, keyed by block id. display_name is the MCP server's `tool.annotations.title` when provided, otherwise a readable transform of the wire name; server_display_name is the MCP server's own display name; icon_url is the MCP server's directory icon URL (claude.ai connectors only); server_id is the mcpsrv_ connector id of a server provisioned by claude.ai, set by the CLI from claude.ai's own connector listing, so a client may show the call as that connector's. server_id_stamp is the X-MCP-Server-ID header value, lower-cased, of an http entry in the dynamic scope (passed in at launch or by a later mcp_set_servers push). Claude Code Remote writes the connector's uuid there when the session has one, otherwise an id it generates; the CLI checks only its shape (at most 128 characters of letters, digits, '.', '_', ':' and '-'; anything else yields no stamp), not whose it is, since a --mcp-config or SDK-host entry can write anything. A client may look it up in its own server list, treat a miss as a server it does not know (never as an error), and show a hit as the entry's claim to be that server, not as proof. They are separate fields: a server provisioned by claude.ai carries server_id, a dynamic-scope http entry server_id_stamp. Both absent for a plugin's, a repo's, a settings or an agent entry. Neither is a permission grant. tool_name is the tool's name as its server lists it, without the mcp__<server>__ prefix. Omitted for blocks whose display label equals the wire name (built-in tools). Wrapper-level sibling \u2014 never inside `message.content` \u2014 so it is not replayed to the model."),narration_block_indexes:C(E().int().nonnegative()).optional().describe("@internal Ascending zero-based indexes into this frame's `message.content` of the thinking blocks whose signature the server tagged block_kind 'narration' (server summaries of the prose between tool calls, not the model's own reasoning), so a renderer can label them as summaries without decoding the signature envelope. Fail-closed: an unparseable or legacy signature is not listed. A listed block can have empty thinking text when the request returned no thinking text; give those ordinary thinking treatment. Omitted when the frame has no such block, and by CLI versions before this field existed; treat unlisted thinking blocks as ordinary thinking. Wrapper-level sibling \u2014 never inside `message.content` \u2014 so it is not replayed to the model."),narration_hint:B(["hidden","faint"]).optional().describe("@internal Display-only, for this frame's narration_block_indexes blocks: how to draw their trailing ' \xB7 summarized' hint, by the same rule Claude Code's terminal UI uses for the model that produced the frame. 'hidden': draw no hint. 'faint': draw ' \xB7 summary'. Omitted: draw ' \xB7 summarized'. Sent only to the VS Code extension and only on frames that have such a block; older CLI versions never send it. Wrapper-level sibling \u2014 never inside `message.content` \u2014 so it is not replayed to the model."),thinking_duration_ms:E().int().positive().optional().catch(void 0).describe("@internal How long the thinking block in this frame took to stream, in whole milliseconds (at least 1): from its content_block_start to its content_block_stop, so the wait for the response's first token is not counted. For display only. Sent only on a frame whose one content block is a thinking block that was streamed. Older CLI versions never send it, and a CLI that rebuilt its history from SDK frames does not send it when it replays that history, so be ready to show the block without a duration. Wrapper-level sibling \u2014 never inside `message.content` \u2014 so it is not replayed to the model."),thinking_display:o().optional().catch(void 0).describe("@internal The thinking.display that Claude Code put in the API request body for the response that streamed this frame's thinking block. It has the same source and meaning as `thinking_display` on a stream event. Sent only on a frame whose one content block is a thinking block that was streamed, and only when the body had a display. Older CLI versions never send it, and a CLI that rebuilt its history from SDK frames does not send it when it replays that history. An absent key states nothing. Wrapper-level sibling \u2014 never inside `message.content` \u2014 so it is not replayed to the model."),timestamp:o().optional().describe("ISO timestamp of when this content block finished on the originating process. One API assistant turn may produce several assistant messages sharing a message.id, each with its own timestamp. Uses the originating host's clock, so it's for display only; do not order messages by this field. Older emitters omit it; consumers should fall back to receive time."),is_meta:T(!0).optional().describe("@internal True when the message was synthesized by the loop (not a model response)."),context_usage:DF().optional().describe("Structured twin of the /context report, carried on the synthetic assistant message that delivers the markdown table. Present only on /context results from CLIs new enough to attach it; the markdown in message.content remains the canonical fallback. Wrapper-level sibling \u2014 never inside `message.content` \u2014 so it is not replayed to the model."),usage_report:Aqo().optional().describe("Structured twin of the /usage report, carried on the synthetic assistant message that delivers its text: the session totals, the plan's usage rows and extra-usage spend, for remote clients that render a card from data. Present only on /usage results from CLIs new enough to attach it and from claude.ai-subscriber sessions; the text in message.content remains the canonical fallback. Wrapper-level sibling \u2014 never inside `message.content` \u2014 so it is not replayed to the model."),local_command_source:o().optional().describe("@internal The originating system local_command row's wire-form content (escaped frames), carried on the loop-synthesized local-command twin. Round-tripped so toInternalMessages rebuilds the internal system row on a bridge/SDK history replay \u2014 replay then matches the live session, where that row is model-visible \u2014 instead of dropping the output or replaying the twin's decoded display text. Wrapper-level sibling \u2014 never inside `message.content`."),local_command_run:u({command:o(),args:o(),plugin:o().optional()}).optional().describe("@internal On the local-command twin, the run that printed the row: the command's name as `command.run` carried it (no slash), its arguments as the echo shows them (`***` when the command marks them sensitive) and, for a command a plugin registered, that plugin's name, or, for a row whose text plugins' `command.run` hooks answered or retold, the names the text is led by (untrusted text; absent for the binary's own command in its own words). Present when a `local` command's dispatch printed the row or a `command.run` hook answered it, absent on a never-ran notice. A surface that draws the hooks engine's `CommandOutput` site asks ui_render with these, the twin's text and its uuid as instance_id; toInternalMessages round-trips it onto the rebuilt row. Wrapper-level sibling \u2014 never inside `message.content`."),local_command_outcome:u({kind:B(Xr),suggestion:o().optional().describe("unknown: the registered command closest to the typed name, no slash.")}).optional().catch(void 0).describe("@internal On the local-command twin, what the row reports, so a host can offer a fix instead of relaying the text: 'unavailable_headless' (an interactive-panel command this session cannot open), 'unknown' (no command has the typed name), 'failed' (the command ran and failed), 'restart_required' (the change applies after Claude Code restarts). Absent when the row reports none of these; new kinds are additive, so treat an unknown one as absent. toInternalMessages round-trips it onto the rebuilt row. Wrapper-level sibling \u2014 never inside `message.content`."),is_virtual:T(!0).optional().describe("@internal Display-only: rendered in the UI but filtered before API send."),batch_tool_uses:C(Ue({id:o(),name:o()})).optional().describe("@internal `{id, name}` of the original Batch* tool_use block(s) for a message whose content was decomposed into synthetic v1 tool_use blocks. Round-tripped so a replayed history reassembles the batch block on the wire (not N synthetics). Input is reassembled from the synthetics in `message.content` \u2014 never carried here. Wrapper-level sibling \u2014 never inside `message.content` \u2014 so it is not replayed to the model."),wire_tool_inputs:me(o(),oe()).optional().describe("@internal `tool_use.input` exactly as the API produced it, keyed by tool_use id, for a message whose `message.content` carries the client-normalized input. Round-tripped so a replayed history echoes each earlier tool call back to the API as the API emitted it (the server may hold its own copy of the turn). Wrapper-level sibling \u2014 never inside `message.content`."),wire_ingest_context:me(o(),oe()).optional().describe("@internal What the client-side input normalization read from process state (the working directory a leading `cd` was stripped against, the stamp applied to a Slack send) for the inputs in `wire_tool_inputs`, keyed by the same tool_use ids. Round-tripped with `wire_tool_inputs` so a replayed history can verify each recorded input against the normalized one exactly. Wrapper-level sibling \u2014 never inside `message.content`."),is_api_error_message:O().optional().describe("@internal True when this assistant message wraps an API error (from internal AssistantMessage.isApiErrorMessage)."),api_error_status:E().int().optional().describe("@internal HTTP status code of the API error when is_api_error_message is true."),api_error:B(["max_output_tokens","dlp_request_denied","claude_code_version_too_old","safety_monitor_blocked","effort_requires_thinking","advisor_incompatible","tool_history_mismatch","autocompact_thrashing","pdf_too_large","pdf_password_protected","media_removed","no_response","tls_untrusted_ca","gateway_content_type","provider_credentials","gateway_signin_required","gateway_session_expired","api_key_auth_disabled","org_disabled_credential","invalid_credential_header","model_requires_usage_credits","long_context_credits_required","consent_unanswered","no_allowed_fallback","model_substitution_disabled","field_not_granted","usage_limit_reached","empty_completion"]).optional().catch(void 0).describe("@internal Typed kind of the API error when is_api_error_message is true, for consumers that key on the cause instead of the message text (the text stays the fallback and may change). Absent when the error has no typed kind; new values are added over time, so treat an unknown value as absent. dlp_request_denied: the request was refused by the organization's data-loss-prevention policy \u2014 terminal for that request body; a consumer replaying history must not re-send it. claude_code_version_too_old: the API refused the request because this Claude Code build is below a required minimum version \u2014 the selected model's minimum, or an organization-policy floor; only the message text says which and names the versions, and the remedy is updating Claude Code. safety_monitor_blocked: a server-side safety monitor blocked the model's response for this turn; terminal for the turn, so a consumer replaying history must not re-send the prompt that led to it. effort_requires_thinking: the model refuses the requested effort level while thinking is off; api_error_params.effort names the level. advisor_incompatible: the configured advisor model cannot be paired with this request's model. tool_history_mismatch: the API rejected the conversation's tool_use/tool_result pairing (a tool_use without its result, an orphaned tool_result, a duplicate tool_use id); re-sending the same history fails the same way, and rewinding the conversation is the remedy. autocompact_thrashing: the context refilled to the limit right after each automatic compaction, repeatedly, so the turn stopped; something in context is too large for the window. pdf_too_large: a PDF is over the API's page or size limit. pdf_password_protected: a PDF is encrypted. media_removed: the API refused an image or a document in the conversation, so Claude Code leaves it out of the requests that follow. The frame comes either before the answer of a retry that already left it out, or as the error that ended the turn (the result then repeats this value). api_error_params.media_reason says why, and api_error_params.media which kind of block. Other kinds (pdf_too_large, pdf_password_protected) and some untyped errors also leave the block out, so the absence of this value does not mean that nothing was left out. no_response: no response arrived before the first-byte deadline on any attempt, usually a proxy or gateway that holds responses until they complete. tls_untrusted_ca: the API's TLS certificate comes from an authority this process does not trust, usually a TLS-inspecting proxy or a gateway signed by a private CA. gateway_content_type: a proxy between Claude Code and Amazon Bedrock rewrote Bedrock's event-stream response. provider_credentials: a third-party cloud provider (api_error_params.provider) refused the request's credentials or access; api_error_params.remedy says what fixes it. gateway_signin_required: the Cloud gateway provider is configured and nobody is signed in to it; no request was sent. gateway_session_expired: the Cloud gateway session expired; no request was sent; api_error_params.remedy is gateway_token when the token came from the environment, which signing in does not replace. api_key_auth_disabled: the organization turned off API key authentication and the active credential is an API key. org_disabled_credential: the ANTHROPIC_API_KEY environment variable belongs to a disabled organization and overrides the account sign-in. invalid_credential_header: a credential or header value (from the environment, a helper, or the saved sign-in) cannot be sent as an HTTP header; caught before the request was sent. model_requires_usage_credits: the model runs on usage credits for this account, and credits are off or the included allowance is used up. long_context_credits_required: a request over the 200K-token context boundary needs usage credits. consent_unanswered: the model now uses usage credits and the prompt to confirm went unanswered; nothing was sent. no_allowed_fallback: switching off the model was needed (the usage-credits prompt was declined) and the model policy allows no other model. model_substitution_disabled: switching off the model was needed and CLAUDE_CODE_NO_MODEL_FALLBACK forbids it. field_not_granted: the organization is not allowed to send a field in the request, and the message text says what to do. usage_limit_reached: the request was refused by the account's own usage limit, a plan limit (session, weekly or per-model) or a spend cap on usage credits; api_error_params.rate_limit_info says which and when it resets. The other refusals that share error rate_limit never carry it: an organization policy that turned the service off (no limit was reached, and no reset clears it), a temporary server throttle, a capacity switch-off, an entitlement refusal shown in the server's own words, or a 429 on an API key or a third-party cloud provider. empty_completion: the model ended its turn with no visible text, and its one retry had no content block, on a person's own prompt with no reply and no tool result after it; the turn ends as an error so that a host shows a failure and not a blank reply."),api_error_params:u({effort:o().optional(),provider:B(["bedrock","anthropicAws","mantle","anthropicGoogleCloud","vertex","foundry","gateway"]).optional(),remedy:B(["refresh_command","refresh_credentials","adc","gateway_token","host_managed","model_access"]).optional(),media:B(["image","document"]).optional().catch(void 0),media_reason:B(["unprocessable","unsupported_by_model","media_budget"]).optional().catch(void 0),rate_limit_info:uKr().optional().catch(void 0)}).optional().describe("@internal Parameters of api_error, present only for the kinds that have any. effort: the effort level the API refused (effort_requires_thinking). media (media_removed): the kind of block the API refused; absent for media_budget. media_reason (media_removed): unsupported_by_model \u2014 the API said that the model does not accept PDF documents; media_budget \u2014 the request's images and documents together exceed the API's limit, and the requests that follow may leave out blocks of either kind; unprocessable \u2014 every other refusal, a gateway's report of a model's refusal among them. provider: the API provider whose credentials failed (provider_credentials, gateway_session_expired). remedy (provider_credentials, gateway_session_expired): refresh_command \u2014 a configured refresh command (awsAuthRefresh / gcpAuthRefresh) refreshes the credentials; refresh_credentials \u2014 refresh the provider's credentials by hand, no command is configured; adc \u2014 refresh the Google application default credentials or the GOOGLE_APPLICATION_CREDENTIALS key file; gateway_token \u2014 replace the gateway token supplied through ANTHROPIC_AUTH_TOKEN or ANTHROPIC_CUSTOM_HEADERS; host_managed \u2014 the host application owns these credentials; model_access \u2014 the credentials work but the model is not enabled for this account and region (Amazon Bedrock). rate_limit_info (usage_limit_reached): what the refused request's own response said about the limit, in the shape rate_limit_event carries. It is read from the same values as the message text, so its status, limit and reset are the text's: status is rejected and isUsingOverage false, rateLimitType names the limit, resetsAt is when it resets, and overageStatus, overageResetsAt, overageDisabledReason and limitScope say whose spend cap it is (the person's own cap arrives as org_level_disabled_until, as on rate_limit_event); no other member is sent. It is that refusal's record and is never updated, so compare resetsAt with the clock before calling the limit current."),api_error_code:o().optional().describe("@internal The server's error.details.error_code for this API error, copied through when it is an identifier (^[a-z][a-z0-9_]{0,63}$) and dropped otherwise. Carries server gate codes this build has no api_error value for, so a host can key on a new gate without a Claude Code release. Absent when the response carried no code."),api_error_origin:B(["first_party"]).optional().catch(void 0).describe("@internal first_party when this API error was built from a response Anthropic's own API sent: the request used the firstParty provider, went to https://api.anthropic.com on the default port and was answered from there, not redirected, over TLS verified with no added CA (NODE_EXTRA_CA_CERTS), no verification override and no unix-socket tunnel. Absent in every other case: an ANTHROPIC_BASE_URL or WIF base_url override, a gateway, a third-party provider, a connection error, an error Claude Code raised itself, and any frame replayed from the transcript, SDK input or a remote session. Treat absence as unknown origin. It says which endpoint answered, not that the message text is the server's verbatim, and a CA installed in the system trust store can still intercept. An invalid-request message (400 or 422) can quote request values, so it is stamped only when it is one of the known Anthropic wordings, and no message is stamped that quotes the request's model id; render stamped text as plain text. New values may be added; treat an unknown value as absent."),error_details:o().optional().describe("@internal Raw API error message \u2014 preserves details (e.g. prompt-too-long token counts) that user-facing content discards."),advisor_model:o().optional().describe("@internal Advisor model that produced this message, when applicable."),attribution_agent:o().optional().describe("@internal Attribution stamp: agent name parsed from querySource (see messageAttribution.ts). May overlap with subagent_type."),attribution_skill:o().optional().describe("@internal Skill that produced this message."),attribution_plugin:o().optional().describe("@internal Plugin that produced this message."),attribution_mcp_server:o().optional().describe("@internal MCP server that produced this message."),attribution_mcp_tool:o().optional().describe("@internal MCP tool that produced this message.")}).describe("An assistant message. While a response streams the CLI emits one assistant message per completed content block, so several consecutive assistant messages can share message.id and each carries just that block in message.content; on those, message.stop_reason is null and message.usage is not final \u2014 the turn's stop reason and total usage arrive on the result message. parent_tool_use_id is non-null when the message was produced inside a subagent started by that tool_use."));var LF=f(()=>u({type:T("rate_limit_event"),rate_limit_info:uKr(),uuid:p(),session_id:o()}).describe("Rate limit event emitted when rate limit info changes.")),IA=f(()=>u({tool_name:o(),tool_use_id:o(),tool_input:me(o(),oe())})),UF=f(()=>u({id:o(),name:o(),input:me(o(),oe())})),PA=f(()=>B(eA).describe("Why the query loop terminated. Unset when the loop was bypassed (local slash command).")),MA=f(()=>u({spawned:E().int().describe("Subagents actually started (one tengu_agent_tool_selected each); a refused or failed launch is not counted."),requested:u({background:E().int(),foreground:E().int(),unset:E().int()}).describe("Spawns by the run_in_background value the model passed; all count as unset while the parameter is not offered (background tasks disabled, or subagents forced into the background: in a terminal, the desktop app or the VS Code extension, or with CLAUDE_CODE_FORK_SUBAGENT=1)."),started_in_background:E().int().describe("Spawns that started in the background after defaults and session settings (tengu_agent_tool_selected.is_async); the rest blocked the spawning tool call."),by_type:me(o(),E().int()).describe("Spawns by agent type."),max_depth:E().int().describe("Deepest spawn: 1 = started by the main thread, 2 = by a depth-1 subagent."),spawned_by_subagents:E().int().describe("Spawns made from inside another subagent (depth > 1)."),completed:E().int(),failed:E().int(),killed:u({parent:E().int(),user:E().int(),system:E().int()}).describe("Stopped before finishing: parent = by another agent through TaskStop; system = by Claude Code itself (the --max-budget-usd halt, the sweep of background subagents when an SDK or IDE client interrupts, or -p giving up on a background subagent still running at its wait ceiling); user = any other stop, including a foreground subagent cancelled just as it finished (counted here, not as completed)."),refused:u({depth_limit:E().int(),concurrency_limit:E().int(),budget:E().int()}).describe("Agent tool calls turned down because one of these limits was reached (other denials, such as an unknown agent type, are not counted). depth_limit stays near zero in practice: a subagent at the nesting limit is normally not offered the tool at all.")}).describe("@internal Subagents started through the Agent tool in this session, as running totals (forked skills, workflows, teammates and other internal agents are not counted; two sessions in one process keep separate counts). Cumulative like modelUsage: read the latest result rather than summing across results; a resumed session starts fresh and a mid-session /clear zeroes it, though a background subagent that outlives the /clear still records its outcome, so completed, failed and killed can then exceed spawned. A result that was held back while background subagents finished carries the counts as of when it is written to the stream, as do its total_cost_usd, duration_api_ms and modelUsage (and usage where that is a running total; a per-turn main-loop usage keeps its turn-end value). Omitted by hosts without a local Agent tool and on crash/startup-error results; all zeros until the Agent tool starts or refuses a subagent. A remote (isolation: remote) launch counts as spawned but never reports an outcome. Per-subagent detail is on the task_started / task_notification events.")),xA="Per-model totals for every model call made through the query pipeline during this query() call \u2014 main loop, Task subagents, sidechains, and internal calls such as compaction and Workflow agents. Cumulative across turns in streaming-input sessions: each result carries the running total so far, so read the latest result rather than summing across results. Internal helper calls outside the query pipeline (e.g. the permission classifier, token-count probes) are excluded; crash/startup-error results may carry zeroed usage, a resumed or forked session continues from the totals its transcript saved, when it has them (so the first result already carries the earlier turns), and a mid-session /clear resets the running total. The correct field for token/cost accounting; treat it as an estimate, not a billing statement.",DA="@internal Per-model usage and cost of the calls this process counted since it wrote its previous result (since it started, for its first), keyed and shaped like modelUsage and covering the same calls. Sum it over a conversation's results instead of subtracting modelUsage totals: within a conversation each call is stated on at most one result, whatever a resume or a kill does to modelUsage. Calls that finish after a result (a background subagent, a late title call) are stated on the next result, and a /clear's own result states what was counted before it. Nothing is carried from one process to the next, so what a process counted after its last result is stated nowhere. That includes the finished calls of a turn in flight when the process is shut down or killed, even where another process carries the turn on and writes its result. A result whose write fails loses its usage too (result_index shows the gap). A Workflow agent that runs as a cloud session of its own is counted here, as in modelUsage, and that session's own results state it too. costBasis, canonicalModel and provider are the latest request's. A model with nothing counted is left out; {} means nothing was counted. Set by a stream-json or --sdk-url run on the results it numbers as it writes them; a result relayed from another process keeps what that process set. Not set on error results numbered by hand (a start-up failure, an error that escapes the run), by --output-format json and text runs, or by older versions. Absent is not {}.",LA="@internal Running totals of the subagents the Agent tool started this session; see SDKSubagentStats.",UA="@internal How many times a safety system has stopped one of this session's model calls made through the query pipeline (main loop, subagents, forked skills, compaction and other internal calls), as a running total since the session started in this process; two sessions in one process keep separate counts. Counted: a response that ends on stop_reason refusal, whether Claude Code then shows it, retries it or re-sends it to another model; a refusal that the API itself answered on a fallback model; output that the API's content filter stopped for good (the stop ends the call); and, where the build can recognise it (public builds cannot), a server-side safety monitor's block (api_error safety_monitor_blocked). It counts these events, not calls: one call can add a refusal answered on a fallback model and then that model's own refusal. 0 means that none of these was seen; a kind of stop that this version does not know is not counted. Never sum across results. It is never saved, so a resumed session starts at 0 again, and a mid-session /clear zeroes it: over a stored log that spans a restart, a resume or a /clear, any result above 0 means a stop happened, and a later 0 does not cancel it. Present, 0 included, on every result that carries a turn's measured totals. Absent on the zeroed results that stand in for a crashed, cut or never-started turn, on Remote Control's results and from older producers, where it says nothing: absent is not 0. A call still running when a result is written (a background subagent's) shows on the next result; a result held back while background subagents finished carries the count as of when it is written to the stream, never less than it was built with. Not counted inside the pipeline: a stop of the API's content filter that Claude Code answers by streaming the request again (so 0 does not rule one out), an organization's data-loss-prevention denial (api_error dlp_request_denied), a block by a cloud provider's own guardrail, an advisor's refusal inside a reply that ends normally. Not counted at all: model calls outside the query pipeline (e.g. the permission classifier, token-count probes) and work in other processes.",VA="User-initiated sends still waiting in the command queue when this result was produced. Greater than 0 means at least one more user turn (and result) follows without further input, barring cancellation; 0 means none is pending, or the session is ending (end_session or a shutdown latched mid-turn discards the backlog). Queued sends may coalesce into fewer turns, so this counts pending sends, not remaining results. System-generated queue entries are not counted. Absent on fatal startup results and on surfaces without a command queue.",jA="Cumulative estimated cost in USD for this query() call, covering the same query-pipeline calls as modelUsage and sharing its lifecycle: cumulative across turns in streaming-input sessions \u2014 each result carries the running total so far, so read the latest result rather than summing across results. Crash/startup-error results may carry zeroed values, a resumed or forked session continues from the total its transcript saved, when it has one (so the first result already carries the earlier turns; maxBudgetUsd counts only the spend since this query() call started or last /clear), and a mid-session /clear resets the running total. An estimate, not a billing statement.",qA="Delivery sequence of this result within the run: how many results the run numbered before this one, starting at 0, in the order the process writes them. A result held back while background work finishes is numbered when it is finally written, not when its text was produced; a result whose write fails still consumes its number, so a gap in a stream-json sequence means a result was lost. Distinct from num_turns, which counts model round-trips within one turn. Numbered by the process that hosts the run (`claude -p`, stream-json): a local client relaying a cloud session passes the cloud session's numbering through and its own locally built error results carry none; the in-process engine surface does not number yet. Absent from older producers.",GA="@internal The host of a multi-tenant worker shut the worker down while this turn ran. The shutdown was the first thing to abort the turn, and the turn is left for the session's next worker. The other frames of the ending, and terminal_reason, are the same as for a Stop from a client. Read this member to tell the two apart. A success result can have it, when the shutdown falls in a Stop hook. A result without it can also be the result of a shutdown. A shutdown that makes the turn write no interrupt marker does not set it, and older producers never set it.",VF=f(()=>u({phase:B(["setup","run"]).describe("@internal 'setup' when the session process never started, 'run' when it exited."),exit_code:E().int().nullable().optional(),signal:o().nullable().optional()}).describe("@internal How a self-hosted runner's session process ended, on the result the runner synthesizes for it.")),jF=f(()=>B(["org_pin_api_key_conflict","provider_not_allowed","org_verify_failed","org_pin_mismatch","managed_settings_invalid","remote_settings_required_unavailable","gateway_signin_required","gateway_access_denied","proxy_invalid","temp_dir_unusable","cwd_unavailable","shell_tool_missing","session_held_by_background","worktree_resume_refused","worktree_unverified","cli_version_too_old","bypass_root","org_config_required_unavailable","org_config_refused"]).describe("Why Claude Code refused to start, so a host can offer the fix instead of a retry. org_pin_api_key_conflict: managed settings pin a first-party or Cloud gateway sign-in, and an Anthropic API key or auth token is configured instead. provider_not_allowed: managed settings list the API providers this machine may use (allowedProviders), and the session is set up for one that is not listed. org_verify_failed: the sign-in's organization could not be verified against the pin (network, or a revoked token). org_pin_mismatch: the sign-in belongs to an organization the pin does not allow. managed_settings_invalid: managed policy settings could not be read, the pin names no organization, or managed model settings (deniedModels, or an availableModels list matched exactly) block the default model and leave no allowed model to use instead. remote_settings_required_unavailable: managed settings the organization requires could not be loaded. gateway_signin_required: the Cloud gateway ended this sign-in. gateway_access_denied: the Cloud gateway refused managed settings for this account. proxy_invalid: a proxy setting is not a complete URL. temp_dir_unusable: the per-user temp directory is unsafe or could not be created. cwd_unavailable: the working directory was deleted, moved or cannot be read. shell_tool_missing: Windows has no shell tool: Git Bash is missing, and PowerShell is missing or turned off by CLAUDE_CODE_USE_POWERSHELL_TOOL. session_held_by_background: the conversation to resume or continue is running as a background session. worktree_resume_refused: the resume was refused because the session's worktree failed its safety checks or the resume was launched from inside it; errors says whether a re-run continues without the worktree. worktree_unverified: the session's worktree could not be verified right now; retrying may succeed. cli_version_too_old: this Claude Code version is below the minimum Anthropic requires. bypass_root: bypass permissions mode was requested while running as root. org_config_required_unavailable: the organization requires its policy limits and managed settings before a session starts, and they could not be loaded (network, proxy, or an Anthropic error); retrying may succeed. org_config_refused: the organization requires its policy limits and managed settings, and Anthropic refused them for this sign-in (expired or revoked session, or the organization does not allow Claude Code for this account); signing in again or an admin's change is the fix, not a retry.")),qF=f(()=>u({type:T("result"),subtype:T("success"),duration_ms:E().int(),duration_api_ms:E().int(),ttft_ms:E().int().optional(),ttft_stream_ms:E().int().optional(),time_to_request_ms:E().int().optional(),time_to_request_phases_ms:me(o(),E().int()).optional().describe("@internal How time_to_request_ms was spent, in integer ms per phase, summing to it exactly: system_prompt, resume_other (settling, before the turn's own prompt, tool calls that an earlier run left open or the session's client handed over, see turn_start_resume_kind; excluding four parts of it that have keys of their own: resume_store_confirm, writing a handed-over turn's lines to the transcript and waiting for the store to confirm them; resume_staged_files_wait, that turn's wait for files its client is still staging; resume_connector_wait, an orphaned permission's wait for its tool's MCP server to connect; turn_start_tool_run, the calls' permission checks, a person's time at a prompt included, and their runs, which are work the user asked for, not preparation; older producers report these five as one key, turn_start_resume), process_user_input (excluding four parts of it that have keys of their own: input_images, input_attachments, input_command, input_hooks), transcript_persist, tool_pool_refresh, system_prompt_rebuild (a second assembly of the system prompt, run when the tool pool re-read after the message was handled differs from the turn-start pool; older producers report it inside system_prompt), init_message, engine_pickup, memory_recall_wait, memory_context_wait, message_prep, model_config_wait, autocompact, query_setup, auto_mode_context_wait (the wait at dispatch for the auto-mode context, on a request that started one), model_gates, tool_schema_build, message_normalization, client_creation, request_build, then at most one of redrive_reactive_compact, redrive_fallback_model, redrive_non_streaming and redrive_other (present when the first model request of the turn never began streaming, or was answered without streaming, so time_to_request_ms runs to the send time of a later request: the time between the two sends, named for the reason; after a reply without streaming it includes that reply and any tool calls), and other (the remainder no phase covers). A phase that did not run on the turn is absent; other is always present. Present where time_to_request_ms is, on CLAUDE_CODE_REMOTE sessions and hosts that set CLAUDE_CODE_EMIT_STARTUP_TIMING; absent elsewhere and from older producers."),turn_start_resume_kind:B(Zy).optional().describe("@internal What the turn was given to settle before its own prompt (the resume_ phases and turn_start_tool_run in time_to_request_phases_ms say how long that took): orphaned_permission (a permission answer whose pending request was lost, as when a worker restarts, so the tool call is settled with that answer), turn_handoff (a turn in progress that the session's client handed over), deferred_tool_use (a call a PreToolUse hook deferred), or none (resume_other is still reported, at about 0). A turn given more than one reports the first in that order. Present where time_to_request_phases_ms is."),handoff_intake_phases_ms:me(o(),E().int()).optional().describe("@internal On a turn that the session's client handed over (turn_start_resume_kind is turn_handoff), how long its turn_handoff control request waited from its arrival on the session server's SSE stream (--sdk-url) until the input loop read it, in integer ms on the monotonic clock, split into parts that frame_intake_phases_ms explains: startup_wait, control_requests_ahead and user_frames_ahead, each absent when 0, and before_read (the rest), always present. The values sum to the wait. Present only on results that carry turn_start_resume_kind. Absent on a claude-code-server tenant, when the host had handled too much since the arrival to say what the request waited behind, and from older producers."),process_turn_index:E().int().optional().describe("@internal Number of earlier turns of this CLI process that sent a main-conversation model request: 0 is the process's first turn to reach the model, not the conversation's first. Turns stopped or failed after sending count but carry no value, so values can skip. Where one process hosts several sessions, each has its own count, from 0 each time the process starts hosting it. Present where time_to_request_phases_ms is."),time_to_request_cpu_ms:E().int().optional().describe("@internal CPU time (user plus system) the CLI process used from turn start until it sent the turn's first main-conversation model request. Normally that is the time_to_request_ms window; if that request was abandoned for a new call (not an ordinary retry), time_to_request_ms runs on to the new one and this does not. Near time_to_request_ms, the window was mostly computing; near 0, mostly waiting. It adds up all threads, so it can exceed the window, and leaves out child processes, such as a command a tool runs. Unrelated work counts, such as the request that names the session (usually in its first turn). On a virtual machine, time the host spends restoring memory can count as CPU time, so a high value alone does not mean JavaScript work. Present where time_to_request_phases_ms is, unless the runtime reports no resource usage or the process hosts other sessions too."),time_to_request_loop_lag_ms:E().int().optional().describe("@internal The longest single stall of the session's thread between turn start and the turn's first main-conversation model request, measured as how late a 50 ms timer fired: the real stall can be up to 50 ms longer, so one under 50 ms can read 0, and a few ms is timer noise. JavaScript ran without a break, or the thread waited inside a blocking call (a synchronous file read or child process), or the whole process was paused; time_to_request_cpu_ms below this value means one of the last two, though on a virtual machine a pause while the host restores memory can look like CPU time. Any work on the thread counts: the request that names the session (usually in its first turn), or another session's where several share the thread. Only the first two minutes are measured. Present where time_to_request_phases_ms is."),time_to_request_major_faults:E().int().optional().describe("@internal Major page faults (waits for memory to be read from disk) by the process in the time_to_request_cpu_ms window; Windows also counts faults needing no disk read. On a virtual machine, memory the host restores is not counted: the machine never sees those faults. Present where time_to_request_cpu_ms is."),process_rss_mib_turn_start:E().int().optional().describe("@internal Resident memory of the CLI process at turn start, in whole MiB, as its kernel counts it (VmRSS in /proc/self/status). From the process's second turn on, it shows what stayed resident through the idle time since the turn before. Child processes, such as a command a tool runs or an MCP server, are left out. On a virtual machine it is the guest kernel's count, not what the host holds for the machine. Sent only by a worker that Anthropic hosts (never by a self-hosted runner, a BYOC environment, a session that Claude Desktop starts or a local run), and only with telemetry on. On such a worker it is present, always with process_rss_mib_result, where process_turn_index is, on Linux (not WSL), unless /proc/self/status cannot be read or lacks VmRSS, or the process hosts other sessions too."),process_anon_mib_turn_start:E().int().optional().describe("@internal The anonymous part of process_rss_mib_turn_start (RssAnon): memory with no file behind it, such as heaps, stacks and code the JavaScript engine compiles while running. Mapped files, such as the executable, are left out. Present where process_rss_mib_turn_start is, if the kernel gives it."),process_rss_mib_result:E().int().optional().describe("@internal As process_rss_mib_turn_start, read again after the turn, just before this result is built: the level the turn leaves behind."),process_anon_mib_result:E().int().optional().describe("@internal The anonymous part of process_rss_mib_result; see process_anon_mib_turn_start. Present where process_rss_mib_result is, if the kernel gives it."),process_peak_rss_mib:E().int().optional().describe("@internal The most memory the process has had resident from its start until this result (VmHWM), in whole MiB. It is not the peak of this turn alone: a later turn repeats an earlier peak unless it went higher. Present where process_rss_mib_result is, if the kernel gives it."),process_cpu_ms_between_turns:E().int().optional().describe("@internal CPU time (user plus system, all threads, without child processes) the CLI process used from the end of its previous turn to this turn's start: mostly what it costs while no turn runs. A turn ends after its last frame and its turn-end hooks. Work it left running in the background counts here, as do this turn's steps ahead of turn start, such as re-reading the tool list. To get CPU time per second, add these up over many results and divide by the sum of their process_wall_ms_between_turns, which always comes with it. Present where process_cpu_ms_turn is, from the process's second turn of any kind on (process_turn_index can still be 0), unless the previous turn was abandoned midway and so never ended."),process_wall_ms_between_turns:E().int().optional().describe("@internal The time that passed in the process_cpu_ms_between_turns stretch, by a clock that never runs backward. Time while the process is stopped counts; time while its virtual machine is paused may not."),process_cpu_ms_turn:E().int().optional().describe("@internal CPU time, counted as in process_cpu_ms_between_turns, from this turn's start until just before this result is built, so what the turn does after that is in neither stretch. The stretch includes the waits for the model and for tools. It always comes with process_wall_ms_turn. Sent only by the workers named under process_rss_mib_turn_start. On them it is present where process_turn_index is, unless the runtime reports no resource usage or the process hosts other sessions too."),process_wall_ms_turn:E().int().optional().describe("@internal The time that passed in the process_cpu_ms_turn stretch, by the same clock as process_wall_ms_between_turns."),input_attachments_detail:u({slowest_producer:o().optional(),slowest_producer_ms:E().int().optional(),cpu_ms:E().int().optional(),major_faults:E().int().optional(),changed_files_reread:E().int().optional(),touch_compare:u({same:E().int().optional(),differs:E().int().optional(),via_outputs_link:E().int().optional(),partial_view:E().int().optional(),already_compared:E().int().optional(),link_on_path:E().int().optional(),leaf_link:E().int().optional(),nlink:E().int().optional(),not_regular:E().int().optional(),oversize:E().int().optional(),enoent:E().int().optional(),other:E().int().optional()}).optional()}).optional().describe("@internal What the input_attachments phase of time_to_request_phases_ms did on the turn, to tell a wait inside one attachment producer from a process that was busy. The producers are the calls of maybe() in getAttachments; their labels are a closed list, and a producer's time includes the computing of the others that run beside it. slowest_producer is the label of the one that took longest from its start to its result, among those that began within the phase, and slowest_producer_ms is that time; a background agent's pass that begins within the phase is timed with the turn's own (a new process's first turn has none), and its re-reads are not counted. Where slowest_producer_ms is well above cpu_ms that producer most likely waited (on a file, the network or a child process); a time_to_request_loop_lag_ms near slowest_producer_ms says instead that the thread itself stood still about that long (a blocking call, or a paused process). Where it is not well above cpu_ms the label tells little. cpu_ms and major_faults are time_to_request_cpu_ms's and time_to_request_major_faults's counters over this phase alone and are read the same way: cpu_ms far below the phase's time means the process was not computing; at or above it means computing, without saying whose. Where cpu_ms is absent, the phase's own time is what there is to compare slowest_producer_ms with. changed_files_reread is how many files the changed_files producer set out to read again in full because their modification time was later than the one recorded when the conversation last wrote or edited them (0 when it read none again, whether or not any file was a candidate; absent when the conversation's record of files was empty or the producer did not run). Present on turns where the input_attachments phase started, unless nothing of it is known. cpu_ms and major_faults are absent wherever time_to_request_cpu_ms is absent, and when the turn's first model request went out before the phase ended. touch_compare counts how the changed_files producer's compares ended in the main thread's pass (a subagent's are not counted). A compare checks a touched file against what the conversation last saw (its size, then its bytes), before deciding whether to read it again. same: the text had not changed, so it was not read again. differs: it had, so it was read again. partial_view and already_compared: the file was not compared (the conversation has seen only part of it or an older copy, or it was compared once already since the conversation last read or wrote it) and was read again. The rest are why a compare declined and the file was read again: link_on_path (the file could not be shown to be the one its path names: on Linux a symbolic link on the way, or a landing through the outputs link that the read check did not judge; or the file swapped or removed meanwhile), leaf_link (the open met a symbolic link: at the file, or on macOS anywhere on the way), nlink (the file has a second hard link), not_regular, oversize, enoent (the file was gone) and other (anything else, errors included). via_outputs_link counts those of same and differs that were reached through the hosted container's outputs link, from /mnt/user-data/outputs to /mnt/attach/outputs. Whole numbers; a zero count is left out, and touch_compare is absent when nothing was counted."),resume_store_confirm_detail:u({write_ms:E().int(),ahead_ms:E().int(),post_ms:E().int(),other_ms:E().int(),posts:E().int(),failed_posts:E().int(),rows_ahead:E().int(),rows:E().int()}).optional().describe("@internal How the resume_store_confirm phase of time_to_request_phases_ms was spent. Present where that phase is, in a session whose transcript goes to a hosted store: on the result of a handed-off turn whose lines were confirmed and that went on to a model request. A wait that ends its turn (the lines not stored, or the turn stopped meanwhile) is therefore not in the measure. The four _ms values sum to that phase exactly. write_ms: the transcript write, until the carried lines are in the queue of the lane that uploads transcript rows (POST /worker/internal-events, one POST out at a time); a POST that is out during the write is counted in posts and rows, but that part of its time is in write_ms only. The other three split the wait for that lane to empty. ahead_ms: a POST was out that held only rows queued before the hand-off's write began, one already out at that moment included. post_ms: any other POST was out, timed by the client from before the body is encoded to the response, each retry included. other_ms: no POST was out (a backoff between retries, picking and sizing the next batch, a busy event loop), plus rounding, any POST still out when the wait was cut short, and the time of POSTs after the 64th. posts: POST attempts that ended between the start of the write and the end of the wait; failed_posts: those that did not go through. rows_ahead: rows the lane had accepted and the store had not yet confirmed when the write began, queued or in a POST already out; rows written earlier but kept back for a compaction's summary count from when they are queued. rows: rows queued since then that a POST delivered, the carried lines among them."),user_message_uuid:o().optional(),user_message_uuids:C(o()).optional(),resume_reason:o().optional(),local_command:o().optional(),request_sent_wall_ms:E().optional(),first_request_input_tokens:E().int().optional().describe("@internal Input tokens of the model call whose send time is request_sent_wall_ms: input_tokens + cache_read_input_tokens + cache_creation_input_tokens from that call's message_start. Lets a consumer group turn latency by prompt size. Present only with request_sent_wall_ms, and only when the sum is above zero; absent from older producers."),user_message_server_received_wall_ms:E().optional().describe("@internal The server_received_wall_ms of the user message that user_message_uuid names, copied unchanged, so the session server can measure from its own receipt to request_sent_wall_ms (two machines' clocks) without keeping the receipt time. Present only with request_sent_wall_ms, and only when that message carried a positive finite number there; absent from older producers."),first_content_frame_ms:E().int().optional(),first_stream_post_ms:E().int().optional(),first_stream_post_ack_ms:E().int().optional(),first_stream_post_queue_wait_ms:E().int().optional(),first_stream_post_queued_behind:B($r).optional(),first_stream_post_wall_ms:E().optional(),frame_received_wall_ms:E().optional().describe("@internal Date.now() (epoch ms) when the triggering send's frame arrived on a session reading its input from the session server's SSE stream (--sdk-url), before the input loop read it. With frame_enqueued_wall_ms and turn_started_wall_ms it splits the stretch between the server's persist and request_sent_wall_ms into transit, the input loop's handling of the frame, its wait on the command queue, and the turn's own work. Present only together with request_sent_wall_ms, and only when the transport recorded the receipt; absent on a local stdin host and from older producers."),frame_enqueued_wall_ms:E().optional().describe("@internal Date.now() (epoch ms) when the input loop put the triggering send's frame on the command queue. Present exactly when frame_received_wall_ms is."),turn_started_wall_ms:E().optional().describe("@internal Date.now() (epoch ms) when the turn's clock started: the anchor duration_ms, ttft_ms, ttft_stream_ms, time_to_request_ms, first_content_frame_ms, first_stream_post_ms and first_stream_post_ack_ms are measured from. Present exactly when frame_received_wall_ms is."),frame_intake_phases_ms:me(o(),E().int()).optional().describe("@internal How the triggering send's frame spent the time from frame_received_wall_ms to frame_enqueued_wall_ms, in integer ms per step: before_read (until the input loop read the frame; a frame received more than once counts from the earliest receipt no earlier copy already took), and, carved out of before_read where the loop could tell them apart, startup_wait (the part before the input loop existed, the worker still starting), control_requests_ahead (the part the loop spent handling control requests before it read the frame) and user_frames_ahead (the part it spent on earlier user frames, each from its read until the loop moved on, at its delivery or its parking), so that before_read keeps only the rest (frames handled without being noted, and everything when no split could be made); then dedup, flag_settle, receive_hook, attachments, admission_wait (held behind a pending model switch, a pending MCP server-set change, start-up work the worker still owed its first turn, or an earlier held frame), admit_check (the host's decision whether to queue the frame, when it had to be awaited), and other (the rest). Steps that did not run are absent; before_read and other are always present. The values sum to frame_enqueued_wall_ms minus frame_received_wall_ms, unless other or before_read came out negative and was set to 0. Present exactly when frame_received_wall_ms is, except from older producers."),turn_start_phases_ms:me(o(),E().int()).optional().describe("@internal How the time from frame_enqueued_wall_ms to turn_started_wall_ms was spent, in integer ms per step of the host's work through its message queue. Each step is where the host was at the time, which for part of the stretch may be an earlier message's turn. The steps: idle (the host was not working through its queue), earlier_turn (an earlier turn still running, including its work after its result), after_turn (the host's work after an earlier turn ended and before it took the next message: recording the outcome, writing the transcript and acknowledgements, and releasing the queue; also its handling of a crash), background_wait (waiting on background tasks before looking at the queue again), entry_joins (other waits when the host starts on its queue, before it may take a message), sdk_mcp_update (the claude -p host updating its SDK MCP servers when it starts on its queue), loop_top (reloading plugins that changed, at the start of each pass over the queue), session_start_wait (waiting for the plugins' first session.start hook, and taking the message off the queue), first_command (the claude -p host's waits for its plugin registry and a Projects mount before the first message it takes each time it starts on its queue), mcp_prewait (waiting for MCP servers still connecting, before that same first message), repo_wait (a claude-code-server session waiting for its repository before a turn), turn_joins (before every turn: starting the memory re-check, and waiting for a Projects mount and for SDK or newly added MCP servers), tool_pool (building the turn's tools), commit (marking the message taken and setting up its turn), after_arm (waiting for a cleared permission prompt's record to be written, and the host's other work once the turn is set up), turn_gate (work the host requires before every turn), turn_open (the host's turn-start hook and other turn setup), engine_setup (getting the engine for the turn; on the claude -p host's first turn, building its session), tool_reread (re-reading tools, MCP clients and settings for the turn), cwd (switching to the turn's working directory), and other (the rest: rounding, and the wall clock running ahead of the monotonic one). Values are rounded so that they add up: each is within 1 ms of its step's time, a step that comes out as 0 is absent, and other is always present. The values sum to turn_started_wall_ms minus frame_enqueued_wall_ms, except that they can exceed it, usually by 1 ms from rounding and by more if the wall clock stepped back. Present only when frame_received_wall_ms is, and absent from older producers."),turn_start_control_requests_ms:E().int().optional().describe("@internal Of the time from frame_enqueued_wall_ms to turn_started_wall_ms, the integer ms in which the claude -p host's message reader was held by control requests (such as mcp_set_servers or set_permission_mode) instead of reading the next message; for a request handled in the background, only its start counts. The host can keep working toward the turn meanwhile, so this overlaps turn_start_phases_ms and is not part of its sum. Absent when 0. A claude-code-server tenant does not time control requests, so its results never have this field."),first_text_post_ms:E().int().optional(),first_text_post_queue_wait_ms:E().int().optional(),first_text_post_queued_behind:B($r).optional(),first_text_post_wall_ms:E().optional(),time_to_request_from_spawn_ms:E().int().optional(),warm_spare_claimed:O().optional(),flag_fetch_kick:o().optional().describe("@internal One of FLAG_FETCH_KICKS, a string here so that list can change: whether this process started its start-up feature-flag fetch before the wait for it, or why not: the same value as system:init's startup_timing.flag_fetch_kick. started_in_init_* and started_after_init_*: it did, inside init() or right after. not_asked_warm: the flag cache was warm and nothing asked for an early start. settings_pending_*: settings that could change the fetch were still to be applied. launch_excluded: not a launch that starts it early. not_eligible: interactive, or no wait is budgeted. An _empty or _warm ending is the flag cache at that moment. Present only where time_to_request_from_spawn_ms is, and only when start-up judged it."),time_origin_ms:E().optional(),is_error:O(),api_error_status:E().int().nullable().optional(),api_error_code:o().optional().describe("@internal The api_error_code of the API error that ended the turn (see SDKAssistantMessage.api_error_code): the server's error.details.error_code when it is an identifier. Absent when the turn did not end on an API error or the response carried no code."),api_error_origin:B(["first_party"]).optional().catch(void 0).describe("@internal The api_error_origin of the API error that ended the turn (see SDKAssistantMessage.api_error_origin): first_party when Anthropic's own API sent the response. Absent when the turn did not end on an API error or the origin is anything else; treat an unknown value as absent."),api_error:pn().shape.api_error.describe("@internal The api_error of the API error that ended the turn (see SDKAssistantMessage.api_error). Absent when the turn did not end on an API error or the error has no typed kind; treat an unknown value as absent."),num_turns:E().int(),result:o(),stop_reason:o().nullable(),total_cost_usd:E().describe(jA),usage:zA(),modelUsage:me(o(),Ge()).describe(xA),model_usage_since_last_result:me(o(),Ge()).optional().describe(DA),subagent_stats:MA().optional().describe(LA),safety_stops:E().int().nonnegative().optional().describe(UA),permission_denials:C(IA()),queued_turn_count:E().int().optional().describe(VA),structured_output:oe().optional(),deferred_tool_use:UF().optional(),terminal_reason:PA().optional(),interrupted_by_shutdown:T(!0).optional().describe(GA),result_index:E().int().nonnegative().optional().describe(qA),fast_mode_state:$t().optional(),fast_mode_disabled_reason:Xt().optional(),origin:uo().optional(),uuid:p(),session_id:o()})),GF=f(()=>u({type:T("result"),subtype:B(["error_during_execution","error_max_turns","error_max_budget_usd","error_max_structured_output_retries"]),duration_ms:E().int(),duration_api_ms:E().int(),is_error:O(),num_turns:E().int(),stop_reason:o().nullable(),total_cost_usd:E().describe(jA),usage:zA(),modelUsage:me(o(),Ge()).describe(xA),model_usage_since_last_result:me(o(),Ge()).optional().describe(DA),subagent_stats:MA().optional().describe(LA),safety_stops:E().int().nonnegative().optional().describe(UA),permission_denials:C(IA()),queued_turn_count:E().int().optional().describe(VA),errors:C(o()),runner_exit:VF().optional().describe("@internal Set by the self-hosted runner on the result it synthesizes when the session process fails to start or exits abnormally (src/self-hosted-runner/failureResult.ts buildFailureEvents)."),startup_failure_reason:jF().optional().describe("Set on the zeroed error_during_execution result a stream-json run writes before exiting on a known startup failure; errors carries the same text as stderr. Failures that used to end with stderr alone write that result only when the host sets CLAUDE_CODE_STARTUP_FAILURE_RESULTS. Absent on every other result, on startup failures without a known cause, and from older producers."),user_message_uuid:o().optional().describe("Client uuid of the user message that triggered this turn (submitMessage options.uuid), echoed back so a consumer can link this error result to the send it answers \u2014 the same join key the success variant echoes, carried alone (error turns have no request_sent_wall_ms to report). A delivery-failure result from the remote-session client echoes the failed send's queue key, which is client-minted when the host sent no uuid of its own. A synthetic/scheduled (meta) turn's own uuid is echoed only when the host vouches it is the client event's own (delivered content such as a Slack owner ping or a Slack-bot observation); a meta turn that folded queued user messages in mid-turn, vouched or not, echoes the LAST of them. Absent on turns that neither had a client uuid nor folded a user message in, on session-scoped failures with no single triggering send (a crashed worker's zeroed result), and from older producers."),user_message_uuids:C(o()).optional().describe("Client uuids of every user message whose prompt this turn consumed, in consumption order \u2014 all members of a prompt batch the host merged into this one turn (several messages sent close together run as one turn whose user_message_uuid is the LAST member's), then any queued user message folded into the running turn between tool rounds, once taken off the queue \u2014 so a consumer that sent any of them can bind this result to its own send by finding its uuid anywhere in the list. Always contains user_message_uuid; at most 64 entries; can be longer than the list on the turn's first reply frame. Present when a headless turn that ran echoes user_message_uuid; absent on delivery-failure and zeroed results and from older producers (fall back to user_message_uuid)."),resume_reason:o().optional().describe("Why this turn continued one that a worker restart interrupted. Such a turn is the automatic re-run of the interrupted turn (CLAUDE_CODE_RESUME_INTERRUPTED_TURN), or one that goes on from the answer to the permission prompt the new worker took over, or from that turn's tool calls still in flight. The value is the host's CLAUDE_CODE_RESUME_REASON when it set one (host_draining, checkpoint_restore, container_recreated, \u2026), else 'interrupted_turn'. Present on such a headless turn's result, success or error, with or without an echo (a turn whose opening user prompt could not be vouched for still carries the reason); absent on every other turn (also one that goes on from the answer to any other permission prompt), on the Remote Control bridge's per-turn synthetic results, and from older producers."),terminal_reason:PA().optional(),interrupted_by_shutdown:T(!0).optional().describe(GA),result_index:E().int().nonnegative().optional().describe(qA),fast_mode_state:$t().optional(),fast_mode_disabled_reason:Xt().optional(),origin:uo().optional(),uuid:p(),session_id:o()})),BF=f(()=>Fe([qF(),GF()]).describe(`The outcome of a turn. The CLI emits exactly one result message per turn, after that turn's assistant, user and stream_event messages; treat it as the turn-complete signal (informational system messages such as task notifications, session state changes or prompt suggestions may still follow it). subtype "success" carries the final assistant text in result \u2014 or, with is_error true, the error text when the turn ended on an API error; the error subtypes say why the turn stopped early. In single-prompt (non-streaming-input) mode the process exits after the turn.`)),mn=f(()=>u({file:o().optional().describe("Path to the settings file that failed to parse or validate."),path:o().describe("Dot-notation path to the field with the error, or empty string for whole-file errors."),message:o().describe("Human-readable error message.")}).describe("A settings file parse or validation error. When a settings.json file fails to parse (invalid JSON, JSON comments, schema mismatch), the file is skipped and any rules it contained \u2014 including permission allow/deny lists \u2014 are not applied.")),mo="The plugin's version as declared in its plugin.json manifest, emitted verbatim (plugin-author-controlled \u2014 validate before trusting). Omitted when the manifest declares no version.";function BA(){return u({id:o(),view_url:o(),device:Kr("status",[u({status:T("bound"),device_id:o(),display_name:o().optional()}),u({status:T("unbound"),reason:o(),message:o()})]),directory_sync:u({state:B(["off","seeding","armed","stopped"]),reason:o().optional(),message:o().optional(),first_upload:o().optional(),synced_files:E().int().nonnegative().optional(),other_window:O().optional(),muted:O().optional(),started_from_upload:O().optional(),direction:B(["two_way","upload_only"]).optional().catch(void 0),file_mode:B(["container_sync","device_tools","unspecified"]),file_mode_source:B(["stored"])}),client_version:T(1),not_applied:C(u({name:o(),kind:B(["lost","kept","preference"])})).optional(),host:u({handle:o(),working_dir:o(),platform:o(),cli_version:o().optional()}).optional(),serving:u({state:B(["on","off","pending","revoked"]).catch("off"),reason:o().optional().catch(void 0),policy:B(["parity","interim"]).catch("interim"),channel:B(["session","bridge_only"]).catch("bridge_only")}).optional(),connection:B(["connecting","live","reconnecting"]).optional().catch(void 0),calls:u({live:C(u({call_id:o(),tool:o(),state:B(["running","asked"]).catch("running"),since:E(),ask_id:o().optional(),lapses_at:E().optional()})),recent:C(u({call_id:o(),tool:o(),ended:B(["completed","denied","withdrawn","refused","failed"]).catch("failed"),code:o().optional(),at:E()}))}).optional(),notices:C(u({key:o(),text:o()})).optional().catch(void 0)})}var KF=f(()=>u({type:T("system"),subtype:T("init"),agents:C(o()).optional(),apiKeySource:n0(),startup_timing:me(o(),oe()).optional().describe("@internal Cold-start telemetry for hosted (CCR) sessions: named startup phases and resume-hydration counters (StartupTiming in src/utils/startupTiming.ts). Absent elsewhere."),betas:C(o()).optional(),claude_code_version:o(),cwd:o(),tools:C(o()),mcp_servers:C(u({name:o(),status:o(),source:o().optional().describe("Where the server definition came from \u2014 same values as McpServerStatus.source (sdk | plugin | a config scope). Absent on CLIs that predate the field.")})),model:o(),permissionMode:de(),slash_commands:C(o()),terminal_slash_commands:C(o()).optional().describe("Subset of slash_commands whose UX is bound to the local terminal (e.g. exit, statusline). Phone/remote UIs should hide these from command menus; desktop surfaces may keep them. Present only when non-empty; absent on CLIs that predate the field, and on sessions where no advertised command carries the tag."),output_style:o(),skills:C(o()),plugins:C(u({name:o(),path:o(),source:o().optional().describe('@internal Plugin source identifier in "name\\@marketplace" format. Sentinels: "name\\@inline" for --plugin-dir, "name\\@skills-dir" for .claude/skills plugins, "name\\@synced" for plugins synced from claude.ai, "name\\@builtin" for built-in plugins.'),version:o().optional().describe(mo)})),plugin_errors:C(u({plugin:o(),type:o(),message:o(),path:o().optional().describe("Present only when a --plugin-dir, SDK `plugins` or synced directory entry did not load at all: the path of that entry, resolved against the cwd (for a directory, the value its `plugins[]` row would have carried; for a .zip, the archive; a --plugin-url entry carries none). `plugin` is then the positional `inline[N]` / `synced[N]` tag, so a host that mounts several directories pairs the error to its own by this path.")})).optional().describe("Plugin load-time errors. A plugin that did not load (an unmet dependency, a --plugin-dir entry that failed) is absent from `plugins[]`; a plugin that loaded without one of its components keeps its row and gets an entry here too. `plugin` is `name@marketplace`, or the positional `inline[N]` / `synced[N]` tag for a directory entry that failed before it had a name; `type` is a category from an open set (path-not-found, generic-error, manifest-validation-error, dependency-unsatisfied, hook-load-failed, \u2026) \u2014 treat a value you do not recognize as a generic failure; `message` is display text. The key is omitted when there are no errors; CI can fail on `(plugin_errors?.length ?? 0) > 0`. A session whose frames are persisted server-side (a Remote Control worker) always omits this key \u2014 plugin diagnostics stay in the local log there, so an omitted key does not assert a clean load."),plugin_warnings:C(u({plugin:o(),type:o(),message:o()})).optional().describe("@internal Plugin authoring feedback (e.g., a default folder shadowed by a manifest key). When `plugin` matches an entry in `plugins[]`, that plugin loaded and the warning is advisory; warnings with a synthetic `plugin` source (no matching `plugins[]` entry, e.g. workspace-level suppression notices) describe content that did NOT load. The key is omitted when there are no warnings. On connections that persist frames server-side (the local bridge-worker lane) this key is always omitted \u2014 plugin diagnostics stay in the local log, so an omitted key there does NOT assert a clean load."),mcp_server_errors:C(u({name:o(),type:o(),message:o()})).optional().describe("@internal MCP server config entries from --mcp-config that failed validation and were skipped (e.g. a `url` entry with no `type`). Affected servers are absent from `mcp_servers[]`. `type` is a stable category from an open set \u2014 currently unknown_type, url_missing_type, invalid_config, reserved_name, or (Remote Control child only) bridge_carrier_foreign_entry, bridge_carrier_not_http, bridge_carrier_url_mismatch, bridge_carrier_no_ingress_origin, bridge_carrier_no_session_id; treat values you do not recognize as a generic skip. The key is omitted when there are no errors; CI can fail on `(mcp_server_errors?.length ?? 0) > 0`. On connections that persist frames server-side (the local bridge-worker lane) this key is always omitted \u2014 the skipped-entry detail stays in the local log, so an omitted key there does NOT assert every entry validated."),fast_mode_state:$t().optional(),fast_mode_disabled_reason:Xt().optional(),footer_indicator:Ao().optional().describe(`@internal The terminal's configured "\u25C6 <text>" footer pill \u2014 see SDKFooterIndicator. Absent when nothing is configured.`),effort:B(["low","medium","high","xhigh","max"]).nullable().optional().describe("The effort level the session will send on its next request \u2014 after env overrides, session state, org caps and model-support downgrades; the same value get_settings reports as applied.effort. null when no effort parameter will be sent (a model without effort, CLAUDE_CODE_EFFORT_LEVEL=unset, or an internal numeric budget). Present on Remote Control bridge init frames (terminal- and Desktop/VS Code-hosted sessions); absent on hosts that do not publish it and on CLIs that predate the field. Re-emitted inits carry the current value \u2014 the newest frame wins."),per_turn_effort_active:O().optional().describe("@internal Whether per-turn effort is active for this frame's `model`. true: an effort change keeps the prompt cache, because the effort is sent inside the conversation, at the turn where it changes. false: the effort is sent only as the top-level parameter, so a change rewrites the cached prefix. Mid-session the CLI reports only a change to false (system/per_turn_effort_changed), and true comes only from an init. After a fresh process, or after the conversation's refusals are cleared (for example by /clear or a compaction), a true is provisional: a refusal on any later request sends system/per_turn_effort_changed before the retry, so a host keeps listening for it all session. Absent means unknown. Sent by the stream-json (Agent SDK) host."),view_mode:B(["focus","default"]).optional().describe("Whether the session's transcript is in focus view ('focus': the model is told the user sees only its final message per turn, so clients may collapse each turn to the prompt and the final response; 'default' otherwise). Toggled by /focus, including over Remote Control. Present on Remote Control bridge init frames and on the per-turn init of headless stream-json runs (`claude rc` workers, -p, the SDK's subprocess transport); absent on hosts that do not publish it (the in-process engine) and on CLIs that predate the field. Re-emitted inits carry the current value \u2014 the newest frame wins."),capabilities:C(o()).optional().describe("Protocol capabilities this CLI supports, so SDK consumers can feature-detect instead of version-sniffing. Open set \u2014 ignore unknown values; check each capability for exactly the behavior you use. 'interrupt_receipt_v1' = the interrupt control_response success payload carries still_queued (uuids of async user messages that survive the interrupt). 'interrupt_cancel_queued_v1' = the interrupt control_request honors cancel_queued:true (queued and pending-dispatch commands are cancelled alongside the abort, listed on the response's cancelled field; still_queued is then empty \u2014 including any uuid that was mid-fold at the interrupt instant, since this request also aborts and the fold never delivers it \u2014 except that a client driving a hosted session lists there what it can no longer recall: a send already in flight to that session, or the first prompt the session was created with). 'queued_notifications' = the CLI accepts inbound queued_notification stream messages and drains them via ReadNotifications (the cloud session backend reads this from the persisted init event to decide whether it may send them). Absent on older CLIs."),analytics_disabled:O().optional().describe("@internal True when the CLI has analytics/telemetry disabled (privacy level, DO_NOT_TRACK, or 3P provider). IDE clients use this to hide per-message thumbs feedback UI since the rating event would be a no-op."),product_feedback_disabled:O().optional().describe("@internal True when the org's allow_product_feedback policy is false (ZDR/HIPAA). IDE clients use this to hide feedback surfaces (thumbs, session survey) whose events the CLI would drop at the proxy boundary anyway."),memory_paths:u({auto:o().optional(),team:o().optional()}).optional().describe("@internal Absolute directory paths for the auto-memory and team-memory stores. Lets SDK renderers classify Read/Write/Edit tool calls on these paths as memory operations without re-implementing CLI path detection."),scratchpad_path:o().optional().describe("@internal Absolute path of this session's scratchpad directory, for clients that read files from the session. Omitted when the scratchpad is disabled, and from the redacted init sent over the Remote Control bridge and by the hosted worker."),original_cwd:o().optional().describe("@internal Absolute path of the folder the session's file permission checks are anchored at, for clients that read files from the session. Unlike cwd it does not follow the shell: it moves only on /cd, on entering or leaving a worktree, and on a session restore. Omitted on the lanes that redact system/init's local paths: the init sent over the Remote Control bridge and by the claude-code-server tenant worker. Omitted too in a session that has no directory, where cwd is the empty string, and, on every lane, for an organization that is under HIPAA or whose policy the session fetches but does not hold."),additional_directories:C(o()).optional().describe("@internal Absolute paths of the folders added to the session (--add-dir, the SDK additionalDirectories option, settings, a grant or a host's request made mid-session), in no particular order; an empty array when there are none. Re-read for every init message. Left out: a folder that only a settings file the repository delivers adds (.claude/settings.json, and .claude/settings.local.json unless git is known not to track it), so that a branch cannot widen what a client fetches; and an entry not stored as an absolute path. Entries are not all symlink-resolved, and one can be the symlinked spelling of the start folder. It grants nothing: the CLI's own check decides every read. Absent means not told, not none: omitted on the lanes that redact system/init's local paths and for an organization that is under HIPAA or whose policy the session fetches but does not hold, like original_cwd, and by a host that has not wired it. A session that has no directory still sends it."),worker_epoch:E().int().min(1).optional().describe("@internal This cloud worker's life (CLAUDE_CODE_WORKER_EPOCH): a new number each time the session's worker is started. A claude --cloud client that latched an acknowledged epoch (remote_tools_announce) re-registers only when this differs. Emitted on workers where the account's remote-tools gate (tengu_violin_wood) is on, and by every claude-code-server worker whatever that gate reads; absent outside cloud workers and on CLIs that predate the field."),powershell_path:o().nullable().optional().describe("@internal Windows only: the absolute path of the PowerShell binary this session runs PowerShell commands with (PowerShell 7 when installed, including Microsoft Store installs, else Windows PowerShell 5.1), or null when none was found. Lets a desktop host open its own terminal with the same shell instead of re-implementing the detection. Present on stream-json (Agent SDK) init frames; absent on other platforms, wherever the init ambient is redacted (the Remote Control bridge), and on CLIs that predate the field."),cloud_session:BA().optional().describe("@internal Only on init frames written by the headless stream-json client of a cloud-hosted session (agent loop in the cloud container; this machine may be bound to it as a device): a snapshot per frame, absent in every other mode; no user, assistant or result frame precedes the first such init (informational system frames may; so may a worker's result that no init preceded, after all that was held ahead of it; on a re-attach so may frames of a turn already in progress, other clients' prompts, and the echo of this host's own prompt when the session already had it or it joins a turn in progress). `id` is the cloud session id, always in its `session_\u2026` spelling (the producer normalizes the service's `cse_\u2026` spelling of the same session); hosts store it and pass it back verbatim to re-attach. The frame-level `session_id` is instead the cloud worker's id, a uuidv5 of the session id in its `cse_` form: the same for the life of the cloud session across worker restarts and re-attaches until a /clear in the session, and passed through by the client unchanged. When `device.status` is `unbound`, `reason` is one of the client's unbound-reason keys and `message` its phrase: one line, at most 200 characters, no ANSI or trailing newline, worded to follow `Laptop tools unavailable: `. `directory_sync`: see docs/cloud-session-block.md. `not_applied`, when present, lists what the host passed that this session does not apply \u2014 `name` is a flag as `--flag`, a key inside --settings / --managed-settings as `settings.<key>` / `managed-settings.<key>`, or a field of the opening initialize as `initialize.<field>` (at most 40, lost first, each one line of about 64 characters at most); `kind` says what it costs: `lost` (the session does without something this invocation asked for \u2014 the informational warning names these), `kept` (an attach: the existing session keeps what it was created with) or `preference` (a display or host preference nobody would miss \u2014 the informational notice names these two), so a host may show them itself once or never; absent when nothing was left unapplied. `host`, when present, is what this machine announces as to the session: `handle` is the name the model addresses it by (and a client shows), `working_dir` the absolute directory served calls run in (that machine's separators), `platform` its platform word, `cli_version` its Claude Code version; each one line of at most 200 characters; present once this machine has built an announce for the session (bound, with something or an explicit nothing to serve), absent otherwise and on clients that predate it. `serving`, when present, says whether this machine serves its tools (Bash, Read, Write, Edit) to the session over the session's channel: `state` is `pending` while bound and about to announce, `on` once the session holds this machine's tools, `off` when it serves nothing, `revoked` when it stopped mid-session; `reason` (present when `state` is not `on` and the cause is known) is one of the client's serving-off keys \u2014 `not_bound` (see `device.reason`), `external_build`, `windows`, `muted` (Anthropic's emergency switch turned serving off; it comes back when the switch does), `switch_off`, `launched_from_home`, `channel_off`, `egress`, `policy_org` (the organization does not allow remote sessions), `flag_off`, `flag_stale`, `announce_refused`, `announce_unverified`, `superseded` \u2014 an open set: render an unrecognized value as a generic not-serving state; `policy` is the serving policy in effect (`parity`, or the stricter `interim` fallback); `channel` is `session`, or `bridge_only` when the session channel is switched off on this machine and served calls (if any) ride only the legacy device bridge, whose state this block does not describe. Absent on clients that predate it: feature-detect the key. `connection`, when present, is this client's stream to the session: `connecting` before it first connects, `live` while it is up, `reconnecting` while it is lost and being re-dialled (this machine is offline to the session meanwhile). `calls`, when present (once this machine has served a call this attach), is what it serves right now and how its last calls ended, by id and tool name only \u2014 never a call's input or output: `live` lists, oldest first, each call admitted here and not yet ended, `state` `running` while this machine executes it or `asked` while it waits on the session's approval (`ask_id` names the question; `since` is when it entered that state and `lapses_at` about when the session gives an unanswered question up, both epoch milliseconds on this machine's clock \u2014 the session's own timer decides); `recent` lists, newest last, at most 20 calls that ended here, `ended` being `completed`, `denied` (the session said no), `withdrawn` (the session took the question back unanswered \u2014 its patience ran out or the turn moved on), `refused` or `failed`, with `code` the result's disposition, refusal or failure word when it has one, and `at` when. `notices`, when present, is what this machine's serving has told the person during this attach that a host should show, at most 8: `key` is the notice's stable name (an open set \u2014 `device-mcp-consent`: this machine has MCP servers a cloud session could use and none are offered until the person allows it; `device-mcp-reconsent`: a server it offers changed the tools it lists and is withheld until re-approved, or this machine's record of what its servers list could not be read and none are offered \u2014 `text` says which; `device-mcp-policy`: a deny list in this machine's Claude Code settings lists remote-devices, so none of its MCP servers are offered; `device-mcp-dropped`; `served-hooks-not-run`; `served-hook-errors`; `served-bash-launched-from-home`; `served-tools-muted` / `served-tools-unmuted`; `announce_unverified`) and `text` its one line (at most 200 characters, no ANSI or newline) \u2014 this machine's own words with names from its own configuration, to be shown as plain text; written only by a serve-only helper (`--attach-serve`) and absent when nothing was said. `calls`, `connection` and `notices` are pushed between inits on `cloud_session_delta` frames. `client_version` rises only on a breaking change to this block \u2014 warn and continue on a higher value, never refuse; `not_applied[].kind`, `serving.state`, `connection`, `calls[].state` / `ended` and reason keys may gain values without it changing, so treat unrecognized values neutrally (an unrecognized `serving.state` as not serving \u2014 this schema itself parses an unrecognized `serving.state` as `off`, `policy` as `interim`, `channel` as `bridge_only`)."),uuid:p(),session_id:o()}).describe("Session metadata the CLI emits at the start of each turn, normally ahead of every other message of that turn: session_id, model, working directory, tools, MCP servers, slash commands, permission mode, and the capabilities list for feature detection.")),HF=f(()=>u({type:T("stream_event"),event:OF(),parent_tool_use_id:o().nullable(),uuid:p(),session_id:o(),ttft_ms:E().int().optional(),thinking_display:o().optional().describe("@internal The thinking.display Claude Code put in the API request body for the response this event belongs to. If anything rewrites the request on its way to the API, this value still states what Claude Code sent, not what the API received. Two responses of one turn can differ. Set on `message_start`, on a thinking block's `content_block_start` and on `thinking_delta` events when the body had a display; absent on every other event, on Remote Control (interactive terminal) sessions and from older producers. An event that the API did not send as it stands can lack the key. The key states which display the text was requested with, and nothing about how to show it. An absent key states nothing: neither which display was requested, nor that none was."),api_message_id:o().optional().describe("@internal The API's id (`msg_\u2026`) of the response this event belongs to: `event.message.id` on its `message_start`, `message.id` on its assistant messages. Not a message `uuid`. Set on every event from a response's `message_start` to its `message_stop`, so that a consumer that missed the `message_start` can still tell responses apart. Two responses can share an id, as when a `message_start` is replayed; the key does not tell those apart. Absent on pings, when the `message_start` had no id or an empty one, on Remote Control (interactive terminal) sessions and from older producers. The events that Claude Code produces itself to close a response cut short carry it too. Events that a plugin produced or rewrote, and those that Claude Code builds in their place or to close them, can lack it. An absent key states nothing about which response the event belongs to."),abandoned_blocks:u({api_message_id:o().describe("The API's id (`msg_\u2026`) of the response that was cut short: `event.message.id` on its `message_start`, `message.id` on its assistant messages. Not a message `uuid`. Should two responses share an id, the one meant is the one this `message_stop` closes."),from_block_index:E().int().nonnegative().describe("Blocks of the response at this index and above have no assistant message and never will. It is an `event.index` as on the response's `content_block_*` events, not a count of assistant messages. 0 means the whole response. Can be higher than every index the consumer has seen, and then there is nothing to remove.")}).optional().describe("@internal Set on a `message_stop` that Claude Code produced itself, after it stopped reading the response that `message_stop` closes because the API's stream failed, stalled or ended early. That response's content blocks at index `from_block_index` and above have no assistant message and will never get one, so a consumer that drew or stored them from stream events, and holds no assistant message for them, can remove them, even a block that has had its `content_block_stop`. Nothing is stated about lower blocks: some may have no assistant message, and what follows may repeat or replace them. What follows can be, among others, a retry (a new `message_start`), the same request without streaming (assistant messages under another id, with no `message_start` before them), an assistant message that reports the error, or nothing. A plugin can add content blocks of its own to a response, and those do get assistant messages under the same id, emitted before this event. Absent on every other `message_stop` (the API's own, one produced for a response that had arrived whole, one where Claude Code cannot be sure), on Remote Control (interactive terminal) sessions and from older producers. An absent key states nothing: a block with no assistant message yet may still get one."),text_runs_joined:T(!0).optional().describe("@internal Set on the `message_start` of a response when CLAUDE_CODE_WEBSEARCH_CITATIONS is on in a non-interactive session. Each run of adjacent text blocks of that response gets one assistant message with one text block, which holds the joined text. Each entry of its `citations`, except a `web_search_result_location`, has `span_start` and `span_end`: the place of the cited block in the joined text, in Unicode code points, end exclusive. The `content_block_*` events still show each block of the run by its own index. A response that came without streaming has no `message_start`, and it is joined too."),user_message_uuid:o().optional().describe("Client uuid of the user message this turn is answering (submitMessage options.uuid), stamped on a non-ping stream event each time that send changes: the turn's FIRST non-ping stream event (normally the frame that triggers the turn's initial ack), and, for a turn started by a synthetic (meta) prompt, the first non-ping stream event after each queued user message folded in mid-turn takes the echo over (see SDKAssistantMessage.user_message_uuid for the rule) \u2014 so a consumer can bind the reply stream to the send it answers without waiting for the result. A turn started by a typed prompt stamps only its first non-ping stream event; independently, its first complete assistant message is stamped as well (see SDKAssistantMessage.user_message_uuid), so the same uuid may appear on both. Absent on every other stream event of the turn, on turns that neither had a client uuid nor folded a user message in, and from older producers."),user_message_uuids:C(o()).optional().describe("Client uuids of every user message whose prompt this turn has consumed so far, in consumption order \u2014 all members of a prompt batch the host merged into this one turn (several messages sent close together run as one turn whose user_message_uuid is the LAST member's), then any user message folded into the turn before this frame \u2014 so a consumer that sent any of them can bind this reply to its own send by finding its uuid anywhere in the list. Always contains user_message_uuid; at most 64 entries. Present exactly when user_message_uuid is, on the same frames; absent from older producers (fall back to user_message_uuid)."),resume_reason:o().optional().describe("Why this frame's turn continues one that a worker restart interrupted. Such a turn is the automatic re-run of the interrupted turn (CLAUDE_CODE_RESUME_INTERRUPTED_TURN), or one that goes on from the answer to the permission prompt the new worker took over, or from that turn's tool calls still in flight. The value is the host's CLAUDE_CODE_RESUME_REASON when it set one (host_draining, checkpoint_restore, container_recreated, \u2026), else 'interrupted_turn'. Stamped on the same reply frames as user_message_uuid (which on such a turn names the interrupted turn's own last user prompt), so a consumer can tell its first reply from the interrupted attempt's. Absent on every other turn (also one that goes on from the answer to any other permission prompt), on thinking_tokens frames, and from older producers.")}).describe("An incremental streaming event for the assistant message being generated, emitted only when partial messages are requested (--include-partial-messages). The complete assistant message still follows as its own message.")),FF=f(()=>u({type:T("system"),subtype:T("compact_boundary"),compact_metadata:u({trigger:B(["manual","auto"]),pre_tokens:E().int(),post_tokens:E().int().optional(),cumulative_dropped_tokens:E().int().optional().describe("@internal Running total of context tokens compaction has removed so far, across this and every earlier compaction. "+"Each contribution is approximately pre_tokens \u2212 post_tokens."),duration_ms:E().int().optional(),user_context:o().optional().describe('@internal User-provided focus text for manual "summarize from here".'),messages_summarized:E().int().optional().describe("@internal Count of messages the compaction summarized."),precomputed:O().optional().describe("@internal The summary was generated in the background at the autocompact threshold and swapped in when prompt-too-long fired; duration_ms measures user-wait from that point."),pre_compact_discovered_tools:C(o()).optional().describe("@internal Deferred-tool names discovered before this compaction. extractDiscoveredToolNames reads this back on the next turn so the tool-schema filter keeps including them after the tool_reference-carrying messages were summarized away."),pre_compact_artifact_read_versions:C(u({slug:o(),ver:o()})).optional().describe("@internal The artifact versions the conversation held before this compaction (slug is the artifact id, ver the version read or published), most recently changed first; empty when it held none. A resumed session replays these so it can update those artifacts without reading them again."),preserved_segment:u({head_uuid:p(),anchor_uuid:p(),tail_uuid:p()}).optional().describe("Relink info for messagesToKeep. Loaders splice the preserved segment at anchor_uuid (summary for suffix-preserving, boundary for prefix-preserving partial compact) so resume includes preserved content. Unset when compaction summarizes everything (no messagesToKeep)."),preserved_messages:u({anchor_uuid:p(),uuids:C(p()),all_uuids:C(p()).optional().describe("@internal Unfiltered messagesToKeep UUIDs. uuids is the on-disk subset (messages recordTranscript writes); all_uuids is the in-memory superset including non-loggable messages an in-process surface still holds for the next turn's API input. Absent from older producers.")}).optional().describe("Ordered messagesToKeep UUIDs. Supersedes preserved_segment \u2014 "+"readers look up each UUID directly and relink uuids[i] to uuids[i-1] (uuids[0] to anchor_uuid) instead of walking the parentUuid chain. Unset when compaction summarizes everything.")}),logical_parent_uuid:p().nullable().optional().describe("@internal uuid of the last pre-compact message \u2014 the backpointer "+"forkSession follows across the compaction break. Distinct from the session-file chain parent (which is the post-compact summary). Absent from older producers."),uuid:p(),session_id:o(),historical:O().optional().describe("@internal Replayed history rather than a live message (stamped by the Remote Control bridge when it flushes history to the session server).")})),WF=f(()=>u({type:T("system"),subtype:T("status"),status:NF(),permissionMode:de().optional(),compact_result:B(["success","failed"]).optional(),compact_error:o().optional(),compact_output_chars:E().int().optional().describe("@internal On the 'compacting' statuses of an automatic compaction (absent on a typed /compact): characters of the summary streamed so far (text and tool-input deltas, not thinking). Returns to 0 at each new attempt at the summary (a request retried inside an attempt adds to what the dropped try streamed), and stays 0 while waiting for a summary written in the background. A rising count shows that the summary is being written; a still one proves nothing, and it is not a share of the final length, which is not known in advance."),uuid:p(),session_id:o()})),_o=f(()=>u({type:T("system"),subtype:T("post_turn_summary"),summarizes_uuid:o(),status_category:o(),status_detail:o(),needs_action:o(),uuid:p(),session_id:o()}).describe("@internal Background post-turn summary emitted after each assistant turn. summarizes_uuid points to the assistant message this summarizes.")),go=f(()=>u({type:T("system"),subtype:T("task_summary"),detail:o().nullable(),uuid:p(),session_id:o()}).describe("@internal Mid-turn progress line from the debounced classifier. Mirrors external_metadata.task_summary so non-CCR consumers (desktop LocalSessionManager) see the same live phrase. detail is null on the idle clear.")),fo=f(()=>u({type:T("system"),subtype:T("session_metadata"),metadata:u({artifacts:C(u({url:o(),title:o().optional(),favicon:o().optional(),kind:T("frame"),updated_at:o()})).nullable().optional()}),uuid:p(),session_id:o()}).describe("@internal The same external_metadata patch a cloud worker sends the session server, for the keys a local host needs: today `artifacts` (the session's published-artifact list, whole list on each change, null once empty). Lets an SDK host keep the per-session summary a cloud session gets, without reading transcript rows.")),YF=f(()=>u({type:T("system"),subtype:T("informational"),content:o(),level:B(["info","notice","suggestion","warning"]).describe("Render level. 'info' shows only in transcript mode; 'notice' renders in inactive gray; 'suggestion' and 'warning' are more prominent."),tool_use_id:o().optional().describe("Dedupes progress messages for the same tool use."),prevent_continuation:O().optional().describe("When true, execution stops after this message (e.g. a Stop hook denied continuation)."),tag:o().optional().describe("Opaque feature tag on a line a host may treat specially; absent on ordinary lines. Hosts ignore values they do not know."),prompt_submit_outcome:u({kind:B(tA).optional().catch(void 0),no_verdict_kind:B(sA).optional().catch(void 0).describe("Sent with kind 'no_verdict', and says why: 'remote_run_failed' (the hook runs on another machine, and the run failed or gave no usable answer), 'remote_run_timed_out' (the wait for that run timed out; the hook may never have been sent), 'interrupted' (the turn was aborted during that wait), 'remote_runner_refused' (Claude Code does not send this hook to that machine; a retry does not help), 'unsupported_in_cloud_session' (a cloud session cannot run this type of hook), 'output_distrusted' (Claude Code could not prove that it read all of the hook's output), 'callback_timed_out' (a callback hook did not answer in time), 'hook_failed' and 'hook_timed_out' (for this hook a failure blocks), 'hooks_never_ran' (an internal fault: the hooks did not run over the submitted text), 'personal_config_refused' (the session restricts personal config, and part of the person's own settings did not load or is off), 'rewrite_unplaceable' (a plugin's code module changed the prompt's text, and Claude Code has no place to put the change)."),prompt_kept:O(),reason:o().optional()}).optional().catch(void 0).describe("@internal Present on the line that ends a submitted prompt before a model call. It says how the prompt ended, so a host can write its own message or count endings and does not match `content`. kind: 'blocked_by_hook' (a hook answered with a block), 'stopped_by_hook' (a hook answered continue:false), 'dropped_by_hook' (a plugin's code module dropped the prompt), 'not_passed_on' (a plugin's code module answered and did not pass the prompt on), 'no_verdict' (no hook gave a verdict, and Claude Code ended the prompt itself). prompt_kept: true when the prompt stays in the conversation, where the model reads it on the next turn. Do not infer it from kind. reason: the hook's text as Claude Code got it, with nothing added here; a model writes it for a prompt or agent hook. It is never sent with no_verdict. It is absent when Claude Code got no text, and for a plugin's code module that blocks on the UserPromptSubmit hook event. ANSI codes are removed, control and invisible characters are replaced, line feeds stay, and long text is cut. It is untrusted and can quote the prompt, so render it as plain text. A cloud session can run the hook on another machine: its tool container, where any program can write reason, or the person's own machine. reason is then what that machine sent, for a block and for a stop. The person's own machine puts a label before the stderr of an exit 2, or before 'No stderr output' when there is none. Either machine makes the block itself when it could not read all of the hook's output, and the person's own machine can do so when its timeout fires. Each reads 'blocked_by_hook', with that machine's sentence as reason. Claude Code's own block for an SDK host that reconnected before its hook answered reads the same way, with Claude Code's sentence as reason. New values can appear: treat an unknown value as absent, and ignore reason beside an unknown kind. A slash command that runs as a fork does not send this key when a hook ends it. A follow-up that a hook blocks while a turn runs carries this key too, so read it as the end of a turn only when the next result has num_turns 0."),uuid:p(),session_id:o()}).describe("Generic text banner emitted by the loop \u2014 non-error status lines, hook feedback (e.g. a UserPromptSubmit hook's block reason), slash-command output. Hosts render `content` as plaintext at the given level.")),I8=f(()=>u({type:T("system"),subtype:T("permission_retry"),content:o(),commands:C(o()).describe("Display names of the commands that were allowed."),uuid:p(),session_id:o()}).describe("@internal Emitted when tool execution retries after a permission-mode change allowed previously-denied commands. REPL renders a 'retrying with <commands>' banner. From internal SystemMessage 'permission_retry'.")),P8=f(()=>u({type:T("system"),subtype:T("stop_hook_summary"),hook_count:E().int(),hook_infos:C(u({command:o(),prompt_text:o().optional(),duration_ms:E().int().optional()})),hook_errors:C(o()),hook_additional_context:C(o()).optional().describe("Non-error feedback from hookSpecificOutput.additionalContext \u2014 kept separate from hook_errors so the sanctioned feedback channel is not labeled an error. Absent in sessions persisted before this field existed."),prevented_continuation:O(),stop_reason:o().optional(),has_output:O(),level:B(["info","notice","suggestion","warning"]),tool_use_id:o().optional(),hook_label:o().optional(),total_duration_ms:E().int().optional(),uuid:p(),session_id:o()}).describe("@internal Summary of Stop/SubagentStop hook execution at turn end \u2014 which hooks ran, their output, and whether any prevented continuation. From internal SystemMessage 'stop_hook_summary'.")),M8=f(()=>u({type:T("system"),subtype:T("memory_saved"),written_paths:C(o()),team_count:E().int().optional(),verb:o().optional().describe('Renders as "<verb> N memories". Defaults to "Saved".'),uuid:p(),session_id:o()}).describe("@internal Confirmation that the memory subsystem wrote to the listed paths. REPL renders a '<verb> N memories' banner. From internal SystemMessage 'memory_saved'.")),x8=f(()=>u({type:T("system"),subtype:T("agents_killed"),uuid:p(),session_id:o()}).describe("@internal Emitted when background agents are terminated (e.g. on interrupt). REPL renders an 'agents killed' banner. From internal SystemMessage 'agents_killed'.")),$F=f(()=>u({type:T("system"),subtype:T("instruction_size_warning"),total_chars:E().int().describe("Combined length, in characters, of the instruction files in the session prompt: CLAUDE.md files, rules files and the files they import. Always over total_limit_chars."),total_limit_chars:E().int().describe("The recommended limit for total_chars on the turn's model, in characters."),file_count:E().int().describe("Number of files counted in total_chars. When it is 1, word the warning for a single file rather than a total."),largest_chars:E().int().optional().describe("Length of the largest file, in characters. Present only when the warning should mention it: there are several files and this one by itself is over total_limit_chars."),uuid:p(),session_id:o()}).describe("@internal The session's instruction files add up to more than the recommended limit. Numbers only: the host words the warning in the person's language. Sent to Claude Desktop's Code tab alone, at most once per process, on a conversation's first turn after system/init; never stored in the transcript. Safe to ignore: a host that does not recognize this subtype shows nothing.")),D8=f(()=>u({type:T("system"),subtype:T("away_summary"),content:o(),uuid:p(),session_id:o()}).describe("@internal Summary of what happened while the user was away (background tasks completed, notifications accumulated). From internal SystemMessage 'away_summary'.")),L8=f(()=>u({type:T("system"),subtype:T("thinking"),content:o(),uuid:p(),session_id:o()}).describe("@internal Rendered thinking content (the text itself, not the running token estimate \u2014 that is SDKThinkingTokensMessage). From internal SystemMessage 'thinking'.")),bo=f(()=>u({type:T("transcript_mirror"),filePath:o(),entries:C(oe())}).describe("@internal Emitted after each successful local transcript write. The parent peels these off the stdout stream and batches them to the SessionStore adapter. Not exposed to public SDK consumers.")),XF=f(()=>u({type:T("system"),subtype:T("mirror_error"),error:o(),key:u({projectKey:o(),sessionId:o(),subpath:o().optional()}),uuid:p(),session_id:o()}).describe("Emitted when SessionStore.append() rejects or times out for a transcript-mirror batch after bounded retry (3 attempts with short backoff; timeouts are not retried). The batch is then dropped; this surfaces the failure so consumers are not silent on data loss.")),QF=f(()=>u({type:T("system"),subtype:T("api_retry"),attempt:E().int(),max_retries:E().int(),retry_delay_ms:E().int(),error_status:E().int().nullable(),error:ho(),no_response:u({waited_ms:E().int(),retry_wait_ms:E().int()}).optional().describe("Present only when the API sent no response headers within the first-byte window (CLAUDE_STREAM_FIRST_BYTE_TIMEOUT_MS): waited_ms is how long the failed attempt waited for headers, retry_wait_ms how long the retry will wait for them. For this cause max_retries is its own cap (normally one retry), not the session budget."),uuid:p(),session_id:o()}).describe("Emitted when an API request fails with a retryable error and will be retried after a delay. error_status is null for connection errors (e.g. timeouts) that had no HTTP response.")),JF=f(()=>u({type:T("system"),subtype:T("control_request_progress"),request_id:o().describe("request_id of the in-flight control_request this progress belongs to."),status:B(["started","api_retry"]),attempt:E().int().optional(),max_retries:E().int().optional(),retry_delay_ms:E().int().optional(),error_status:E().int().nullable().optional(),uuid:p(),session_id:o()}).describe("Progress for a long-running client-originated control_request (currently only side_question), correlated by request_id. status 'started' means the worker accepted the request and launched the work; 'api_retry' carries the same retry counters as SDKAPIRetryMessage and is present only for that status.")),ZF=f(()=>u({type:T("system"),subtype:T("model_refusal_fallback"),trigger:T("refusal"),direction:B(["retry","revert","sticky"]),scope:B(["session","local"]).optional().describe("'session': the main thread fell back and the session model is swapped. 'local': a subagent / side-question (/btw) / background fork fell back \u2014 only that response came from the fallback model and the session model is unchanged. Absent from older CLIs (treat as 'session')."),original_model:o(),fallback_model:o(),request_id:o().nullable(),api_refusal_category:o().nullable().optional().describe("The refusal category ('cyber', 'bio', \u2026): stop_details.category from the refused API response (client lane), or the fallback block's server-gated trigger.category (server lane). Open string \u2014 new categories ship on the wire ahead of schema updates. null when neither source carried a category (normal, not an error). Absent when emitted by an older CLI."),saw_cyber_refusal:T(!0).optional().describe("@internal Present when ANY hop of this banner's multi-hop episode was a cyber refusal \u2014 not only the origin hop that api_refusal_category describes (the banner keeps first-hop category semantics for display). Re-arm evidence for the CLI's cyber-exclusion header on session restore; never rendered, not part of the public SDK contract. Absent on cyber-free episodes and when emitted by an older CLI."),api_refusal_explanation:o().nullable().optional().describe("stop_details.explanation from the refused API response (client lane only \u2014 the server-lane trigger carries no explanation). Unstable human prose \u2014 display only, never parse. null/absent when the response carried none, and always null on server-lane banners."),retracted_message_uuids:C(o()).optional().describe("Wire uuids of the messages this fallback retracted \u2014 the refused partial as the consumer received it (one uuid per normalized SDK message; multi-block messages carry per-block derived uuids) plus any tombstoned tool_results. Emitted AFTER the retraction, so this is a resolution-time eviction signal: remove these messages from transcript state on receipt. Eviction is idempotent \u2014 unknown or already-removed uuids are a no-op. Absent when emitted by an older CLI."),refused_user_message_uuid:o().nullable().optional().describe("UUID of the user message the refused request was for \u2014 the rewind target and composer prefill for edit-and-retry. This is the message's own uuid as delivered on the replay ack (not a per-block normalized uuid). null when the refused turn was not human-authored (e.g. a background task notification or auto-continuation \u2014 nothing to edit-and-retry) or otherwise cannot be identified; absent from older CLIs."),content:o(),uuid:p(),session_id:o()}).describe('Emitted when the primary model ends the stream with stop_reason "refusal" and the turn is retried once on a fallback model (direction: "retry"). When `scope` is "session" (or absent \u2014 older CLIs), the swap is made persistent for the session; when `scope` is "local", only that subagent/side-question response came from the fallback model and the session model is unchanged. "revert" and "sticky" are retained in the enum for SDK-consumer compat and are no longer emitted.')),eW=f(()=>u({type:T("system"),subtype:T("model_refusal_no_fallback"),original_model:o(),request_id:o().nullable(),api_refusal_category:o().nullable().optional(),api_refusal_explanation:o().nullable().optional(),refused_user_message_uuid:o().nullable().optional(),content:o(),uuid:p(),session_id:o()}).describe('Emitted when the model ends the stream with stop_reason "refusal" and no retry runs: no fallback model is configured, or per-category routing declined the retry (the mapped fallback target is unresolvable, or CLAUDE_CODE_REFUSAL_FALLBACK_CATCH_ALL is explicitly disabled and the refusal category has no fallback map entry). The structured counterpart to detecting stop_reason "refusal" on the assistant error frame. Not emitted when the retry ran or the user declined the retry dialog (model_refusal_fallback covers the retry case). Absent from older CLIs.')),U8=f(()=>u({type:T("system"),subtype:T("model_fallback"),trigger:B(["model_not_found","permission_denied","overloaded","server_error","last_resort","model_blocked"]),original_model:o(),fallback_model:o(),content:o(),uuid:p(),session_id:o()}).describe('@internal Emitted when the current turn is switched to the configured fallback model because the primary model failed (trigger "model_not_found": model retired/unknown; "permission_denied": org lacks access; "overloaded": repeated 529s; "server_error": retryable 5xx pivot; "last_resort": non-retryable error on the primary; "model_blocked": primary disabled by the per-model kill switch). Turn-scoped \u2014 the primary is re-tried on the next user turn. Not yet in the public SDKMessage union.')),V8=f(()=>u({type:T("system"),subtype:T("model_consent_fallback"),choice:B(["consent","switch_default","cancelled"]).describe("The consent-prompt answer (or no-dialog collapse) that produced the swap. 'consent' appears here only when the gate could not honor it (e.g. usage credits did not end up provisioned \u2014 the loop never enables billing from a bare wire reply)."),original_model:o(),original_model_name:o().optional().describe(`The name the CLI's usage-credit copy uses for original_model ("Fable 5"), for a host that renders its own notice; "Fable" when absent.`),fallback_model:o(),persisted_as_default:O().describe("True when the decline also rewrote the saved default model (explicit switch_default with the consent-gated model as the saved default)."),content:o(),uuid:p(),session_id:o()}).describe("@internal Emitted when a pre-send model consent gate swaps the session off the requested model (consent declined, dismissed, or given without the required entitlement ending up provisioned). Currently emitted by the Fable 5 usage-credit gate (`fable_overage_consent_prompt`). Session-scoped \u2014 the swap persists for the session, and additionally as the saved default when persisted_as_default is true. Absence of this message after the consent dialog resolves means the session stayed on the requested model. Not yet in the public SDKMessage union.")),j8=f(()=>u({type:T("system"),subtype:T("file_snapshot"),content:o(),snapshot_files:C(u({key:o().describe("Identifier for the file type (e.g. 'plan', 'todo')."),path:o().describe("Original file path (for debugging)."),content:o()})),uuid:p(),session_id:o()}).describe("@internal Snapshot of session files (plan, todo) captured for rewind. From internal SystemMessage 'file_snapshot'.")),q8=f(()=>u({type:T("system"),subtype:T("scheduled_task_fire"),content:o(),uuid:p(),session_id:o()}).describe("@internal Emitted when a scheduled task (cron) fires. content is the render text. From internal SystemMessage 'scheduled_task_fire'.")),tW=f(()=>u({type:T("system"),subtype:T("peer_message_hold"),state:B(["held","released","dropped"]).describe("'held' when the receive-side policy parks the message instead of queueing it (once per message per hold cause \u2014 a re-announcement under a different cause emits again); then at most one of 'released' (the policy now accepts it: it enters the queue \u2014 its command_lifecycle 'queued' and, when it drains, its user replay echo follow under message_uuid) or 'dropped' (it will never reach the model in this session; see outcome)."),message_uuid:o().optional().describe("The parked command's uuid \u2014 the value its later command_lifecycle frames and user replay echo carry. For lane 'bridge'/'stdin' it is the id the host (or its bridge) supplied on the inbound message; for lane 'socket' it was chosen by the SENDING session, so a host must correlate it only within peer_message_hold / peer replay frames, never against its own prompts' lifecycle."),lane:B(["bridge","stdin","socket"]).describe("Which ingress delivered it: the Remote Control bridge, the host's own stdin stream, or the local cross-session socket."),from:o().describe("The sender's address as the envelope will show it (the cross-session-message `from`) \u2014 an address-shaped token with control and invisible code points scrubbed; empty when the sender supplied none or an unshaped one. Sender-asserted on the socket lane: a label, not an identity proof."),from_name:o().optional().describe("The sender's display name when it supplied one, normalized and scrubbed the same way. A claim, like `from`."),cause:B(["explicit-setting","managed-setting","repo-setting","invalid-setting","bypass-default","mode-unknown","mode-mismatch","no-mode-asserted"]).optional().describe("state 'held' only: why the policy parked it. 'mode-mismatch' / 'no-mode-asserted' are the permission-mode parity holds (the sender runs in a different permission class, or asserted none while this session bypasses permissions); the *-setting causes are a standing crossSessionInbound:'hold'."),outcome:B(["expired","refused","dropped","discarded"]).optional().describe("state 'dropped' only: 'expired' \u2014 no one approved it before the approval deadline (a headless host has no approval surface, so every parity hold ends this way unless the mode changes first); 'refused' \u2014 the policy turned to refuse while it waited; 'dropped' \u2014 released or approved but the ingress guard (rate limit, duplicate, queue cap) discarded it; 'discarded' \u2014 the session ended with it still parked."),uuid:p(),session_id:o()}).describe("@internal A cross-session (peer) message this session's receive-side policy HELD rather than queued, and how that hold resolved. Lets a host show the human that a message arrived but has not reached the model (and may never) instead of nothing at all; the sending session is told separately over its own transport where one exists. Informational only \u2014 there is no host-side approval through this frame. Emitted on the stdout stream in -p/SDK sessions.")),G8=f(()=>u({type:T("system"),subtype:T("turn_duration"),duration_ms:E().int(),budget_tokens:E().int().optional().describe("Output tokens spent this turn toward the token budget."),budget_limit:E().int().optional().describe("Turn token-budget ceiling."),budget_nudges:E().int().optional().describe("Budget-nudge count this turn."),message_count:E().int().optional().describe("In-memory message count at turn end; used by resume-consistency telemetry to detect write\u2192load round-trip drift."),pending_background_agent_count:E().int().optional().describe("Background Agent-tool runs still in flight when the turn finished."),pending_workflow_count:E().int().optional().describe("Workflow-tool runs still in flight when the turn finished."),uuid:p(),session_id:o()}).describe("@internal Per-turn wall-clock duration plus budget and pending-background-work counts. REPL renders the 'Done in Ns' / 'Waiting for N agents' line. From internal SystemMessage 'turn_duration'.")),B8=f(()=>u({type:T("system"),subtype:T("api_error"),error:u({message:o(),status:E().int().optional(),request_id:o().optional(),formatted:o().describe("Human-readable display string for the error."),connection:u({code:o(),message:o(),is_ssl_error:O()}).nullable().describe("errno/SSL code extracted from the cause chain; null when absent."),is_network_down:O(),rate_limits:u({resets_at:E().int().optional(),rate_limit_type:o().optional()}).nullable().describe("Quota-429 headers surfaced by the retry banner; null when not a quota 429.")}).describe("Plain-data snapshot of the APIError \u2014 the class instance cannot cross the wire."),retry_in_ms:E().int(),retry_attempt:E().int(),max_retries:E().int(),uuid:p(),session_id:o()}).describe("@internal Retryable-API-error frame carrying the plain-data error snapshot and retry counters. REPL renders the retry banner from this. Wire twin is SDKAPIRetryMessage ('api_retry'). From internal SystemMessage 'api_error'."));var sW=f(()=>u({type:T("system"),subtype:T("local_command_output"),content:o(),uuid:p(),session_id:o()}).describe("Output from a local slash command (e.g. /voice, /usage). Displayed as assistant-style text in the transcript.")),nW=f(()=>u({type:T("system"),subtype:T("hook_started"),hook_id:o(),hook_name:o